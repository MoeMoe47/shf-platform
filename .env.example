# SHRV1 local development environment example.
# Copy to .env.local or .env for local use only. Never commit real secrets.

# Local-only placeholder. Replace locally; staging and production must use a secret manager.
ADMIN_API_KEY=replace-with-local-dev-key

# Cross-app route bridge base URLs.
VITE_SHRV1_BASE_URL=http://127.0.0.1:5174
VITE_SHF_NEXT_BASE_URL=http://127.0.0.1:5175
VITE_UNIVERSE_ORIGIN=http://127.0.0.1:5173

# Optional frontend origin for local Agent Fabric CORS configuration.
SHF_WEB_ORIGIN=http://127.0.0.1:5174

# Canonical local services: SHS API http://127.0.0.1:8091, Agent Fabric http://127.0.0.1:8090.

# Canonical SHS API (apps/shs-api; local port 8091). Resolved by
# src/system/identity/authConfig.js: window.__SHS_API_BASE__ -> VITE_SHS_API_BASE -> "/api".
# Leave unset in local development to use the same-origin "/api" path, which
# the Vite dev proxy forwards to http://127.0.0.1:8091 (vite.config.js).
# Set to an absolute origin only where no proxy is available, e.g.:
# VITE_SHS_API_BASE=http://127.0.0.1:8091
# VITE_API_BASE is a legacy override that several clients read for DIFFERENT
# backends (SHS API, Civic); leave it unset and use
# VITE_SHS_API_BASE / VITE_FABRIC_API_BASE instead.

# Agent Fabric (services/shf-agent-fabric; local port 8090 — main.py default,
# started by services/shf-agent-fabric/bin/restart_8090.sh). Every frontend
# Fabric client resolves its base through src/system/fabric/fabricConfig.js:
#   VITE_FABRIC_API_BASE -> VITE_FABRIC_URL -> VITE_FABRIC_BASE_URL -> "/fabric-api"
# Leave unset in local development: "/fabric-api" is the same-origin Vite dev
# proxy to http://127.0.0.1:8090 (vite.config.js; override its target with
# SHS_VITE_FABRIC_PROXY_TARGET). "/api" stays SHS-API-only.
# In production, either set VITE_FABRIC_API_BASE to an approved public Fabric
# origin or set VITE_FABRIC_ENABLE_SAME_ORIGIN_PROXY=true only after the
# frontend/gateway really routes /fabric-api/* to Agent Fabric. Otherwise the
# frontend uses /__fabric-production-route-unconfigured__ so the missing route
# is visible and never falls back to localhost.
# Set an absolute origin only where no proxy is available, e.g.:
# VITE_FABRIC_API_BASE=http://127.0.0.1:8090
# VITE_FABRIC_ENABLE_SAME_ORIGIN_PROXY=true
# VITE_FABRIC_URL and VITE_FABRIC_BASE_URL are legacy compatibility aliases;
# prefer VITE_FABRIC_API_BASE. Never use VITE_API_BASE for the Fabric.
