############################################################
# SHF — Top-1% Git Hygiene
# Goal: never commit secrets, local dbs, logs, build output,
# OS junk, or editor temp/backup files.
############################################################

# --- Secrets (never commit) ---
.env
.env.*
!.env.example
!.env.sample
!.env.template

# --- OS / Editor / IDE junk ---
.DS_Store
.DS_Store?
Thumbs.db
.idea/
.vscode/
*.swp
*.swo

# --- Node / Vite / React ---
node_modules/
dist/
build/
.cache/
.vite/
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
coverage/

# --- Python ---
__pycache__/
*.py[cod]
*.pyo
.venv/
venv/
.envrc

# --- Local databases / data directories ---
db/
**/*.sqlite
**/*.sqlite3
**/*.db

# Canonical SHS database client/runner source is code, not a local database.
!apps/shs-api/src/db/
!apps/shs-api/src/db/**

# --- Runtime logs (services + app) ---
logs/
**/logs/
*.log

# --- Generated artifacts / outputs ---
/tmp/
*.pdf
*.zip

# --- Terraform local state and configuration ---
*.tfstate
*.tfstate.*
.terraform/
*.tfvars
!*.tfvars.example

# Allow curated contract snapshots (keep these tracked)
!services/shf-agent-fabric/registry/contracts/
!services/shf-agent-fabric/registry/contracts/**

# --- Backups / scratch / accidental exports ---
backups/
**/*.bak
**/*.bak.*
**/*.save
**/*.old
**/*.orig
**/*~ 
**/*.tmp

# --- Safety: never commit published runs (regenerate anytime) ---
services/shf-agent-fabric/registry/published/
services/shf-agent-fabric/registry/audit/

# Playwright
test-results/
playwright-report/

# Playwright
test-results/
playwright-report/

# local backups
*.bak
*.bak.*

# Python caches
__pycache__/
*.py[cod]

# local backups / artifacts
.backup_loo_*/
loo_rankings*.json
.env.local

# Local heavyweight Blender working archive; back up separately
/assets-source/brainiact/blender/

# Downloaded Terraform working directories
**/.terraform/
