import React from "react";

function badgeStyle(kind = "neutral") {
  if (kind === "strong") {
    return {
      border: "1px solid rgba(34,197,94,0.28)",
      background: "rgba(34,197,94,0.08)",
      color: "rgba(220,252,231,0.98)",
    };
  }
  if (kind === "weak") {
    return {
      border: "1px solid rgba(245,158,11,0.28)",
      background: "rgba(245,158,11,0.08)",
      color: "rgba(254,243,199,0.98)",
    };
  }
  return {
    border: "1px solid rgba(148,163,184,0.22)",
    background: "rgba(148,163,184,0.08)",
    color: "rgba(226,232,240,0.98)",
  };
}

function Row({ label, value }) {
  return (
    <div
      style={{
        display: "grid",
        gridTemplateColumns: "160px 1fr",
        gap: 14,
        alignItems: "start",
        padding: "12px 0",
        borderTop: "1px solid rgba(148,163,184,0.10)",
      }}
    >
      <span
        style={{
          fontSize: 11,
          letterSpacing: "0.08em",
          textTransform: "uppercase",
          color: "rgba(148,163,184,0.86)",
        }}
      >
        {label}
      </span>
      <strong
        style={{
          fontSize: 15,
          lineHeight: 1.6,
          color: "rgba(241,245,249,0.98)",
          fontWeight: 700,
        }}
      >
        {value ?? "—"}
      </strong>
    </div>
  );
}

export default function ComparePanel({ data, loading, error }) {
  return (
    <section
      className="reporting-command__card"
      style={{
        marginTop: 18,
        border: "1px solid rgba(99,102,241,0.22)",
        background: "linear-gradient(180deg, rgba(6,10,24,0.98), rgba(3,8,18,0.995))",
        boxShadow: "0 18px 40px rgba(2, 6, 23, 0.18)",
      }}
    >
      <div className="reporting-command__card-top">
        <div>
          <p className="reporting-command__card-kicker">Cross-Entity Intelligence</p>
          <h2 className="reporting-command__card-title">Oracle Compare Panel</h2>
        </div>
      </div>

      {loading ? (
        <p className="reporting-command__summary">Loading comparison results…</p>
      ) : error ? (
        <div
          style={{
            padding: "12px 14px",
            borderRadius: 12,
            border: "1px solid rgba(239,68,68,0.22)",
            background: "rgba(127,29,29,0.14)",
            color: "rgba(254,202,202,0.98)",
            fontSize: 13,
            lineHeight: 1.5,
          }}
        >
          {error}
        </div>
      ) : !data ? (
        <p className="reporting-command__summary">No comparison data available.</p>
      ) : (
        <>
          <div
            style={{
              marginTop: 10,
              padding: "14px 16px",
              borderRadius: 12,
              border: "1px solid rgba(99,102,241,0.18)",
              background: "rgba(99,102,241,0.08)",
              color: "rgba(224,231,255,0.98)",
              fontSize: 14,
              lineHeight: 1.65,
              fontWeight: 600,
            }}
          >
            {data.summary}
          </div>

          <div
            style={{
              display: "grid",
              gridTemplateColumns: "repeat(2, minmax(0, 1fr))",
              gap: 16,
              marginTop: 16,
            }}
          >
            <article
              style={{
                padding: 16,
                borderRadius: 14,
                ...badgeStyle("strong"),
              }}
            >
              <div
                style={{
                  fontSize: 11,
                  letterSpacing: "0.08em",
                  textTransform: "uppercase",
                  opacity: 0.85,
                  marginBottom: 8,
                }}
              >
                Strongest Case
              </div>
              <div style={{ fontSize: 20, fontWeight: 800 }}>
                {data.strongest?.entityId || "—"}
              </div>
              <div style={{ marginTop: 8, fontSize: 14, lineHeight: 1.6 }}>
                Readiness: {data.strongest?.readinessStatus || "—"}<br />
                Confidence: {data.strongest?.confidenceScore ?? "—"} ({data.strongest?.confidenceBand || "—"})<br />
                Contradictions: {data.strongest?.contradictionStatus || "—"}
              </div>
            </article>

            <article
              style={{
                padding: 16,
                borderRadius: 14,
                ...badgeStyle("weak"),
              }}
            >
              <div
                style={{
                  fontSize: 11,
                  letterSpacing: "0.08em",
                  textTransform: "uppercase",
                  opacity: 0.85,
                  marginBottom: 8,
                }}
              >
                Weakest Case
              </div>
              <div style={{ fontSize: 20, fontWeight: 800 }}>
                {data.weakest?.entityId || "—"}
              </div>
              <div style={{ marginTop: 8, fontSize: 14, lineHeight: 1.6 }}>
                Readiness: {data.weakest?.readinessStatus || "—"}<br />
                Confidence: {data.weakest?.confidenceScore ?? "—"} ({data.weakest?.confidenceBand || "—"})<br />
                Contradictions: {data.weakest?.contradictionStatus || "—"}
              </div>
            </article>
          </div>

          <article
            style={{
              marginTop: 18,
              padding: 16,
              borderRadius: 14,
              border: "1px solid rgba(148,163,184,0.14)",
              background: "rgba(2,6,23,0.36)",
            }}
          >
            <div className="reporting-command__card-top">
              <div>
                <p className="reporting-command__card-kicker">Ranked Comparison</p>
                <h3 className="reporting-command__card-title" style={{ fontSize: 22 }}>
                  Priority Order
                </h3>
              </div>
            </div>

            <div style={{ display: "grid", gap: 0 }}>
              {(data.ranked || []).map((item, index) => (
                <div key={item.entityId || index}>
                  <Row
                    label={`Rank ${index + 1}`}
                    value={`${item.entityId} | ${item.readinessStatus} | ${item.confidenceScore} (${item.confidenceBand}) | contradictions: ${item.contradictionStatus}`}
                  />
                </div>
              ))}
            </div>
          </article>
        </>
      )}
    </section>
  );
}
