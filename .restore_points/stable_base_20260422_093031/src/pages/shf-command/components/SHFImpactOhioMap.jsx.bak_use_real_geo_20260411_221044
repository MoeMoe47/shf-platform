import React, { useState } from "react";
import "./shf-impact-ohio-map.css";

/*
  Recalibrated for a larger Ohio frame.
  Coordinates are relative to the INNER OHIO FRAME only.
*/
const COUNTY_POINTS = [
  { name: "Franklin",   x: 50.5, y: 63.0, size: "lg", active: true  },
  { name: "Cuyahoga",   x: 74.0, y: 18.5, size: "md", active: false },
  { name: "Hamilton",   x: 25.5, y: 86.5, size: "md", active: false },
  { name: "Summit",     x: 67.5, y: 33.5, size: "sm", active: false },
  { name: "Montgomery", x: 38.5, y: 74.0, size: "sm", active: false },
  { name: "Lucas",      x: 71.5, y: 5.5,  size: "sm", active: false },
];

export default function SHFImpactOhioMap() {
  const [hovered, setHovered] = useState(null);

  const countyData = {
    Franklin:   { programs: "5", people: "3,824", funding: "$4.5M", outcome: "82%", risk: "Stable" },
    Cuyahoga:   { programs: "4", people: "2,406", funding: "$3.2M", outcome: "79%", risk: "Watch" },
    Hamilton:   { programs: "3", people: "1,955", funding: "$2.1M", outcome: "74%", risk: "Stable" },
    Summit:     { programs: "2", people: "1,240", funding: "$1.4M", outcome: "71%", risk: "Opportunity" },
    Montgomery: { programs: "2", people: "1,112", funding: "$1.1M", outcome: "69%", risk: "Stable" },
    Lucas:      { programs: "2", people: "913",   funding: "$940K", outcome: "67%", risk: "Stable" },
  };

  const shown = hovered ? countyData[hovered.name] : countyData.Franklin;
  const shownName = hovered?.name || "Franklin";

  return (
    <div className="shf-impact-map-root">
      <div className="shf-impact-map-grid" />

      <div className="shf-impact-map-frame">
        <img
          src="/assets/shf-command/maps/shf-impact-ohio-texture.png"
          alt="Ohio map"
          className="shf-impact-map-base"
        />

        <div className="shf-impact-node-layer">
          {COUNTY_POINTS.map((n) => (
            <div
              key={n.name}
              className={`shf-impact-node shf-impact-node--${n.size} ${n.active ? "is-active" : ""}`}
              style={{ left: `${n.x}%`, top: `${n.y}%` }}
              onMouseEnter={() => setHovered(n)}
              onMouseLeave={() => setHovered(null)}
            >
              <div className="shf-impact-node-core" />
              <div className="shf-impact-node-pulse" />
            </div>
          ))}
        </div>
      </div>

      <div className="shf-impact-map-tooltip">
        <strong>{shownName} County</strong>
        <div>Programs Active: {shown.programs}</div>
        <div>People Served: {shown.people}</div>
        <div>Funding Deployed: {shown.funding}</div>
        <div>Top Outcome: {shown.outcome}</div>
        <div>Program Condition: {shown.risk}</div>
      </div>
    </div>
  );
}
