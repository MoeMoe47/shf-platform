.shf-impact-map-root {
  position: relative;
  min-height: 520px;
  border-radius: 26px;
  overflow: hidden;
  background: linear-gradient(180deg, rgba(248,243,236,0.94) 0%, rgba(240,234,226,0.98) 100%);
}

.shf-impact-map-grid {
  position: absolute;
  inset: 0;
  background-image:
    linear-gradient(rgba(122, 96, 70, 0.05) 1px, transparent 1px),
    linear-gradient(90deg, rgba(122, 96, 70, 0.05) 1px, transparent 1px);
  background-size: 44px 44px;
  pointer-events: none;
  z-index: 0;
}

.shf-impact-map-toolbar {
  position: absolute;
  top: 18px;
  right: 18px;
  display: flex;
  gap: 10px;
  z-index: 24;
}

.shf-impact-map-toolbar button {
  border: 1px solid rgba(164, 137, 108, 0.18);
  background: rgba(255,255,255,0.82);
  color: #7a6249;
  border-radius: 999px;
  padding: 10px 16px;
  font: inherit;
}

.shf-impact-map-toolbar .is-active {
  background: rgba(223, 179, 116, 0.20);
  color: #6b4a2e;
}

.shf-impact-map-stage {
  position: relative;
  height: 470px;
  padding: 26px 18px 18px;
  z-index: 1;
}

.shf-impact-map-surface {
  position: absolute;
  inset: 20px 18px 16px;
}

.shf-impact-map-ohio-body-slot,
.shf-impact-map-geo-slot,
.shf-impact-map-focus-halo,
.shf-impact-map-processing-layer {
  position: absolute;
  inset: 5% 8% 7% 8%;
}

.shf-impact-map-ohio-body-slot { z-index: 2; }
.shf-impact-map-geo-slot { z-index: 5; }
.shf-impact-map-focus-halo { z-index: 6; pointer-events: none; }
.shf-impact-map-processing-layer { z-index: 4; pointer-events: none; }

.shf-impact-map-ohio-body-slot svg,
.shf-impact-map-geo-slot svg {
  width: 100%;
  height: 100%;
}

.shf-impact-map-ohio-body-slot path,
.shf-impact-map-ohio-body-slot polygon,
.shf-impact-map-ohio-body-slot polyline {
  fill: rgba(225, 176, 112, 0.34) !important;
  stroke: rgba(134, 94, 59, 0.18) !important;
  stroke-width: 0.9 !important;
}

.shf-impact-map-geo-slot path,
.shf-impact-map-geo-slot polygon,
.shf-impact-map-geo-slot polyline {
  fill: transparent !important;
  stroke: rgba(112, 77, 46, 0.88) !important;
  stroke-width: 2.15 !important;
  vector-effect: non-scaling-stroke;
  stroke-linejoin: round;
  stroke-linecap: round;
}

.shf-impact-map-geo-slot .ohio-official-map-v2__county.is-hovered,
.shf-impact-map-geo-slot .ohio-official-map-v2__county.is-selected,
.shf-impact-map-geo-slot .ohio-official-map-v2__county.is-active {
  stroke: rgba(214, 128, 47, 0.98) !important;
  stroke-width: 3.6 !important;
  filter: drop-shadow(0 0 8px rgba(226,132,44,0.34));
}

.shf-processing-beacon {
  position: absolute;
  width: 66px;
  height: 66px;
  margin-left: -33px;
  margin-top: -33px;
  border-radius: 999px;
  background: radial-gradient(circle, rgba(232,182,96,0.40) 0%, rgba(232,182,96,0.18) 45%, rgba(232,182,96,0) 76%);
  animation: shfCountyPulseGold 1.9s ease-in-out infinite;
  z-index: 8;
}

.shf-processing-beacon::before {
  content: "";
  position: absolute;
  inset: 10px;
  border-radius: 999px;
  box-shadow:
    0 0 0 1px rgba(255, 231, 191, 0.50),
    0 0 20px rgba(215, 156, 78, 0.34);
}

.shf-processing-beacon[data-county="Franklin"] { left: 52%; top: 58%; }
.shf-processing-beacon[data-county="Cuyahoga"] { left: 67%; top: 26%; }
.shf-processing-beacon[data-county="Hamilton"] { left: 33%; top: 79%; }

@keyframes shfCountyPulseGold {
  0%, 100% { transform: scale(0.94); opacity: 0.78; }
  50% { transform: scale(1.20); opacity: 1; }
}

.shf-impact-map-focus-halo {
  background:
    radial-gradient(circle at 52% 58%, rgba(243, 172, 83, 0.26), transparent 9%),
    radial-gradient(circle at 52% 58%, rgba(255, 223, 170, 0.16), transparent 17%);
}

.shf-impact-map-tooltip {
  position: absolute;
  left: 8.5%;
  bottom: 36px;
  z-index: 30;
  background: rgba(255,255,255,0.95);
  border: 1px solid rgba(170, 137, 103, 0.16);
  border-radius: 22px;
  padding: 18px 20px 16px;
  min-width: 255px;
  box-shadow:
    0 18px 38px rgba(86, 58, 34, 0.10),
    0 2px 0 rgba(255,255,255,0.78) inset;
  opacity: 0;
  pointer-events: none;
  transform: translateY(8px) scale(0.985);
  transition: opacity 180ms ease, transform 220ms ease;
}

.shf-impact-map-tooltip.is-visible {
  opacity: 1;
  transform: translateY(0) scale(1);
}

.shf-impact-map-tooltip strong {
  display: block;
  margin-bottom: 10px;
  font-size: 18px;
}

.shf-impact-map-tooltip div {
  line-height: 1.55;
}

.shf-system-status {
  position: absolute;
  top: 18px;
  left: 18px;
  z-index: 24;
  display: inline-flex;
  align-items: center;
  gap: 10px;
  max-width: min(520px, calc(100% - 180px));
  padding: 10px 14px;
  border-radius: 999px;
  border: 1px solid rgba(166, 133, 97, 0.16);
  background: rgba(255, 251, 245, 0.80);
  backdrop-filter: blur(10px);
  box-shadow:
    0 6px 18px rgba(80, 56, 34, 0.06),
    0 1px 0 rgba(255,255,255,0.66) inset;
  opacity: 0;
  transform: translateY(-6px);
  pointer-events: none;
  transition: opacity 220ms ease, transform 260ms ease;
}

.shf-system-status.is-visible {
  opacity: 1;
  transform: translateY(0);
}

.shf-system-status__dot {
  width: 8px;
  height: 8px;
  border-radius: 999px;
  flex: 0 0 auto;
  background: rgba(207, 148, 72, 0.95);
  box-shadow: 0 0 0 4px rgba(230, 183, 109, 0.14);
}

.shf-system-status__text {
  font-size: 12px;
  line-height: 1.2;
  letter-spacing: 0.01em;
  color: rgba(99, 69, 43, 0.88);
  white-space: nowrap;
  overflow: hidden;
  text-overflow: ellipsis;
}

.shf-regional-detail-panel {
  position: absolute;
  right: 18px;
  bottom: 18px;
  z-index: 35;
  min-width: 250px;
  background: rgba(255,255,255,0.94);
  border: 1px solid rgba(170, 137, 103, 0.16);
  border-radius: 22px;
  padding: 18px 18px 16px;
  box-shadow:
    0 18px 38px rgba(86, 58, 34, 0.12),
    0 2px 0 rgba(255,255,255,0.78) inset;
}



/* ===== COMMAND STRIP + STATUS CHIPS ===== */
.shf-command-strip {
  position: absolute;
  left: 18px;
  right: 290px;
  bottom: 18px;
  z-index: 20;
  display: flex;
  flex-direction: column;
  gap: 8px;
  padding: 8px 10px 10px;
  border-radius: 16px;
  border: 1px solid rgba(166, 133, 97, 0.12);
  background: rgba(255, 250, 242, 0.66);
  backdrop-filter: blur(10px);
  box-shadow:
    0 6px 16px rgba(80, 56, 34, 0.05),
    0 1px 0 rgba(255,255,255,0.68) inset;
}

.shf-command-strip__label {
  font-size: 10px;
  letter-spacing: 0.10em;
  text-transform: uppercase;
  color: rgba(115, 86, 58, 0.72);
}

.shf-command-strip__chips {
  display: grid;
  grid-template-columns: repeat(6, minmax(0, 1fr));
  gap: 6px;
}

.shf-command-chip {
  display: flex;
  flex-direction: column;
  gap: 2px;
  min-height: 42px;
  padding: 7px 9px;
  border-radius: 12px;
  border: 1px solid rgba(170, 137, 103, 0.12);
  background: rgba(255,255,255,0.72);
  box-shadow: 0 1px 0 rgba(255,255,255,0.62) inset;
}

.shf-command-chip span {
  font-size: 8px;
  text-transform: uppercase;
  letter-spacing: 0.06em;
  color: rgba(120, 91, 64, 0.70);
}

.shf-command-chip strong {
  font-size: 11px;
  line-height: 1.12;
  color: rgba(88, 60, 35, 0.96);
}

.shf-command-chip--confidence {
  background:
    linear-gradient(180deg, rgba(255,245,227,0.92) 0%, rgba(251,235,206,0.84) 100%);
  border-color: rgba(214, 166, 91, 0.22);
}

@media (max-width: 1200px) {
  .shf-command-strip__chips {
    grid-template-columns: repeat(3, minmax(0, 1fr));
  }
}

@media (max-width: 980px) {
  .shf-command-strip {
    right: 18px;
  }

  .shf-command-strip__chips {
    grid-template-columns: repeat(3, minmax(0, 1fr));
  }

  .shf-regional-detail-panel {
    position: absolute;
    right: 18px;
    left: 18px;
    bottom: 92px;
    width: auto;
    min-width: 0;
  }
}

@media (max-width: 760px) {
  .shf-command-strip {
    left: 18px;
    right: 18px;
    bottom: 18px;
  }

  .shf-command-strip__chips {
    grid-template-columns: repeat(2, minmax(0, 1fr));
  }

  .shf-impact-map-stage {
    padding-bottom: 148px;
  }
}


/* ===== REGIONAL DRILLDOWN ===== */
.shf-regional-cluster-surface {
  position: absolute;
  inset: 18px 18px 18px;
  border-radius: 24px;
  overflow: hidden;
  background:
    radial-gradient(circle at 50% 46%, rgba(246, 223, 183, 0.16), transparent 28%),
    linear-gradient(180deg, rgba(246,239,229,0.78) 0%, rgba(236,227,214,0.88) 100%);
}

.shf-regional-cluster-surface::before {
  content: "";
  position: absolute;
  inset: 0;
  pointer-events: none;
  background-image:
    linear-gradient(rgba(122, 96, 70, 0.04) 1px, transparent 1px),
    linear-gradient(90deg, rgba(122, 96, 70, 0.04) 1px, transparent 1px);
  background-size: 44px 44px;
  z-index: 0;
}

.shf-regional-cluster-svg {
  position: absolute;
  inset: 0;
  width: 100%;
  height: 100%;
  z-index: 1;
}

.shf-regional-counties {
  isolation: isolate;
}

.shf-regional-county {
  stroke-linejoin: round;
  stroke-linecap: round;
  transition:
    opacity 220ms ease,
    filter 220ms ease,
    stroke 220ms ease,
    fill 220ms ease,
    transform 220ms ease;
  cursor: pointer;
  transform-box: fill-box;
  transform-origin: center;
}

.shf-regional-county.is-context {
  fill: rgba(255, 143, 47, 0.10);
  stroke: rgba(122, 82, 47, 0.46);
  stroke-width: 2.1;
  opacity: 0.84;
  filter:
    drop-shadow(0 0 1px rgba(214, 120, 34, 0.06));
}

.shf-regional-county.is-context.is-hovered {
  fill: rgba(255, 160, 70, 0.24);
  stroke: rgba(214, 128, 47, 0.92);
  stroke-width: 3;
  filter:
    drop-shadow(0 0 8px rgba(223,131,40,0.22));
  opacity: 0.96;
}

.shf-regional-county.is-selected {
  stroke: rgba(255, 236, 196, 1);
  stroke-width: 4.8;
  opacity: 1;
  filter:
    url(#shfRegionalGoldGlow)
    drop-shadow(0 0 12px rgba(255, 146, 38, 0.40))
    drop-shadow(0 0 28px rgba(255, 108, 22, 0.32))
    drop-shadow(0 0 54px rgba(255, 186, 92, 0.22));
  animation: shfRegionalLavaPulse 1.9s ease-in-out infinite;
}

@keyframes shfRegionalLavaPulse {
  0%, 100% {
    opacity: 0.96;
    transform: scale(1);
  }
  50% {
    opacity: 1;
    transform: scale(1.022);
  }
}

.shf-regional-cluster-loading {
  position: absolute;
  left: 18px;
  bottom: 18px;
  z-index: 3;
  padding: 10px 14px;
  border-radius: 14px;
  border: 1px solid rgba(170, 137, 103, 0.16);
  background: rgba(255,255,255,0.88);
  color: rgba(99, 69, 43, 0.88);
}

.shf-regional-detail-panel {
  position: absolute;
  right: 18px;
  bottom: 86px;
  z-index: 35;
  width: 260px;
  min-width: 260px;
  background: rgba(255,255,255,0.95);
  border: 1px solid rgba(170, 137, 103, 0.16);
  border-radius: 22px;
  padding: 18px 18px 16px;
  box-shadow:
    0 18px 38px rgba(86, 58, 34, 0.12),
    0 2px 0 rgba(255,255,255,0.78) inset;
}

.shf-regional-detail-panel strong {
  display: block;
  margin-bottom: 8px;
  font-size: 18px;
}

.shf-regional-detail-panel div {
  line-height: 1.55;
}
