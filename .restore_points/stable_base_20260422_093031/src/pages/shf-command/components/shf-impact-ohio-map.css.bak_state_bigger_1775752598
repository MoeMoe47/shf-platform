.shf-impact-map {
  position: relative;
  width: 100%;
  height: 560px;
  overflow: hidden;
  border-radius: 18px;
}

/* TEXTURE */
.shf-map-texture {
  position: absolute;
  inset: 0;
  width: 100%;
  height: 100%;
  object-fit: contain;

  transform: scale(1.35);
  transform-origin: center;

  z-index: 1;
}

/* COUNTY LINES */
.shf-map-counties {
  position: absolute;
  inset: 0;
  width: 100%;
  height: 100%;
  object-fit: contain;

  transform: scale(1.35);
  transform-origin: center;

  z-index: 2;
  pointer-events: none;
}

/* NODES */
.shf-map-nodes {
  position: absolute;
  inset: 0;
  z-index: 3;
}

.shf-node {
  position: absolute;
  transform: translate(-50%, -50%);
  width: 14px;
  height: 14px;
  border-radius: 50%;

  background: radial-gradient(circle, #fff7d6, #f5b041);
  box-shadow: 0 0 12px rgba(255, 200, 100, 0.8);
}

/* TOOLTIP */
.shf-tooltip {
  position: absolute;
  bottom: 20%;
  left: 25%;
  background: white;
  padding: 12px;
  border-radius: 10px;
  box-shadow: 0 10px 30px rgba(0,0,0,0.15);
  z-index: 10;
}
