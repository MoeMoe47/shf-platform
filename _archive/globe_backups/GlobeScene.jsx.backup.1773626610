import React, { useEffect, useRef } from "react";

export default function GlobeScene() {
  const orbitRef = useRef(null);

  useEffect(() => {
    let frame;
    const start = performance.now();

    const animate = (t) => {
      const elapsed = (t - start) / 1000;

      if (orbitRef.current) {
        const drift = Math.sin(elapsed * 0.18) * 8;
        orbitRef.current.style.transform =
          `translate(-50%, -50%) rotate(${elapsed * 4 + drift}deg)`;
      }

      frame = requestAnimationFrame(animate);
    };

    frame = requestAnimationFrame(animate);

    return () => cancelAnimationFrame(frame);
  }, []);

  return (
    <div
      style={{
        width: "100%",
        height: "640px",
        borderRadius: 18,
        overflow: "hidden",
        position: "relative",
        border: "1px solid rgba(120,170,245,0.28)",
        background:
          "radial-gradient(circle at 50% 18%, rgba(32,60,95,0.26) 0%, rgba(4,8,16,0.95) 45%, rgba(2,4,8,1) 100%)",
        boxShadow:
          "0 0 0 1px rgba(255,255,255,0.02) inset, 0 0 40px rgba(80,140,220,0.25), 0 20px 40px rgba(0,0,0,0.28)"
      }}
    >
      <img
        src="/textures/earth-intelligence-8k.png?v=1"
        alt="SHF intelligence globe"
        style={{
          position: "absolute",
          inset: 0,
          width: "100%",
          height: "100%",
          objectFit: "contain",
          objectPosition: "center",
          filter: "brightness(0.98) contrast(1.08) saturate(0.95)"
        }}
      />

      <div
        ref={orbitRef}
        style={{
          position: "absolute",
          left: "50%",
          top: "52%",
          width: "78%",
          height: "78%",
          borderRadius: "50%",
          border: "1px solid rgba(143,196,255,0.10)",
          boxShadow: "0 0 18px rgba(143,196,255,0.06)",
          transform: "translate(-50%, -50%) rotate(0deg)",
          pointerEvents: "none",
          zIndex: 2
        }}
      />

      <svg
        viewBox="0 0 1000 640"
        preserveAspectRatio="none"
        style={{
          position: "absolute",
          inset: 0,
          width: "100%",
          height: "100%",
          pointerEvents: "none",
          zIndex: 6
        }}
      >
        <defs>
          <filter id="stateGlow">
            <feGaussianBlur stdDeviation="3" result="blur" />
            <feMerge>
              <feMergeNode in="blur" />
              <feMergeNode in="SourceGraphic" />
            </feMerge>
          </filter>

          <filter id="countyGlow">
            <feGaussianBlur stdDeviation="5" result="blur" />
            <feMerge>
              <feMergeNode in="blur" />
              <feMergeNode in="SourceGraphic" />
            </feMerge>
          </filter>
        </defs>

        <g transform="translate(520 320) scale(1.6) translate(-520 -320)">
          <path
            d="
              M490 295
              L515 288
              L545 288
              L565 302
              L570 327
              L565 355
              L545 372
              L515 372
              L495 358
              L488 332
              Z
            "
            stroke="rgba(235,240,255,0.95)"
            strokeWidth="2.4"
            fill="rgba(180,200,230,0.04)"
            filter="url(#stateGlow)"
          />

          <path
            d="
              M525 318
              L538 317
              L544 328
              L538 342
              L525 342
              L518 330
              Z
            "
            fill="rgba(255,165,70,0.85)"
            stroke="rgba(255,200,120,0.95)"
            strokeWidth="1.2"
            filter="url(#countyGlow)"
          >
            <animate
              attributeName="opacity"
              values="0.6;1;0.6"
              dur="1.6s"
              repeatCount="indefinite"
            />
          </path>
        </g>
      </svg>

      <div
        style={{
          position: "absolute",
          left: "55%",
          top: "54%",
          padding: "8px 10px",
          fontSize: 12,
          lineHeight: 1.2,
          color: "#dcecff",
          background: "rgba(7,14,24,0.72)",
          border: "1px solid rgba(143,196,255,0.22)",
          borderRadius: 10,
          boxShadow: "0 8px 24px rgba(0,0,0,0.28)",
          backdropFilter: "blur(6px)",
          pointerEvents: "none",
          zIndex: 6
        }}
      >
        <div style={{ fontWeight: 700 }}>Franklin County</div>
        <div style={{ opacity: 0.8 }}>23 participants • active</div>
      </div>
    </div>
  );
}
