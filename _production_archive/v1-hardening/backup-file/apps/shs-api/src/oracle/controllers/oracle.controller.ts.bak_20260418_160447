import { getOracleTruth } from "../services/oracle.service";

export async function getOracleTruthHandler(req: any, res: any) {
  try {
    const { entityId } = req.params;

    const result = await getOracleTruth({
      entityId,
      entityType: "case",
    });

    res.json(result);
  } catch (err: any) {
    res.status(500).json({
      error: "ORACLE_FAILED",
      message: err.message || "Unknown error",
    });
  }
}
