import React, { useState } from "react";
import { sendOracleAction } from "@/pages/admin/reporting/oracle-action-adapter";

function getRankIcon(rank, readinessStatus) {
  if (rank === 1) return "🥇";
  if (rank === 2) return "🥈";
  if (String(readinessStatus || "").toLowerCase() === "blocked") return "⚠️";
  return "•";
}

export default function PriorityQueuePanel({ priorityData }) {
  const [actionMessage, setActionMessage] = useState("");
  const [actionError, setActionError] = useState("");
  const [busyKey, setBusyKey] = useState("");

  async function handleAction(entityId, action) {
    try {
      setActionError("");
      setActionMessage("");
      setBusyKey(`${entityId}:${action}`);

      const result = await sendOracleAction(entityId, action);
      setActionMessage(result.message || "Action accepted.");
    } catch (err) {
      setActionError(err instanceof Error ? err.message : "Action failed");
    } finally {
      setBusyKey("");
    }
  }

  if (!priorityData) {
    return (
      <div className="section-card">
        <h3 style={{ marginBottom: 12 }}>Priority Queue</h3>
        <p style={{ color: "#94a3b8" }}>No priority data available.</p>
      </div>
    );
  }

  return (
    <div className="section-card">
      <h3
        style={{
          marginBottom: 12,
          color: "#f8fafc",
          fontSize: 16,
          fontWeight: 700,
          letterSpacing: "0.01em",
        }}
      >
        Priority Queue
      </h3>

      <div
        style={{
          marginTop: 4,
          marginBottom: 12,
          padding: "14px 18px",
          borderRadius: 14,
          background:
            "linear-gradient(90deg, rgba(16,185,129,0.25), rgba(2,6,23,1))",
          border: "1px solid rgba(16,185,129,0.65)",
          boxShadow: "0 0 24px rgba(16,185,129,0.18)",
          color: "#ffffff",
          fontWeight: 800,
          fontSize: 16,
          lineHeight: 1.6,
        }}
      >
        ⚡ SYSTEM DECISION — {priorityData.summary}
      </div>

      {actionMessage ? (
        <div
          style={{
            marginBottom: 12,
            padding: "12px 14px",
            borderRadius: 12,
            border: "1px solid rgba(34,197,94,0.28)",
            background: "rgba(34,197,94,0.10)",
            color: "rgba(220,252,231,0.98)",
            fontSize: 13,
            fontWeight: 700,
          }}
        >
          {actionMessage}
        </div>
      ) : null}

      {actionError ? (
        <div
          style={{
            marginBottom: 12,
            padding: "12px 14px",
            borderRadius: 12,
            border: "1px solid rgba(239,68,68,0.28)",
            background: "rgba(239,68,68,0.10)",
            color: "rgba(254,226,226,0.98)",
            fontSize: 13,
            fontWeight: 700,
          }}
        >
          {actionError}
        </div>
      ) : null}

      <div>
        {priorityData.ranked.map((item) => {
          const isTop = item.rank === 1;
          const isRisk = item.readinessStatus === "blocked";

          return (
            <div
              key={item.entityId}
              style={{
                marginBottom: 14,
                padding: 14,
                borderRadius: 14,
                background: isRisk
                  ? "linear-gradient(180deg, rgba(2,6,23,0.96), rgba(30,0,0,0.35))"
                  : "rgba(2,6,23,0.96)",
                border: isTop
                  ? "1px solid rgba(16,185,129,0.6)"
                  : isRisk
                  ? "1px solid rgba(239,68,68,0.5)"
                  : "1px solid rgba(148,163,184,0.22)",
                borderLeft: isTop
                  ? "4px solid #22c55e"
                  : isRisk
                  ? "4px solid #ef4444"
                  : "4px solid #64748b",
                color: "#f8fafc",
                boxShadow: isTop
                  ? "0 0 24px rgba(16,185,129,0.25)"
                  : isRisk
                  ? "0 0 18px rgba(239,68,68,0.25)"
                  : "none",
                transform: isTop ? "scale(1.01)" : "scale(1)",
                opacity: isTop ? 1 : isRisk ? 0.82 : 0.92,
                transition: "all 180ms ease",
              }}
            >
              <div
                style={{
                  display: "flex",
                  justifyContent: "space-between",
                  alignItems: "center",
                  gap: 14,
                  flexWrap: "wrap",
                  marginBottom: 10,
                }}
              >
                <div
                  style={{
                    fontWeight: 800,
                    color: "#ffffff",
                    fontSize: isTop ? 19 : 17,
                    letterSpacing: "0.01em",
                  }}
                >
                  {getRankIcon(item.rank, item.readinessStatus)} #{item.rank} — {item.entityId}
                </div>

                <div
                  style={{
                    padding: "6px 10px",
                    borderRadius: 999,
                    fontSize: 11,
                    fontWeight: 800,
                    letterSpacing: "0.08em",
                    textTransform: "uppercase",
                    border: isTop
                      ? "1px solid rgba(16,185,129,0.5)"
                      : isRisk
                      ? "1px solid rgba(239,68,68,0.45)"
                      : "1px solid rgba(148,163,184,0.24)",
                    background: isTop
                      ? "rgba(16,185,129,0.10)"
                      : isRisk
                      ? "rgba(239,68,68,0.08)"
                      : "rgba(148,163,184,0.08)",
                    color: "#f8fafc",
                  }}
                >
                  {item.readinessStatus}
                </div>
              </div>

              <div
                style={{
                  display: "grid",
                  gridTemplateColumns: "repeat(3, minmax(0, 1fr))",
                  gap: 10,
                }}
              >
                <div>
                  <div
                    style={{
                      fontSize: 11,
                      letterSpacing: "0.08em",
                      textTransform: "uppercase",
                      color: "rgba(148,163,184,0.88)",
                      marginBottom: 6,
                    }}
                  >
                    Confidence
                  </div>
                  <div style={{ fontSize: 15, fontWeight: 700, color: "#f8fafc" }}>
                    {item.confidenceScore}
                  </div>
                </div>

                <div>
                  <div
                    style={{
                      fontSize: 11,
                      letterSpacing: "0.08em",
                      textTransform: "uppercase",
                      color: "rgba(148,163,184,0.88)",
                      marginBottom: 6,
                    }}
                  >
                    Priority Score
                  </div>
                  <div style={{ fontSize: 15, fontWeight: 700, color: "#f8fafc" }}>
                    {item.priorityScore}
                  </div>
                </div>

                <div>
                  <div
                    style={{
                      fontSize: 11,
                      letterSpacing: "0.08em",
                      textTransform: "uppercase",
                      color: "rgba(148,163,184,0.88)",
                      marginBottom: 6,
                    }}
                  >
                    Truth Status
                  </div>
                  <div style={{ fontSize: 15, fontWeight: 700, color: "#f8fafc" }}>
                    {item.truthStatus}
                  </div>
                </div>
              </div>

              <div
                style={{
                  marginTop: 14,
                  paddingTop: 12,
                  borderTop: "1px solid rgba(148,163,184,0.10)",
                  display: "grid",
                  gridTemplateColumns: "repeat(2, minmax(0, 1fr))",
                  gap: 10,
                }}
              >
                <div>
                  <div
                    style={{
                      fontSize: 11,
                      letterSpacing: "0.08em",
                      textTransform: "uppercase",
                      color: "rgba(148,163,184,0.88)",
                      marginBottom: 6,
                    }}
                  >
                    Contradictions
                  </div>
                  <div style={{ fontSize: 14, fontWeight: 700, color: "#f8fafc" }}>
                    {item.contradictionStatus}
                  </div>
                </div>

                <div>
                  <div
                    style={{
                      fontSize: 11,
                      letterSpacing: "0.08em",
                      textTransform: "uppercase",
                      color: "rgba(148,163,184,0.88)",
                      marginBottom: 6,
                    }}
                  >
                    Next Action
                  </div>
                  <div
                    style={{
                      fontSize: 14,
                      fontWeight: 600,
                      color: "#f8fafc",
                      lineHeight: 1.5,
                    }}
                  >
                    {item.recommendedNextAction || "Review before proceeding."}
                  </div>
                </div>
              </div>

              {isTop ? (
                <div
                  style={{
                    marginTop: 14,
                    display: "flex",
                    gap: 10,
                    flexWrap: "wrap",
                  }}
                >
                  <button
                    type="button"
                    onClick={() => handleAction(item.entityId, "execute")}
                    disabled={busyKey === `${item.entityId}:execute`}
                  >
                    {busyKey === `${item.entityId}:execute` ? "Executing..." : "Execute"}
                  </button>

                  <button
                    type="button"
                    onClick={() => handleAction(item.entityId, "hold")}
                    disabled={busyKey === `${item.entityId}:hold`}
                  >
                    {busyKey === `${item.entityId}:hold` ? "Holding..." : "Hold"}
                  </button>

                  <button
                    type="button"
                    onClick={() => handleAction(item.entityId, "request_data")}
                    disabled={busyKey === `${item.entityId}:request_data`}
                  >
                    {busyKey === `${item.entityId}:request_data` ? "Requesting..." : "Request Data"}
                  </button>
                </div>
              ) : null}
            </div>
          );
        })}
      </div>
    </div>
  );
}
