*,
*::before,
*::after {
  box-sizing: border-box;
}

html,
body,
#root {
  margin: 0;
  min-height: 100%;
}

body {
  background:
    linear-gradient(rgba(99, 79, 63, 0.06) 1px, transparent 1px),
    linear-gradient(90deg, rgba(99, 79, 63, 0.06) 1px, transparent 1px),
    linear-gradient(180deg, #f4eee7 0%, #efe7dc 100%);
  background-size: 48px 48px, 48px 48px, 100% 100%;
  color: #4f3729;
  font-family: Inter, ui-sans-serif, system-ui, -apple-system, BlinkMacSystemFont, "Segoe UI", sans-serif;
}

a {
  color: inherit;
  text-decoration: none;
}

img {
  display: block;
}

.shf-site {
  min-height: 100vh;
}

.shf-shell {
  width: min(calc(100% - 64px), 1360px);
  margin: 0 auto;
}

.shf-header {
  position: sticky;
  top: 0;
  z-index: 40;
  backdrop-filter: blur(14px);
  background: rgba(246, 240, 233, 0.92);
  border-bottom: 1px solid rgba(160, 131, 108, 0.22);
}

.shf-header__inner {
  min-height: 78px;
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 22px;
}

.shf-brand {
  display: inline-flex;
  align-items: center;
  gap: 14px;
  min-width: 0;
}

.shf-brand__mark {
  width: 56px;
  height: 56px;
  border-radius: 999px;
  overflow: hidden;
  flex: 0 0 auto;
  display: grid;
  place-items: center;
  background: linear-gradient(180deg, #f8efe3 0%, #ead8c7 100%);
  border: 1px solid rgba(165, 114, 72, 0.18);
  box-shadow: 0 8px 20px rgba(118, 77, 46, 0.12);
}

.shf-brand__mark img {
  width: 100%;
  height: 100%;
  object-fit: cover;
}

.shf-brand__fallback {
  font-size: 14px;
  font-weight: 700;
  color: #a85e2f;
  letter-spacing: 0.08em;
}

.shf-brand__text {
  display: flex;
  flex-direction: column;
  line-height: 1.02;
}

.shf-brand__title {
  font-family: Georgia, "Times New Roman", serif;
  font-size: 1.08rem;
  font-weight: 700;
}

.shf-brand__subtitle {
  font-size: 0.73rem;
  font-weight: 700;
  text-transform: uppercase;
  letter-spacing: 0.18em;
  color: #735847;
  margin-top: 4px;
}

.shf-nav {
  display: flex;
  align-items: center;
  gap: 22px;
  flex-wrap: wrap;
}

.shf-nav__link {
  font-size: 0.98rem;
  color: #735847;
  transition: color 160ms ease;
}

.shf-nav__link:hover {
  color: #4f3729;
}

.shf-header__actions {
  display: inline-flex;
  align-items: center;
  gap: 12px;
}

.shf-btn {
  display: inline-flex;
  align-items: center;
  justify-content: center;
  min-height: 48px;
  padding: 0 24px;
  border-radius: 999px;
  font-weight: 700;
  border: 1px solid transparent;
  transition:
    transform 160ms ease,
    box-shadow 160ms ease,
    background 160ms ease,
    border-color 160ms ease;
}

.shf-btn:hover {
  transform: translateY(-1px);
}

.shf-btn--primary {
  color: #fffaf5;
  background: linear-gradient(180deg, #cb7337 0%, #b65d29 100%);
  box-shadow: 0 12px 24px rgba(180, 96, 44, 0.18);
}

.shf-btn--secondary {
  color: #fffaf5;
  background: linear-gradient(180deg, #6b93ad 0%, #537a94 100%);
  box-shadow: 0 12px 24px rgba(71, 111, 140, 0.18);
}

.shf-btn--ghost {
  color: #4f3729;
  background: rgba(255, 255, 255, 0.45);
  border-color: rgba(181, 145, 118, 0.35);
}

.shf-main {
  padding-bottom: 0;
}

.shf-hero {
  padding: 56px 0 0;
}

.shf-hero__grid {
  display: grid;
  grid-template-columns: minmax(0, 0.9fr) minmax(0, 1.1fr);
  gap: 20px;
  align-items: center;
}

.shf-hero__content {
  padding: 28px 8px 48px 18px;
}

.shf-eyebrow {
  display: inline-flex;
  align-items: center;
  min-height: 38px;
  padding: 0 16px;
  border-radius: 999px;
  font-size: 0.84rem;
  font-weight: 700;
  letter-spacing: 0.16em;
  text-transform: uppercase;
  background: rgba(200, 111, 52, 0.06);
  color: #a85e2f;
  border: 1px solid rgba(200, 111, 52, 0.16);
}

.shf-hero__title {
  margin: 22px 0 18px;
  max-width: 7ch;
  font-family: Georgia, "Times New Roman", serif;
  font-size: clamp(3.9rem, 6.4vw, 5.9rem);
  line-height: 0.92;
  letter-spacing: -0.055em;
  color: #4a2d20;
}

.shf-hero__text {
  max-width: 28ch;
  font-size: 1rem;
  line-height: 1.65;
  color: #735847;
}

.shf-hero__actions {
  display: flex;
  flex-wrap: wrap;
  gap: 14px;
  margin-top: 28px;
}

.shf-hero__visual {
  display: flex;
  align-items: center;
  justify-content: flex-start;
  min-height: 100%;
}

.shf-hero__imageWrap {
  position: relative;
  width: 100%;
  max-width: 880px;
  height: 520px;
  border-radius: 28px;
  overflow: hidden;
  background: #ece3d7;
  box-shadow: 0 20px 44px rgba(102, 67, 40, 0.08);
}

.shf-hero__image {
  width: 100%;
  height: 100%;
  object-fit: cover;
  object-position: 58% center;
  transform: scale(1.06);
  filter: contrast(1.04) saturate(0.96) brightness(1.01);
}

.shf-hero__imageFade {
  position: absolute;
  inset: 0;
  background:
    linear-gradient(
      90deg,
      rgba(244, 238, 231, 0.98) 0%,
      rgba(244, 238, 231, 0.88) 8%,
      rgba(244, 238, 231, 0.48) 15%,
      rgba(244, 238, 231, 0.14) 24%,
      rgba(244, 238, 231, 0.00) 34%
    );
  pointer-events: none;
}

.shf-kpi-band {
  margin-top: 22px;
  background: linear-gradient(180deg, #b76635 0%, #9e5428 100%);
  border-top: 1px solid rgba(128, 72, 34, 0.3);
  border-bottom: 1px solid rgba(128, 72, 34, 0.3);
  box-shadow: inset 0 1px 0 rgba(255,255,255,0.08);
}

.shf-kpi-band__grid {
  display: grid;
  grid-template-columns: repeat(3, 1fr);
}

.shf-kpi {
  min-height: 92px;
  display: flex;
  align-items: center;
  justify-content: center;
  gap: 12px;
  color: #fff6ee;
  border-right: 1px solid rgba(255,255,255,0.18);
}

.shf-kpi:last-child {
  border-right: none;
}

.shf-kpi__value {
  font-size: 1.35rem;
  font-weight: 800;
  letter-spacing: -0.02em;
}

.shf-kpi__label {
  font-size: 0.95rem;
  font-weight: 600;
  opacity: 0.96;
}

.shf-footer {
  border-top: 1px solid rgba(181, 145, 118, 0.22);
  background: rgba(247, 240, 232, 0.7);
}

.shf-footer__inner {
  padding: 26px 0 34px;
  display: flex;
  justify-content: space-between;
  gap: 24px;
  flex-wrap: wrap;
}

.shf-footer__title {
  font-family: Georgia, "Times New Roman", serif;
  font-size: 1.05rem;
  font-weight: 700;
}

.shf-footer__text {
  margin: 8px 0 0;
  color: #735847;
  max-width: 54ch;
  line-height: 1.7;
}

.shf-footer__links {
  display: flex;
  flex-wrap: wrap;
  gap: 16px;
  color: #735847;
}

@media (max-width: 1180px) {
  .shf-hero__grid {
    grid-template-columns: 1fr;
    gap: 26px;
  }

  .shf-hero__content {
    padding: 20px 0 0;
  }

  .shf-hero__title {
    max-width: 100%;
  }

  .shf-hero__text {
    max-width: 52ch;
  }

  .shf-hero__imageWrap {
    max-width: 100%;
    height: 420px;
  }
}

@media (max-width: 900px) {
  .shf-header__inner {
    flex-wrap: wrap;
    padding: 14px 0;
  }

  .shf-nav {
    order: 3;
    width: 100%;
    gap: 16px;
  }

  .shf-kpi-band__grid {
    grid-template-columns: 1fr;
  }

  .shf-kpi {
    border-right: none;
    border-bottom: 1px solid rgba(255,255,255,0.18);
  }

  .shf-kpi:last-child {
    border-bottom: none;
  }
}

@media (max-width: 720px) {
  .shf-shell {
    width: min(calc(100% - 24px), 1360px);
  }

  .shf-header__actions {
    width: 100%;
  }

  .shf-header__actions .shf-btn {
    flex: 1 1 0;
  }

  .shf-hero {
    padding-top: 34px;
  }

  .shf-hero__title {
    font-size: clamp(2.6rem, 13vw, 4rem);
    line-height: 0.95;
  }

  .shf-hero__imageWrap {
    height: 320px;
    border-radius: 20px;
  }

  .shf-hero__image {
    object-position: 60% center;
    transform: scale(1.08);
  }

  .shf-kpi {
    min-height: 74px;
    flex-direction: column;
    gap: 4px;
  }
}

/* ===== SHF MAP ALIGNMENT LOCK ===== */
.shf-impact-map {
  position: relative;
  width: 100%;
  height: 100%;
  overflow: hidden;
}

.shf-map-texture {
  position: absolute;
  inset: 0;
  width: 100%;
  height: 100%;
  object-fit: contain;
  z-index: 1;
}

.shf-impact-map svg {
  position: absolute;
  inset: 0;
  z-index: 2;

  transform: scale(1.32) translate(1%, -4%);
  transform-origin: center;
}

/* =========================
   SHF MAP COLOR OVERRIDE
========================= */

/* remove all fills */
.shf-impact-map svg path {
  fill: transparent !important;
}

/* clean white county lines */
.shf-impact-map svg path {
  stroke: rgba(255,255,255,0.85) !important;
  stroke-width: 1.2px !important;
}

/* soften overall look */
.shf-impact-map svg {
  opacity: 0.9;
}

/* OPTIONAL: subtle glow (top 1% look) */
.shf-impact-map svg path {
  filter: drop-shadow(0 0 2px rgba(255,255,255,0.15));
}

