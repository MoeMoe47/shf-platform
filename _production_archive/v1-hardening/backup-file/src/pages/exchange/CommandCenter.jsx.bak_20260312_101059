          style={{
            position: "absolute",
            inset: 0,
            width: "100%",
            height: "100%",
            overflow: "visible",
          }}
        >
          {mapArcPaths.map((a) => (
            <path
              key={a.key}
              d={a.d}
              fill="none"
              stroke={a.color === "orange" ? "rgba(244,166,100,0.75)" : "rgba(125,203,255,0.72)"}
