function arcPath(fromX, fromY, toX, toY, bend = 100) {
  const x1 = parseFloat(fromX);
  const y1 = parseFloat(fromY);
  const x2 = parseFloat(toX);
  const y2 = parseFloat(toY);
  const cx = (x1 + x2) / 2;
  const cy = (y1 + y2) / 2 - bend / 10;
  return `M ${x1} ${y1} Q ${cx} ${cy} ${x2} ${y2}`;
}

function CenterMap({ centerMap }) {
  const nodes = centerMap?.nodes || [];
  const arcs = centerMap?.arcs || [];

  const mapArcPaths = useMemo(() => {
    return arcs.map((a, i) => ({
      ...a,
      d: arcPath(a.from[0], a.from[1], a.to[0], a.to[1], a.bend),
      key: i,
    }));
  }, [arcs]);

  return (
    <div
      style={{
        position: "relative",
        minHeight: 760,
        borderRadius: 14,
        overflow: "hidden",
        border: "1px solid rgba(118,164,212,0.2)",
