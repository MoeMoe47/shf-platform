          "radial-gradient(circle at 50% 42%, rgba(40,82,130,0.20) 0%, rgba(9,15,25,0.9) 48%, rgba(3,7,12,1) 100%)",
        boxShadow: "inset 0 0 120px rgba(77,132,196,0.08)",
      }}
    >
      <div
        style={{
          position: "absolute",
          inset: 0,
          backgroundImage:
            "radial-gradient(circle, rgba(255,255,255,0.08) 1px, transparent 1px)",
          backgroundSize: "28px 28px",
          opacity: 0.08,
        }}
      />

      <div
        style={{
          position: "absolute",
          top: "50%",
          left: "50%",
          transform: "translate(-50%, -50%)",
          width: "78%",
          maxWidth: 760,
          aspectRatio: "1 / 1",
          borderRadius: "50%",
          background:
            "radial-gradient(circle at 42% 34%, rgba(164,203,244,0.26) 0%, rgba(78,108,146,0.20) 30%, rgba(18,32,52,0.78) 62%, rgba(6,11,18,0.96) 100%)",
          boxShadow:
            "0 0 120px rgba(64,164,255,0.25), 0 0 200px rgba(32,104,188,0.18), inset 0 0 140px rgba(255,255,255,0.06), inset 0 0 0 2px rgba(176,217,255,0.28)",
          overflow: "hidden",
        }}
      >
        <div
          style={{
            position: "absolute",
            inset: "10%",
            borderRadius: "50%",
            border: "1px solid rgba(145,195,245,0.10)",
            boxShadow: "0 0 30px rgba(84,158,240,0.06) inset",
          }}
        />
        <div
          style={{
            position: "absolute",
            inset: "20%",
            borderRadius: "50%",
