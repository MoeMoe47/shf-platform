          style={{
            position: "absolute",
            left: 24,
            right: 24,
            top: 44,
            height: 2,
            background: "linear-gradient(90deg, rgba(125,203,255,0.15), rgba(125,203,255,0.35), rgba(244,166,100,0.24), rgba(125,203,255,0.10))",
          }}
        />
        <div
          style={{
            display: "grid",
            gridTemplateColumns: `repeat(${items.length || 6}, 1fr)`,
            gap: 12,
            position: "relative",
            zIndex: 2,
          }}
        >
          {items.map((item) => {
            const color =
              item.state === "critical"
                ? "#ff8e8e"
                : item.state === "warning"
                ? "#f0b27a"
                : item.state === "ok"
                ? "#78dfb5"
                : "#8fd1ff";

            return (
              <div key={item.label} style={{ textAlign: "left" }}>
                <div
                  style={{
                    width: 10,
                    height: 10,
                    borderRadius: "50%",
                    background: color,
                    boxShadow: `0 0 10px ${color}`,
                    marginBottom: 12,
                  }}
                />
                <div style={{ color: "#dbe5ef", fontSize: 13, fontWeight: 600 }}>{item.label}</div>
                <div style={{ color: "#7e97ac", fontSize: 11, marginTop: 2 }}>{item.meta}</div>
              </div>
            );
          })}
        </div>
      </div>

      <div
        style={{
          height: 58,
          display: "grid",
          gridTemplateColumns: "1.2fr 1fr 1fr 1fr 1fr 1fr",
          gap: 0,
        }}
      >
        {[
          ["Participants", proofMetrics?.highRiskParticipants || 0],
          ["Cost Per Outcome", `$${Number(proofMetrics?.costPerOutcome || 0).toLocaleString()}`],
          ["Payment State", proofMetrics?.capitalDeployed > 0 ? "ACTIVE" : "PENDING"],
          ["Anomalies", proofMetrics?.anomalyCount || 0],
          ["Released", `$${Number(proofMetrics?.capitalDeployed || 0).toLocaleString()}`],
          ["Top Program", proofMetrics?.topProgram || "—"],
        ].map(([label, value], i) => (
          <div
            key={label}
            style={{
              padding: "10px 16px",
              borderRight: i < 5 ? "1px solid rgba(118,164,212,0.10)" : "none",
              display: "flex",
              flexDirection: "column",
              justifyContent: "center",
            }}
          >
            <div style={{ color: "#7f98af", fontSize: 11, textTransform: "uppercase", letterSpacing: "0.04em" }}>
              {label}
            </div>
            <div
              style={{
                color: i === 4 ? "#7ae0b2" : "#edf4fb",
                fontWeight: 700,
                fontSize: 16,
                marginTop: 3,
              }}
            >
              {value}
            </div>
          </div>
        ))}
      </div>
    </div>
  );
}

