import React from "react";
import { Outlet, NavLink, useLocation } from "react-router-dom";

const shellStyle = {
  minHeight: "100vh",
  background: "#0b1020",
  color: "#f3f4f6",
};

const wrapStyle = {
  display: "grid",
  gridTemplateColumns: "260px 1fr",
  minHeight: "100vh",
};

const sidebarStyle = {
  borderRight: "1px solid rgba(255,255,255,0.08)",
  background: "rgba(15,23,42,0.92)",
  padding: 20,
};

const brandStyle = {
  fontSize: 20,
  fontWeight: 700,
  marginBottom: 8,
};

const subStyle = {
  fontSize: 12,
  color: "#94a3b8",
  marginBottom: 24,
  textTransform: "uppercase",
  letterSpacing: "0.08em",
};

const navStyle = {
  display: "grid",
  gap: 10,
};

const linkBaseStyle = {
  display: "block",
  padding: "12px 14px",
  borderRadius: 12,
  textDecoration: "none",
  color: "#cbd5e1",
  border: "1px solid rgba(255,255,255,0.06)",
  background: "rgba(255,255,255,0.02)",
};

const mainStyle = {
  padding: 24,
};

const topbarStyle = {
  display: "flex",
  alignItems: "center",
  justifyContent: "space-between",
  gap: 12,
  marginBottom: 20,
};

export default function ExchangeLayout() {
  const location = useLocation();

  const commandMode =
    location.pathname === "/exchange" ||
    location.pathname === "/exchange/" ||
    location.pathname === "/exchange/command";

  const linkStyle = ({ isActive }) => ({
    ...linkBaseStyle,
    color: isActive ? "#ffffff" : "#cbd5e1",
    background: isActive ? "rgba(249,115,22,0.16)" : "rgba(255,255,255,0.02)",
    border: isActive
      ? "1px solid rgba(249,115,22,0.55)"
      : "1px solid rgba(255,255,255,0.06)",
    boxShadow: isActive ? "0 0 0 1px rgba(249,115,22,0.18) inset" : "none",
  });

  
  if (commandMode) {
    return (
      <div style={{height:"100vh",width:"100vw",background:"#020617"}}>
        <Outlet />
      </div>
    );
  }

  return (

    <div style={shellStyle}>
      <div style={wrapStyle}>
        <aside style={sidebarStyle}>
          <div style={brandStyle}>SHF Outcomes Exchange</div>
          <div style={subStyle}>Institutional Control Layer</div>

          <nav style={navStyle}>
            <NavLink to="/exchange/command" style={linkStyle}>
              Command Center
            </NavLink>
            <NavLink to="/exchange/operator" style={linkStyle}>
              Operator Dashboard
            </NavLink>
            <NavLink to="/exchange/provider" style={linkStyle}>
              Provider Dashboard
            </NavLink>
            <NavLink to="/exchange/investor" style={linkStyle}>
              Investor Dashboard
            </NavLink>
            <NavLink to="/exchange/public" style={linkStyle}>
              Public Transparency
            </NavLink>
          </nav>
        </aside>

        <main style={mainStyle}>
          <div style={topbarStyle}>
            <div>
              <div style={{ fontSize: 24, fontWeight: 700 }}>Outcomes Exchange</div>
              <div style={{ color: "#94a3b8", marginTop: 4 }}>
                One engine. Five views. Shared institutional infrastructure.
              </div>
            </div>

            <a
              href="#/operator"
              style={{
                color: "#fdba74",
                textDecoration: "none",
                border: "1px solid rgba(249,115,22,0.35)",
                padding: "10px 14px",
                borderRadius: 12,
                background: "rgba(249,115,22,0.08)",
              }}
            >
              Legacy Operator Panel
            </a>
          </div>

          <Outlet />
        </main>
      </div>
    </div>
  );
}
