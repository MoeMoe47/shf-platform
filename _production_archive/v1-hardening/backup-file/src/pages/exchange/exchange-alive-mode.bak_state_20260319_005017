/* =========================================
   ALIVE MODE
========================================= */

@keyframes aliveBannerPulse {
  0%   { transform: translateY(0); }
  50%  { transform: translateY(-1px); }
  100% { transform: translateY(0); }
}

@keyframes bannerAura {
  0%   { opacity: 0.16; }
  50%  { opacity: 0.34; }
  100% { opacity: 0.16; }
}

@keyframes timelineSweep {
  0%   { transform: translateX(-110%); opacity: 0; }
  12%  { opacity: 0.18; }
  50%  { opacity: 0.24; }
  88%  { opacity: 0.18; }
  100% { transform: translateX(110%); opacity: 0; }
}

@keyframes analystBreath {
  0%   { box-shadow: inset 0 0 0 1px rgba(255,255,255,0.015), 0 10px 28px rgba(0,0,0,0.26), 0 0 18px rgba(26,74,128,0.04); }
  50%  { box-shadow: inset 0 0 0 1px rgba(255,255,255,0.018), 0 10px 28px rgba(0,0,0,0.28), 0 0 28px rgba(54,120,220,0.08); }
  100% { box-shadow: inset 0 0 0 1px rgba(255,255,255,0.015), 0 10px 28px rgba(0,0,0,0.26), 0 0 18px rgba(26,74,128,0.04); }
}

@keyframes centerHalo {
  0%   { box-shadow: 0 0 0 rgba(60,140,255,0); }
  50%  { box-shadow: 0 0 42px rgba(60,140,255,0.10); }
  100% { box-shadow: 0 0 0 rgba(60,140,255,0); }
}

.alive-recommendation {
  position: relative;
  animation: aliveBannerPulse 4.8s ease-in-out infinite;
}

.alive-recommendation::after {
  content: "";
  position: absolute;
  inset: 0;
  border-radius: 16px;
  pointer-events: none;
  background:
    radial-gradient(circle at 14% 50%, rgba(34,197,94,0.12) 0%, rgba(34,197,94,0.04) 18%, rgba(34,197,94,0) 38%),
    radial-gradient(circle at 86% 50%, rgba(96,165,250,0.12) 0%, rgba(96,165,250,0.04) 18%, rgba(96,165,250,0) 38%);
  animation: bannerAura 4.8s ease-in-out infinite;
}

.alive-timeline {
  position: relative;
  overflow: hidden;
}

.alive-timeline::before {
  content: "";
  position: absolute;
  top: 12%;
  bottom: 12%;
  width: 24%;
  border-radius: 999px;
  pointer-events: none;
  background: linear-gradient(
    90deg,
    rgba(80,160,255,0) 0%,
    rgba(80,160,255,0.05) 20%,
    rgba(80,160,255,0.16) 50%,
    rgba(80,160,255,0.05) 80%,
    rgba(80,160,255,0) 100%
  );
  filter: blur(12px);
  animation: timelineSweep 5.5s linear infinite;
  z-index: 0;
}

.alive-timeline > * {
  position: relative;
  z-index: 1;
}

.alive-analyst > * {
  animation: analystBreath 6.2s ease-in-out infinite;
}

.command-main-grid > :nth-child(2) {
  animation: centerHalo 6s ease-in-out infinite;
}

.command-center-grid > * {
  will-change: transform, opacity, box-shadow;
}
