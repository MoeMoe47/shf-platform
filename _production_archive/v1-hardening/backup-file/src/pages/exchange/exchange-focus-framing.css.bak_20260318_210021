/* Focus framing: make the hero dominate */
[data-focus-frame="left-rail"],
[data-focus-frame="right-rail"] {
  filter: brightness(0.86) saturate(0.92);
  opacity: 0.92;
  transition: filter 180ms ease, opacity 180ms ease, transform 180ms ease, box-shadow 180ms ease;
}

[data-focus-frame="left-rail"]:hover,
[data-focus-frame="right-rail"]:hover {
  filter: brightness(0.94) saturate(0.97);
  opacity: 0.98;
}

/* Stronger hero dominance */
.top1-globe-shell {
  position: relative;
  z-index: 3;
  box-shadow:
    inset 0 1px 0 rgba(255,255,255,0.10),
    inset 0 0 0 1px rgba(255,255,255,0.04),
    0 45px 120px rgba(0,0,0,0.55),
    0 0 90px rgba(60,140,255,0.26) !important;
}

/* wider side aura */
.top1-globe-shell::before {
  width: 88% !important;
  height: 132px !important;
  bottom: -30px !important;
  filter: blur(42px) !important;
}

.top1-globe-shell::after {
  inset: -10px !important;
  border-radius: 34px !important;
  background:
    radial-gradient(circle at 50% 50%,
      rgba(120,180,255,0.26) 0%,
      rgba(120,180,255,0.16) 34%,
      rgba(120,180,255,0.08) 56%,
      rgba(120,180,255,0.03) 72%,
      transparent 84%) !important;
  filter: blur(26px) !important;
}

/* subtle energy edge on the hero frame */
.top1-globe-shell > * {
  position: relative;
  z-index: 2;
}

.top1-globe-shell canvas,
.top1-globe-shell img {
  filter: brightness(1.10) contrast(1.08) saturate(1.10);
}

/* make generic neighboring panels a little quieter without flattening everything */
.panel:not(.top1-globe-shell),
.card:not(.top1-globe-shell),
aside:not(.top1-globe-shell) {
  transition: filter 180ms ease, opacity 180ms ease;
}

/* if the rails were not tagged, this still helps by calming common side stacks */
.dashboard-grid > :first-child,
.dashboard-grid > :last-child,
.exchange-main-grid > :first-child,
.exchange-main-grid > :last-child {
  filter: brightness(0.90) saturate(0.94);
}

/* preserve readability for text inside dimmed rails */
[data-focus-frame="left-rail"] *,
[data-focus-frame="right-rail"] * {
  text-shadow: none;
}
