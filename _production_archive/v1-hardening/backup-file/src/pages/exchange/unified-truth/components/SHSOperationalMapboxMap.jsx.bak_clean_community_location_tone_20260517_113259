    safeSetPaint(map, selectedCountyLineLayers, "line-opacity", 0.24);
    safeSetPaint(map, selectedCountyLineLayers, "line-width", 1.15);
    safeSetPaint(map, selectedCountyPulseLayers, "line-opacity", 0.0);

