function go(hash) {
  window.location.hash = hash;
}

function money(value) {
  if (!value) return "$0";
  if (value >= 1000000) return `$${(value / 1000000).toFixed(1)}M`;
  if (value >= 1000) return `$${Math.round(value / 1000)}K`;
  return `$${value}`;
}

function readEvents() {
  try {
    return JSON.parse(localStorage.getItem("shs_hub_sales_pipeline_events_v1") || "[]");
  } catch {
    return [];
  }
}

function writeEvents(events) {
  localStorage.setItem("shs_hub_sales_pipeline_events_v1", JSON.stringify(events));
}

function getStageValue(items, stage) {
  return items
    .filter((item) => item.stage === stage)
    .reduce((sum, item) => sum + item.estimatedValue, 0);
}

function getPriorityClass(priority) {
  return String(priority || "medium").toLowerCase();
}

