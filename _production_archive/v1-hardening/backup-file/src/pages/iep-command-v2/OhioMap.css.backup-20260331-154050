}

.ohio-map-root.state .selected-county-rim-base {
  opacity: 0.86;
  stroke-width: 2.1;
}

.ohio-map-root.state .selected-county-rim-shine {
  opacity: 0.62;
  stroke-width: 0.95;
  stroke-dasharray: 34 560;
  animation-duration: 6s;
}

.ohio-map-root.regional .selected-county-rim-base {
