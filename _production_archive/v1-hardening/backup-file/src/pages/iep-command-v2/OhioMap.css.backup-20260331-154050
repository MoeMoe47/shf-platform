  opacity: 0.08;
  mix-blend-mode: screen;
  filter: contrast(1.22) brightness(1.14) saturate(0.96);
}

/* === selected county texture overlay END === */


/* === metallic county rim START === */

.selected-county-rim-base,
.selected-county-rim-shine {
  fill: none;
  stroke-linejoin: round;
  stroke-linecap: round;
  vector-effect: non-scaling-stroke;
}

.selected-county-rim-base {
  stroke: rgba(255, 186, 116, 0.96);
  stroke-width: 2.6;
  filter:
    drop-shadow(0 0 3px rgba(255, 222, 180, 0.24))
