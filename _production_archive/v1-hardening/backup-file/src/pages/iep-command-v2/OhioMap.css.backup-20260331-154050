  stroke-width: 1.9;
  opacity: 1;
  filter:
    drop-shadow(0 0 4px rgba(240, 128, 48, 0.12))
    drop-shadow(0 0 10px rgba(224, 112, 48, 0.10))
    drop-shadow(0 0 18px rgba(176, 64, 32, 0.08));
