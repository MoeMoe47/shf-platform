}

.ohio-map-root.regional .selected-county-rim-shine {
  opacity: 0.86;
  stroke-width: 1.2;
  stroke-dasharray: 48 510;
  animation-duration: 4.6s;
}

@keyframes county-rim-run {
  from { stroke-dashoffset: 0; }
  to { stroke-dashoffset: -584; }
}

