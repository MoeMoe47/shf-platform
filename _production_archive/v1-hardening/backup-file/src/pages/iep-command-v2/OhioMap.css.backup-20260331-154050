.ohio-map-root {
  position: relative;
  width: 100%;
  height: 100%;
  overflow: hidden;
}

.ohio-map-message {
  display: grid;
  place-items: center;
  background: rgba(9, 13, 20, 0.88);
  color: rgba(245, 247, 251, 0.78);
  font-size: 14px;
  font-weight: 700;
}

.ohio-map-svg {
  position: absolute;
  inset: 0;
  width: 100%;
  height: 100%;
  overflow: visible;
}

.ohio-state-skin {
  fill: rgba(18, 12, 9, 0.10);
  stroke: none;
  filter: none;
}

.ohio-state-outline {
  fill: none;
  stroke: rgba(230, 236, 245, 0.24);
  stroke-width: 1.15;
  vector-effect: non-scaling-stroke;
  filter: none;
}

.ohio-county-borders {
  pointer-events: none;
}

.ohio-county-path {
  fill: none;
  stroke: rgba(210, 220, 235, 0.34);
  stroke-width: 1;
  vector-effect: non-scaling-stroke;
  opacity: 0.82;
  filter: none;
  transition:
    stroke 220ms ease,
    opacity 220ms ease,
    filter 220ms ease,
    fill-opacity 220ms ease,
    stroke-width 220ms ease;
}

.ohio-county-path.selected {
  stroke: rgba(235, 240, 248, 0.58);
  stroke-width: 1.4;
  opacity: 1;
}

.ohio-county-path.monitor {
  stroke: rgba(220, 228, 240, 0.45);
  stroke-width: 1.25;
  opacity: 0.95;
  filter: drop-shadow(0 0 4px rgba(220, 228, 240, 0.10));
}

.ohio-county-path.active {
  stroke: url(#goldGradient);
  stroke-width: 2.7;
  opacity: 1;
  filter:
    drop-shadow(0 0 3px rgba(255, 220, 150, 0.70))
    drop-shadow(0 0 8px rgba(255, 176, 72, 0.65))
    drop-shadow(0 0 18px rgba(166, 86, 28, 0.55))
    drop-shadow(0 0 30px rgba(120, 55, 18, 0.32));
  animation: metallicRadiance 2.4s ease-in-out infinite;
}

.ohio-county-path.fill-active.active {
  fill: url(#goldFillGradient);
  fill-opacity: 0.78;
}

.ohio-map-glow {
  position: absolute;
  inset: 0;
  z-index: 3;
  pointer-events: none;
}

.ohio-map-root::after {
  content: "";
  position: absolute;
  inset: 0;
  background:
    radial-gradient(
      circle at center,
      rgba(0, 0, 0, 0) 55%,
      rgba(0, 0, 0, 0.30) 100%
    );
  pointer-events: none;
  z-index: 4;
}

.ohio-texture-img {
  filter: brightness(0.45) contrast(1.1) saturate(0.6);
}

@keyframes metallicRadiance {
  0% {
    stroke-width: 2.45;
    filter:
      drop-shadow(0 0 2px rgba(255, 220, 150, 0.55))
      drop-shadow(0 0 7px rgba(255, 176, 72, 0.50))
      drop-shadow(0 0 14px rgba(166, 86, 28, 0.42))
      drop-shadow(0 0 24px rgba(120, 55, 18, 0.24));
  }

  50% {
    stroke-width: 3.05;
    filter:
      drop-shadow(0 0 4px rgba(255, 235, 175, 0.82))
      drop-shadow(0 0 11px rgba(255, 196, 92, 0.78))
      drop-shadow(0 0 22px rgba(182, 98, 34, 0.62))
      drop-shadow(0 0 36px rgba(126, 60, 20, 0.36));
  }

  100% {
    stroke-width: 2.45;
    filter:
      drop-shadow(0 0 2px rgba(255, 220, 150, 0.55))
      drop-shadow(0 0 7px rgba(255, 176, 72, 0.50))
      drop-shadow(0 0 14px rgba(166, 86, 28, 0.42))
      drop-shadow(0 0 24px rgba(120, 55, 18, 0.24));
  }
}

/* 🔥 Ohio Base Texture (State-Level) */
.ohio-texture-img {
  width: 100%;
  height: 100%;
  object-fit: cover;

  filter:
    brightness(0.35)
    contrast(1.2)
    saturate(0.4);

  opacity: 0.9;
}


/* 🧠 Elite Neutral Base Layer */
.ohio-texture-img {
  width: 100%;
  height: 100%;
  object-fit: cover;

  filter:
    brightness(0.55)
    contrast(1.25)
    saturate(0.2);

  opacity: 0.85;
}


/* 🎯 Franklin Zoom Focus */
.ohio-map-stage {
  transition: transform 1.2s ease, filter 1.2s ease;
}

.ohio-map-stage.zoom-franklin {
  transform: scale(1.25) translate(-6%, -4%);
  filter: brightness(1.05);
}

/* 🔥 Franklin Lava Pulse */
@keyframes franklinPulse {
  0% {
    filter: drop-shadow(0 0 6px rgba(255,140,0,0.4));
  }
  50% {
    filter: drop-shadow(0 0 18px rgba(255,170,60,0.9))
            drop-shadow(0 0 40px rgba(255,120,0,0.6));
  }
  100% {
    filter: drop-shadow(0 0 6px rgba(255,140,0,0.4));
  }
}

.ohio-county-path.active {
  animation: franklinPulse 1.6s ease-in-out infinite;
  stroke-width: 2.2;
}




.ohio-map-root {
  transition: transform 1.2s ease, filter 1.2s ease;
}

.ohio-map-root.zoom-franklin {
  transform: scale(1.25) translate(-6%, -4%);
  transform-origin: center;
  filter: brightness(1.05);
}


/* === state regional county glow override START === */

.ohio-map-root {
  position: relative;
  overflow: hidden;
}

.ohio-map-svg {
  display: block;
  width: 100%;
  height: 100%;
}

.ohio-map-root.state .ohio-map-svg {
  filter: brightness(1) contrast(1);
}

.ohio-map-root.regional .ohio-map-svg {
  filter: brightness(1.05) contrast(1.06);
}

.ohio-map-reset {
  position: absolute;
  top: 14px;
  right: 14px;
  z-index: 5;
  opacity: 0;
  pointer-events: none;
  border: 1px solid rgba(255, 184, 92, 0.34);
  background: rgba(10, 16, 24, 0.88);
  color: rgba(255, 231, 195, 0.96);
  padding: 8px 12px;
  font-size: 12px;
  letter-spacing: 0.04em;
  text-transform: uppercase;
  transition: opacity 180ms ease, transform 180ms ease;
  transform: translateY(-4px);
}

.ohio-map-reset.is-visible {
  opacity: 1;
  pointer-events: auto;
  transform: translateY(0);
}

.ohio-county-path {
  fill: rgba(255, 255, 255, 0.018);
  stroke: rgba(210, 220, 235, 0.20);
  stroke-width: 0.95;
  vector-effect: non-scaling-stroke;
  opacity: 0.76;
  transition:
    fill 220ms ease,
    stroke 220ms ease,
    stroke-width 220ms ease,
    opacity 220ms ease,
    filter 220ms ease;
}

.ohio-county-path.monitor {
  fill: rgba(255, 132, 44, 0.05);
  stroke: rgba(224, 232, 242, 0.30);
  opacity: 0.88;
}

.ohio-county-path.selected,
.ohio-county-path.active.selected,
.ohio-county-path[data-active="true"] {
  fill: url(#countyHeatGradient);
  stroke: rgba(255, 198, 118, 0.98);
  stroke-width: 2.25;
  opacity: 1;
  filter:
    drop-shadow(0 0 8px rgba(255, 190, 96, 0.40))
    drop-shadow(0 0 18px rgba(255, 132, 44, 0.30))
    drop-shadow(0 0 36px rgba(255, 96, 28, 0.18));
}

.ohio-state-outline {
  fill: none;
  stroke: rgba(235, 241, 248, 0.28);
  stroke-width: 1.2;
  vector-effect: non-scaling-stroke;
}

.ohio-state-skin {
  fill: rgba(255, 255, 255, 0.02);
}

/* === state regional county glow override END === */


/* === click-through fix START === */

.ohio-map-glow,
.ohio-texture-img,
.ohio-state-skin {
  pointer-events: none !important;
}

.ohio-map-svg,
.ohio-county-borders,
.ohio-state-outline {
  pointer-events: auto;
}

.ohio-county-path {
  pointer-events: all !important;
}

/* === click-through fix END === */

