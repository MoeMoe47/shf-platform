/* === selected county texture overlay START === */

.selected-county-fill,
.selected-county-texture-dark,
.selected-county-texture-light,
.selected-county-rim-base,
.selected-county-rim-shine {
  pointer-events: none;
}

/* kill the original selected-path interior so it cannot turn black */
.ohio-map-root .ohio-county-path.selected {
  fill: transparent !important;
  fill-opacity: 0 !important;
}

/* dedicated orange surface */
.selected-county-fill {
  fill: url(#countyHeatGradient);
}

.ohio-map-root.state .selected-county-fill {
  opacity: 0.92;
  filter:
    drop-shadow(0 0 4px rgba(240, 126, 52, 0.10))
    drop-shadow(0 0 10px rgba(176, 72, 36, 0.06));
}

.ohio-map-root.regional .selected-county-fill {
