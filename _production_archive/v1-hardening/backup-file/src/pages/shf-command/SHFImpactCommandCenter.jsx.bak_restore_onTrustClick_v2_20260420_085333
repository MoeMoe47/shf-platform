        setOracleBundle(null);
        setOracleError("");
        return;
      }

      setOracleLoading(true);
      setOracleError("");

      try {
        const bundle = await fetchOracleBundle({
          entityId: selectedEntityId,
          county: selectedCounty,
        });

        if (!cancelled) setOracleBundle(bundle);
      } catch (err) {
        if (!cancelled) {
          setOracleBundle(null);
          setOracleError(err?.message || "Oracle unavailable");
        }
      } finally {
        if (!cancelled) setOracleLoading(false);
      }
    }

    loadOracle();
    return () => {
      cancelled = true;
    };
  }, [selectedEntityId, selectedCounty]);


  const countyActions = useMemo(() => {
    return getActionsForCounty(selectedCounty);
  }, [selectedCounty]);

  const trendPoints = useMemo(() => {
    return [8,12,10,14,18,16,20,24,22,28,26,30,34,33,38,42];
  }, []);

  const openDrawer = (payload) => setSelected(payload);

  const onCountyClick = (county) => {
    const resolved = resolveCountyRecord(county, COUNTIES);

    openDrawer({
      title: resolved.name,
      summary: "County command context",
      metrics: [
        { label: "Programs", value: resolved.programs },
        { label: "Funding", value: resolved.funding }
      ],
      actions: ["Open county profile"]
    });
  };

  const onAiActionClick = (action) => {
    const payload = buildAiActionPayload(action, selectedCounty);

    if (oracleInsight?.confidence) {
      payload.metrics = [
        ...(payload.metrics || []),
        { label: "Oracle Confidence", value: oracleInsight.confidence },
        { label: "Oracle Priority", value: oracleInsight.priorityLabel || "Monitor" },
      ];
    }

    if (oracleInsight?.whyPoints?.length) {
      payload.reasonSignals = oracleInsight.whyPoints;
    }

    if (oracleInsight?.nextMoveText) {
      payload.summary = action || oracleInsight.nextMoveText;
    }

    setSelected(payload);
  };

  return (
    <div className="shf-page">
      <div className="shf-shell">
<header className="shf-topbar">
          <div className="shf-brand">
            <div className="shf-brand__mark">
              <span className="shf-brand__mark-top" />
              <span className="shf-brand__mark-bottom" />
            </div>
            <div className="shf-brand__text">Silicon Heartland</div>
            <div className="shf-brand__divider" />
            <h1>SHF Impact Command Center</h1>
          </div>

          <div className="shf-topbar__controls">
            <select className="shf-select" defaultValue="reporting">
              <option value="reporting">Reporting Period</option>
              <option>Last 30 Days</option>
              <option>Last 90 Days</option>
              <option>Last 12 Months</option>
            </select>

            <select className="shf-select" defaultValue="ohio">
              <option value="ohio">Ohio : Statewide</option>
              <option>Franklin County</option>
              <option>Cuyahoga County</option>
              <option>Hamilton County</option>
            </select>

            <button
              className="shf-export-btn"
              type="button"
              onClick={() =>
                openDrawer({
                  title: "Export Report",
                  summary: "Generate executive, donor, grant, and public-facing report outputs from this command surface.",
                  metrics: [
                    { label: "Exports Ready", value: "5" },
                    { label: "PDF Engine", value: "Connected" },
                  ],
                  actions: ["Generate Executive Brief", "Generate Donor Summary", "Generate Grant Narrative"],
                  reason: "This is where command-center insight becomes a real funding and reporting asset."
                })
              }
            >
              Export Report
            </button>
          </div>
        </header>

        <ImpactKpiBand kpis={KPIS} />

        <main className="shf-main-grid">

          <section className="shf-left-col">
            <SHFImpactOhioMap
              selectedCounty={selectedCounty}
              onCountyClick={onCountyClick}
            />
          </section>

          <section className="shf-middle-col">
            <ImpactOverviewWheelPanel
              wheelSegments={WHEEL_SEGMENTS}
              trendPoints={trendPoints}
            />
          </section>

          

        
        <aside className="shf-right-col">
            <AIAnalystPanel
              changedText={
                oracleLoading
                  ? "Oracle is evaluating the current county and entity context..."
                  : (oracleInsight?.changedText || aiInsight.changedText)
              }
              whyPoints={
                oracleError
                  ? [`Oracle unavailable: ${oracleError}`, ...(aiInsight?.whyPoints || [])]
                  : (oracleInsight?.whyPoints || aiInsight.whyPoints)
              }
              nextMoveText={oracleInsight?.nextMoveText || aiInsight.nextMoveText}
              actionLabel={
                oracleLoading
                  ? "Oracle loading..."
                  : (oracleInsight?.actionLabel || "Execute Oracle recommendation")
              }
              onAction={() => onAiActionClick(oracleInsight?.nextMoveText || aiInsight.nextMoveText)}
              headerExtra={
                <div className="shf-ai-live-signal">
                  <span className="shf-ai-live-dot" />
                  <span className="shf-ai-live-text">
                    {oracleLoading
                      ? "ORACLE SYNCING"
                      : oracleError
                      ? "ORACLE FALLBACK MODE"
                      : "ORACLE ACTIVE"}
                  </span>
                </div>
              }
            />

            <TrustVerificationPanel
              items={TRUST_ITEMS}
              onTrustClick={onTrustClick}
            />
          </aside>
        </main>

        <DetailDrawer selected={selected} onClose={() => setSelected(null)} />

      </div>
    </div>
  );
}

