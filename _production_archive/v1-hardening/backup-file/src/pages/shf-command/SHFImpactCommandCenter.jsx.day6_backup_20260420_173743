const ORACLE_ENDPOINTS = {
  truth: "/oracle/truth",
  compare: "/oracle/compare",
  priority: "/oracle/priority",
};

async function fetchOracleBundle({ entityId, county }) {
  const params = new URLSearchParams();
  if (entityId) params.set("entity_id", entityId);
  if (county) params.set("county", county);

  const qs = params.toString() ? `?${params.toString()}` : "";

  const [truthRes, compareRes, priorityRes] = await Promise.allSettled([
    fetch(`${ORACLE_BASE}${ORACLE_ENDPOINTS.truth}${qs}`),
    fetch(`${ORACLE_BASE}${ORACLE_ENDPOINTS.compare}${qs}`),
    fetch(`${ORACLE_BASE}${ORACLE_ENDPOINTS.priority}${qs}`),
  ]);

  async function readSettled(res) {
    if (res.status !== "fulfilled") return null;
    if (!res.value.ok) return null;
    try {
      return await res.value.json();
    } catch {
      return null;
    }
  }

  return {
    truth: await readSettled(truthRes),
    compare: await readSettled(compareRes),
    priority: await readSettled(priorityRes),
  };
}

function normalizeOracleInsight(bundle, fallbackInsight, county) {
  const truth = bundle?.truth || {};
  const compare = bundle?.compare || {};
  const priority = bundle?.priority || {};

  const countyName =
    typeof county === "string"
      ? county
      : county?.name || "Unknown County";

  const confidence =
    truth?.confidence ??
    truth?.oracle_truth_package?.confidence ??
    compare?.confidence ??
    priority?.confidence ??
    null;

  const priorityLabel =
    priority?.priority ??
    priority?.recommended_priority ??
    truth?.priority ??
    "Monitor";

  const changedText =
    truth?.summary ||
    truth?.judgment ||
    truth?.oracle_truth_package?.summary ||
    fallbackInsight.changedText;

  const whyPoints =
    truth?.reasons ||
    truth?.why ||
    compare?.drivers ||
    compare?.differences ||
    priority?.signals ||
    fallbackInsight.whyPoints;

  const nextMoveText =
    priority?.recommended_action ||
    priority?.next_move ||
    truth?.recommended_action ||
    compare?.recommended_action ||
    fallbackInsight.nextMoveText;

  const actionLabel =
    priority?.cta_label ||
    "Execute Oracle recommendation";

  return {
    changedText,
    whyPoints: Array.isArray(whyPoints) ? whyPoints : fallbackInsight.whyPoints,
    nextMoveText,
    actionLabel,
    confidence: confidence == null ? null : String(confidence),
    priorityLabel,
    raw: { truth, compare, priority },
    countyName,
  };
}

