import React, { useState } from "react";
import "./shf-impact-ohio-map.css";
import OhioCountyNeutralBase from "@/pages/iep-command-v2/OhioCountyNeutralBase.jsx";

const POINTS = [
  { name: "Franklin", x: 51.5, y: 61.5 },
  { name: "Cuyahoga", x: 72.5, y: 29.5 },
  { name: "Hamilton", x: 36.0, y: 76.5 },
  { name: "Summit", x: 67.0, y: 42.5 },
  { name: "Montgomery", x: 43.0, y: 66.5 },
  { name: "Lucas", x: 74.0, y: 16.0 },
];

export default function SHFImpactOhioMap() {
  const [hovered, setHovered] = useState(null);

  return (
    <div className="shf-impact-map">

      {/* TEXTURE */}
      <img
        src="/assets/shf-command/maps/shf-impact-ohio-texture.png"
        className="shf-map-texture"
      />

            <img
        src="/assets/shf-command/maps/ohio-counties.svg"
        className="shf-map-counties"
        alt=""
      />

      {/* COUNTY LINES */}
            <div className="shf-map-counties shf-real-county-overlay" aria-hidden="true">
        <OhioCountyNeutralBase />
      </div>

      {/* NODES */}
      <div className="shf-map-nodes">
        {POINTS.map(p => (
          <div
            key={p.name}
            className="shf-node"
            style={{ left: `${p.x}%`, top: `${p.y}%` }}
            onMouseEnter={() => setHovered(p.name)}
            onMouseLeave={() => setHovered(null)}
          />
        ))}
      </div>

      {hovered && (
        <div className="shf-tooltip">
          <strong>{hovered} County</strong>
        </div>
      )}

    </div>
  );
}
