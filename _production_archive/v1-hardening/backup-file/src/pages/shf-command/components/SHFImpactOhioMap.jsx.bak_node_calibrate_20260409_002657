import React, { useState } from "react";
import "./shf-impact-ohio-map.css";

const COUNTY_POINTS = [
  { name: "Franklin", x: 52, y: 58, size: "lg", active: true },
  { name: "Cuyahoga", x: 70, y: 20, size: "md", active: false },
  { name: "Hamilton", x: 38, y: 78, size: "md", active: false },
  { name: "Summit", x: 66, y: 32, size: "sm", active: false },
  { name: "Montgomery", x: 45, y: 68, size: "sm", active: false },
  { name: "Lucas", x: 72, y: 8, size: "sm", active: false },
];

export default function SHFImpactOhioMap() {
  const [hovered, setHovered] = useState(null);

  return (
    <div className="shf-impact-map-root">
      <img
        src="/assets/shf-command/maps/shf-impact-ohio-base.png"
        alt="Ohio map"
        className="shf-impact-map-base"
      />

      <div className="shf-impact-map-grid" />

      <div className="shf-impact-node-layer">
        {COUNTY_POINTS.map((n) => (
          <div
            key={n.name}
            className={`shf-impact-node shf-impact-node--${n.size} ${n.active ? "is-active" : ""}`}
            style={{ left: `${n.x}%`, top: `${n.y}%` }}
            onMouseEnter={() => setHovered(n)}
            onMouseLeave={() => setHovered(null)}
          >
            <div className="shf-impact-node-core" />
            <div className="shf-impact-node-pulse" />
          </div>
        ))}
      </div>

      {hovered ? (
        <div className="shf-impact-map-tooltip">
          <strong>{hovered.name} County</strong>
          <div>Programs Active: 5</div>
          <div>People Served: 3,824</div>
          <div>Funding: $4.5M</div>
          <div>Outcome: 82%</div>
        </div>
      ) : null}
    </div>
  );
}
