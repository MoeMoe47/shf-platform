.shf-impact-map-root {
  position: relative;
  min-height: 520px;
  border-radius: 26px;
  overflow: hidden;
  background:
    linear-gradient(180deg, rgba(248,243,236,0.94) 0%, rgba(240,234,226,0.98) 100%);
}

.shf-impact-map-grid {
  position: absolute;
  inset: 0;
  background-image:
    linear-gradient(rgba(122, 96, 70, 0.05) 1px, transparent 1px),
    linear-gradient(90deg, rgba(122, 96, 70, 0.05) 1px, transparent 1px);
  background-size: 44px 44px;
  pointer-events: none;
  z-index: 0;
}

.shf-impact-map-toolbar {
  position: absolute;
  top: 18px;
  right: 18px;
  display: flex;
  gap: 10px;
  z-index: 10;
}

.shf-impact-map-toolbar button {
  border: 1px solid rgba(164, 137, 108, 0.18);
  background: rgba(255,255,255,0.82);
  color: #7a6249;
  border-radius: 999px;
  padding: 10px 16px;
  font: inherit;
}

.shf-impact-map-toolbar .is-active {
  background: rgba(223, 179, 116, 0.20);
  color: #6b4a2e;
}

.shf-impact-map-stage {
  position: relative;
  height: 470px;
  padding: 26px 18px 18px;
  z-index: 1;
}

.shf-impact-map-surface {
  position: absolute;
  inset: 28px 18px 18px;
  transform:
    translate(var(--map-tx, 0%), var(--map-ty, 0%))
    scale(var(--map-scale, 1));
  transform-origin: 50% 50%;
  transition: transform 760ms cubic-bezier(.22,1,.36,1);
}

.shf-impact-map-ohio-body-slot {
  position: absolute;
  inset: 6% 9% 8% 9%;
  z-index: 2;
  filter: drop-shadow(0 10px 18px rgba(92, 58, 29, 0.06));
}

.shf-impact-map-ohio-body-slot svg {
  width: 100%;
  height: 100%;
}

.shf-impact-map-ohio-body-slot path,
.shf-impact-map-ohio-body-slot polygon,
.shf-impact-map-ohio-body-slot polyline {
  fill: rgba(224, 149, 63, 0.90) !important;
  stroke: rgba(255, 244, 228, 0.84) !important;
  stroke-width: 1.08 !important;
}

.shf-impact-map-ohio-body-slot::before {
  content: "";
  position: absolute;
  inset: 0;
  pointer-events: none;
  background:
    radial-gradient(circle at 28% 24%, rgba(255, 223, 170, 0.38), transparent 22%),
    radial-gradient(circle at 74% 28%, rgba(213, 120, 38, 0.18), transparent 24%),
    radial-gradient(circle at 66% 72%, rgba(176, 86, 22, 0.16), transparent 28%),
    linear-gradient(135deg, rgba(255, 233, 193, 0.10) 0%, rgba(202, 118, 38, 0.16) 100%);
  mix-blend-mode: soft-light;
  z-index: 3;
}

.shf-impact-map-geo-slot {
  position: absolute;
  inset: 6% 9% 8% 9%;
  z-index: 5;
  opacity: 0.98;
  mix-blend-mode: normal;
}

.shf-impact-map-geo-slot svg {
  width: 100%;
  height: 100%;
}

.shf-impact-map-geo-slot path,
.shf-impact-map-geo-slot polygon,
.shf-impact-map-geo-slot polyline {
  fill: transparent !important;
  stroke: rgba(255, 248, 238, 0.995) !important;
  stroke-width: 1.5 !important;
  transition: stroke 240ms ease, opacity 240ms ease, filter 240ms ease;
}

/* processing beacons */
.shf-impact-map-processing-layer {
  position: absolute;
  inset: 6% 9% 8% 9%;
  z-index: 4;
  pointer-events: none;
}

.shf-processing-beacon {
  position: absolute;
  width: 54px;
  height: 54px;
  margin-left: -27px;
  margin-top: -27px;
  border-radius: 999px;
  background:
    radial-gradient(circle, rgba(244, 184, 96, 0.28) 0%, rgba(244, 184, 96, 0.14) 36%, rgba(244, 184, 96, 0.0) 74%);
  animation: shfCountyPulse 2.2s ease-in-out infinite;
  opacity: 0.92;
}

.shf-processing-beacon::before {
  content: "";
  position: absolute;
  inset: 10px;
  border-radius: 999px;
  box-shadow: 0 0 0 1px rgba(255, 224, 170, 0.28);
}

.shf-processing-beacon.is-hidden {
  opacity: 0;
  transition: opacity 220ms ease;
}

/* approximate regional anchors */
.shf-processing-beacon[data-county="Franklin"] { left: 52%; top: 56%; }
.shf-processing-beacon[data-county="Cuyahoga"] { left: 66%; top: 23%; }
.shf-processing-beacon[data-county="Hamilton"] { left: 35%; top: 78%; }

@keyframes shfCountyPulse {
  0%, 100% { transform: scale(0.96); opacity: 0.82; }
  50% { transform: scale(1.12); opacity: 1; }
}

/* regional mode */
.shf-impact-map-stage.is-regional .shf-impact-map-ohio-body-slot {
  filter:
    drop-shadow(0 10px 18px rgba(92, 58, 29, 0.06))
    saturate(0.96)
    brightness(0.98);
}

.shf-impact-map-stage.is-regional .shf-impact-map-ohio-body-slot path,
.shf-impact-map-stage.is-regional .shf-impact-map-ohio-body-slot polygon,
.shf-impact-map-stage.is-regional .shf-impact-map-ohio-body-slot polyline {
  fill: rgba(212, 138, 58, 0.56) !important;
}

.shf-impact-map-stage.is-regional .shf-impact-map-geo-slot path,
.shf-impact-map-stage.is-regional .shf-impact-map-geo-slot polygon,
.shf-impact-map-stage.is-regional .shf-impact-map-geo-slot polyline {
  stroke: rgba(255, 248, 238, 0.82) !important;
  stroke-width: 1.56 !important;
}

/* selected region halo */
.shf-impact-map-focus-halo {
  position: absolute;
  inset: 6% 9% 8% 9%;
  z-index: 6;
  pointer-events: none;
  background:
    radial-gradient(circle at 52% 56%, rgba(243, 172, 83, 0.22), transparent 9%),
    radial-gradient(circle at 52% 56%, rgba(255, 223, 170, 0.10), transparent 16%);
  opacity: 0;
  transition: opacity 320ms ease;
}

.shf-impact-map-stage.is-regional .shf-impact-map-focus-halo {
  opacity: 1;
}

.shf-impact-map-stage.is-regional::after {
  content: "";
  position: absolute;
  inset: 18px;
  pointer-events: none;
  background:
    radial-gradient(circle at 50% 52%, rgba(255,255,255,0.00) 0%, rgba(255,255,255,0.00) 28%, rgba(88, 60, 35, 0.07) 100%);
  border-radius: 24px;
  z-index: 7;
}

.shf-impact-map-tooltip {
  position: absolute;
  left: 18%;
  bottom: 19%;
  z-index: 8;
  background: rgba(255,255,255,0.94);
  border: 1px solid rgba(170, 137, 103, 0.16);
  border-radius: 22px;
  padding: 18px 18px 16px;
  min-width: 238px;
  box-shadow:
    0 16px 34px rgba(86, 58, 34, 0.08),
    0 2px 0 rgba(255,255,255,0.78) inset;
  transition: transform 240ms ease, box-shadow 240ms ease;
}

.shf-impact-map-tooltip.is-active {
  transform: translateY(-3px) scale(1.01);
  box-shadow:
    0 18px 38px rgba(86, 58, 34, 0.12),
    0 2px 0 rgba(255,255,255,0.78) inset;
}

.shf-impact-map-tooltip strong {
  display: block;
  margin-bottom: 10px;
  font-size: 18px;
}

.shf-impact-map-tooltip div {
  line-height: 1.55;
}

/* =========================================================
   SHF MAP — STRONGER ZOOM + OUTLINE-FIRST + GOLD FOCUS
   ========================================================= */

/* much stronger regional zoom */
.shf-impact-map-surface {
  transition: transform 820ms cubic-bezier(.22,1,.36,1) !important;
}

/* quiet the county body */
.shf-impact-map-ohio-body-slot path,
.shf-impact-map-ohio-body-slot polygon,
.shf-impact-map-ohio-body-slot polyline {
  fill: rgba(225, 176, 112, 0.34) !important;
  stroke: rgba(255, 235, 210, 0.22) !important;
  stroke-width: 0.9 !important;
}

/* outlines become the main structural language */
.shf-impact-map-geo-slot path,
.shf-impact-map-geo-slot polygon,
.shf-impact-map-geo-slot polyline {
  fill: transparent !important;
  stroke: rgba(255, 245, 230, 0.98) !important;
  stroke-width: 2.2 !important;
  vector-effect: non-scaling-stroke;
  stroke-linejoin: round;
  stroke-linecap: round;
  filter: drop-shadow(0 0 2px rgba(255, 225, 184, 0.10));
}

/* stronger regional mode */
.shf-impact-map-stage.is-regional .shf-impact-map-geo-slot path,
.shf-impact-map-stage.is-regional .shf-impact-map-geo-slot polygon,
.shf-impact-map-stage.is-regional .shf-impact-map-geo-slot polyline {
  stroke: rgba(255, 247, 235, 1) !important;
  stroke-width: 2.6 !important;
  filter:
    drop-shadow(0 0 3px rgba(255, 230, 190, 0.16))
    drop-shadow(0 0 8px rgba(214, 156, 79, 0.10));
}

/* selected region halo becomes more obvious and metallic-gold */
.shf-impact-map-focus-halo {
  background:
    radial-gradient(circle at 52% 56%, rgba(231, 176, 92, 0.34), transparent 7%),
    radial-gradient(circle at 52% 56%, rgba(255, 223, 170, 0.18), transparent 14%),
    radial-gradient(circle at 52% 56%, rgba(193, 131, 48, 0.10), transparent 22%) !important;
  opacity: 0 !important;
  transition: opacity 280ms ease, transform 820ms cubic-bezier(.22,1,.36,1) !important;
}

.shf-impact-map-stage.is-regional .shf-impact-map-focus-halo {
  opacity: 1 !important;
}

/* processing beacons feel more premium */
.shf-processing-beacon {
  width: 64px !important;
  height: 64px !important;
  margin-left: -32px !important;
  margin-top: -32px !important;
  background:
    radial-gradient(circle, rgba(232, 182, 96, 0.34) 0%, rgba(232, 182, 96, 0.18) 34%, rgba(232, 182, 96, 0.00) 74%) !important;
  animation: shfCountyPulseGold 1.9s ease-in-out infinite !important;
}

.shf-processing-beacon::before {
  inset: 8px !important;
  box-shadow:
    0 0 0 1px rgba(255, 231, 191, 0.34),
    0 0 16px rgba(215, 156, 78, 0.18) !important;
}

@keyframes shfCountyPulseGold {
  0%, 100% {
    transform: scale(0.94);
    opacity: 0.78;
  }
  50% {
    transform: scale(1.18);
    opacity: 1;
  }
}

/* selected county card feels more active */
.shf-impact-map-tooltip.is-active {
  transform: translateY(-4px) scale(1.015) !important;
  box-shadow:
    0 20px 42px rgba(86, 58, 34, 0.14),
    0 2px 0 rgba(255,255,255,0.82) inset !important;
}

/* slightly stronger board darkening during focus */
.shf-impact-map-stage.is-regional::after {
  background:
    radial-gradient(circle at 50% 52%, rgba(255,255,255,0.00) 0%, rgba(255,255,255,0.00) 22%, rgba(88, 60, 35, 0.10) 100%) !important;
}

/* toolbar chip reads more active */
.shf-impact-map-toolbar .is-active {
  background: rgba(224, 179, 109, 0.24) !important;
  color: #6b4a2e !important;
  box-shadow:
    0 0 0 1px rgba(220, 165, 85, 0.10) inset,
    0 0 18px rgba(223, 179, 116, 0.08) !important;
}

/* =========================================================
   SHF MAP — DARK BROWN OUTLINES FOR LIGHT BOARD
   ========================================================= */

/* base statewide outline language */
.shf-impact-map-geo-slot path,
.shf-impact-map-geo-slot polygon,
.shf-impact-map-geo-slot polyline {
  fill: transparent !important;
  stroke: rgba(112, 77, 46, 0.88) !important;
  stroke-width: 2.15 !important;
  vector-effect: non-scaling-stroke;
  stroke-linejoin: round;
  stroke-linecap: round;
  filter: drop-shadow(0 0 1px rgba(255, 231, 191, 0.05));
}

/* stronger regional mode */
.shf-impact-map-stage.is-regional .shf-impact-map-geo-slot path,
.shf-impact-map-stage.is-regional .shf-impact-map-geo-slot polygon,
.shf-impact-map-stage.is-regional .shf-impact-map-geo-slot polyline {
  stroke: rgba(96, 62, 34, 0.98) !important;
  stroke-width: 2.5 !important;
  filter:
    drop-shadow(0 0 2px rgba(255, 231, 191, 0.04))
    drop-shadow(0 0 6px rgba(176, 123, 58, 0.08));
}

/* quiet base county body stays behind the darker structure */
.shf-impact-map-ohio-body-slot path,
.shf-impact-map-ohio-body-slot polygon,
.shf-impact-map-ohio-body-slot polyline {
  fill: rgba(225, 176, 112, 0.34) !important;
  stroke: rgba(134, 94, 59, 0.18) !important;
  stroke-width: 0.9 !important;
}

/* =========================================================
   SHF MAP — CENTER AND ENLARGE OHIO
   ========================================================= */

/* center the Ohio system inside the board and make it bigger */
.shf-impact-map-ohio-body-slot,
.shf-impact-map-geo-slot,
.shf-impact-map-focus-halo,
.shf-impact-map-processing-layer {
  inset: 3% 5% 4% 5% !important;
}

/* make the map surface feel more centered during both statewide and regional views */
.shf-impact-map-surface {
  inset: 20px 16px 14px !important;
  transform-origin: 50% 50% !important;
}

/* keep tooltip from feeling too low if Ohio grows upward */
.shf-impact-map-tooltip {
  left: 17% !important;
  bottom: 18% !important;
}

/* =========================================================
   SHF MAP — MAKE OHIO WIDER IN THE BOARD
   ========================================================= */

/* widen the shared Ohio frame so the state uses more horizontal space */
.shf-impact-map-ohio-body-slot,
.shf-impact-map-geo-slot,
.shf-impact-map-focus-halo,
.shf-impact-map-processing-layer {
  inset: 5% 2% 6% 2% !important;
}

/* keep the overall surface nicely centered */
.shf-impact-map-surface {
  inset: 18px 14px 14px !important;
  transform-origin: 50% 50% !important;
}

/* small tooltip nudge so it still sits comfortably */
.shf-impact-map-tooltip {
  left: 18% !important;
  bottom: 18% !important;
}

/* =========================================================
   SHF MAP — RAISE OHIO AND MAKE IT A BIT WIDER
   ========================================================= */

/* shared Ohio frame for all map layers */
.shf-impact-map-ohio-body-slot,
.shf-impact-map-geo-slot,
.shf-impact-map-focus-halo,
.shf-impact-map-processing-layer {
  inset: 1% 1% 10% 1% !important;
}

/* keep the overall map surface centered and slightly higher */
.shf-impact-map-surface {
  inset: 12px 12px 18px !important;
  transform-origin: 50% 50% !important;
}

/* tooltip slightly higher so it sits naturally after Ohio moves up */
.shf-impact-map-tooltip {
  left: 18% !important;
  bottom: 22% !important;
}

/* =========================================================
   SHF MAP — HOVER/SELECT TOOLTIP BEHAVIOR
   ========================================================= */
.shf-impact-map-tooltip {
  opacity: 0;
  pointer-events: none;
  transform: translateY(8px) scale(0.985);
  transition:
    opacity 180ms ease,
    transform 220ms ease,
    box-shadow 240ms ease;
}

.shf-impact-map-tooltip.is-visible {
  opacity: 1;
  pointer-events: auto;
  transform: translateY(0) scale(1);
}

.shf-impact-map-tooltip.is-active {
  transform: translateY(-3px) scale(1.01);
  box-shadow:
    0 18px 38px rgba(86, 58, 34, 0.12),
    0 2px 0 rgba(255,255,255,0.78) inset !important;
}

/* =========================================================
   SHF MAP — TOOLTIP SHOULD NOT BLOCK COUNTY HOVER/CLICK
   ========================================================= */
.shf-impact-map-tooltip,
.shf-impact-map-tooltip.is-visible,
.shf-impact-map-tooltip.is-active {
  pointer-events: none !important;
}


/* ===== BEHAVIOR RESTORE ===== */
.shf-impact-map-tooltip {
  left: 10%;
  bottom: 20px;
  min-width: 250px;
  opacity: 0;
  pointer-events: none;
  transform: translateY(8px) scale(0.985);
  transition: opacity 180ms ease, transform 220ms ease;
}

.shf-impact-map-tooltip.is-visible {
  opacity: 1;
  transform: translateY(0) scale(1);
}

.shf-impact-map-tooltip strong {
  display: block;
  margin-bottom: 10px;
  font-size: 18px;
}

.shf-impact-map-processing-layer {
  pointer-events: none;
}

.shf-processing-beacon {
  position: absolute;
  width: 56px;
  height: 56px;
  margin-left: -28px;
  margin-top: -28px;
  border-radius: 999px;
  background: radial-gradient(circle, rgba(232,182,96,0.30) 0%, rgba(232,182,96,0.12) 45%, rgba(232,182,96,0) 76%);
  animation: shfCountyPulseGold 1.9s ease-in-out infinite;
  z-index: 8;
}

.shf-processing-beacon::before {
  content: "";
  position: absolute;
  inset: 9px;
  border-radius: 999px;
  box-shadow:
    0 0 0 1px rgba(255, 231, 191, 0.44),
    0 0 16px rgba(215, 156, 78, 0.28);
}

.shf-processing-beacon[data-county="Franklin"] { left: 52%; top: 58%; }
.shf-processing-beacon[data-county="Cuyahoga"] { left: 67%; top: 26%; }
.shf-processing-beacon[data-county="Hamilton"] { left: 33%; top: 79%; }

.shf-impact-map-geo-slot .ohio-official-map-v2__county.is-hovered,
.shf-impact-map-geo-slot .ohio-official-map-v2__county.is-selected,
.shf-impact-map-geo-slot .ohio-official-map-v2__county.is-active {
  stroke: rgba(214, 128, 47, 0.98) !important;
  stroke-width: 3.2 !important;
  filter: drop-shadow(0 0 6px rgba(226,132,44,0.26));
}

.shf-system-status {
  position: absolute;
  top: 18px;
  left: 18px;
  z-index: 24;
  display: inline-flex;
  align-items: center;
  gap: 10px;
  max-width: min(520px, calc(100% - 180px));
  padding: 10px 14px;
  border-radius: 999px;
  border: 1px solid rgba(166, 133, 97, 0.16);
  background: rgba(255, 251, 245, 0.72);
  backdrop-filter: blur(10px);
  box-shadow:
    0 6px 18px rgba(80, 56, 34, 0.06),
    0 1px 0 rgba(255,255,255,0.66) inset;
  opacity: 0;
  transform: translateY(-6px);
  pointer-events: none;
  transition: opacity 220ms ease, transform 260ms ease;
}

.shf-system-status.is-visible {
  opacity: 1;
  transform: translateY(0);
}

.shf-system-status__dot {
  width: 8px;
  height: 8px;
  border-radius: 999px;
  flex: 0 0 auto;
  background: rgba(207, 148, 72, 0.95);
  box-shadow: 0 0 0 4px rgba(230, 183, 109, 0.14);
}

.shf-system-status__text {
  font-size: 12px;
  line-height: 1.2;
  letter-spacing: 0.01em;
  color: rgba(99, 69, 43, 0.88);
  white-space: nowrap;
  overflow: hidden;
  text-overflow: ellipsis;
}
