/* =========================
   SHF MAP VISIBILITY RESET
========================= */

.shf-impact-map,
.shf-impact-map-root {
  position: relative;
  width: 100%;
  height: 100%;
  min-height: 560px;
  overflow: hidden;
  background: transparent;
}

.shf-map-texture,
.shf-impact-map-base {
  position: absolute;
  inset: 0;
  width: 100%;
  height: 100%;
  object-fit: contain;
  z-index: 1;
  opacity: 1 !important;
  mix-blend-mode: normal !important;
  filter: none !important;
  transform: scale(1.38) translate(1.5%, -6%);
  transform-origin: center;
}

.shf-map-counties,
.shf-real-county-overlay,
.shf-impact-map svg {
  position: absolute;
  inset: 0;
  width: 100%;
  height: 100%;
  z-index: 2;
  opacity: 1 !important;
  mix-blend-mode: normal !important;
  filter: none !important;
  transform: scale(1.38) translate(1.5%, -6%);
  transform-origin: center;
}

.shf-impact-map svg path,
.shf-impact-map svg polygon,
.shf-impact-map svg polyline,
.shf-impact-map svg line {
  fill: transparent !important;
  stroke: rgba(255,255,255,0.92) !important;
  stroke-width: 1.3px !important;
}

.shf-map-nodes {
  position: absolute;
  inset: 0;
  z-index: 3;
}

.shf-node,
.shf-impact-node {
  z-index: 4;
}


/* =========================
   FORCE SHF GOLD MAP STYLE
   ========================= */

/* remove any dark fill */
.shf-map-counties svg {
  background: transparent !important;
}

/* state + counties fill */
.shf-map-counties path {
  fill: #e9a24a !important; /* base gold */
  stroke: #ffffff !important;
  stroke-width: 1.2 !important;
}

/* subtle gradient feel */
.shf-map-counties path:nth-child(odd) {
  fill: #f2b35e !important;
}

.shf-map-counties path:nth-child(even) {
  fill: #d98b2f !important;
}

/* soften harsh contrast */
.shf-map-counties {
  filter: drop-shadow(0 6px 14px rgba(0,0,0,0.12));
}

/* OPTIONAL: parchment harmony */
.shf-impact-map {
  background: transparent !important;
}

