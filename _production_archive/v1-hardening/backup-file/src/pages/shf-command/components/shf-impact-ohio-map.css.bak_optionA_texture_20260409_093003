.shf-impact-map-root {
  position: relative;
  width: 100%;
  height: 100%;
  min-height: 500px;
  border-radius: 18px;
  overflow: hidden;
  background:
    radial-gradient(circle at 50% 42%, rgba(255,255,255,0.34), rgba(236,228,217,0.22) 72%),
    linear-gradient(180deg, rgba(243,236,228,0.16), rgba(230,220,208,0.18));
}

/* Ohio bigger and more dominant */
.shf-impact-map-frame {
  position: absolute;
  left: -2%;
  top: -12%;
  width: 104%;
  height: 124%;
  z-index: 2;
}

.shf-impact-map-base {
  position: absolute;
  inset: 0;
  width: 100%;
  height: 100%;
  object-fit: contain;
  transform: scale(1.26);
  transform-origin: center center;
  opacity: 1;
  filter:
    brightness(0.98)
    contrast(1.04)
    saturate(1.02)
    drop-shadow(0 8px 22px rgba(88, 57, 31, 0.08));
}

.shf-impact-node-layer {
  position: absolute;
  inset: 0;
  z-index: 4;
}

.shf-impact-node {
  position: absolute;
  transform: translate(-50%, -50%);
  cursor: pointer;
}

.shf-impact-node-core {
  width: 12px;
  height: 12px;
  border-radius: 50%;
  position: relative;
  z-index: 2;
  background: radial-gradient(
    circle at 35% 35%,
    rgba(255, 250, 239, 0.98) 0%,
    rgba(255, 233, 191, 0.98) 22%,
    rgba(255, 208, 138, 0.98) 46%,
    rgba(255, 242, 214, 0.98) 70%,
    rgba(241, 210, 148, 0.96) 100%
  );
  border: 1px solid rgba(255, 245, 224, 0.95);
  box-shadow:
    0 0 0 2px rgba(154, 84, 28, 0.20),
    0 0 8px rgba(255, 244, 220, 0.82),
    0 0 18px rgba(255, 225, 168, 0.62),
    0 0 30px rgba(255, 248, 228, 0.32);
}

.shf-impact-node-pulse {
  position: absolute;
  width: 40px;
  height: 40px;
  top: -14px;
  left: -14px;
  border-radius: 50%;
  z-index: 1;
  background: radial-gradient(
    circle,
    rgba(255, 248, 228, 0.38) 0%,
    rgba(255, 222, 160, 0.22) 34%,
    rgba(255, 241, 212, 0.08) 66%,
    transparent 100%
  );
  opacity: 0;
}

.shf-impact-node.is-active .shf-impact-node-core {
  box-shadow:
    0 0 0 2px rgba(165, 88, 24, 0.22),
    0 0 10px rgba(255, 255, 240, 0.94),
    0 0 22px rgba(255, 232, 176, 0.84),
    0 0 42px rgba(255, 245, 221, 0.44),
    0 0 68px rgba(255, 255, 245, 0.20);
}

.shf-impact-node.is-active .shf-impact-node-pulse {
  opacity: 1;
  animation: shfImpactPulse 2.05s ease-out infinite;
}

.shf-impact-node:hover .shf-impact-node-core {
  transform: scale(1.08);
  box-shadow:
    0 0 0 2px rgba(165, 88, 24, 0.22),
    0 0 10px rgba(255, 255, 240, 0.96),
    0 0 24px rgba(255, 232, 176, 0.88),
    0 0 48px rgba(255, 245, 221, 0.46);
}

.shf-impact-node:hover .shf-impact-node-pulse {
  opacity: 1;
  animation: shfImpactPulse 1.7s ease-out infinite;
}

.shf-impact-node--sm .shf-impact-node-core { width: 9px; height: 9px; }
.shf-impact-node--md .shf-impact-node-core { width: 13px; height: 13px; }
.shf-impact-node--lg .shf-impact-node-core { width: 19px; height: 19px; }

.shf-impact-map-tooltip {
  position: absolute;
  left: 20%;
  top: 68%;
  transform: translate(-50%, -50%);
  background: rgba(255, 251, 247, 0.97);
  border: 1px solid rgba(194, 163, 136, 0.42);
  padding: 16px 18px;
  border-radius: 18px;
  box-shadow:
    0 12px 34px rgba(79, 53, 40, 0.12),
    0 3px 10px rgba(79, 53, 40, 0.05);
  font-size: 13px;
  line-height: 1.62;
  color: #4f3528;
  z-index: 6;
  min-width: 240px;
}

.shf-impact-map-tooltip strong {
  display: block;
  margin-bottom: 8px;
  font-size: 18px;
  color: #2f2118;
}

@keyframes shfImpactPulse {
  0% {
    transform: scale(0.48);
    opacity: 0.72;
  }
  68% {
    transform: scale(1.58);
    opacity: 0;
  }
  100% {
    transform: scale(1.58);
    opacity: 0;
  }
}

@media (max-width: 980px) {
  .shf-impact-map-frame {
    left: -2%;
    top: -4%;
    width: 104%;
    height: 108%;
  }

  .shf-impact-map-base {
    transform: scale(1.12);
  }

  .shf-impact-map-tooltip {
    left: 18px;
    top: auto;
    bottom: 18px;
    transform: none;
    min-width: 210px;
  }
}
