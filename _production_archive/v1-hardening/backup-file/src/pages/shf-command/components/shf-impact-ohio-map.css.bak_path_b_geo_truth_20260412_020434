.shf-impact-map-root {
  position: relative;
  min-height: 520px;
  border-radius: 26px;
  overflow: hidden;
  background:
    linear-gradient(180deg, rgba(248,243,236,0.94) 0%, rgba(240,234,226,0.98) 100%);
}

.shf-impact-map-grid {
  position: absolute;
  inset: 0;
  background-image:
    linear-gradient(rgba(122, 96, 70, 0.05) 1px, transparent 1px),
    linear-gradient(90deg, rgba(122, 96, 70, 0.05) 1px, transparent 1px);
  background-size: 44px 44px;
  pointer-events: none;
  z-index: 0;
}

.shf-impact-map-toolbar {
  position: absolute;
  top: 18px;
  right: 18px;
  display: flex;
  gap: 10px;
  z-index: 6;
}

.shf-impact-map-toolbar button {
  border: 1px solid rgba(164, 137, 108, 0.18);
  background: rgba(255,255,255,0.78);
  color: #7a6249;
  border-radius: 999px;
  padding: 10px 16px;
  font: inherit;
}

.shf-impact-map-toolbar .is-active {
  background: rgba(223, 179, 116, 0.18);
  color: #6b4a2e;
}

.shf-impact-map-stage {
  position: relative;
  height: 470px;
  padding: 26px 18px 18px;
  z-index: 1;
}

.shf-impact-map-surface {
  position: absolute;
  inset: 28px 18px 18px;
  transform:
    translate(var(--map-tx, 0%), var(--map-ty, 0%))
    scale(var(--map-scale, 1));
  transform-origin: 50% 50%;
  transition: transform 700ms cubic-bezier(.22,1,.36,1);
}

.shf-impact-map-board-art {
  position: absolute;
  inset: 6% 9% 8% 9%;
  width: 82%;
  height: 86%;
  object-fit: contain;
  object-position: center center;
  z-index: 2;
  filter: saturate(0.98) contrast(0.98) brightness(0.96);
  pointer-events: none;
}

.shf-impact-map-geo-slot {
  position: absolute;
  inset: 6% 9% 8% 9%;
  z-index: 3;
  opacity: 0.98;
  mix-blend-mode: normal;
}

.shf-impact-map-geo-slot svg {
  width: 100%;
  height: 100%;
}

.shf-impact-map-geo-slot path,
.shf-impact-map-geo-slot polygon,
.shf-impact-map-geo-slot polyline {
  fill: transparent !important;
  stroke: rgba(255, 248, 238, 0.98) !important;
  stroke-width: 1.35 !important;
  vector-effect: non-scaling-stroke;
  stroke-linejoin: round;
  stroke-linecap: round;
}

.shf-impact-map-stage.is-zoomed::after {
  content: "";
  position: absolute;
  inset: 18px;
  pointer-events: none;
  background:
    radial-gradient(circle at 50% 52%, rgba(255,255,255,0.00) 0%, rgba(255,255,255,0.00) 34%, rgba(88, 60, 35, 0.05) 100%);
  border-radius: 24px;
  z-index: 4;
}

.shf-impact-map-tooltip {
  position: absolute;
  left: 18%;
  bottom: 19%;
  z-index: 5;
  background: rgba(255,255,255,0.94);
  border: 1px solid rgba(170, 137, 103, 0.16);
  border-radius: 22px;
  padding: 18px 18px 16px;
  min-width: 238px;
  box-shadow:
    0 16px 34px rgba(86, 58, 34, 0.08),
    0 2px 0 rgba(255,255,255,0.78) inset;
}

.shf-impact-map-tooltip strong {
  display: block;
  margin-bottom: 10px;
  font-size: 18px;
}

.shf-impact-map-tooltip div {
  line-height: 1.55;
}

/* =========================================================
   SHF MAP — BOARD ART ALIGNMENT TEST
   ========================================================= */
.shf-impact-map-board-art {
  inset: 2% 4% 4% 4% !important;
  width: 92% !important;
  height: 94% !important;
  object-fit: contain !important;
  object-position: center 48% !important;
}

.shf-impact-map-geo-slot {
  inset: 2% 4% 4% 4% !important;
}
