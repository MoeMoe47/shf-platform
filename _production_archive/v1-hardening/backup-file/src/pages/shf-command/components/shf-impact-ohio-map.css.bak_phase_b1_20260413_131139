.shf-impact-map-root {
  position: relative;
  min-height: 520px;
  border-radius: 26px;
  overflow: hidden;
  background: linear-gradient(180deg, rgba(248,243,236,0.94) 0%, rgba(240,234,226,0.98) 100%);
}

.shf-impact-map-grid {
  position: absolute;
  inset: 0;
  background-image:
    linear-gradient(rgba(122, 96, 70, 0.05) 1px, transparent 1px),
    linear-gradient(90deg, rgba(122, 96, 70, 0.05) 1px, transparent 1px);
  background-size: 44px 44px;
  pointer-events: none;
  z-index: 0;
}

.shf-impact-map-toolbar {
  position: absolute;
  top: 18px;
  right: 18px;
  display: flex;
  gap: 10px;
  z-index: 40;
}

.shf-impact-map-toolbar button {
  border: 1px solid rgba(164, 137, 108, 0.18);
  background: rgba(255,255,255,0.82);
  color: #7a6249;
  border-radius: 999px;
  padding: 10px 16px;
  font: inherit;
}

.shf-impact-map-toolbar .is-active {
  background: rgba(224, 179, 109, 0.24);
  color: #6b4a2e;
  box-shadow: 0 0 0 1px rgba(220, 165, 85, 0.10) inset;
}

.shf-impact-map-stage {
  position: relative;
  height: 470px;
  padding: 26px 18px 18px;
  z-index: 1;
}

.shf-impact-map-surface {
  position: absolute;
  inset: 12px 12px 18px;
}

.shf-impact-map-ohio-body-slot,
.shf-impact-map-geo-slot,
.shf-impact-map-focus-halo,
.shf-impact-map-processing-layer {
  position: absolute;
  inset: 1% 1% 10% 1%;
}

.shf-impact-map-ohio-body-slot { z-index: 2; }
.shf-impact-map-geo-slot { z-index: 5; }
.shf-impact-map-focus-halo { z-index: 6; pointer-events: none; }
.shf-impact-map-processing-layer { z-index: 4; pointer-events: none; }

.shf-impact-map-ohio-body-slot svg,
.shf-impact-map-geo-slot svg {
  width: 100%;
  height: 100%;
}

.shf-impact-map-ohio-body-slot path,
.shf-impact-map-ohio-body-slot polygon,
.shf-impact-map-ohio-body-slot polyline {
  fill: rgba(225, 176, 112, 0.34) !important;
  stroke: rgba(134, 94, 59, 0.18) !important;
  stroke-width: 0.9 !important;
}

.shf-impact-map-geo-slot path,
.shf-impact-map-geo-slot polygon,
.shf-impact-map-geo-slot polyline {
  fill: transparent !important;
  stroke: rgba(112, 77, 46, 0.88) !important;
  stroke-width: 2.15 !important;
  vector-effect: non-scaling-stroke;
  stroke-linejoin: round;
  stroke-linecap: round;
}

.shf-processing-beacon {
  position: absolute;
  width: 64px;
  height: 64px;
  margin-left: -32px;
  margin-top: -32px;
  border-radius: 999px;
  background:
    radial-gradient(circle, rgba(232, 182, 96, 0.34) 0%, rgba(232, 182, 96, 0.18) 34%, rgba(232, 182, 96, 0.00) 74%);
  animation: shfCountyPulseGold 1.9s ease-in-out infinite;
}

.shf-processing-beacon::before {
  content: "";
  position: absolute;
  inset: 8px;
  border-radius: 999px;
  box-shadow:
    0 0 0 1px rgba(255, 231, 191, 0.34),
    0 0 16px rgba(215, 156, 78, 0.18);
}

.shf-processing-beacon[data-county="Franklin"] { left: 52%; top: 56%; }
.shf-processing-beacon[data-county="Cuyahoga"] { left: 66%; top: 23%; }
.shf-processing-beacon[data-county="Hamilton"] { left: 35%; top: 78%; }

@keyframes shfCountyPulseGold {
  0%, 100% { transform: scale(0.94); opacity: 0.78; }
  50% { transform: scale(1.18); opacity: 1; }
}

.shf-impact-map-tooltip {
  position: absolute;
  left: 18%;
  bottom: 22%;
  z-index: 30;
  background: rgba(255,255,255,0.94);
  border: 1px solid rgba(170, 137, 103, 0.16);
  border-radius: 22px;
  padding: 18px 18px 16px;
  min-width: 238px;
  box-shadow: 0 16px 34px rgba(86, 58, 34, 0.08), 0 2px 0 rgba(255,255,255,0.78) inset;
  opacity: 0;
  pointer-events: none;
  transform: translateY(8px) scale(0.985);
  transition: opacity 180ms ease, transform 220ms ease;
}

.shf-impact-map-tooltip.is-visible {
  opacity: 1;
  transform: translateY(0) scale(1);
}

.shf-impact-map-tooltip strong,
.shf-regional-detail-panel strong {
  display: block;
  margin-bottom: 10px;
  font-size: 18px;
}

.shf-impact-map-tooltip div,
.shf-regional-detail-panel div {
  line-height: 1.55;
}

/* ===== REAL REGIONAL COUNTY-SHAPE VIEW ===== */
.shf-regional-cluster-surface {
  position: absolute;
  inset: 18px 16px 16px;
  border-radius: 26px;
  overflow: hidden;
  z-index: 10;
  background:
    linear-gradient(180deg, rgba(244,236,224,0.96) 0%, rgba(234,225,214,0.98) 100%);
}

.shf-regional-cluster-surface::before {
  content: "";
  position: absolute;
  inset: 0;
  background-image:
    linear-gradient(rgba(122, 96, 70, 0.05) 1px, transparent 1px),
    linear-gradient(90deg, rgba(122, 96, 70, 0.05) 1px, transparent 1px);
  background-size: 44px 44px;
  opacity: 0.9;
}

.shf-regional-cluster-svg {
  position: absolute;
  inset: 0;
  width: 100%;
  height: 100%;
}

.shf-regional-county {
  cursor: pointer;
  transition: opacity 180ms ease, filter 220ms ease, stroke 220ms ease, fill 220ms ease;
}

.shf-regional-county--context {
  fill: rgba(224, 179, 109, 0.18);
  stroke: rgba(112, 77, 46, 0.82);
  stroke-width: 2.8;
}

.shf-regional-county--context.is-hovered {
  fill: rgba(224, 179, 109, 0.30);
  stroke: rgba(98, 66, 39, 0.92);
}

.shf-regional-county--selected {
  stroke: rgba(137, 88, 44, 0.98);
  stroke-width: 3.4;
}

.shf-regional-cluster-loading {
  position: absolute;
  inset: 0;
  display: grid;
  place-items: center;
  color: #7a6249;
  z-index: 10;
}

.shf-regional-detail-panel {
  position: absolute;
  right: 18px;
  bottom: 18px;
  z-index: 35;
  min-width: 250px;
  background: rgba(255,255,255,0.94);
  border: 1px solid rgba(170, 137, 103, 0.16);
  border-radius: 22px;
  padding: 18px 18px 16px;
  box-shadow:
    0 18px 38px rgba(86, 58, 34, 0.12),
    0 2px 0 rgba(255,255,255,0.78) inset;
}

/* =========================================================
   SHF MAP — VANISHING SYSTEM STATUS LAYER
   ========================================================= */
.shf-system-status {
  position: absolute;
  top: 18px;
  left: 18px;
  z-index: 24;
  display: inline-flex;
  align-items: center;
  gap: 10px;
  max-width: min(520px, calc(100% - 180px));
  padding: 10px 14px;
  border-radius: 999px;
  border: 1px solid rgba(166, 133, 97, 0.16);
  background: rgba(255, 251, 245, 0.72);
  backdrop-filter: blur(10px);
  box-shadow:
    0 6px 18px rgba(80, 56, 34, 0.06),
    0 1px 0 rgba(255,255,255,0.66) inset;
  opacity: 0;
  transform: translateY(-6px);
  pointer-events: none;
  transition:
    opacity 220ms ease,
    transform 260ms ease;
}

.shf-system-status.is-visible {
  opacity: 1;
  transform: translateY(0);
}

.shf-system-status__dot {
  width: 8px;
  height: 8px;
  border-radius: 999px;
  flex: 0 0 auto;
  background: rgba(207, 148, 72, 0.95);
  box-shadow: 0 0 0 4px rgba(230, 183, 109, 0.14);
}

.shf-system-status__text {
  font-size: 12px;
  line-height: 1.2;
  letter-spacing: 0.01em;
  color: rgba(99, 69, 43, 0.88);
  white-space: nowrap;
  overflow: hidden;
  text-overflow: ellipsis;
}

@media (max-width: 900px) {
  .shf-system-status {
    max-width: calc(100% - 36px);
    top: 14px;
    left: 14px;
    padding: 9px 12px;
  }

  .shf-system-status__text {
    font-size: 11px;
  }
}
