.shf-impact-map {
  position: relative;
  width: 100%;
  height: 560px;
  overflow: hidden;
  border-radius: 18px;
}

/* TEXTURE */
.shf-map-texture {
  position: absolute;
  inset: 0;
  width: 100%;
  height: 100%;
  object-fit: contain;

  transform: scale(1.35);
  transform-origin: center;

  z-index: 1;
}

/* COUNTY LINES */
.shf-map-counties {
  position: absolute;
  inset: 0;
  width: 100%;
  height: 100%;
  object-fit: contain;

  transform: scale(1.35);
  transform-origin: center;

  z-index: 2;
  pointer-events: none;
}

/* NODES */
.shf-map-nodes {
  position: absolute;
  inset: 0;
  z-index: 3;
}

.shf-node {
  position: absolute;
  transform: translate(-50%, -50%);
  width: 14px;
  height: 14px;
  border-radius: 50%;

  background: radial-gradient(circle, #fff7d6, #f5b041);
  box-shadow: 0 0 12px rgba(255, 200, 100, 0.8);
}

/* TOOLTIP */
.shf-tooltip {
  position: absolute;
  bottom: 20%;
  left: 25%;
  background: white;
  padding: 12px;
  border-radius: 10px;
  box-shadow: 0 10px 30px rgba(0,0,0,0.15);
  z-index: 10;
}



/* =========================
   SHF STATE > COUNTIES LOCK
========================= */

/* make the actual Ohio texture/state slightly larger */
.shf-impact-map-base,
.shf-map-texture {
  transform: scale(1.46) translate(2%, -5%);
  transform-origin: center;
}

/* keep county lines slightly smaller so they sit inside the state */
.shf-map-counties {
  transform: scale(1.36) translate(2%, -5%);
  transform-origin: center;
  filter:
    brightness(0) invert(1) brightness(0.92) opacity(0.58)
    drop-shadow(0 0 2px rgba(255,255,255,0.08));
}

/* if the old frame system is still active, enlarge it too */
.shf-impact-map-frame {
  left: 10%;
  top: 2%;
  width: 78%;
  height: 94%;
}

\n\n
/* =========================
   REAL COUNTY GEOMETRY OVERLAY
========================= */

.shf-real-county-overlay {
  position: absolute;
  inset: 0;
  z-index: 2;
  pointer-events: none;

  /* keep aligned with SHF map framing */
  transform: scale(1.36) translate(2%, -5%);
  transform-origin: center;
}

.shf-real-county-overlay svg {
  width: 100%;
  height: 100%;
  display: block;
  overflow: visible;
}

/* strip fills, keep clean county lines only */
.shf-real-county-overlay svg path,
.shf-real-county-overlay svg polygon,
.shf-real-county-overlay svg polyline,
.shf-real-county-overlay svg line,
.shf-real-county-overlay svg rect {
  fill: transparent !important;
  stroke: rgba(255,255,255,0.82) !important;
  stroke-width: 1.4px !important;
  vector-effect: non-scaling-stroke;
}

/* if the imported SVG uses fill on grouped regions */
.shf-real-county-overlay svg [fill]:not([fill="none"]) {
  fill: transparent !important;
}

/* if the imported SVG has a heavy state outline, soften it */
.shf-real-county-overlay svg [stroke] {
  filter: drop-shadow(0 0 1px rgba(255,255,255,0.05));
}
