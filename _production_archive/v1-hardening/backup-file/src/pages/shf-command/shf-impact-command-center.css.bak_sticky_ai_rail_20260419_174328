/* =========================================================
   BRANDED FLYWHEEL
   ========================================================= */

.shf-wheel-card--branded {
  padding: 0 6px 2px;
  display: flex;
  justify-content: center;
  align-items: flex-start;
  min-height: 470px;
}

.shf-branded-flywheel {
  position: relative;
  display: block;
  width: 100%;
  max-width: 410px;
  margin: -10px auto 0;
  border: 0;
  padding: 0;
  background: transparent;
  cursor: pointer;
}

.shf-branded-flywheel__image {
  display: block;
  width: 100%;
  height: auto;
  margin: 0 auto;
  border-radius: 20px;
}

.shf-branded-flywheel__overlay {
  position: absolute;
  inset: 0;
  pointer-events: none;
}

.shf-flywheel-hotspot {
  position: absolute;
  border-radius: 999px;
  opacity: 0;
  transform: scale(0.92);
  transition: opacity 240ms ease, transform 280ms ease;
  box-shadow:
    0 0 0 1px rgba(255, 193, 108, 0.18),
    0 0 18px rgba(243, 145, 44, 0.18),
    0 0 42px rgba(243, 145, 44, 0.14);
}

.shf-flywheel-hotspot.is-active {
  opacity: 1;
  transform: scale(1);
  animation: shfFlywheelPulse 2.2s ease-in-out infinite;
}

@keyframes shfFlywheelPulse {
  0%, 100% {
    box-shadow:
      0 0 0 1px rgba(255, 193, 108, 0.22),
      0 0 18px rgba(243, 145, 44, 0.22),
      0 0 42px rgba(243, 145, 44, 0.16);
    filter: saturate(1);
  }
  50% {
    box-shadow:
      0 0 0 2px rgba(255, 215, 140, 0.34),
      0 0 26px rgba(247, 153, 54, 0.34),
      0 0 60px rgba(247, 153, 54, 0.24);
    filter: saturate(1.08);
  }
}

.shf-flywheel-hotspot--verification {
  left: 39%;
