  font-size: 12px;
  letter-spacing: 0.1em;
  text-transform: uppercase;
  color: var(--shf-text-faint);
}

/* FEATURED COMMAND CARD */

.shf-command-card {
  display: block;
  width: calc(100% - 28px);
  margin: 0 14px 14px;
  padding: 14px 14px 14px;
  text-align: left;
  border-radius: 14px;
  border: 1px solid rgba(218, 111, 45, 0.28);
  background:
    linear-gradient(180deg, rgba(255,255,255,0.76), rgba(255,245,236,0.94)),
    radial-gradient(circle at top right, rgba(240,138,57,0.12), transparent 34%);
  box-shadow:
    0 1px 0 rgba(255,255,255,0.65) inset,
    0 10px 24px rgba(171, 97, 39, 0.10);
  cursor: pointer;
  transition: transform 0.16s ease, box-shadow 0.16s ease, border-color 0.16s ease;
}

.shf-command-card:hover {
  transform: translateY(-2px);
  border-color: rgba(218, 111, 45, 0.5);
  box-shadow:
    0 1px 0 rgba(255,255,255,0.75) inset,
    0 14px 30px rgba(171, 97, 39, 0.16);
}

.shf-command-card--high {
  position: relative;
  overflow: hidden;
}

.shf-command-card--high::after {
  content: "";
  position: absolute;
  inset: 0;
  pointer-events: none;
  background:
    radial-gradient(circle at 18% 50%, rgba(255,138,44,0.12), transparent 32%);
}

.shf-command-card__topline {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 10px;
  margin-bottom: 10px;
}

.shf-command-chip {
  display: inline-flex;
  align-items: center;
  padding: 5px 8px;
  border-radius: 999px;
  font-size: 10px;
  font-weight: 700;
  letter-spacing: 0.1em;
  color: #fffaf2;
  background: linear-gradient(180deg, #d97831, #c45f1f);
}

.shf-command-urgency {
  font-size: 10px;
  font-weight: 700;
  letter-spacing: 0.1em;
  color: #b55229;
}

.shf-command-card__title {
  font-size: 17px;
  line-height: 1.35;
  font-weight: 600;
  color: var(--shf-text);
  margin-bottom: 12px;
}

.shf-command-card__meta {
  display: grid;
  grid-template-columns: repeat(2, minmax(0, 1fr));
  gap: 10px;
  margin-bottom: 12px;
}

.shf-command-metric {
  padding: 10px 10px 8px;
  border-radius: 10px;
  border: 1px solid rgba(165, 139, 114, 0.16);
  background: rgba(255,255,255,0.52);
}

.shf-command-metric span {
  display: block;
  font-size: 11px;
  color: var(--shf-text-faint);
  margin-bottom: 4px;
}

.shf-command-metric strong {
  font-size: 20px;
  font-weight: 700;
  color: var(--shf-text);
}

.shf-command-card__outcome {
  font-size: 12px;
  font-weight: 600;
  color: #b86b35;
  letter-spacing: 0.03em;
}

/* SUPPORTING ACTIONS */

.shf-action-list--supporting {
