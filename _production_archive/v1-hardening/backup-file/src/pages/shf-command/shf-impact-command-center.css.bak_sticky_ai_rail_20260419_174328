:root {
  --shf-bg: #f5f0ea;
  --shf-bg-2: #efe8df;
  --shf-panel: rgba(255, 252, 248, 0.82);
  --shf-panel-solid: #f8f2eb;
  --shf-border: rgba(165, 139, 114, 0.18);
  --shf-border-strong: rgba(145, 118, 92, 0.28);
  --shf-text: #2f2621;
  --shf-text-soft: #79685a;
  --shf-text-faint: #a69484;
  --shf-orange: #da6f2d;
  --shf-orange-2: #f08a39;
  --shf-orange-3: #e7b37d;
  --shf-cream: #efe3d4;
  --shf-shadow:
    0 1px 0 rgba(255,255,255,0.6) inset,
    0 10px 24px rgba(113, 85, 57, 0.06);
  --shf-radius: 18px;
  --shf-radius-sm: 12px;
  --shf-font-serif: "Iowan Old Style", "Palatino Linotype", "Book Antiqua", Georgia, serif;
  --shf-font-sans: Inter, ui-sans-serif, system-ui, -apple-system, BlinkMacSystemFont, "Segoe UI", sans-serif;
}

* {
  box-sizing: border-box;
}

body {
  background:
    radial-gradient(circle at top, rgba(255,255,255,0.7), transparent 35%),
    linear-gradient(180deg, #f6f1eb 0%, #efe7de 100%);
}

.shf-page {
  min-height: 100vh;
  padding: 28px;
  color: var(--shf-text);
  font-family: var(--shf-font-sans);
  background:
    linear-gradient(180deg, rgba(255,255,255,0.45), rgba(255,255,255,0.12)),
    repeating-linear-gradient(
      180deg,
      rgba(255,255,255,0.04),
      rgba(255,255,255,0.04) 2px,
      rgba(0,0,0,0.008) 2px,
      rgba(0,0,0,0.008) 3px
    ),
    var(--shf-bg);
}

.shf-shell {
  width: min(1440px, 100%);
  margin: 0 auto;
  border: 1px solid var(--shf-border);
  border-radius: 0;
  overflow: hidden;
  background: rgba(255, 250, 245, 0.55);
  box-shadow: 0 18px 40px rgba(77, 58, 40, 0.08);
  backdrop-filter: blur(10px);
}

.shf-topbar {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 18px;
  padding: 20px 24px;
  border-bottom: 1px solid var(--shf-border);
  background: rgba(255,255,255,0.18);
}

.shf-brand {
  display: flex;
  align-items: center;
  gap: 14px;
  min-width: 0;
}

.shf-brand__mark {
  position: relative;
  width: 18px;
  height: 28px;
  flex: 0 0 auto;
}

.shf-brand__mark-top,
.shf-brand__mark-bottom {
  position: absolute;
  left: 50%;
  transform: translateX(-50%);
  clip-path: polygon(50% 0%, 100% 100%, 0% 100%);
}

.shf-brand__mark-top {
  top: 0;
  width: 14px;
  height: 16px;
  background: linear-gradient(180deg, #b2a192, #d9cbbd);
}

.shf-brand__mark-bottom {
  bottom: 0;
  width: 16px;
  height: 12px;
  background: linear-gradient(180deg, #ef7f35, #c95c20);
}

.shf-brand__text,
.shf-brand h1 {
  white-space: nowrap;
}

.shf-brand__text {
  font-family: var(--shf-font-serif);
  font-size: 24px;
  letter-spacing: -0.02em;
}

.shf-brand__divider {
  width: 1px;
  height: 30px;
  background: var(--shf-border-strong);
}

.shf-brand h1 {
  margin: 0;
  font-family: var(--shf-font-serif);
  font-size: 24px;
  font-weight: 500;
  letter-spacing: -0.02em;
}

.shf-topbar__controls {
  display: flex;
  align-items: center;
  gap: 14px;
}

.shf-select,
.shf-export-btn,
.shf-mini-filter,
.shf-icon-btn {
  border: 1px solid var(--shf-border-strong);
  background: rgba(255,255,255,0.42);
  color: var(--shf-text);
  border-radius: 10px;
  font-family: var(--shf-font-sans);
}

.shf-select {
  min-width: 180px;
  height: 38px;
  padding: 0 14px;
  font-size: 14px;
}

.shf-export-btn {
  height: 42px;
  padding: 0 18px;
  font-size: 14px;
  font-weight: 600;
  background: linear-gradient(180deg, #78856c, #6a775f);
  color: #fff8ee;
  box-shadow: 0 8px 18px rgba(76, 92, 64, 0.22);
}

.shf-kpi-row {
  display: grid;
  grid-template-columns: repeat(6, minmax(0, 1fr));
  gap: 14px;
  padding: 18px 28px;
  border-bottom: 1px solid var(--shf-border);
}

.shf-kpi-card {
  position: relative;
  overflow: hidden;
  text-align: left;
  border: 1px solid var(--shf-border);
  border-radius: 14px;
  background: rgba(255,255,255,0.36);
  box-shadow: var(--shf-shadow);
  padding: 16px 18px 14px;
  cursor: pointer;
  min-height: 112px;
}

.shf-kpi-card:hover {
  transform: translateY(-1px);
  border-color: rgba(218, 111, 45, 0.28);
}

.shf-kpi-card__label {
  font-size: 16px;
  color: var(--shf-text);
  margin-bottom: 10px;
}

.shf-kpi-card__value-row {
  display: flex;
  align-items: baseline;
  gap: 10px;
}

.shf-kpi-card__value-row strong {
  font-size: 28px;
  font-weight: 500;
  letter-spacing: -0.03em;
}

.shf-kpi-card__value-row span {
  color: #b26e3c;
  font-size: 16px;
}

.shf-kpi-card__sub {
  margin-top: 6px;
  font-size: 12px;
  color: var(--shf-text-faint);
}

.shf-kpi-card__ghost {
  position: absolute;
  right: 8px;
  bottom: 10px;
  width: 82px;
  height: 42px;
  opacity: 0.23;
  background:
    linear-gradient(180deg, rgba(236, 223, 210, 0.2), rgba(201, 169, 139, 0.42)),
    linear-gradient(90deg, transparent 0 8%, rgba(255,255,255,0.65) 8% 14%, transparent 14% 22%, rgba(255,255,255,0.45) 22% 32%, transparent 32% 100%);
  clip-path: polygon(0 100%, 0 82%, 12% 82%, 12% 58%, 30% 58%, 30% 38%, 48% 38%, 48% 18%, 68% 18%, 68% 0, 100% 0, 100% 100%);
}

.shf-main-grid {
  display: grid;
  grid-template-columns: minmax(0, 1.58fr) minmax(260px, 0.92fr) minmax(340px, 0.46fr);
  gap: 16px;
  align-items: start;
}

.shf-left-col,
.shf-middle-col,
.shf-right-col {
  min-width: 0;
  display: flex;
  flex-direction: column;
  gap: 14px;
}

.shf-right-col {
  min-width: 340px;
}

.shf-panel {
  border: 1px solid var(--shf-border);
  border-radius: 14px;
  background: rgba(255,255,255,0.34);
  box-shadow: var(--shf-shadow);
  overflow: hidden;
}

.shf-panel__header {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 10px;
  padding: 16px 18px 10px;
}

.shf-panel__header h2 {
  margin: 0;
  font-family: var(--shf-font-serif);
  font-size: 25px;
  font-weight: 500;
  letter-spacing: -0.02em;
}

.shf-panel__small-label {
  font-size: 12px;
  color: var(--shf-text-faint);
}

.shf-mini-filter {
  height: 30px;
  padding: 0 12px;
  font-size: 12px;
  color: var(--shf-text-soft);
  background: rgba(255,255,255,0.3);
}

.shf-map-stage {
  position: relative;
  padding: 0 12px 12px;
}

.shf-map-toolbar {
  position: absolute;
  left: 24px;
  top: 62px;
  z-index: 3;
  display: flex;
  flex-direction: column;
  overflow: hidden;
  border: 1px solid var(--shf-border-strong);
  border-radius: 10px;
  background: rgba(255,255,255,0.65);
}

.shf-map-toolbar button {
  width: 34px;
  height: 34px;
  border: 0;
  background: transparent;
  font-size: 22px;
  color: var(--shf-text-soft);
}

.shf-map-canvas {
  position: relative;
  height: 390px;
  border: 1px solid rgba(173, 153, 130, 0.16);
  background:
    radial-gradient(circle at 55% 44%, rgba(219, 177, 135, 0.12), transparent 18%),
    radial-gradient(circle at 30% 68%, rgba(196, 171, 145, 0.08), transparent 20%),
    linear-gradient(180deg, rgba(255,255,255,0.22), rgba(236,229,221,0.44)),
    repeating-linear-gradient(
      90deg,
      rgba(255,255,255,0.03),
      rgba(255,255,255,0.03) 32px,
      rgba(147, 124, 101, 0.03) 32px,
      rgba(147, 124, 101, 0.03) 33px
    );
  border-radius: 0 0 14px 14px;
  overflow: hidden;
}

.shf-map-canvas::before,
.shf-map-canvas::after {
  content: "";
  position: absolute;
  inset: 0;
  pointer-events: none;
}

.shf-map-canvas::before {
  background:
    radial-gradient(circle at 18% 24%, rgba(145, 118, 92, 0.12) 0 1px, transparent 1px 100%),
    radial-gradient(circle at 30% 15%, rgba(145, 118, 92, 0.12) 0 1px, transparent 1px 100%),
    radial-gradient(circle at 48% 20%, rgba(145, 118, 92, 0.12) 0 1px, transparent 1px 100%),
    radial-gradient(circle at 72% 24%, rgba(145, 118, 92, 0.12) 0 1px, transparent 1px 100%),
    radial-gradient(circle at 88% 52%, rgba(145, 118, 92, 0.12) 0 1px, transparent 1px 100%);
}

.shf-map-canvas::after {
  background:
    linear-gradient(90deg, transparent 0 18%, rgba(125, 106, 89, 0.08) 18% 18.2%, transparent 18.2% 100%),
    linear-gradient(180deg, transparent 0 72%, rgba(125, 106, 89, 0.08) 72% 72.2%, transparent 72.2% 100%);
  mix-blend-mode: multiply;
}

.shf-map-state {
  position: absolute;
  inset: 0;
}

.shf-map-state__lake {
  position: absolute;
  left: 34%;
  top: 0;
  width: 45%;
  height: 22%;
  background: rgba(170, 165, 163, 0.22);
  clip-path: polygon(0 100%, 8% 70%, 28% 56%, 62% 42%, 100% 20%, 100% 0, 0 0);
}

.shf-county {
  position: absolute;
  width: 18px;
  height: 18px;
  margin: -9px 0 0 -9px;
  border: 0;
  padding: 0;
  background: transparent;
}

.shf-county__dot {
  display: block;
  width: 18px;
  height: 18px;
  border-radius: 999px;
  border: 2px solid rgba(255,255,255,0.82);
  box-shadow: 0 0 0 6px rgba(255,255,255,0.18);
}

.shf-county--high .shf-county__dot {
  background: linear-gradient(180deg, #f18a38, #c96127);
}

.shf-county--mid .shf-county__dot {
  background: linear-gradient(180deg, #e4b57f, #d18a49);
}

.shf-county--low .shf-county__dot {
  background: linear-gradient(180deg, #e8d6c2, #cfb292);
}

.shf-county.is-selected .shf-county__dot {
  box-shadow:
    0 0 0 6px rgba(236, 161, 100, 0.16),
    0 0 28px rgba(215, 105, 40, 0.35);
}

.shf-map-card {
  position: absolute;
  left: 27%;
  top: 25%;
  z-index: 2;
  width: 200px;
  border: 1px solid var(--shf-border-strong);
  border-radius: 16px;
  padding: 14px 14px 12px;
  background: rgba(253, 248, 241, 0.82);
  box-shadow: 0 16px 32px rgba(84, 61, 41, 0.12);
  backdrop-filter: blur(8px);
}

.shf-map-card__title-row {
  display: flex;
  justify-content: space-between;
  gap: 8px;
  margin-bottom: 10px;
}

.shf-map-card__title-row strong {
  font-size: 16px;
}

.shf-map-card__grid {
  display: grid;
  grid-template-columns: 1fr auto;
  gap: 8px 12px;
}

.shf-map-card__grid span {
  font-size: 12px;
  color: var(--shf-text-soft);
}

.shf-map-card__grid strong {
  font-size: 14px;
}

.shf-map-footer {
  display: flex;
  align-items: center;
  justify-content: flex-start;
  padding: 10px 14px 12px;
}

.shf-program-table-panel {
  padding-bottom: 8px;
}

.shf-table-filters {
  display: flex;
  gap: 8px;
}

.shf-program-table {
  display: flex;
  flex-direction: column;
  gap: 1px;
  padding: 0 12px 12px;
}

.shf-program-row {
  display: grid;
  grid-template-columns: minmax(200px, 1.45fr) 120px repeat(4, minmax(80px, 1fr));
  align-items: center;
  gap: 14px;
  text-align: left;
  padding: 16px 12px;
  border: 1px solid rgba(170, 145, 121, 0.12);
  background: rgba(255,255,255,0.18);
  cursor: pointer;
}

.shf-program-row:hover {
  background: rgba(255,255,255,0.34);
  border-color: rgba(218, 111, 45, 0.24);
}

.shf-program-row__name strong {
  display: block;
  font-size: 19px;
  font-weight: 500;
}

.shf-program-row__name span,
.shf-program-row__metric span {
  display: block;
  font-size: 12px;
  color: var(--shf-text-faint);
  margin-top: 4px;
}

.shf-program-row__metric strong {
  font-size: 16px;
  font-weight: 500;
}

.shf-program-row__metric--risk strong {
  color: #b56c37;
}

.shf-status-pill {
  display: inline-flex;
  align-items: center;
  justify-content: center;
  min-height: 30px;
  padding: 0 12px;
  border-radius: 10px;
  font-size: 13px;
  border: 1px solid rgba(214, 162, 110, 0.2);
  background: rgba(241, 212, 181, 0.5);
  color: #89592f;
}

.shf-status-pill--intervene {
  background: linear-gradient(180deg, rgba(237, 170, 114, 0.75), rgba(219, 135, 73, 0.72));
  color: #5b2d12;
}

.shf-status-pill--expanding,
.shf-status-pill--growing,
.shf-status-pill--in-progress {
  background: rgba(241, 224, 203, 0.75);
}

.shf-wheel-card {
  padding: 4px 14px 14px;
}

.shf-wheel {
  width: 100%;
  border: 0;
  background: transparent;
  cursor: pointer;
  padding: 0;
}

.shf-wheel__outer {
  position: relative;
  width: 100%;
  aspect-ratio: 1 / 1;
  max-width: 310px;
  margin: 0 auto;
  border-radius: 50%;
  background:
    radial-gradient(circle at center, rgba(255,255,255,0.92) 0 29%, rgba(232, 214, 196, 0.9) 29% 31%, transparent 31% 32%),
    conic-gradient(
      from -90deg,
      #d66a2d 0 32deg,
      #eb8c37 32deg 64deg,
      #f0a748 64deg 96deg,
      #efd9c6 96deg 128deg,
      #ecd6c0 128deg 160deg,
      #ead4be 160deg 192deg,
      #e3cdb8 192deg 224deg,
      #df9150 224deg 256deg,
      #e28138 256deg 288deg,
      #d1b49a 288deg 320deg,
      #d7c2ae 320deg 360deg
    );
  box-shadow:
    0 0 0 8px rgba(233, 224, 216, 0.72),
    inset 0 0 0 2px rgba(255,255,255,0.82);
}

.shf-wheel__outer::before {
  content: "";
  position: absolute;
  inset: 16px;
  border-radius: 50%;
  background:
    radial-gradient(circle, rgba(255,255,255,0.86) 0 44%, transparent 44%),
    repeating-conic-gradient(
      from -90deg,
      rgba(255,255,255,0.4) 0deg 2deg,
      rgba(0,0,0,0.02) 2deg 30deg
    );
  box-shadow: inset 0 0 0 6px rgba(225, 211, 198, 0.68);
}

.shf-wheel-segment {
  position: absolute;
  left: 50%;
  top: 50%;
  width: 42%;
  height: 18px;
  transform-origin: 0 50%;
  transform: rotate(calc(var(--segment-index) * 32deg - 74deg)) translateX(108px);
  color: #fff7ef;
  font-size: 12px;
  font-weight: 600;
  text-align: center;
}

.shf-wheel-segment span {
  display: inline-block;
  transform: rotate(calc((var(--segment-index) * -32deg) + 74deg));
  color: #fff8f0;
  text-shadow: 0 1px 1px rgba(0,0,0,0.1);
}

.shf-wheel-segment.seg-4 span,
.shf-wheel-segment.seg-5 span,
.shf-wheel-segment.seg-6 span,
.shf-wheel-segment.seg-7 span,
.shf-wheel-segment.seg-10 span,
.shf-wheel-segment.seg-11 span {
  color: #6e5645;
  text-shadow: none;
}

.shf-wheel__center {
  position: absolute;
  inset: 28%;
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  border-radius: 50%;
  background:
    radial-gradient(circle at center, rgba(255,255,255,0.95), rgba(228, 214, 201, 0.95));
  box-shadow: inset 0 0 0 8px rgba(208, 190, 173, 0.58);
  text-align: center;
}

.shf-wheel__center-globe {
  position: absolute;
  inset: 10%;
  border-radius: 50%;
  background:
    radial-gradient(circle at 45% 35%, rgba(255,255,255,0.55), transparent 30%),
    radial-gradient(circle at center, rgba(210, 185, 160, 0.16), transparent 62%),
    radial-gradient(circle at 52% 58%, rgba(182, 155, 129, 0.18), transparent 24%);
  opacity: 0.7;
}

.shf-wheel__center strong {
  position: relative;
  z-index: 1;
  font-family: var(--shf-font-serif);
  font-size: 18px;
  line-height: 1.05;
  max-width: 120px;
}

.shf-wheel__center span {
  position: relative;
  z-index: 1;
  margin-top: 6px;
  font-size: 9px;
  color: var(--shf-text-soft);
  letter-spacing: 0.14em;
}

.shf-trend-block {
  border-top: 1px solid var(--shf-border);
  padding: 14px 18px 16px;
}

.shf-trend-block__header,
.shf-trend-block__value-row {
  display: flex;
  align-items: center;
  justify-content: space-between;
}

.shf-trend-block__header h3 {
  margin: 0;
  font-size: 16px;
  font-weight: 500;
}

.shf-trend-block__header span,
.shf-trend-block__value-row span {
  font-size: 12px;
  color: var(--shf-text-faint);
}

.shf-trend-block__value-row {
  margin-top: 6px;
}

.shf-trend-block__value-row strong {
  font-size: 28px;
  font-weight: 500;
}

.shf-trend-block__value-row span {
  color: #6f8a63;
  font-size: 14px;
}

.shf-trend-svg {
  width: 100%;
  height: 62px;
  margin-top: 4px;
  color: #d87c38;
  opacity: 0.86;
}

.shf-analyst-panel__section-title {
  padding: 6px 18px 8px;
  font-size: 14px;
  font-weight: 600;
  color: var(--shf-text);
}

.shf-action-list {
  list-style: none;
  margin: 0;
  padding: 0 18px 18px;
  display: flex;
  flex-direction: column;
  gap: 14px;
}

.shf-action-list li {
  position: relative;
  padding-left: 16px;
}

.shf-action-list li::before {
  content: "";
  position: absolute;
  left: 0;
  top: 9px;
  width: 7px;
  height: 7px;
  border-radius: 50%;
  background: #d6a36e;
}

.shf-action-list button {
  border: 0;
  background: transparent;
  padding: 0;
  text-align: left;
  color: var(--shf-text);
  line-height: 1.45;
  font-size: 14px;
  cursor: pointer;
}

.shf-bulb {
  font-size: 18px;
}

.shf-trust-list,
.shf-export-list {
  padding: 0 12px 12px;
  display: flex;
  flex-direction: column;
  gap: 8px;
}

.shf-trust-row,
.shf-export-row {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 16px;
  min-height: 48px;
  border: 1px solid rgba(173, 153, 130, 0.16);
  border-radius: 12px;
  background: rgba(255,255,255,0.16);
  padding: 0 14px;
  color: var(--shf-text);
  cursor: pointer;
}

.shf-trust-row strong,
.shf-export-row strong {
  font-weight: 600;
}

.shf-trust-row:hover,
.shf-export-row:hover {
  border-color: rgba(218, 111, 45, 0.24);
  background: rgba(255,255,255,0.3);
}

.shf-drawer-backdrop {
  position: fixed;
  inset: 0;
  z-index: 80;
  background: rgba(35, 26, 20, 0.28);
  display: flex;
  justify-content: flex-end;
}

.shf-drawer {
  width: min(460px, 100%);
  height: 100%;
  background:
    linear-gradient(180deg, rgba(255,255,255,0.88), rgba(245, 236, 226, 0.95)),
    var(--shf-bg);
  border-left: 1px solid var(--shf-border-strong);
  box-shadow: -24px 0 48px rgba(58, 39, 22, 0.16);
  display: flex;
  flex-direction: column;
}

.shf-drawer__header {
  display: flex;
  align-items: flex-start;
  justify-content: space-between;
  gap: 14px;
  padding: 22px 22px 14px;
  border-bottom: 1px solid var(--shf-border);
}

.shf-eyebrow {
  font-size: 12px;
  color: var(--shf-text-faint);
  text-transform: uppercase;
  letter-spacing: 0.14em;
}

.shf-drawer__header h3 {
  margin: 6px 0 0;
  font-family: var(--shf-font-serif);
  font-size: 28px;
  font-weight: 500;
  letter-spacing: -0.02em;
}

.shf-icon-btn {
  width: 38px;
  height: 38px;
  font-size: 16px;
  cursor: pointer;
}

.shf-drawer__body {
  padding: 18px 22px 28px;
  overflow: auto;
  display: flex;
