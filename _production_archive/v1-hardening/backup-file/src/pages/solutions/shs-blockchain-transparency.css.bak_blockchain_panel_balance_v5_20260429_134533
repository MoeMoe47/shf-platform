  font-size: clamp(48px, 4.55vw, 64px) !important;
  line-height: 0.98 !important;
  letter-spacing: -0.065em !important;
  font-weight: 850 !important;
}

.bt-title-line {
  display: block !important;
  white-space: nowrap !important;
}

.bt-title-line em {
