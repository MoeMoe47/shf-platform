@import url("https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700;800;900&display=swap");

:root {
  --bt-bg: #020813;
  --bt-panel: rgba(7, 22, 38, 0.78);
  --bt-panel-2: rgba(9, 29, 49, 0.88);
  --bt-line: rgba(77, 161, 235, 0.28);
  --bt-line-2: rgba(80, 174, 255, 0.42);
  --bt-text: #eef6ff;
  --bt-muted: #b6c4d5;
  --bt-blue: #38aaff;
  --bt-blue-2: #2f82ff;
  --bt-green: #38e3b0;
  --bt-red: #ff6b8a;
}

* {
  box-sizing: border-box;
}

body {
  margin: 0;
}

.bt-page {
  min-height: 100vh;
  color: var(--bt-text);
  font-family: "Inter", system-ui, -apple-system, BlinkMacSystemFont, "Segoe UI", sans-serif;
  background:
    radial-gradient(circle at 78% 8%, rgba(45, 141, 255, 0.16), transparent 32%),
    radial-gradient(circle at 35% 28%, rgba(36, 120, 255, 0.08), transparent 30%),
    linear-gradient(180deg, #020813 0%, #031020 47%, #020813 100%);
  overflow-x: hidden;
}

.bt-page::before {
  content: "";
  position: fixed;
  inset: 0;
  pointer-events: none;
  opacity: 0.22;
  background-image:
    linear-gradient(rgba(68, 154, 255, 0.11) 1px, transparent 1px),
    linear-gradient(90deg, rgba(68, 154, 255, 0.09) 1px, transparent 1px);
  background-size: 42px 42px;
  mask-image: linear-gradient(180deg, black 0%, transparent 65%);
}

.bt-header {
  height: 74px;
  padding: 0 36px;
  display: flex;
  align-items: center;
  justify-content: space-between;
  background: rgba(2, 8, 18, 0.92);
  border-bottom: 1px solid rgba(74, 155, 235, 0.16);
  position: sticky;
  top: 0;
  z-index: 10;
  backdrop-filter: blur(16px);
}

.bt-brand {
  display: flex;
  align-items: center;
  gap: 12px;
  text-decoration: none;
  min-width: 270px;
}

.bt-brand-main {
  font-size: 34px;
  line-height: 1;
  font-weight: 900;
  letter-spacing: -0.08em;
  color: #2fa8ff;
  text-shadow: 0 0 18px rgba(49, 161, 255, 0.28);
}

.bt-brand-divider {
  width: 1px;
  height: 34px;
  background: rgba(230, 242, 255, 0.32);
}

.bt-brand-text {
  display: flex;
  flex-direction: column;
  text-transform: uppercase;
  line-height: 1.03;
  letter-spacing: 0.08em;
  color: #f5f8ff;
}

.bt-brand-text strong,
.bt-brand-text span {
  font-size: 11px;
  font-weight: 800;
}

.bt-nav {
  display: flex;
  align-items: center;
  gap: 34px;
}

.bt-nav a,
.bt-demo {
  color: #e8f1fb;
  text-transform: uppercase;
  font-size: 12px;
  letter-spacing: 0.07em;
  font-weight: 800;
  text-decoration: none;
}

.bt-nav a:hover {
  color: #52bbff;
}

.bt-demo {
  padding: 14px 24px;
  border: 1px solid rgba(64, 169, 255, 0.72);
  border-radius: 4px;
  color: #9ddaff;
  box-shadow: inset 0 0 20px rgba(37, 137, 255, 0.08);
}

.bt-hero {
  position: relative;
  z-index: 1;
  max-width: 1320px;
  margin: 0 auto;
  min-height: 380px;
  padding: 56px 34px 20px;
  display: grid;
  grid-template-columns: 0.92fr 1.08fr;
  gap: 30px;
  align-items: center;
}

.bt-eyebrow {
  margin: 0 0 24px;
  color: #39b6ff;
  text-transform: uppercase;
  font-size: 14px;
  font-weight: 800;
  letter-spacing: 0.08em;
}

.bt-hero h1 {
  margin: 0;
  max-width: 620px;
  font-size: clamp(45px, 4.9vw, 70px);
  line-height: 0.98;
  letter-spacing: -0.06em;
  font-weight: 850;
  color: #f4f8ff;
}

.bt-hero h1 span,
.bt-cta h2 span {
  color: #3aaeff;
  text-shadow: 0 0 20px rgba(57, 174, 255, 0.3);
}

.bt-lead {
  max-width: 490px;
  margin: 26px 0 24px;
  color: #c7d3e0;
  font-size: 16px;
  line-height: 1.48;
  font-weight: 500;
}

.bt-actions,
.bt-cta-actions {
  display: flex;
  gap: 14px;
  flex-wrap: wrap;
}

.bt-primary,
.bt-secondary {
  display: inline-flex;
  align-items: center;
  justify-content: center;
  min-height: 42px;
  padding: 0 24px;
  border-radius: 4px;
  text-decoration: none;
  text-transform: uppercase;
  letter-spacing: 0.07em;
  font-size: 12px;
  font-weight: 800;
}

.bt-primary {
  color: white;
  background: linear-gradient(135deg, #39a8ff, #1a66d8);
  box-shadow: 0 0 30px rgba(48, 152, 255, 0.3);
}

.bt-secondary {
  color: #9edaff;
  border: 1px solid rgba(84, 175, 255, 0.5);
  background: rgba(6, 20, 36, 0.4);
}

.bt-hero-visual {
  position: relative;
  height: 330px;
  overflow: hidden;
}

.bt-grid-glow {
  position: absolute;
  inset: 0;
  background:
    radial-gradient(circle at 52% 46%, rgba(44, 155, 255, 0.22), transparent 34%),
    linear-gradient(90deg, transparent, rgba(45, 138, 255, 0.08), transparent);
}

.bt-network-globe {
  position: absolute;
  right: 32px;
  top: 16px;
  width: 430px;
  height: 260px;
  border-radius: 50%;
  background:
    radial-gradient(circle at 50% 42%, rgba(90, 194, 255, 0.34), transparent 20%),
    radial-gradient(circle at 50% 50%, rgba(23, 87, 165, 0.68), rgba(1, 9, 19, 0.14) 70%);
  border: 1px solid rgba(111, 201, 255, 0.18);
  box-shadow:
    inset 0 0 90px rgba(0, 0, 0, 0.76),
    0 0 80px rgba(44, 149, 255, 0.22);
}

.bt-network-globe::before {
  content: "";
  position: absolute;
  inset: -10%;
  border-radius: inherit;
  background:
    repeating-linear-gradient(72deg, transparent 0 31px, rgba(119, 210, 255, 0.13) 32px 33px),
    repeating-linear-gradient(-8deg, transparent 0 34px, rgba(119, 210, 255, 0.08) 35px 36px);
  transform: rotate(-10deg);
  mask-image: radial-gradient(ellipse at center, black 0 58%, transparent 75%);
}

.bt-orbit {
  position: absolute;
  border-radius: 50%;
  border: 1px solid rgba(86, 184, 255, 0.34);
  border-color: rgba(86, 184, 255, 0.46) transparent transparent transparent;
}

.bt-orbit-a {
  width: 530px;
  height: 220px;
  right: -10px;
  top: 40px;
  transform: rotate(-8deg);
}

.bt-orbit-b {
  width: 580px;
  height: 250px;
  right: -30px;
  top: 88px;
  transform: rotate(17deg);
}

.bt-orbit-c {
  width: 420px;
  height: 190px;
  right: 50px;
  top: 110px;
  transform: rotate(-35deg);
}

.bt-cube {
  position: absolute;
  left: 47%;
  top: 42%;
  width: 110px;
  height: 110px;
  transform: translate(-50%, -50%);
  filter: drop-shadow(0 0 38px rgba(38, 158, 255, 0.64));
}

.bt-cube-face {
  position: absolute;
  display: grid;
  place-items: center;
  border: 1px solid rgba(102, 209, 255, 0.7);
  background: rgba(7, 34, 72, 0.8);
}

.bt-cube-front {
  inset: 18px;
  font-size: 34px;
  color: #84d9ff;
  box-shadow: inset 0 0 34px rgba(43, 163, 255, 0.28);
}

.bt-cube-top {
  left: 18px;
  top: -8px;
  width: 74px;
  height: 28px;
  transform: skewX(-42deg);
}

.bt-cube-side {
  right: -8px;
  top: 18px;
  width: 28px;
  height: 74px;
  transform: skewY(-42deg);
}

.bt-node {
  position: absolute;
  width: 14px;
  height: 14px;
  border-radius: 4px;
  background: rgba(68, 171, 255, 0.95);
  box-shadow: 0 0 18px rgba(68, 171, 255, 0.9);
}

.node-1 { left: 33%; top: 43%; }
.node-2 { left: 41%; top: 64%; }
.node-3 { left: 55%; top: 67%; }
.node-4 { right: 20%; top: 48%; }
.node-5 { right: 30%; top: 28%; }
.node-6 { right: 12%; top: 68%; }

.bt-callout {
  position: absolute;
  display: flex;
  align-items: center;
  gap: 10px;
  color: #eaf6ff;
  font-size: 13px;
  font-weight: 800;
  text-shadow: 0 0 12px rgba(58, 175, 255, 0.24);
}

.bt-callout i {
  width: 54px;
  height: 54px;
  border-radius: 999px;
  display: grid;
  place-items: center;
  border: 1px solid rgba(128, 207, 255, 0.36);
  background: rgba(5, 18, 34, 0.74);
  color: #9bdcff;
  font-style: normal;
  font-size: 22px;
}

.callout-a { left: 14%; top: 24px; }
.callout-b { right: 0; top: 42px; }
.callout-c { left: 14%; bottom: 28px; }
.callout-d { right: 0; bottom: 42px; }

.bt-section,
.bt-dashboard-row,
.bt-lower-row,
.bt-cta,
.bt-footer {
  position: relative;
  z-index: 1;
  max-width: 1320px;
  margin-left: auto;
  margin-right: auto;
}

.bt-section {
  padding: 16px 34px 0;
}

.bt-section-title {
  display: grid;
  grid-template-columns: 1fr auto 1fr;
  gap: 22px;
  align-items: center;
  margin: 8px 0 18px;
}

.bt-section-title span {
  height: 1px;
  background: linear-gradient(90deg, transparent, rgba(52, 161, 255, 0.6), transparent);
}

.bt-section-title h2,
.bt-panel h2 {
  margin: 0;
  color: #42b8ff;
  text-transform: uppercase;
  letter-spacing: 0.06em;
  font-size: 15px;
  font-weight: 850;
}

.bt-card-grid {
  display: grid;
  gap: 18px;
}

.bt-card-grid.five {
  grid-template-columns: repeat(5, 1fr);
}

.bt-info-card,
.bt-panel,
.bt-cta {
  border: 1px solid var(--bt-line);
  background:
    linear-gradient(180deg, rgba(10, 31, 53, 0.8), rgba(4, 14, 26, 0.92));
  border-radius: 8px;
  box-shadow:
    inset 0 1px 0 rgba(255, 255, 255, 0.035),
    0 24px 60px rgba(0, 0, 0, 0.18);
}

.bt-info-card {
  min-height: 184px;
  padding: 24px 20px;
  text-align: center;
}

.bt-icon,
.bt-process-icon,
.bt-cta-icon {
  width: 72px;
  height: 72px;
  margin: 0 auto 18px;
  border-radius: 999px;
  display: grid;
  place-items: center;
  color: #44b6ff;
  font-size: 34px;
  border: 1px solid rgba(78, 179, 255, 0.36);
  background: rgba(5, 19, 35, 0.75);
  box-shadow: 0 0 24px rgba(47, 156, 255, 0.2);
}

.bt-info-card h3,
.bt-process-step h3,
.bt-mini-card h3,
.bt-how-card h3 {
  margin: 0 0 9px;
  font-size: 16px;
  line-height: 1.15;
  letter-spacing: -0.03em;
}

.bt-info-card p,
.bt-process-step p,
.bt-mini-card p,
.bt-how-card p,
.bt-panel p {
  margin: 0;
  color: var(--bt-muted);
  font-size: 13px;
  line-height: 1.45;
  font-weight: 500;
}

.bt-process {
  display: grid;
  grid-template-columns: 1fr 46px 1fr 46px 1fr 46px 1fr 46px 1fr;
  align-items: start;
  gap: 6px;
  padding: 8px 6px 10px;
}

.bt-process-step {
  position: relative;
  text-align: center;
  min-height: 190px;
}

.bt-process-step b,
.bt-how-card b {
  position: absolute;
  top: -4px;
  left: 26px;
  width: 26px;
  height: 26px;
  border-radius: 999px;
  display: grid;
  place-items: center;
  color: white;
  background: linear-gradient(135deg, #53b8ff, #226ad7);
  box-shadow: 0 0 18px rgba(55, 159, 255, 0.35);
  font-size: 13px;
}

.bt-process-icon {
  width: 86px;
  height: 86px;
  font-size: 36px;
}

.bt-arrow {
  color: #47bdff;
  font-size: 44px;
  padding-top: 54px;
  text-align: center;
  text-shadow: 0 0 18px rgba(61, 173, 255, 0.42);
}

.bt-dashboard-row,
.bt-lower-row {
  padding: 10px 34px 0;
  display: grid;
  gap: 22px;
}

.bt-dashboard-row {
  grid-template-columns: 1.05fr 0.95fr;
}

.bt-lower-row {
  grid-template-columns: 0.95fr 1.05fr;
}

.bt-panel {
  padding: 18px;
}

.bt-panel h2 {
  margin-bottom: 16px;
}

.bt-verify-grid {
  display: grid;
  grid-template-columns: repeat(6, 1fr);
  gap: 8px;
}

.bt-mini-card {
  min-height: 170px;
  padding: 16px 12px;
  border: 1px solid rgba(84, 164, 232, 0.25);
  border-radius: 7px;
  background: rgba(5, 17, 31, 0.72);
}

.bt-mini-card i {
  display: grid;
  place-items: center;
  width: 44px;
  height: 44px;
  margin-top: 20px;
  color: #42b7ff;
  border: 1px solid rgba(70, 177, 255, 0.35);
  border-radius: 6px;
  font-style: normal;
  font-size: 26px;
}

.bt-snapshot-grid {
  display: grid;
  grid-template-columns: repeat(3, 1fr);
  border: 1px solid rgba(81, 157, 225, 0.22);
  border-radius: 7px;
  overflow: hidden;
}

.bt-metric {
  padding: 16px;
  background: rgba(4, 15, 28, 0.66);
  border-right: 1px solid rgba(81, 157, 225, 0.2);
}

.bt-metric:last-child {
  border-right: none;
}

.bt-metric span {
  display: block;
  color: #b9c5d3;
  font-size: 12px;
  margin-bottom: 8px;
}

.bt-metric strong {
  display: block;
  font-size: 28px;
  letter-spacing: -0.04em;
  margin-bottom: 3px;
}

.bt-metric small {
  color: var(--bt-green);
  font-weight: 700;
}

.bt-metric em {
  display: block;
  height: 22px;
  margin-top: 10px;
  background:
    linear-gradient(135deg, transparent 0 35%, rgba(70, 190, 255, 0.7) 36% 39%, transparent 40%),
    linear-gradient(45deg, transparent 0 50%, rgba(70, 190, 255, 0.5) 51% 54%, transparent 55%);
  opacity: 0.8;
}

.bt-chart-row {
  margin-top: 16px;
  display: grid;
  grid-template-columns: 1fr 160px;
  gap: 18px;
  align-items: center;
}

.bt-bars {
  height: 82px;
  display: flex;
  align-items: end;
  justify-content: center;
  gap: 10px;
}

.bt-bars span {
  width: 18px;
  border-radius: 4px 4px 0 0;
  background: linear-gradient(180deg, #57bdff, #1d5ed2);
}

.bt-bars span:nth-child(1) { height: 38px; }
.bt-bars span:nth-child(2) { height: 64px; }
.bt-bars span:nth-child(3) { height: 52px; }
.bt-bars span:nth-child(4) { height: 78px; }
.bt-bars span:nth-child(5) { height: 48px; }

.bt-donut {
  width: 104px;
  height: 104px;
  margin: 0 auto;
  border-radius: 999px;
  display: grid;
  place-items: center;
  background:
    radial-gradient(circle, #07182a 0 54%, transparent 55%),
    conic-gradient(#4be5c3 0 79%, #1c5aa2 80% 100%);
  box-shadow: 0 0 28px rgba(72, 230, 200, 0.18);
}

.bt-donut span {
  font-size: 16px;
  font-weight: 850;
}

.bt-snapshot-note {
  text-align: center;
  margin-top: 8px !important;
}

.bt-privacy-grid {
  display: grid;
  grid-template-columns: 1fr 44px 1fr;
  align-items: center;
  gap: 10px;
}

.bt-private,
.bt-public {
  min-height: 150px;
  border: 1px solid rgba(91, 163, 232, 0.18);
  border-radius: 7px;
  padding: 18px;
  background: rgba(4, 14, 26, 0.68);
}

.bt-private h3 {
  color: #ff7b95;
}

.bt-public h3 {
  color: #37e2a7;
}

.bt-private h3,
.bt-public h3 {
  margin: 0 0 10px;
  font-size: 17px;
}

.bt-private ul,
.bt-public ul {
  margin: 0 0 12px;
  padding-left: 18px;
  color: #c5d1df;
  font-size: 13px;
  line-height: 1.5;
}

.bt-private small,
.bt-public small {
  color: #e5eef9;
  font-size: 12px;
  font-weight: 700;
}

.bt-divider-pill {
  width: 34px;
  height: 34px;
  border-radius: 999px;
  display: grid;
  place-items: center;
  color: #56dfff;
  background: rgba(9, 27, 45, 0.95);
  border: 1px solid rgba(90, 198, 255, 0.3);
  font-size: 26px;
}

.bt-how-grid {
  display: grid;
  grid-template-columns: repeat(3, 1fr);
  gap: 14px;
}

.bt-how-card {
  position: relative;
  min-height: 158px;
  padding: 24px 16px 18px;
  text-align: center;
  border: 1px solid rgba(85, 164, 235, 0.24);
  border-radius: 7px;
  background: rgba(5, 17, 31, 0.72);
}

.bt-how-card i {
  display: grid;
  place-items: center;
  color: #48b9ff;
  font-style: normal;
  font-size: 44px;
  margin-bottom: 8px;
}

.bt-how-card b {
  left: 14px;
  top: 12px;
}

.bt-cta {
  margin-top: 20px;
  margin-bottom: 18px;
  padding: 28px 42px;
  min-height: 132px;
  display: grid;
  grid-template-columns: 118px 1fr auto;
  gap: 24px;
  align-items: center;
  background:
    radial-gradient(circle at 82% 60%, rgba(58, 166, 255, 0.18), transparent 33%),
    linear-gradient(180deg, rgba(10, 38, 68, 0.92), rgba(4, 16, 30, 0.96));
}

.bt-cta-icon {
  margin: 0;
  width: 82px;
  height: 82px;
  font-size: 40px;
}

.bt-cta h2 {
  margin: 0 0 8px;
  font-size: 30px;
  letter-spacing: -0.05em;
  line-height: 1.1;
}

.bt-cta p {
  max-width: 680px;
}

.bt-footer {
  padding: 16px 34px 26px;
  display: grid;
  grid-template-columns: 220px 1fr 260px 190px;
  align-items: center;
  gap: 18px;
  border-top: 1px solid rgba(72, 152, 224, 0.16);
}

.bt-footer-brand {
  display: flex;
  align-items: center;
  gap: 12px;
}

.bt-footer-brand strong {
  color: #2fa8ff;
  font-size: 28px;
  letter-spacing: -0.08em;
}

.bt-footer-brand span,
.bt-footer p,
.bt-footer small,
.bt-footer a {
  color: #aebdcb;
  font-size: 11px;
  text-decoration: none;
}

.bt-footer nav {
  display: flex;
  justify-content: flex-end;
  gap: 24px;
}

@media (max-width: 1100px) {
  .bt-nav {
    display: none;
  }

  .bt-hero,
  .bt-dashboard-row,
  .bt-lower-row {
    grid-template-columns: 1fr;
  }

  .bt-card-grid.five {
    grid-template-columns: repeat(2, 1fr);
  }

  .bt-process {
    grid-template-columns: 1fr;
  }

  .bt-arrow {
    display: none;
  }

  .bt-verify-grid {
    grid-template-columns: repeat(2, 1fr);
  }

  .bt-cta {
    grid-template-columns: 1fr;
  }

  .bt-footer {
    grid-template-columns: 1fr;
  }
}

