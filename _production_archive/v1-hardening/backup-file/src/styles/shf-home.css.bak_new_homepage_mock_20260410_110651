:root {
  --shf2-bg: #efe7df;
  --shf2-paper: #f5eee7;
  --shf2-paper-2: #f0e7de;
  --shf2-ink: #4f3022;
  --shf2-ink-soft: #684938;
  --shf2-line: rgba(111, 85, 64, 0.14);
  --shf2-copper: #a85d34;
  --shf2-copper-deep: #8e4a27;
  --shf2-navy: #43586e;
  --shf2-navy-deep: #34475a;
  --shf2-strip: #a5643f;
  --shf2-shell: 1180px;
}

*,
*::before,
*::after {
  box-sizing: border-box;
}

html,
body,
#root {
  margin: 0;
  min-height: 100%;
}

body {
  background: var(--shf2-bg);
  color: var(--shf2-ink);
  font-family: Georgia, "Times New Roman", serif;
}

a {
  color: inherit;
  text-decoration: none;
}

button {
  font: inherit;
}

.shf2-page {
  min-height: 100vh;
  background:
    linear-gradient(rgba(255,255,255,0.10), rgba(255,255,255,0.10)),
    linear-gradient(rgba(111, 85, 64, 0.045) 1px, transparent 1px),
    linear-gradient(90deg, rgba(111, 85, 64, 0.045) 1px, transparent 1px),
    linear-gradient(180deg, #f4ece4 0%, #eee4da 100%);
  background-size: auto, 36px 36px, 36px 36px, auto;
}

.shf2-shell {
  width: min(var(--shf2-shell), calc(100% - 40px));
  margin: 0 auto;
}

.shf2-topbar {
  border-bottom: 1px solid var(--shf2-line);
}

.shf2-topbar__inner {
  min-height: 84px;
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 24px;
}

.shf2-brand img {
  width: 170px;
  display: block;
}

.shf2-nav {
  display: flex;
  align-items: center;
  gap: 30px;
  font-size: 17px;
  color: var(--shf2-ink);
}

.shf2-nav a:not(.shf2-btn) {
  opacity: 0.95;
}

.shf2-btn {
  border: 0;
  border-radius: 4px;
  cursor: pointer;
  padding: 14px 22px;
  color: #fff;
  box-shadow: 0 4px 10px rgba(52, 43, 35, 0.12);
}

.shf2-btn--copper {
  background: linear-gradient(180deg, #b36b3f 0%, var(--shf2-copper-deep) 100%);
}

.shf2-btn--navy {
  background: linear-gradient(180deg, #5a7086 0%, var(--shf2-navy-deep) 100%);
}

.shf2-hero {
  padding: 26px 0 0;
}

.shf2-hero__inner {
  display: grid;
  grid-template-columns: 0.82fr 1.18fr;
  align-items: center;
  gap: 34px;
}

.shf2-hero__copy {
  padding: 10px 0 22px 34px;
}

.shf2-hero__copy h1 {
  margin: 0 0 22px;
  max-width: 520px;
  font-size: clamp(44px, 5vw, 66px);
  line-height: 1.03;
  font-weight: 500;
  letter-spacing: -0.03em;
  color: var(--shf2-ink);
}

.shf2-hero__copy p {
  margin: 0 0 22px;
  max-width: 430px;
  font-size: 19px;
  line-height: 1.6;
  color: var(--shf2-ink-soft);
}

.shf2-hero__actions {
  display: flex;
  gap: 14px;
  flex-wrap: wrap;
}

.shf2-hero__art {
  min-height: 430px;
  position: relative;
}

.shf2-hero__image {
  width: 100%;
  min-height: 430px;
  border-radius: 2px;
  background:
    linear-gradient(
      90deg,
      rgba(239, 231, 223, 0.90) 0%,
      rgba(239, 231, 223, 0.58) 8%,
      rgba(239, 231, 223, 0.18) 18%,
      rgba(239, 231, 223, 0.00) 28%
    ),
    url("/src/assets/brand/catalog-hero-2x1-1920.jpg") center 18% / cover no-repeat;
  box-shadow: inset 0 0 0 1px rgba(111, 85, 64, 0.08);
  background-position: center top;
}

.shf2-kpis {
  margin-top: 14px;
  background: linear-gradient(180deg, #ad6942 0%, #9a5d3a 100%);
  border-top: 1px solid rgba(255,255,255,0.18);
  border-bottom: 1px solid rgba(77, 48, 31, 0.24);
}

.shf2-kpis__inner {
  display: grid;
  grid-template-columns: repeat(3, 1fr);
}

.shf2-kpi {
  min-height: 68px;
  display: flex;
  align-items: center;
  justify-content: center;
  gap: 14px;
  color: #fff7ef;
  border-right: 1px solid rgba(255,255,255,0.2);
}

.shf2-kpi:last-child {
  border-right: 0;
}

.shf2-kpi strong {
  font-size: 27px;
  line-height: 1;
}

.shf2-kpi span {
  font-size: 16px;
  opacity: 0.96;
}

.shf2-section {
  padding: 26px 0 10px;
}

.shf2-headingWrap {
  display: flex;
  align-items: center;
  gap: 18px;
  justify-content: center;
  margin-bottom: 10px;
}

.shf2-headingWrap::before,
.shf2-headingWrap::after {
  content: "";
  height: 1px;
  background: var(--shf2-line);
  flex: 1 1 120px;
  max-width: 210px;
}

.shf2-headingWrap h2 {
  margin: 0;
  font-size: 28px;
  line-height: 1.1;
  font-weight: 500;
  color: var(--shf2-ink);
}

.shf2-mission h3,
.shf2-support h3 {
  margin: 0 0 12px;
  text-align: center;
  font-size: 24px;
  line-height: 1.28;
  font-weight: 500;
  color: var(--shf2-ink);
}

.shf2-centerText {
  max-width: 760px;
  margin: 0 auto;
  text-align: center;
  color: var(--shf2-ink-soft);
  font-size: 18px;
  line-height: 1.65;
}

.shf2-cardGrid {
  margin-top: 20px;
  display: grid;
  grid-template-columns: repeat(3, 1fr);
  gap: 18px;
}

.shf2-card {
  background: rgba(255,255,255,0.36);
  border: 1px solid rgba(111, 85, 64, 0.16);
  border-radius: 4px;
  padding: 16px 16px 14px;
  box-shadow: 0 6px 18px rgba(83, 61, 44, 0.06);
}

.shf2-card h3 {
  margin: 0 0 12px;
  font-size: 17px;
  font-weight: 500;
  color: var(--shf2-ink);
}

.shf2-card__image {
  height: 145px;
  background-size: cover;
  background-position: center;
  border: 1px solid rgba(111, 85, 64, 0.12);
  margin-bottom: 12px;
}

.shf2-card__meta {
  min-height: 42px;
  margin-bottom: 10px;
  color: var(--shf2-ink-soft);
  font-size: 15px;
  line-height: 1.45;
  text-align: center;
}

.shf2-linkBtn {
  width: 100%;
  background: transparent;
  border: 0;
  color: var(--shf2-ink);
  font-size: 17px;
  cursor: pointer;
}

.shf2-information {
  padding-top: 26px;
}

.shf2-information__inner {
  text-align: center;
}

.shf2-information .shf2-btn {
  margin-top: 18px;
}

.shf2-support__inner {
  display: grid;
  grid-template-columns: 0.95fr 1.05fr;
  align-items: end;
  gap: 26px;
}

.shf2-support__actions {
  margin-top: 22px;
  display: flex;
  justify-content: center;
  gap: 14px;
  flex-wrap: wrap;
}

.shf2-support__art {
  min-height: 170px;
  display: flex;
  align-items: end;
}

.shf2-support__image {
  width: 100%;
  height: 170px;
  background:
    linear-gradient(
      90deg,
      rgba(239, 231, 223, 0.96) 0%,
      rgba(239, 231, 223, 0.40) 24%,
      rgba(239, 231, 223, 0.00) 52%
    ),
    url("/src/assets/brand/hero-bg-ohio.png") center center / cover no-repeat;
  border-radius: 2px;
}

.shf2-footer {
  padding: 16px 0 28px;
}

.shf2-footer__inner {
  border-top: 1px solid var(--shf2-line);
  padding-top: 16px;
}

.shf2-footer__row {
  display: flex;
  align-items: center;
  justify-content: center;
  gap: 18px;
  color: var(--shf2-ink-soft);
  font-size: 15px;
}

.shf2-socials {
  display: flex;
  gap: 12px;
}

.shf2-footer__brand img {
  width: 120px;
  display: block;
}

.shf2-footer__email {
  margin-top: 10px;
  text-align: center;
  color: var(--shf2-ink-soft);
  font-size: 14px;
}

@media (max-width: 980px) {
  .shf2-topbar__inner,
  .shf2-nav,
  .shf2-hero__actions,
  .shf2-support__actions,
  .shf2-footer__row {
    flex-wrap: wrap;
  }

  .shf2-hero__inner,
  .shf2-support__inner,
  .shf2-cardGrid,
  .shf2-kpis__inner {
    grid-template-columns: 1fr;
  }

  .shf2-kpi {
    border-right: 0;
    border-bottom: 1px solid rgba(255,255,255,0.2);
  }

  .shf2-kpi:last-child {
    border-bottom: 0;
  }

  .shf2-hero__copy {
    padding: 10px 0 0;
  }
}
