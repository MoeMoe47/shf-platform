.tour-backdrop {
  position: fixed;
  inset: 0;
  background: rgba(5, 10, 18, 0.72);
  backdrop-filter: blur(4px);
  z-index: 9998;
}

.tour-highlight {
  position: fixed;
  z-index: 10000;
  pointer-events: none;
  border-radius: 18px;
  border: 3px solid rgba(255, 181, 92, 0.98);
  box-shadow:
    0 0 0 2px rgba(255, 181, 92, 0.16),
    0 0 24px rgba(255, 158, 64, 0.78),
    0 0 52px rgba(255, 158, 64, 0.42),
    inset 0 0 18px rgba(255, 181, 92, 0.10);
}

.tour-card-wrap {
  position: fixed;
  right: 28px;
  bottom: 28px;
  width: 360px;
  z-index: 10001;
}

.tour-card {
  width: 100%;
  background: rgba(12, 18, 30, 0.97);
  border: 1px solid rgba(255, 181, 92, 0.30);
  border-radius: 18px;
  padding: 16px;
  color: #eef3fb;
  box-shadow: 0 24px 60px rgba(0, 0, 0, 0.38);
}

.tour-header {
  display: flex;
  justify-content: space-between;
  gap: 12px;
  margin-bottom: 10px;
  font-weight: 700;
}

.tour-body p,
.tour-card p {
  margin: 0 0 8px;
  line-height: 1.45;
}

.tour-why {
  opacity: 0.8;
  font-size: 0.92rem;
}

.tour-action {
  color: #ffb76a;
  font-weight: 700;
}

.tour-controls {
  display: flex;
  justify-content: space-between;
  gap: 8px;
  margin-top: 12px;
}

.tour-controls button {
  appearance: none;
  border: 1px solid rgba(255, 181, 92, 0.22);
  background: rgba(255, 255, 255, 0.04);
  color: #eef3fb;
  border-radius: 10px;
  padding: 10px 12px;
  cursor: pointer;
  font-weight: 600;
}

.tour-controls button:hover {
  background: rgba(255, 181, 92, 0.10);
}

.tour-start-btn {
  position: fixed;
  left: 20px;
  bottom: 20px;
  z-index: 10002;
  appearance: none;
  border: 1px solid rgba(255, 181, 92, 0.28);
  background: rgba(15, 23, 42, 0.96);
  color: #f3f6fb;
  border-radius: 14px;
  padding: 10px 14px;
  cursor: pointer;
  font-weight: 700;
  box-shadow: 0 18px 40px rgba(0, 0, 0, 0.24);
}

.tour-start-btn:hover {
  background: rgba(22, 32, 56, 0.98);
}

@media (max-width: 820px) {
  .tour-card-wrap {
    left: 16px;
    right: 16px;
    width: auto;
    bottom: 80px;
  }
}
