                const active = p.id === planetId;
                return (
                  <div key={p.id} style={{ position: "absolute", ...pos }}>
                    <div
                      style={{
                        width: active ? 68 : 58,
                        height: active ? 68 : 58,
                        borderRadius: 999,
                        background: active ? "rgba(90,140,255,0.30)" : "rgba(255,255,255,0.06)",
                        border: "1px solid rgba(255,255,255,0.14)",
                        boxShadow: active ? "0 0 30px rgba(90,140,255,0.25)" : "none",
                        cursor: "pointer",
                      }}
                      onClick={() => setPlanetId(p.id)}
                      title="Click to observe"
                    />
                    <div style={{ marginTop: 8, fontWeight: 800 }}>{p.name}</div>
                    <div style={{ fontSize: 12, opacity: 0.75 }}>{p.biome}</div>
                  </div>
                );
              })}

              {/* Ship indicator */}
              <div style={{ position: "absolute", left: "30%", top: "64%" }}>
                <div style={{ display: "flex", gap: 10, alignItems: "center" }}>
                  <div style={{ width: 12, height: 12, borderRadius: 999, background: "rgba(80,220,140,0.95)" }} />
                  <div style={{ fontWeight: 900 }}>{selectedTeam?.name} Ship</div>
                </div>
                <div style={{ fontSize: 12, opacity: 0.75 }}>Energy: {sim.usableEnergy} • Heat Risk: {Math.round(sim.heatRisk * 100)}%</div>
                <div style={{ fontSize: 12, opacity: 0.85 }}>
                  Status:{" "}
                  <b>{reachedCp ? `Reached: ${reachedCp.name}` : "Not at a checkpoint yet"}</b>
                </div>
              </div>
            </div>
          </div>

          {/* Bottom Panels */}
          <div style={{ display: "grid", gridTemplateColumns: "1fr 1fr", gap: 14 }}>
            {/* Metrics */}
            <div style={{ ...glass, padding: 14 }}>
              <div style={{ fontWeight: 900, fontSize: 14 }}>System Metrics</div>
              <div style={{ marginTop: 10, display: "grid", gap: 8, fontSize: 13 }}>
                <div>Usable Energy: <b>{sim.usableEnergy}</b></div>
                <div>Average Stability: <b>{sim.avgStability}</b></div>
                <div>Heat Risk: <b>{Math.round(sim.heatRisk * 100)}%</b></div>
                <div>Checkpoint: <b>{reachedCp ? reachedCp.name : "None"}</b></div>
              </div>

              <div style={{ marginTop: 12, fontSize: 12, opacity: 0.75 }}>
                Rule: Higher burn rate increases heat risk and reduces usable energy.
              </div>
