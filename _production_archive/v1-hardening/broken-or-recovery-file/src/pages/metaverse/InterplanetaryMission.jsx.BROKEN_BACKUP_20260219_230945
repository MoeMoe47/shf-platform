            <div style={{ marginTop: 6, fontSize: 12, opacity: 0.8 }}>Agent: {selectedTeam?.agent}</div>
          </div>

          <div>
            <div style={{ fontSize: 12, opacity: 0.8, marginBottom: 6 }}>Planet / Resource Zone</div>
            <select value={planetId} onChange={(e) => setPlanetId(e.target.value)} style={{ width: "100%", padding: 10, borderRadius: 12 }}>
              {PLANETS.map(p => (
                <option key={p.id} value={p.id}>{p.name}</option>
              ))}
            </select>
            <div style={{ marginTop: 6, fontSize: 12, opacity: 0.8 }}>
              Biome: {selectedPlanet?.biome} • Risk: {selectedPlanet?.risk}
            </div>
          </div>

          <div style={{ borderTop: "1px solid rgba(255,255,255,0.10)", paddingTop: 12 }}>
            <div style={{ fontWeight: 800, fontSize: 13, marginBottom: 8 }}>Fuel Lab (Theoretical)</div>

            <div style={{ display: "grid", gap: 8 }}>
              {allResources.map(r => (
                <div key={r.id} style={{ display: "grid", gridTemplateColumns: "1fr 90px", gap: 10, alignItems: "center" }}>
                  <div>
                    <div style={{ fontSize: 13, fontWeight: 700 }}>{r.name}</div>
                    <div style={{ fontSize: 12, opacity: 0.8 }}>Energy: {r.energy} • Stability: {r.stability}</div>
                  </div>
                  <input
                    type="number"
                    min={0}
                    value={qty[r.id] ?? 0}
                    onChange={(e) => setQty(prev => ({ ...prev, [r.id]: Number(e.target.value) }))}
                    style={{ width: "100%", padding: 10, borderRadius: 12 }}
                  />
                </div>
              ))}
            </div>

            <div style={{ marginTop: 12 }}>
              <div style={{ fontSize: 12, opacity: 0.8, marginBottom: 6 }}>Burn Rate (1–10)</div>
              <input
                type="range"
                min={1}
                max={10}
                value={burnRate}
                onChange={(e) => setBurnRate(Number(e.target.value))}
                style={{ width: "100%" }}
              />
              <div style={{ fontSize: 12, opacity: 0.85 }}>Burn Rate: <b>{burnRate}</b></div>
            </div>

            <button
              onClick={runSimulation}
              style={{
                marginTop: 12,
                width: "100%",
                padding: "12px 12px",
                borderRadius: 14,
                border: "1px solid rgba(255,255,255,0.18)",
                background: "rgba(90,140,255,0.25)",
                color: "white",
                fontWeight: 800,
                cursor: "pointer",
              }}
            >
              Run Simulation (Observer Log)
