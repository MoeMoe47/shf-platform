                      <div style={{ fontSize: 12, opacity: 0.85, marginTop: 6 }}>
                        Team: <b>{e.payload.team}</b> • Planet: <b>{e.payload.planet}</b> • Result:{" "}
                        <b>{e.payload.status}</b>
                      </div>
                      <div style={{ fontSize: 12, opacity: 0.75, marginTop: 4 }}>
                        Energy: {e.payload.usableEnergy} • Heat: {Math.round(e.payload.heatRisk * 100)}% • Checkpoint: {e.payload.checkpoint}
                      </div>
                    </div>
                  ))
                )}
              </div>
            </div>
          </div>
        </div>
      </div>

      {/* Footer strip */}
      <div style={{ position: "relative", zIndex: 2, padding: "0 16px 16px" }}>
        <div style={{ ...glass, padding: "10px 12px", display: "flex", justifyContent: "space-between", fontSize: 12, opacity: 0.85 }}>
          <div>Mode: Observer • Program: InterplanetaryMission_v1</div>
          <div>Telemetry: In-memory (Watchtower-ready)</div>
        </div>
      </div>
    </div>
  );
}



