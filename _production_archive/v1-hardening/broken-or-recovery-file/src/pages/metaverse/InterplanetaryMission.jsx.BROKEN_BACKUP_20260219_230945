      { id: "ion_gas", name: "Ion Gas", energy: 80, stability: 0.90 },
    ],
  },
  {
    id: "cryos_minor",
    name: "Cryos Minor",
    biome: "Frozen Refinery Moon",
    risk: "Low",
    resources: [{ id: "quantum_ice", name: "Quantum Ice", energy: 150, stability: 0.60 }],
  },
  {
    id: "aether_belt",
    name: "Aether Belt",
    biome: "Asteroid Trade Zone",
    risk: "High",
    resources: [{ id: "dark_crystal", name: "Dark Matter Crystal", energy: 220, stability: 0.45 }],
  },
];

const CHECKPOINTS = [
  { id: "cp1", name: "Escape Orbit", requiredEnergy: 1000 },
  { id: "cp2", name: "Asteroid Belt Crossing", requiredEnergy: 2500 },
  { id: "cp3", name: "Enter Target System", requiredEnergy: 5000 },
];

const TEAMS = [
  { id: "team_alpha", name: "Team Alpha", agent: "Billy Gateson / Flight AI" },
  { id: "team_beta", name: "Team Beta", agent: "Watchtower Scout / Nav AI" },
  { id: "team_gamma", name: "Team Gamma", agent: "LOO Optimizer / Efficiency AI" },
];

function clamp(n, a, b) {
  return Math.max(a, Math.min(b, n));
}

function simulateFuelDesign({ mix, burnRate }) {
  // mix: [{energy, stability, qty}]
  const totalQty = mix.reduce((s, r) => s + r.qty, 0);
  const avgStability = totalQty > 0 ? mix.reduce((s, r) => s + r.stability * r.qty, 0) / totalQty : 0;

  const baseEnergy = mix.reduce((s, r) => s + r.energy * r.qty * r.stability, 0);
  // burnRate 1..10 increases heat risk and reduces usable energy slightly
  const burnPenalty = 1 - (burnRate - 1) * 0.03; // at 10 => 1 - 0.27 = 0.73
  const usableEnergy = Math.round(baseEnergy * clamp(burnPenalty, 0.6, 1.0));

  const heatRisk = clamp((1 - avgStability) * (burnRate / 10), 0, 1); // 0..1

  // Determine checkpoint reached
  let reached = null;
  for (const cp of CHECKPOINTS) {
    if (usableEnergy >= cp.requiredEnergy) reached = cp;
  }

  return {
    usableEnergy,
    avgStability: Number(avgStability.toFixed(2)),
    heatRisk: Number(heatRisk.toFixed(2)),
    checkpointReached: reached ? reached.id : null,
  };
}


// SHF: lightweight parallax (CSS vars only). Respects reduced motion.
function useShfParallaxVars() {
  const raf = useRef(null);
  const target = useRef({ x: 0, y: 0 });
  const cur = useRef({ x: 0, y: 0 });

  useEffect(() => {
    const prefersReduced =
      typeof window !== "undefined" &&
      window.matchMedia &&
      window.matchMedia("(prefers-reduced-motion: reduce)").matches;
    if (prefersReduced) return;

    const onMove = (e) => {
      const x = (e.clientX / window.innerWidth - 0.5) * 2;
      const y = (e.clientY / window.innerHeight - 0.5) * 2;
      target.current.x = x;
      target.current.y = y;
      if (raf.current) return;

      raf.current = requestAnimationFrame(() => {
        raf.current = null;
        cur.current.x += (target.current.x - cur.current.x) * 0.10;
        cur.current.y += (target.current.y - cur.current.y) * 0.10;
        document.documentElement.style.setProperty("--shf-px", cur.current.x.toFixed(4));
        document.documentElement.style.setProperty("--shf-py", cur.current.y.toFixed(4));
      });
    };

    window.addEventListener("mousemove", onMove, { passive: true });
    return () => {
      window.removeEventListener("mousemove", onMove);
      if (raf.current) cancelAnimationFrame(raf.current);
    };
  }, []);
}

export default function InterplanetaryMission() {
  
  useShfParallaxVars();
const [teamId, setTeamId] = useState(TEAMS[0].id);
  const [planetId, setPlanetId] = useState(PLANETS[0].id);
  const [burnRate, setBurnRate] = useState(5);

  // quantities
  const [qty, setQty] = useState(() => ({
    helion_ore: 5,
    ion_gas: 5,
    quantum_ice: 0,
    dark_crystal: 0,
  }));

  const [events, setEvents] = useState(() => []);

  const selectedTeam = useMemo(() => TEAMS.find(t => t.id === teamId), [teamId]);
  const selectedPlanet = useMemo(() => PLANETS.find(p => p.id === planetId), [planetId]);

  const allResources = useMemo(() => {
    const map = new Map();
    for (const p of PLANETS) for (const r of p.resources) map.set(r.id, r);
    return [...map.values()];
  }, []);

  const mix = useMemo(() => {
    return allResources
      .map(r => ({ ...r, qty: Number(qty[r.id] ?? 0) }))
      .filter(r => r.qty > 0);
  }, [allResources, qty]);

  const sim = useMemo(() => simulateFuelDesign({ mix, burnRate }), [mix, burnRate]);

  const reachedCp = useMemo(() => {
    if (!sim.checkpointReached) return null;
    return CHECKPOINTS.find(c => c.id === sim.checkpointReached) || null;
  }, [sim.checkpointReached]);

  function addEvent(type, payload) {
    const e = {
      ts: new Date().toISOString(),
      type,
      payload,
    };
    setEvents(prev => [e, ...prev].slice(0, 50)); // keep last 50
  }

  function runSimulation() {
    const status = reachedCp ? "success" : "failure";
    addEvent("mission.simulation_run", {
      team: selectedTeam?.name,
      agent: selectedTeam?.agent,
      planet: selectedPlanet?.name,
      burnRate,
      mix: mix.map(m => ({ id: m.id, name: m.name, qty: m.qty })),
      usableEnergy: sim.usableEnergy,
      avgStability: sim.avgStability,
      heatRisk: sim.heatRisk,
      checkpoint: reachedCp?.name || "None",
      status,
    });
  }

  const glass = {
    background: "rgba(10, 18, 28, 0.55)",
    border: "1px solid rgba(255,255,255,0.08)",
    boxShadow: "0 10px 30px rgba(0,0,0,0.35)",
    backdropFilter: "blur(12px)",
    borderRadius: 18,
  };

  return (
    <div className="shf-mission-root">
      {/* SHF_BACKDROP_LAYERS_V2 */}
      <div className="shf-bg shf-bg--base" aria-hidden="true" />
      <div className="shf-bg shf-bg--overlay" aria-hidden="true" />
      <div className="shf-bg shf-bg--fog shf-bg--fogA" aria-hidden="true" />
      <div className="shf-bg shf-bg--fog shf-bg--fogB" aria-hidden="true" />
      <div className="shf-mission-ui">
        <style>{`
          :root { --shf-px: 0; --shf-py: 0; }

          .shf-mission-root{
            position: relative;
            min-height: 100vh;
            background: transparent !important;
          }
          .shf-bg{
            position: fixed;
            inset: 0;
            pointer-events: none;
            z-index: 0;
            will-change: transform, opacity, background-position;
            transform: translate3d(0,0,0);
          }

          /* IMPORTANT: use the tower art you already have */
          .shf-bg--base{
            background-image:
              linear-gradient(180deg, rgba(0,0,0,0.22), rgba(0,0,0,0.65)),
              url("/assets/hero/growth-observatory-art.png");
            background-size: cover;
            background-position: center;
            filter: saturate(1.05) contrast(1.05) brightness(1.06);
            transform: translate3d(calc(var(--shf-px) * -10px), calc(var(--shf-py) * -8px), 0) scale(1.03);
          }

          .shf-bg--overlay{
            background-image:
              radial-gradient(70% 70% at 50% 45%, rgba(0,0,0,0.00) 58%, rgba(0,0,0,0.62) 100%),
              linear-gradient(180deg, rgba(120,170,255,0.10), rgba(0,0,0,0.26));
            mix-blend-mode: multiply;
            opacity: 1;
          }

          .shf-bg--fog{
            background-image:
              radial-gradient(55% 45% at 25% 70%, rgba(255,255,255,0.18), rgba(255,255,255,0.00) 70%),
              radial-gradient(55% 50% at 75% 75%, rgba(220,235,255,0.14), rgba(255,255,255,0.00) 72%);
            background-size: 1400px 900px;
            background-repeat: repeat;
            opacity: 0.18;
            filter: blur(0.2px);
          }
          .shf-bg--fogA{
            animation: shfFogA 44s linear infinite;
            transform: translate3d(calc(var(--shf-px) * -16px), calc(var(--shf-py) * -10px), 0);
          }
          .shf-bg--fogB{
            opacity: 0.12;
            animation: shfFogB 68s linear infinite;
            transform: translate3d(calc(var(--shf-px) * -24px), calc(var(--shf-py) * -14px), 0) scale(1.02);
          }

          @keyframes shfFogA { from { background-position: 0 0; } to { background-position: 900px 260px; } }
          @keyframes shfFogB { from { background-position: 0 0; } to { background-position: -1200px 340px; } }

          .shf-mission-ui{
            position: relative;
            z-index: 1;
          }

          @media (prefers-reduced-motion: reduce){
            .shf-bg--fogA, .shf-bg--fogB { animation: none !important; }
            .shf-bg--base { transform: none !important; }
          }
        `}</style>
        <div style={{ minHeight: "100vh", position: "relative", overflow: "hidden", color: "white" }}>
      {/* Backdrop */}
      <div
        style={{
          position: "fixed",
          inset: 0,
          zIndex: 0,
          background:
            "radial-gradient(1200px 800px at 50% 30%, rgba(120,180,255,0.18), rgba(10,18,28,1) 70%), linear-gradient(180deg, rgba(0,0,0,0.15), rgba(0,0,0,0.55))",
        }}
      />
      {/* Fog */}
      <div
        style={{
          position: "fixed",
          inset: -200,
          zIndex: 0,
          opacity: 0.35,
          background:
            "radial-gradient(900px 600px at 30% 40%, rgba(255,255,255,0.06), transparent 60%), radial-gradient(900px 600px at 70% 60%, rgba(255,255,255,0.05), transparent 60%)",
          filter: "blur(2px)",
          transform: "translateZ(0)",
        }}
      />

      {/* Top Status Bar */}
      <div style={{ position: "relative", zIndex: 2, padding: "14px 16px" }}>
        <div style={{ ...glass, padding: "12px 14px", display: "flex", gap: 12, alignItems: "center", justifyContent: "space-between" }}>
          <div style={{ display: "flex", gap: 10, alignItems: "center" }}>
            <div style={{ width: 10, height: 10, borderRadius: 999, background: "rgba(80,220,140,0.95)" }} />
            <div style={{ fontWeight: 700 }}>MISSION CONTROL — Observer Mode</div>
            <div style={{ opacity: 0.75, fontSize: 13 }}>Interplanetary Mission v1</div>
          </div>
          <div style={{ display: "flex", gap: 14, alignItems: "center", fontSize: 13, opacity: 0.9 }}>
            <div>Region: SHF Sector</div>
