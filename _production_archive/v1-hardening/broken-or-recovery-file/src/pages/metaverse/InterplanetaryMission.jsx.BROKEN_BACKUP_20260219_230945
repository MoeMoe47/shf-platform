            {/* Event Log */}
            <div style={{ ...glass, padding: 14, overflow: "hidden" }}>
              <div style={{ fontWeight: 900, fontSize: 14, display: "flex", justifyContent: "space-between" }}>
                <span>Observer Event Log</span>
                <span style={{ opacity: 0.75, fontSize: 12 }}>{events.length} events</span>
