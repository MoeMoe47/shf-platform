        </div>

        {/* Canvas + Bottom Panels */}
        <div style={{ display: "grid", gridTemplateRows: "1fr 220px", gap: 14, minHeight: "calc(100vh - 110px)" }}>
          {/* Canvas */}
          <div style={{ ...glass, position: "relative", overflow: "hidden", padding: 14 }}>
            <div style={{ display: "flex", justifyContent: "space-between", alignItems: "baseline" }}>
              <div>
                <div style={{ fontWeight: 900, fontSize: 16 }}>Planetary Map</div>
                <div style={{ fontSize: 12, opacity: 0.75 }}>Ships move by checkpoint energy. Planets hold mineable resources.</div>
              </div>
              <div style={{ fontSize: 12, opacity: 0.8 }}>
                Checkpoints: {CHECKPOINTS.map(c => c.name).join(" → ")}
              </div>
            </div>

            {/* Simple “map” nodes */}
            <div style={{ position: "absolute", inset: 0, padding: 24 }}>
              {/* Tower marker */}
              <div style={{ position: "absolute", left: "50%", top: "50%", transform: "translate(-50%,-50%)", textAlign: "center" }}>
                <div style={{ width: 140, height: 140, borderRadius: 999, background: "rgba(255,255,255,0.04)", border: "1px solid rgba(255,255,255,0.10)" }} />
                <div style={{ marginTop: 10, fontWeight: 900, opacity: 0.9 }}>OBSERVATORY TOWER</div>
                <div style={{ fontSize: 12, opacity: 0.7 }}>Mission Control / Human View</div>
              </div>

              {/* Planet nodes */}
              {PLANETS.map((p, idx) => {
                const pos = [
                  { left: "16%", top: "26%" },
                  { left: "78%", top: "30%" },
                  { left: "70%", top: "78%" },
