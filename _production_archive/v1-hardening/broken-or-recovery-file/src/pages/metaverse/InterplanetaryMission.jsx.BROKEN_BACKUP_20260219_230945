import React, { useEffect, useMemo, useRef, useState } from "react";

/**
 * InterplanetaryMission v1 (Observer Mode)
 * - No backend
 * - No admin controls
 * - Append-only event stream (in-memory)
 * - Simple fuel -> energy -> checkpoint simulation
 */

