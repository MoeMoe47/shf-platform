            <div>{new Date().toLocaleString()}</div>
          </div>
        </div>
      </div>

      {/* Main Grid */}
      <div
        style={{
          position: "relative",
          zIndex: 2,
          display: "grid",
          gridTemplateColumns: "320px 1fr",
          gap: 14,
          padding: "0 16px 16px",
        }}
      >
        {/* Sidebar */}
        <div style={{ ...glass, padding: 14, display: "flex", flexDirection: "column", gap: 12, minHeight: "calc(100vh - 110px)" }}>
          <div style={{ fontWeight: 800, fontSize: 14, opacity: 0.95 }}>Observer Panels</div>

          <div>
            <div style={{ fontSize: 12, opacity: 0.8, marginBottom: 6 }}>Active Team</div>
            <select value={teamId} onChange={(e) => setTeamId(e.target.value)} style={{ width: "100%", padding: 10, borderRadius: 12 }}>
