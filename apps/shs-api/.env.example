# apps/shs-api local development environment example.
# Copy to .env for local use only. Never commit real credentials.
# Server-side only — nothing in this file is ever read by the Vite
# frontend (which only reads VITE_-prefixed vars from the repo root
# .env.example). Do not duplicate these into that file.

DATABASE_URL=postgres://localhost:5432/shs_dev

# Phase 2A Secure Live Learning — Zoom Server-to-Server OAuth app
# credentials (NOT the deprecated JWT app type). If unset, the Zoom
# provider adapter reports health "not_configured" and refuses to make
# any Zoom API call — it does not silently fall back to an insecure mode.
ZOOM_ACCOUNT_ID=
ZOOM_CLIENT_ID=
ZOOM_CLIENT_SECRET=

# Trusted SHF reporting dispatcher. Local/test only when supplied directly;
# production requires SHF_INTERNAL_SERVICE_KEYS_REF backed by an approved
# secret manager and must fail closed if unavailable.
SHF_AGENT_FABRIC_INTERNAL_URL=http://127.0.0.1:8091
SHF_INTERNAL_SERVICE_ACTIVE_KID=local-dev-k1
SHF_INTERNAL_SERVICE_KEYS_JSON=
SHF_INTERNAL_SERVICE_KEYS_REF=

# Phase 12.1 External Account Security — AES-256-GCM key used to encrypt
# third-party OAuth tokens/PKCE verifiers at rest (src/security/
# external-secret-cipher.ts). Generate a local dev value with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
# Production requires SHF_EXTERNAL_SECRET_KEYS_REF backed by an approved
# secret manager and must fail closed if unavailable.
SHF_EXTERNAL_SECRET_ACTIVE_KID=local-dev-k1
SHF_EXTERNAL_SECRET_KEYS_JSON={"local-dev-k1":"<base64 32-byte key>"}
SHF_EXTERNAL_SECRET_KEYS_REF=

# Phase 12.2 Native External Calendar Integration — Google Calendar OAuth
# app credentials (Calendar API, "Web application" client type). If unset,
# GoogleCalendarProvider reports health "not_configured" and refuses to
# make any Google API call — same pattern as the Zoom credentials above.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Phase 12.2 — Microsoft identity platform app registration credentials
# (Microsoft Graph, Calendars.ReadWrite delegated permission). Same
# not_configured fallback as Google above when unset.
MICROSOFT_CLIENT_ID=
MICROSOFT_CLIENT_SECRET=

# Phase 12.2 — this API server's own externally-reachable base URL, used
# to build each provider's OAuth redirect_uri
# (`${base}/external-accounts/:provider/oauth/callback`). Must exactly
# match the redirect URI registered in the Google/Microsoft app console.
SHF_EXTERNAL_CALENDAR_REDIRECT_BASE_URL=http://localhost:8091

# Phase 12.2 — the frontend's own base URL, used only to build the final
# browser redirect after a successful OAuth callback (back to the
# Settings page the connect flow started from).
SHF_FRONTEND_BASE_URL=http://localhost:5173

# Phase 13 — bounded timeout (milliseconds) applied to every real Google/
# Microsoft HTTP call (src/domain/external-accounts/providers/provider-http.ts).
# A hung provider request aborts after this long rather than blocking
# Calendar Intelligence or a mirror sync pass indefinitely.
SHF_EXTERNAL_CALENDAR_PROVIDER_TIMEOUT_MS=10000
