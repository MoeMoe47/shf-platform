# apps/shs-api local development environment example.
# Copy to .env for local use only. Never commit real credentials.
# Server-side only — nothing in this file is ever read by the Vite
# frontend (which only reads VITE_-prefixed vars from the repo root
# .env.example). Do not duplicate these into that file.

DATABASE_URL=postgres://localhost:5432/shs_dev

# Phase 2A Secure Live Learning — Zoom Server-to-Server OAuth app
# credentials (NOT the deprecated JWT app type). If unset, the Zoom
# provider adapter reports health "not_configured" and refuses to make
# any Zoom API call — it does not silently fall back to an insecure mode.
ZOOM_ACCOUNT_ID=
ZOOM_CLIENT_ID=
ZOOM_CLIENT_SECRET=

# Trusted SHF reporting dispatcher. Local/test only when supplied directly;
# production requires SHF_INTERNAL_SERVICE_KEYS_REF backed by an approved
# secret manager and must fail closed if unavailable.
SHF_AGENT_FABRIC_INTERNAL_URL=http://127.0.0.1:8091
SHF_INTERNAL_SERVICE_ACTIVE_KID=local-dev-k1
SHF_INTERNAL_SERVICE_KEYS_JSON=
SHF_INTERNAL_SERVICE_KEYS_REF=
