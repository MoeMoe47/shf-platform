{
  "name": "shs-api",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "tsx watch src/server.ts",
    "start": "node dist/server.js",
    "test:server": "SHS_RATE_LIMIT_AUTHENTICATED_USER_MAX=5000 SHS_RATE_LIMIT_AUTHENTICATED_USER_WINDOW_SECONDS=60 tsx src/server.ts",
    "test": "tsx --test tests/*.test.ts",
    "worker:trusted-reporting": "tsx src/domain/trusted-reporting/worker.ts",
    "worker:external-calendar-mirror": "tsx src/domain/external-accounts/service/external-calendar-mirror-worker.ts",
    "db:migrate:status": "tsx src/db/migrate.ts status",
    "db:migrate:plan": "tsx src/db/migrate.ts plan",
    "db:migrate": "tsx src/db/migrate.ts up",
    "db:migrate:baseline": "tsx src/db/migrate.ts baseline",
    "db:schema:integrity": "tsx src/db/schema-integrity-check.ts",
    "db:schema:integrity:strict": "tsx src/db/schema-integrity-check.ts --strict",
    "lifecycle:status": "tsx src/db/lifecycle.ts status",
    "lifecycle:plan": "tsx src/db/lifecycle.ts plan",
    "lifecycle:cleanup": "tsx src/db/lifecycle.ts cleanup --confirm",
    "typecheck": "tsc --noEmit",
    "build": "tsc -p tsconfig.json"
  },
  "dependencies": {
    "@types/pg": "^8.20.0",
    "@types/qrcode": "^1.5.6",
    "cors": "^2.8.5",
    "express": "^4.21.2",
    "mammoth": "^1.12.2",
    "multer": "^2.1.1",
    "pdf-parse": "^2.4.5",
    "pg": "^8.20.0",
    "playwright": "^1.58.0",
    "qrcode": "^1.5.4"
  },
  "devDependencies": {
    "@types/cors": "^2.8.17",
    "@types/express": "^5.0.1",
    "docx": "^9.7.1",
    "pdf-lib": "^1.17.1",
    "tsx": "^4.19.2",
    "typescript": "^5.8.3"
  }
}
