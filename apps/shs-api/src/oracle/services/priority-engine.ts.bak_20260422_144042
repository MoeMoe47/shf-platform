import type { TruthPackage } from "../domain/types";

export type PriorityQueueResult = {
  total: number;
  ranked: Array<{
    rank: number;
    entityId: string;
    truthStatus: string;
    readinessStatus: string;
    confidenceScore: number;
    confidenceBand: string;
    contradictionStatus: string;
    recommendedNextAction?: string;
    priorityScore: number;
  }>;
  summary: string;
};

function computePriorityScore(t: TruthPackage): number {
  let score = 0;

  if (t.readinessStatus === "public_ready") score += 70;
  else if (t.readinessStatus === "funder_ready") score += 60;
  else if (t.readinessStatus === "leadership_ready") score += 45;
  else if (t.readinessStatus === "internally_ready") score += 30;
  else if (t.readinessStatus === "blocked") score -= 40;

  score += t.confidenceScore;

  if (t.contradictionStatus === "none") score += 20;
  else if (t.contradictionStatus === "resolved") score += 8;
  else if (t.contradictionStatus === "minor_conflict") score -= 10;
  else score -= 25;

  if (t.verificationStatus === "verified") score += 20;
  else if (t.verificationStatus === "in_review") score -= 5;
  else score -= 15;

  score -= (t.unresolvedItems?.length || 0) * 10;

  return score;
}

export function buildPriorityQueue(packages: TruthPackage[]): PriorityQueueResult {
  const ranked = [...packages]
    .map((item) => ({
      entityId: item.entityId,
      truthStatus: item.truthStatus,
      readinessStatus: item.readinessStatus,
      confidenceScore: item.confidenceScore,
      confidenceBand: item.confidenceBand,
      contradictionStatus: item.contradictionStatus,
      recommendedNextAction: item.recommendedNextAction,
      priorityScore: computePriorityScore(item),
    }))
    .sort((a, b) => b.priorityScore - a.priorityScore)
    .map((item, index) => ({
      rank: index + 1,
      ...item,
    }));

  const top = ranked[0];

  return {
    total: ranked.length,
    ranked,
    summary: top
      ? `Highest-priority case is ${top.entityId} with ${top.readinessStatus}, confidence ${top.confidenceScore}, and priority score ${top.priorityScore}.`
      : "No entities available for prioritization.",
  };
}
