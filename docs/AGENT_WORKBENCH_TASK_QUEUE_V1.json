    "admin.html#/ops/agents",
    "admin.html#/agent-fabric"
  ],
  "access_control": {
    "route": "/ops/agents",
    "allowed_roles": [
      "shs_admin"
    ],
    "blocked_roles": [
      "client_admin",
      "client",
      "public"
    ],
    "permission_guard": "SHS_SECURITY_PERMISSIONS.AUDIT_VIEW"
  },
  "human_approval_rules": [
    "approve task changes local task status and approval_status only",
    "reject task changes local task status and approval_status only",
    "mark complete changes local task status only",
    "return to review changes local task status only",
    "add note updates operator_note and local audit history only",
    "no approval action executes production work"
  ],
  "audit_model": [
    "task_created",
    "approval_changed",
    "task_status_changed",
    "note_added"
  ],
