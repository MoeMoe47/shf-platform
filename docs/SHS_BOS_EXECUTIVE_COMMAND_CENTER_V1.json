    "banking_connection_enabled": false,
    "oauth_connection_enabled": false,
    "payment_execution_enabled": false
  },
  "data_posture": {
    "allowed_values": [
      "live_local",
      "persisted_local",
      "derived_local",
      "sample",
      "unavailable",
      "needs_review"
