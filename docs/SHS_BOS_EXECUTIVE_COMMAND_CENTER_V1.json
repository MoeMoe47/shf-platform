{
  "name": "SHS BOS Executive Command Center V1",
  "version": "v1.1-layer-v1",
  "product_name": "SHS BOS",
  "full_product_name": "Silicon Heartland Business Operating System",
  "purpose": "Unified internal executive and operator mission-control surface for governed visibility, triage, safe previews, local snapshots, and navigation across SHS BOS layers.",
  "route": "admin.html#/ops/executive-command",
  "access": {
    "shs_admin": true,
    "client_admin": false,
    "public": false
  },
  "connected_source_groups": [
    "system_registry",
    "system_orchestrator",
    "command_bus",
    "event_bus",
    "job_scheduler",
    "notification_alert_fabric",
    "tracking_intelligence",
    "durable_persistence",
    "agent_workbench",
    "agent_workflow_engine",
    "controlled_executor",
    "production_automation",
    "direct_connect_proof",
    "shs_reports",
    "governance_truth_oracle",
    "client_operations_business_signals"
  ],
  "layer_status_model": {
    "fields": [
      "layer_id",
      "layer_name",
      "category",
      "route",
      "status",
      "readiness_score",
      "health_score",
      "data_posture",
      "open_items",
      "blockers",
      "warnings",
      "last_activity_at",
      "last_validated_at",
      "source_reference",
      "admin_only",
      "dangerous_flags_enabled"
    ],
    "timestamps": "null or not_verified when no trusted source exists"
  },
  "executive_snapshot_model": {
    "local_admin_only": true,
    "external_export_default": false,
    "contains": [
      "overall_status",
      "readiness",
      "health",
      "layer counts",
      "runtime counts",
      "top priorities",
      "top risks",
      "safe next actions",
      "data posture summary",
      "safety summary",
      "operator note"
    ]
  },
  "health_scoring": {
    "starts_at": 100,
    "deductions": [
      "unavailable layers",
      "degraded layers",
      "blocked layers",
      "stale or unknown source status",
      "unresolved safety warnings"
    ],
    "hidden_scoring": false
  },
  "readiness_scoring": {
    "starts_at": 100,
    "deductions": [
      "critical blocker exists",
      "dangerous capability flag true",
      "governance checks blocked",
      "Truth Spine unavailable or failed",
      "route or identity boundary failed",
      "blocked high-risk commands",
      "failed or blocked jobs",
      "critical alerts unresolved",
      "blocked orchestration plans",
      "system registry dependency conflicts",
      "persistence below threshold",
      "tracking review items",
      "invalid events",
      "agent workflow blockers",
      "report readiness issues",
      "primarily sample or unavailable data posture"
    ],
    "hidden_scoring": false
  },
  "priority_engine": {
    "levels": [
      "P0",
      "P1",
      "P2",
      "P3",
      "P4"
    ],
    "deterministic_local_logic": true,
    "external_model_call": false
  },
  "risk_engine": {
    "deterministic_local_logic": true,
    "private_payload_exposure": false
  },
  "safe_actions": [
    "refresh local summaries",
    "filter by status/category",
    "mark priority reviewed locally",
    "add operator note",
    "create executive snapshot",
    "compare snapshots",
    "navigate to source layer",
    "prepare command preview",
    "prepare orchestration request preview",
    "run local safety scan",
    "show blast-radius preview",
    "show source data posture",
    "archive local snapshot"
  ],
  "dangerous_flags": {
    "execution_enabled": false,
    "autonomous_execution_enabled": false,
    "production_mutation_enabled": false,
    "public_publish_enabled": false,
    "public_approved_mutation_enabled": false,
    "shf_impact_data_mutation_enabled": false,
