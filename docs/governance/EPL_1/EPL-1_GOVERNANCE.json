{
  "schema_version": "1.0",
  "standard_id": "EPL-1",
  "artifact": "EPL-1_GOVERNANCE",
  "prohibited_actions": [
    "Evidence deletion",
    "Evidence rewriting",
    "Evidence ownership reassignment",
    "Certification without evidence",
    "Publication without evidence",
    "Validator bypass",
    "Traceability gaps",
    "Duplicate evidence authority",
    "Untracked evidence",
    "Manual certification without provenance"
  ],
  "future_governance_decisions_require_epl_1": true,
  "duplicate_evidence_authority_allowed": false
}
