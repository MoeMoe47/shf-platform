{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://silicon-heartland.local/schemas/commercial-product-registry.schema.json",
  "title": "SHU Commercial Product Registry Design Schema",
  "description": "Design-only schema for Sales-facing commercial product records. This is not a database migration or API contract.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "commercial_product_id",
    "canonical_name",
    "display_name",
    "slug",
    "commercial_family",
    "product_type",
    "commercial_forms",
    "status",
    "version",
    "source_authorities",
    "readiness",
    "sellability_status",
    "review_gates"
  ],
  "properties": {
    "commercial_product_id": { "type": "string", "pattern": "^cp_[a-z0-9_]+$" },
    "canonical_name": { "type": "string", "minLength": 1 },
    "display_name": { "type": "string", "minLength": 1 },
    "slug": { "type": "string", "pattern": "^[a-z0-9-]+$" },
    "aliases": { "type": "array", "items": { "type": "string" } },
    "commercial_family": { "type": "string" },
    "subfamily": { "type": "string" },
    "product_type": {
      "type": "string",
      "enum": [
        "LICENSE",
        "SERVICE",
        "PROGRAM",
        "SPONSORSHIP",
        "ASSESSMENT",
        "MANAGED_SERVICE",
        "IMPLEMENTATION_PACKAGE",
        "CONTENT_LICENSE",
        "PROFESSIONAL_SERVICE",
        "UNKNOWN"
      ]
    },
    "commercial_forms": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "string",
        "enum": [
          "PER_STUDENT_LICENSE",
          "PER_COHORT_LICENSE",
          "PER_SITE_LICENSE",
          "PER_INSTITUTION_LICENSE",
          "ANNUAL_LICENSE",
          "SUBSCRIPTION",
          "IMPLEMENTATION_FEE",
          "PROFESSIONAL_SERVICE",
          "MANAGED_SERVICE",
          "ASSESSMENT",
          "CUSTOM_DEVELOPMENT",
          "SPONSORSHIP",
          "TRAINING",
          "SUPPORT",
          "USAGE_BASED",
          "ENTERPRISE_CONTRACT",
          "PARTNER_DELIVERED",
          "GRANT_SUPPORTED",
          "EMPLOYER_SUPPORTED",
          "UNKNOWN"
        ]
      }
    },
    "description": { "type": "string" },
    "short_description": { "type": "string" },
    "status": {
      "type": "string",
      "enum": [
        "DISCOVERED",
        "DEFINED",
        "REVIEW",
        "PILOT_READY",
        "PILOT_ACTIVE",
        "SALES_READY",
        "ACTIVE",
        "SUSPENDED",
        "SUNSET",
        "RETIRED"
      ]
    },
    "version": { "type": "integer", "minimum": 1 },
    "source_authorities": {
      "type": "array",
      "minItems": 1,
      "items": { "$ref": "#/$defs/sourceAuthority" }
    },
    "selling_entity": { "$ref": "#/$defs/entityClassification" },
    "delivery_entity": { "$ref": "#/$defs/entityClassification" },
    "partner_required": { "type": "boolean" },
    "partner_type": { "type": "string" },
    "joint_structure_required": { "type": "boolean" },
    "buyer_types": {
      "type": "array",
      "items": { "$ref": "#/$defs/buyerType" }
    },
    "readiness": { "$ref": "#/$defs/readiness" },
    "sellability_status": { "$ref": "#/$defs/sellability" },
    "sellability_reason": { "type": "string" },
    "sellability_blockers": { "type": "array", "items": { "type": "string" } },
    "review_gates": {
      "type": "object",
      "additionalProperties": { "$ref": "#/$defs/gateState" }
    },
    "pricing_status": { "$ref": "#/$defs/pricingStatus" },
    "pricing_model": { "type": "string" },
    "pricing_authority": { "type": "string" },
    "pricing_reference": { "type": "string" },
    "price_effective_from": { "type": ["string", "null"], "format": "date" },
    "price_effective_to": { "type": ["string", "null"], "format": "date" },
    "currency": { "type": "string" },
    "discount_policy_reference": { "type": "string" },
    "margin_status": { "$ref": "#/$defs/marginStatus" },
    "cost_model_reference": { "type": "string" },
    "gross_margin_class": { "type": "string" },
    "minimum_margin_policy": { "type": "string" },
    "commercial_viability_status": { "type": "string" },
    "commission_eligible_status": { "$ref": "#/$defs/commissionStatus" },
    "commission_policy_reference": { "type": "string" },
    "leadership_override_eligible": { "type": "string" },
    "renewal_commission_eligible": { "type": "string" },
    "expansion_commission_eligible": { "type": "string" },
    "revenue_classification": {
      "type": "array",
      "items": { "$ref": "#/$defs/revenueClassification" }
    },
    "required_entitlement_ids": { "type": "array", "items": { "type": "string" } },
    "optional_entitlement_ids": { "type": "array", "items": { "type": "string" } },
    "entitlement_authority": { "type": "string" },
    "entitlement_status_reference": { "type": "string" },
    "funding_relationship_status": { "$ref": "#/$defs/fundingStatus" },
    "regulated_program": { "type": "boolean" },
    "regulatory_authority": { "type": "string" },
    "external_training_authority_required": { "type": "boolean" },
    "credential_authority": { "type": "string" },
    "scope_limitations": { "type": "array", "items": { "type": "string" } },
    "sales_language_restrictions": { "type": "array", "items": { "type": "string" } },
    "implementation_required": { "type": "boolean" },
    "implementation_tier": { "$ref": "#/$defs/implementationTier" },
    "implementation_owner": { "type": "string" },
    "support_required": { "type": "boolean" },
    "support_tier": { "$ref": "#/$defs/supportTier" },
    "managed_service_available": { "type": "string" },
    "SLA_status": { "type": "string" },
    "training_required": { "type": "boolean" },
    "professional_development_available": { "type": "string" },
    "renewal_model": { "$ref": "#/$defs/renewalModel" },
    "renewal_term": { "type": "string" },
    "renewal_window": { "type": "string" },
    "expansion_paths": { "type": "array", "items": { "type": "string" } },
    "upsell_paths": { "type": "array", "items": { "type": "string" } },
    "cross_sell_paths": { "type": "array", "items": { "type": "string" } },
    "approved_public_marketing": { "type": "string" },
    "approved_social_sharing": { "type": "string" },
    "social_campaign_tags": { "type": "array", "items": { "type": "string" } },
    "approved_talking_points_reference": { "type": "string" },
    "sales_language_status": { "type": "string" },
    "brand_restrictions": { "type": "array", "items": { "type": "string" } },
    "last_verified_at": { "type": ["string", "null"], "format": "date-time" }
  },
  "$defs": {
    "sourceAuthority": {
      "type": "object",
      "additionalProperties": false,
      "required": ["source_authority_type", "source_repository", "source_status", "source_provenance"],
      "properties": {
        "source_authority_type": { "type": "string" },
        "source_authority_id": { "type": "string" },
        "source_repository": { "type": "string" },
        "source_domain": { "type": "string" },
        "source_record_id": { "type": "string" },
        "source_version": { "type": "string" },
        "source_status": { "type": "string" },
        "source_last_verified_at": { "type": ["string", "null"], "format": "date-time" },
        "source_provenance": { "type": ["string", "array"], "items": { "type": "string" } }
      }
    },
    "entityClassification": {
      "type": "string",
      "enum": ["SHF", "SHS", "PARTNER", "JOINT_STRUCTURE_REVIEW_REQUIRED", "UNKNOWN"]
    },
    "buyerType": {
      "type": "string",
      "enum": [
        "K12_SCHOOL",
        "SCHOOL_DISTRICT",
        "CHARTER_SCHOOL",
        "PRIVATE_SCHOOL",
        "COLLEGE",
        "UNIVERSITY",
        "CAREER_TECH",
        "WORKFORCE_BOARD",
        "AMERICAN_JOB_CENTER",
        "MUNICIPALITY",
        "COUNTY",
        "STATE_AGENCY",
        "NONPROFIT",
        "YOUTH_PROGRAM",
        "AFTER_SCHOOL_PROVIDER",
        "SUMMER_PROGRAM",
        "LIBRARY",
        "EMPLOYER",
        "DATA_CENTER_OPERATOR",
        "HEALTHCARE_EMPLOYER",
        "HOSPITAL",
        "NURSING_FACILITY",
        "FIRE_DEPARTMENT",
        "PUBLIC_SAFETY_AGENCY",
        "UTILITY",
        "CONTRACTOR",
        "LOGISTICS_EMPLOYER",
        "UNION",
        "APPRENTICESHIP_SPONSOR",
        "BANK",
        "CREDIT_UNION",
        "FOUNDATION",
        "PHILANTHROPY",
        "COMMUNITY_ORGANIZATION",
        "TRAINING_PROVIDER",
        "ENTERPRISE"
      ]
    },
    "readiness": { "type": "string", "enum": ["RED", "YELLOW", "GREEN", "BLUE", "UNKNOWN"] },
    "sellability": { "type": "string", "enum": ["SELL_NOW", "PILOT", "DEVELOP", "NOT_SELLABLE", "NEEDS_REVIEW"] },
    "gateState": { "type": "string", "enum": ["NOT_REQUIRED", "PENDING", "APPROVED", "BLOCKED", "STALE", "UNKNOWN"] },
    "pricingStatus": { "type": "string", "enum": ["NOT_DEFINED", "DRAFT", "UNDER_REVIEW", "APPROVED", "ACTIVE", "EXPIRED", "BLOCKED"] },
    "marginStatus": { "type": "string", "enum": ["NOT_DEFINED", "DRAFT", "UNDER_REVIEW", "APPROVED", "ACTIVE", "BLOCKED", "UNKNOWN"] },
    "commissionStatus": { "type": "string", "enum": ["NOT_ELIGIBLE", "ELIGIBLE_AFTER_APPROVAL", "UNDER_REVIEW", "APPROVED", "BLOCKED", "UNKNOWN"] },
    "fundingStatus": { "type": "string", "enum": ["POTENTIAL", "DOCUMENTED", "VERIFIED", "NOT_FOUND", "REVIEW_REQUIRED"] },
    "revenueClassification": {
      "type": "string",
      "enum": [
        "ONE_TIME",
        "RECURRING",
        "IMPLEMENTATION",
        "SUBSCRIPTION",
        "LICENSE",
        "PROFESSIONAL_SERVICE",
        "MANAGED_SERVICE",
        "SPONSORSHIP",
        "GRANT_SUPPORTED",
        "EMPLOYER_SUPPORTED",
        "RENEWAL",
        "EXPANSION"
      ]
    },
    "implementationTier": { "type": "string", "enum": ["NONE", "LIGHT", "STANDARD", "COMPLEX", "CUSTOM", "UNKNOWN"] },
    "supportTier": { "type": "string", "enum": ["NONE", "BASIC", "STANDARD", "ENHANCED", "ENTERPRISE", "UNKNOWN"] },
    "renewalModel": { "type": "string", "enum": ["NONE", "MANUAL", "ANNUAL", "MULTI_YEAR", "EVERGREEN", "PROJECT_BASED", "UNKNOWN"] }
  }
}
