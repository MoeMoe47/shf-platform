{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:oas:schema:closure:mapping:1",
  "type": "object",
  "properties": {
    "mapping_version": {
      "type": "string",
      "minLength": 1
    },
    "basis_commit": {
      "type": "string",
      "minLength": 1
    },
    "mappings": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "namespace": {
            "type": "string",
            "minLength": 1
          },
          "label": {
            "type": "string",
            "minLength": 1
          },
          "state": {
            "enum": [
              "CANONICAL",
              "ALIAS",
              "DEPRECATED",
              "QUARANTINED LEGACY"
            ]
          },
          "canonical_domain_ids": {
            "type": "array",
            "items": {
              "type": "string",
              "pattern": "^OAS-1-D0[1-8]$"
            },
            "minItems": 0,
            "uniqueItems": true
          },
          "reason": {
            "type": "string",
            "minLength": 1
          }
        },
        "required": [
          "namespace",
          "label",
          "state",
          "canonical_domain_ids",
          "reason"
        ],
        "additionalProperties": false
      },
      "uniqueItems": true
    }
  },
  "required": [
    "mapping_version",
    "basis_commit",
    "mappings"
  ],
  "additionalProperties": false
}
