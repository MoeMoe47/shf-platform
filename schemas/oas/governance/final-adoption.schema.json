{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:oas:schema:governance:final-adoption:1",
  "type": "object",
  "properties": {
    "record_version": {
      "const": "1.0.0"
    },
    "record_kind": {
      "const": "FINAL_ADOPTION_DECISION"
    },
    "state": {
      "const": "ADOPTED"
    },
    "human_actor_reference": {
      "const": "Mike Slate"
    },
    "authority_evidence_reference": {
      "const": "f1060153361ef635c8d26fae91d8a33f031faf31:docs/OAS_FOUNDING_MAINTAINER_DESIGNATION.md"
    },
    "human_statement": {
      "type": "string",
      "pattern": "\\S"
    },
    "decision_timestamp": {
      "type": "string",
      "format": "date-time"
    },
    "immutable_decision_reference": {
      "type": "string",
      "pattern": "^[a-f0-9]{40}:docs/OAS_FINAL_ADOPTION_DECISION\\.md$"
    },
    "prepared_package_revision": {
      "const": "c1048afb47cbb09decd23b4916149d51ae23d3e8"
    },
