{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:oas:schema:preparation:final-proposal:1",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "proposal_version": {
      "const": "1.0.0"
    },
    "marking": {
      "const": "PROPOSED — NOT ADOPTED — NOT PUBLISHED"
    },
    "state": {
      "const": "PROPOSED_NOT_ADOPTED_NOT_PUBLISHED"
    },
    "release_status_target": {
      "const": "released"
    },
    "standard_id": {
      "const": "OAS-1"
    },
    "release_id": {
      "const": "OAS-1@1.0.0"
    },
    "standard_version": {
      "const": "1.0.0"
    },
    "status": {
      "const": "proposed"
    },
    "source_revision": {
      "type": "string",
      "pattern": "^[a-f0-9]{40}$"
    },
    "normative_source_revision": {
      "const": "517cc23426e7485c352a1672c8fe4614291d552a"
    },
    "requirement_ids": {
      "type": "array",
      "items": {
        "type": "string",
        "pattern": "^OAS-1-REQ-[0-9]{4}$"
      },
      "minItems": 14,
      "maxItems": 14,
      "uniqueItems": true
    },
    "domain_ids": {
      "type": "array",
      "items": {
        "type": "string",
        "pattern": "^OAS-1-D0[1-8]$"
      },
      "minItems": 8,
      "maxItems": 8,
      "uniqueItems": true
    },
    "profiles": {
      "type": "array",
      "maxItems": 0
    },
    "declaration_contract_version": {
      "const": "1.1.0"
    },
    "declaration_schema_id": {
      "const": "urn:oas:schema:closure:declaration:1"
    },
    "evaluation_status": {
      "const": "NOT_EVALUATED"
    },
    "requirements": {
      "type": "array",
      "items": {
        "$ref": "urn:oas:schema:requirement:1"
      },
      "minItems": 14,
      "maxItems": 14
    },
    "release_metadata": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "release_date": {
          "type": [
            "string",
            "null"
          ],
          "format": "date"
        },
        "effective_date": {
          "type": [
            "string",
            "null"
          ],
          "format": "date"
        },
        "date_authority": {
          "const": "REQUIRED_EXPLICIT_HUMAN_MAINTAINER_INPUT"
        },
        "publication_target": {
          "const": "public/oas/catalogs/OAS-1@1.0.0.json"
        },
        "predecessor_reference": {
          "const": "OAS-1@1.0.0-rc.1"
        },
        "predecessor_relationship": {
          "const": "proposed_finalization_of_validated_rc1"
        },
        "supersedes": {
          "type": "array",
          "maxItems": 0
        },
        "superseded_by": {
          "type": "array",
          "maxItems": 0
        },
        "currentness": {
          "const": "NOT_CURRENT_PENDING_ADOPTION_AND_PUBLICATION"
        }
      },
      "required": [
        "release_date",
        "effective_date",
        "date_authority",
        "publication_target",
        "predecessor_reference",
        "predecessor_relationship",
        "supersedes",
        "superseded_by",
        "currentness"
      ]
    },
    "requirements_checksum": {
      "type": "string",
      "pattern": "^sha256:[a-f0-9]{64}$"
    },
    "rc1_requirements_checksum": {
      "type": "string",
      "pattern": "^sha256:[a-f0-9]{64}$"
    },
    "scope_checksum": {
      "type": "string",
      "pattern": "^sha256:[a-f0-9]{64}$"
    },
    "source_checksum": {
      "type": "string",
      "pattern": "^sha256:[a-f0-9]{64}$"
    },
    "release_metadata_checksum": {
      "type": "string",
      "pattern": "^sha256:[a-f0-9]{64}$"
    },
    "adoption_decision": {
      "type": "null"
    },
    "publication_authorization": {
      "type": "null"
    },
    "artifact_checksum": {
      "type": "string",
      "pattern": "^sha256:[a-f0-9]{64}$"
    }
  },
  "required": [
    "proposal_version",
    "marking",
    "state",
    "release_status_target",
    "standard_id",
    "release_id",
    "standard_version",
    "status",
    "source_revision",
    "normative_source_revision",
    "requirement_ids",
    "domain_ids",
    "profiles",
    "declaration_contract_version",
    "declaration_schema_id",
    "evaluation_status",
    "requirements",
    "release_metadata",
    "requirements_checksum",
    "rc1_requirements_checksum",
    "scope_checksum",
    "source_checksum",
    "release_metadata_checksum",
    "adoption_decision",
    "publication_authorization",
    "artifact_checksum"
  ]
}
