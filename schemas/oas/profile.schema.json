{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:oas:schema:profile:1",
  "type": "object",
  "properties": {
    "profile_id": {
      "type": "string",
      "pattern": "^OAS-[1-9][0-9]*-P-[a-z][a-z0-9-]*@(?:0|[1-9][0-9]*)\\.(?:0|[1-9][0-9]*)\\.(?:0|[1-9][0-9]*)(?:-(?:[a-z][a-z0-9-]*\\.)*[a-z0-9-]+)?$"
    },
    "profile_name": {
      "type": "string",
      "minLength": 1
    },
    "profile_version": {
      "type": "string",
      "pattern": "^(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)(?:-(?:[a-z][a-z0-9-]*\\.)*[a-z0-9-]+)?$"
    },
    "standard_id": {
      "type": "string",
      "pattern": "^OAS-[1-9][0-9]*$"
    },
    "standard_version": {
      "type": "string",
      "pattern": "^(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)(?:-(?:[a-z][a-z0-9-]*\\.)*[a-z0-9-]+)?$"
    },
    "release_id": {
      "type": "string",
      "pattern": "^OAS-[1-9][0-9]*@(?:0|[1-9][0-9]*)\\.(?:0|[1-9][0-9]*)\\.(?:0|[1-9][0-9]*)(?:-(?:[a-z][a-z0-9-]*\\.)*[a-z0-9-]+)?$"
    },
    "description": {
      "type": "string",
      "minLength": 1
    },
    "applicable_domains": {
      "type": "array",
      "items": {
        "type": "string",
        "pattern": "^OAS-[1-9][0-9]*-D[0-9]{2}$"
      },
      "uniqueItems": true
    },
    "requirement_ids": {
      "type": "array",
      "items": {
        "type": "string",
        "pattern": "^OAS-[1-9][0-9]*-REQ-[0-9]{4,}$"
      },
      "uniqueItems": true
    },
    "status": {
      "enum": [
        "draft",
        "active",
        "deprecated",
        "superseded"
      ]
    },
    "supersedes": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      },
      "uniqueItems": true
    },
    "superseded_by": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      },
      "uniqueItems": true
    }
  },
  "required": [
    "profile_id",
    "profile_name",
    "profile_version",
    "standard_id",
    "standard_version",
    "release_id",
    "description",
    "applicable_domains",
    "requirement_ids",
    "status",
    "supersedes",
    "superseded_by"
  ],
  "additionalProperties": false
}
