{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:oas:schema:requirement:1",
  "type": "object",
  "properties": {
    "requirement_id": {
      "type": "string",
      "pattern": "^OAS-[1-9][0-9]*-REQ-[0-9]{4,}$"
    },
    "standard_id": {
      "type": "string",
      "pattern": "^OAS-[1-9][0-9]*$"
    },
    "standard_version": {
      "type": "string",
      "pattern": "^(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)(?:-(?:[a-z][a-z0-9-]*\\.)*[a-z0-9-]+)?$"
    },
    "release_id": {
      "type": "string",
      "pattern": "^OAS-[1-9][0-9]*@(?:0|[1-9][0-9]*)\\.(?:0|[1-9][0-9]*)\\.(?:0|[1-9][0-9]*)(?:-(?:[a-z][a-z0-9-]*\\.)*[a-z0-9-]+)?$"
    },
    "domain_id": {
      "type": "string",
      "pattern": "^OAS-[1-9][0-9]*-D[0-9]{2}$"
    },
    "risk_levels": {
      "type": "array",
      "items": {
        "enum": [
          "R0",
          "R1",
          "R2",
          "R3",
          "R4"
        ]
      },
      "uniqueItems": true
    },
    "normative_text": {
      "type": "string",
      "minLength": 1
    },
    "normative_text_reference": {
      "type": "object",
      "properties": {
        "source_path": {
          "type": "string",
          "minLength": 1
        },
        "anchor": {
          "type": "string",
          "minLength": 1
        }
      },
      "required": [
        "source_path",
        "anchor"
      ],
      "additionalProperties": false
    },
    "status": {
      "enum": [
        "draft",
        "active",
        "deprecated",
        "superseded"
      ]
    },
    "supersedes": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      },
      "uniqueItems": true
    },
    "superseded_by": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      },
      "uniqueItems": true
    }
  },
  "required": [
    "requirement_id",
    "standard_id",
    "standard_version",
    "release_id",
    "domain_id",
    "risk_levels",
    "normative_text",
    "normative_text_reference",
    "status",
    "supersedes",
    "superseded_by"
  ],
  "additionalProperties": false
}
