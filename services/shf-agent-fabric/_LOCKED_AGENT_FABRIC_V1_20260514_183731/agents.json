  "impact_measurement_agent": {
    "agent_id": "impact_measurement_agent",
    "agentId": "impact_measurement_agent",
    "name": "Impact Measurement Agent",
    "label": "Impact Measurement Agent",
    "version": "v1",
    "layer": "impact_intelligence_layer",
    "role": "Measures verified impact using outcome definitions, time windows, cost logic, evidence strength, and confidence scoring.",
    "visibility": "internal",
    "lifecycle": "active",
