  "reconciliation_agent": {
    "agent_id": "reconciliation_agent",
    "agentId": "reconciliation_agent",
    "name": "Reconciliation Agent",
    "label": "Reconciliation Agent",
    "version": "v1",
    "layer": "reconciliation_layer",
    "role": "Finds conflicting records, compares source priority, and prepares contradiction-resolution notes before Oracle judgment.",
