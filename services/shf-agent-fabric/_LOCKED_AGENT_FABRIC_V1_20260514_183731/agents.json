{
  "ai_analyst_agent": {
    "agent_id": "ai_analyst_agent",
    "agentId": "ai_analyst_agent",
    "name": "AI Analyst Agent",
    "label": "AI Analyst Agent",
    "version": "v1",
    "layer": "analyst_layer",
    "role": "Explains dashboard state, drawer context, verification readiness, and recommended next actions in plain language.",
    "visibility": "user_visible",
    "lifecycle": "active",
    "capabilities": [
      "dashboard_explanation",
      "drawer_context_summary",
      "next_action_recommendation",
      "plain_language_reasoning"
    ],
    "allowedTools": [
      "log_note",
      "save_draft_artifact"
    ],
    "policy": {
      "humanApproval": false,
      "maxSteps": 6,
      "notes": "Can explain and recommend. Cannot approve, verify, publish, or modify official records without another system action."
    },
    "inputs": [
      "selected_entity",
      "selected_county",
      "oracle_truth_package",
      "verification_state",
      "ui_context"
    ],
    "outputs": [
      "plain_language_summary",
      "recommended_next_action",
      "risk_notes",
      "confidence_explanation"
    ],
    "memoryScope": "session_and_case_context",
    "eventLogging": true,
    "healthCheck": {
      "required": true,
      "status": "registered"
    }
  },
  "oracle_truth_agent": {
    "agent_id": "oracle_truth_agent",
    "agentId": "oracle_truth_agent",
    "name": "Oracle Truth Agent",
    "label": "Oracle Truth Agent",
    "version": "v1",
    "layer": "oracle_layer",
    "role": "Reads Oracle truth packages and returns truth status, confidence state, contradiction state, readiness state, and trust-envelope notes.",
    "visibility": "internal",
    "lifecycle": "active",
    "capabilities": [
      "truth_package_reading",
      "confidence_interpretation",
      "contradiction_detection",
      "readiness_summary"
    ],
    "allowedTools": [
      "log_note"
    ],
    "policy": {
      "humanApproval": false,
      "maxSteps": 5,
      "notes": "Reads and explains Oracle outputs. Does not create truth by itself."
    },
    "inputs": [
      "entity_id",
      "oracle_truth_package",
      "source_summary",
      "trust_envelope"
    ],
    "outputs": [
      "truth_status_summary",
      "confidence_band_summary",
      "contradiction_summary",
      "readiness_summary"
    ],
    "memoryScope": "case_context",
    "eventLogging": true,
    "healthCheck": {
      "required": true,
      "status": "registered"
    }
  },
