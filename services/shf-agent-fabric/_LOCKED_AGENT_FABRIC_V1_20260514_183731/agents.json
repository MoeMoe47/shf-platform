    "lifecycle": "active",
    "capabilities": [
      "conflict_detection",
      "source_priority_comparison",
      "contradiction_resolution_notes"
    ],
    "allowedTools": [
      "log_note"
    ],
    "policy": {
      "humanApproval": true,
      "maxSteps": 6,
      "notes": "Can identify conflicts and recommend resolution. Should not silently overwrite source records."
    },
    "inputs": [
      "source_records",
      "conflicting_values",
      "source_priority_rules"
    ],
    "outputs": [
      "conflict_summary",
      "recommended_resolution",
      "remaining_uncertainty",
      "audit_note"
    ],
    "memoryScope": "case_context",
    "eventLogging": true,
    "healthCheck": {
      "required": true,
      "status": "registered"
    }
  },
