{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "SHF Data Entity (v1)",
  "type": "object",
  "required": ["dataset_id", "label", "type", "lifecycle", "owner_app_id", "schema_version", "access"],
  "properties": {
    "dataset_id": { "type": "string", "minLength": 2 },
    "label": { "type": "string", "minLength": 2 },
    "type": { "type": "string", "enum": ["table", "event_stream", "file", "metric", "model", "other"] },
    "lifecycle": { "type": "string", "enum": ["active", "paused", "retired"] },
    "owner_app_id": { "type": "string", "minLength": 2 },
    "schema_version": { "type": "string", "minLength": 1 },
    "description": { "type": "string" },
    "pii": { "type": "boolean" },
    "retention_days": { "type": "integer", "minimum": 0, "maximum": 36500 },
    "access": {
      "type": "object",
      "required": ["read_roles", "write_roles"],
      "properties": {
        "read_roles": { "type": "array", "items": { "type": "string" } },
        "write_roles": { "type": "array", "items": { "type": "string" } }
      },
      "additionalProperties": true
    },
    "attestations": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "ts": { "type": "integer" },
          "iso": { "type": "string" },
          "actor": { "type": "string" },
          "note": { "type": "string" }
        },
        "additionalProperties": true
      }
    },
    "created_at": { "type": "string" },
    "updated_at": { "type": "string" }
  },
  "additionalProperties": true
}
