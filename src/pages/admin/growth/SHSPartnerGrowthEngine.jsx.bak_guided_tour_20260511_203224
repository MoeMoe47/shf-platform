function moneyTotal(items) {
  const total = items.reduce((sum, item) => sum + (item.value || 0), 0);
  if (total >= 1000000) return `$${(total / 1000000).toFixed(1)}M`;
  if (total >= 1000) return `$${(total / 1000).toFixed(0)}K`;
  return `$${total}`;
}

