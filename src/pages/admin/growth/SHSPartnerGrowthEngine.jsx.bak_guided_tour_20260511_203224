}


function formatOpportunityValue(value) {
  const numeric = Number(value || 0);
  if (numeric >= 1000000) return `$${(numeric / 1000000).toFixed(1)}M`;
  if (numeric >= 1000) return `$${Math.round(numeric / 1000)}K`;
  return `$${numeric}`;
}

function makeInitials(name = "Hub Signal") {
  return String(name)
    .split(/\s+/)
    .filter(Boolean)
    .slice(0, 2)
    .map((part) => part[0])
    .join("")
    .toUpperCase() || "HS";
}


