export default function SHSPartnerGrowthEngine() {
  const { events, track } = useAdaptiveEvents();
  const [convertedHubOpportunities, setConvertedHubOpportunities] = React.useState(() => readConvertedHubOpportunities());
  const [selectedLane, setSelectedLane] = React.useState("All Lanes");
  const [selectedOpportunity, setSelectedOpportunity] = React.useState(null);
  const [selectedReferral, setSelectedReferral] = React.useState(null);
  const [showLearningReport, setShowLearningReport] = React.useState(false);
  const [toast, setToast] = React.useState("");

  React.useEffect(() => {
    const refreshConvertedHubOpportunities = () => {
      setConvertedHubOpportunities(readConvertedHubOpportunities());
    };

    refreshConvertedHubOpportunities();

    window.addEventListener("storage", refreshConvertedHubOpportunities);
    window.addEventListener("shs:growth-signal-converted", refreshConvertedHubOpportunities);
    window.addEventListener("shs:growth-converted-opportunities-refresh", refreshConvertedHubOpportunities);

    return () => {
      window.removeEventListener("storage", refreshConvertedHubOpportunities);
      window.removeEventListener("shs:growth-signal-converted", refreshConvertedHubOpportunities);
      window.removeEventListener("shs:growth-converted-opportunities-refresh", refreshConvertedHubOpportunities);
    };
  }, []);

  const allOpportunities = React.useMemo(() => {
    const seen = new Set();
    return [...convertedHubOpportunities, ...opportunities].filter((opp) => {
      if (seen.has(opp.id)) return false;
      seen.add(opp.id);
      return true;
    });
  }, [convertedHubOpportunities]);

  const filteredOpps = React.useMemo(() => {
    if (selectedLane === "All Lanes") return allOpportunities;
    return allOpportunities.filter((opp) => opp.lane === selectedLane || opp.secondaryLanes.includes(selectedLane));
  }, [selectedLane, allOpportunities]);

  const filteredRefs = React.useMemo(() => {
    if (selectedLane === "All Lanes") return referrals;
    return referrals.filter((ref) => ref.lane === selectedLane);
  }, [selectedLane]);

  const totalValue = moneyTotal(filteredOpps);

  const flash = React.useCallback((message) => {
    setToast(message);
    window.clearTimeout(window.__shsGrowthToastTimer);
    window.__shsGrowthToastTimer = window.setTimeout(() => setToast(""), 2600);
  }, []);

  const selectLane = React.useCallback((lane) => {
    setSelectedLane(lane);
    setSelectedOpportunity(null);
    setSelectedReferral(null);
    track("growth.service_lane.selected", {
      lane,
      metadata: {
        source: "service_lane_router",
        actionLabel: "View Lane",
      },
    });
    flash(`${lane} selected. Adaptive panel updated.`);
  }, [track, flash]);

  const handleAction = React.useCallback((eventType, label) => {
    track(eventType, {
      lane: selectedLane,
      opportunityId: selectedOpportunity?.id,
      referralId: selectedReferral?.id,
      metadata: {
        source: "command_header",
        actionLabel: label,
      },
    });
    flash(`${label} recorded in adaptive event log.`);
  }, [track, selectedLane, selectedOpportunity, selectedReferral, flash]);

  const selectOpportunity = React.useCallback((opp) => {
    setSelectedOpportunity(opp);
    setSelectedReferral(null);
    track("growth.opportunity.selected", {
      lane: opp.lane,
      opportunityId: opp.id,
      metadata: {
        partner: opp.partner,
        stage: opp.stage,
        priorityScore: opp.priorityScore,
      },
    });
  }, [track]);

  const selectReferral = React.useCallback((ref) => {
    setSelectedReferral(ref);
    setSelectedOpportunity(null);
    track("growth.referral.selected", {
      lane: ref.lane,
      referralId: ref.id,
      metadata: {
        from: ref.from,
        priority: ref.priority,
        status: ref.status,
      },
    });
  }, [track]);

  const useRecommendation = React.useCallback((opp) => {
    setSelectedOpportunity(opp);
    track("growth.ai.recommendation.clicked", {
      lane: opp.lane,
      opportunityId: opp.id,
      recommendationId: `rec_${opp.id}`,
      metadata: {
        confidence: opp.confidence,
        recommendation: opp.recommendation,
        stage: opp.stage,
      },
    });
    flash(`Recommendation used for ${opp.partner}.`);
  }, [track, flash]);

  const routeReferral = React.useCallback((ref) => {
    track("growth.referral.routed", {
      lane: ref.lane,
      referralId: ref.id,
      metadata: {
        from: ref.from,
        need: ref.need,
        confidence: ref.confidence,
      },
    });
    flash(`${ref.from} routed to ${ref.lane}.`);
  }, [track, flash]);

  const handleKpi = React.useCallback((kpi) => {
    track("growth.kpi.selected", {
      lane: selectedLane,
      metadata: {
        kpi: kpi.label,
        value: kpi.value,
      },
    });
    flash(`${kpi.label} selected.`);
  }, [track, selectedLane, flash]);

  const handleStage = React.useCallback((stage) => {
    track("growth.pipeline.stage_selected", {
      lane: selectedLane,
      metadata: {
        stage: stage.label,
        count: stage.count,
        value: stage.value,
      },
    });
    flash(`${stage.label} stage selected.`);
  }, [track, selectedLane, flash]);

  const handleFriction = React.useCallback((type) => {
    track("growth.friction.reviewed", {
      lane: selectedLane,
      metadata: {
        frictionType: type,
      },
    });
    flash("Friction review recorded.");
  }, [track, selectedLane, flash]);

  const handleConvertedOpportunityAction = React.useCallback((opp, actionType) => {
    if (!opp?.convertedFromHub) return;

    const labels = {
      open_signal: "Hub signal opened",
      create_pilot_packet: "Pilot packet action logged",
      route_to_lane: "Route-to-lane action logged",
      mark_active: "Converted opportunity marked active",
    };

    writeConvertedOpportunityAction({
      actionType,
      opportunityId: opp.id,
      sourceSignalId: opp.sourceSignalId,
      partner: opp.partner,
      lane: opp.lane,
      metadata: {
        stage: opp.stage,
        value: opp.value,
        confidence: opp.confidence,
        priorityScore: opp.priorityScore,
        secondaryLanes: opp.secondaryLanes,
        recommendation: opp.recommendation,
      },
    });

    track(`growth.converted_opportunity.${actionType}`, {
      lane: opp.lane,
      opportunityId: opp.id,
      metadata: {
        sourceSignalId: opp.sourceSignalId,
        partner: opp.partner,
        actionType,
      },
    });

    if (actionType === "open_signal") {
      setSelectedOpportunity(opp);
      setSelectedReferral(null);
    }

    flash(labels[actionType] || "Converted opportunity action logged.");
  }, [track, flash]);

  const showLearning = React.useCallback(() => {
    track("growth.learning.report_viewed", {
      lane: selectedLane,
      metadata: {
        eventCount: events.length,
      },
    });
    setShowLearningReport(true);
  }, [track, selectedLane, events.length]);

  return (
    <div className="pg-shell">
      <LeftNav selectedLane={selectedLane} onNavClick={(item) => {
        track("growth.nav.selected", { lane: selectedLane, metadata: { item } });
        flash(`${item} selected.`);
      }} />

      <div className="pg-app">
        <TopBar selectedLane={selectedLane} />

        <main className="pg-main">
          <CommandHeader
            selectedLane={selectedLane}
            totalValue={totalValue}
            activePartners={filteredOpps.length + filteredRefs.length + 120}
            onAction={handleAction}
          />

          <KpiStrip
            filteredOpps={filteredOpps}
            filteredRefs={filteredRefs}
            selectedLane={selectedLane}
            onKpi={handleKpi}
          />

          <section className="pg-contentGrid">
            <div className="pg-contentMain">
              <Pipeline filteredOpps={filteredOpps} selectedLane={selectedLane} onStage={handleStage} />
              <ServiceLaneRouter selectedLane={selectedLane} onSelectLane={selectLane} />
              <OpportunityCards
                filteredOpps={filteredOpps}
                selectedOpportunity={selectedOpportunity}
                onSelectOpportunity={selectOpportunity}
                onRecommendation={useRecommendation}
                onConvertedAction={handleConvertedOpportunityAction}
              />
              <LaneSummaryPanels selectedLane={selectedLane} onPanel={(panel) => {
                track("growth.special_lane.selected", {
                  lane: selectedLane,
                  metadata: {
                    panel: panel.title,
                    value: panel.value,
                  },
                });
                flash(`${panel.title} selected.`);
              }} />
            </div>

            <aside className="pg-rightRail">
              <AIAnalystRail
                selectedLane={selectedLane}
                selectedOpportunity={selectedOpportunity}
                events={events}
                onRecommendation={useRecommendation}
                onLearningReport={showLearning}
              />
              <HubSignalIntelligencePanel selectedLane={selectedLane} />
              <FrictionPanel filteredRefs={filteredRefs} filteredOpps={filteredOpps} onReview={handleFriction} />
              <ReferralQueue filteredRefs={filteredRefs} selectedReferral={selectedReferral} onSelectReferral={selectReferral} />
              <GrowthFeed selectedLane={selectedLane} />
            </aside>
          </section>

          <InstitutionalFooter
            logoSrc="/assets/shs/shs-logo-mark.svg"
            version="Growth Engine V2C"
            env="Local / Development"
          />
        </main>
      </div>

      <DetailDrawer
        selectedOpportunity={selectedOpportunity}
        selectedReferral={selectedReferral}
        onClose={() => {
          setSelectedOpportunity(null);
          setSelectedReferral(null);
        }}
        onRecommendation={useRecommendation}
        onRouteReferral={routeReferral}
      />

      {showLearningReport && (
        <LearningReportCard events={events} onClose={() => setShowLearningReport(false)} />
      )}

      {toast && <div className="pg-toast">{toast}</div>}
    </div>
  );
}
