    >
      {children}
    </button>
  );
}

function useAdaptiveEvents() {
  const [events, setEvents] = React.useState(() => readStoredEvents());

  const track = React.useCallback((eventType, payload = {}) => {
    const event = {
      id: `growth_evt_${Date.now()}_${Math.random().toString(16).slice(2)}`,
      surface: SURFACE,
      eventType,
      actorRole: "growth_admin",
      lane: payload.lane || "All Lanes",
      opportunityId: payload.opportunityId || null,
      referralId: payload.referralId || null,
      recommendationId: payload.recommendationId || null,
      metadata: payload.metadata || {},
      timestamp: new Date().toISOString(),
    };

    setEvents((prev) => {
      const next = [event, ...prev].slice(0, 150);
      writeStoredEvents(next);
      return next;
    });

    try {
      window.dispatchEvent(new CustomEvent("shs:growth-adaptive-event", { detail: event }));
    } catch {}

    return event;
  }, []);

  return { events, track };
}

