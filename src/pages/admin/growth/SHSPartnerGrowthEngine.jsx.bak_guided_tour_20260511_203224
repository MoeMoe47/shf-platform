function writeConvertedOpportunityAction(action) {
  const event = {
    id: `converted_action_${Date.now()}_${Math.random().toString(16).slice(2)}`,
    surface: "partner_growth_engine",
    eventType: `growth.converted_opportunity.${action.actionType}`,
    opportunityId: action.opportunityId,
    sourceSignalId: action.sourceSignalId || null,
    partner: action.partner || null,
    lane: action.lane || null,
    metadata: action.metadata || {},
    timestamp: new Date().toISOString(),
  };

  try {
    const previousActions = JSON.parse(localStorage.getItem("shs_growth_converted_opportunity_actions_v1") || "[]");
    localStorage.setItem(
      "shs_growth_converted_opportunity_actions_v1",
      JSON.stringify([event, ...previousActions].slice(0, 200))
    );

    const previousFeedback = JSON.parse(localStorage.getItem("shs_growth_feedback_events_v1") || "[]");
    localStorage.setItem(
      "shs_growth_feedback_events_v1",
      JSON.stringify([event, ...previousFeedback].slice(0, 200))
    );

    const previousAdaptive = JSON.parse(localStorage.getItem("shs_growth_adaptive_events_v1") || "[]");
    localStorage.setItem(
      "shs_growth_adaptive_events_v1",
      JSON.stringify([event, ...previousAdaptive].slice(0, 200))
    );

    window.dispatchEvent(new CustomEvent("shs:growth-converted-opportunity-action", { detail: event }));
  } catch {
    // localStorage may be unavailable
  }

  return event;
}

function readConvertedHubOpportunities() {
  try {
    const raw = JSON.parse(localStorage.getItem("shs_growth_converted_signals_v1") || "[]");
    return raw.map((item) => {
      const lanes = Array.isArray(item.serviceLanes) && item.serviceLanes.length
        ? item.serviceLanes
        : ["SHS Infrastructure"];

      const primaryLane = lanes[0] || "SHS Infrastructure";
      const secondaryLanes = lanes.slice(1);

      return {
        id: item.id || `converted_${item.sourceSignalId || Date.now()}`,
        sourceSignalId: item.sourceSignalId || null,
        partner: item.organizationName || "Hub Converted Opportunity",
        logo: makeInitials(item.organizationName || "Hub Signal"),
        type: "Converted Hub signal",
        lane: primaryLane,
        secondaryLanes,
        stage: item.stage || "Service Fit",
        value: Number(item.estimatedValue || 0),
        valueLabel: formatOpportunityValue(item.estimatedValue || 0),
        probability: Number(item.conversionProbability || 65),
        priorityScore: Number(item.priority || 78),
        risk: Number(item.frictionRisk || 20) >= 45 ? "High" : Number(item.frictionRisk || 20) >= 28 ? "Medium" : "Low",
        source: item.source || "Adaptive Growth Optimization Layer",
        owner: item.owner || "Growth Team",
        ownerInitials: makeInitials(item.owner || "Growth Team"),
        dueDate: "Next 7 days",
        next: item.nextStep || "Review converted Hub signal",
        recommendation: item.nextStep || "Review this Hub signal and prepare the correct service-lane action.",
        confidence: Number(item.conversionProbability || 75),
        why: Array.isArray(item.notes) && item.notes.length
          ? item.notes
          : [
              "This opportunity was converted from a scored Hub signal.",
              "The Adaptive Growth Optimization Layer recommended this service-lane fit.",
              "Growth Engine should review next step, owner, and pilot path.",
            ],
        convertedFromHub: true,
        convertedAt: item.createdAt || new Date().toISOString(),
      };
    });
  } catch {
    return [];
  }
}

