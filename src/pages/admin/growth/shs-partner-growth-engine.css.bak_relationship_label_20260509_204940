}

.pg-insight {
  min-height: 48px;
}

.pg-insight p {
  font-size: 10.5px;
}

.pg-friction {
  background:
    radial-gradient(circle at 0 0, rgba(255, 157, 82, 0.13), transparent 38%),
    linear-gradient(145deg, rgba(18, 22, 32, 0.95), rgba(5, 14, 25, 0.92));
}

.pg-friction button {
  min-height: 40px;
}

/* Referral queue + growth feed: reduce height but keep clarity */
.pg-refItem {
  min-height: 58px;
}

.pg-feedList article {
  padding-bottom: 8px;
}

.pg-feedList strong {
  font-size: 10.5px;
}

.pg-feedList span {
  font-size: 10.5px;
  line-height: 1.3;
}

/* Funding / Employer / Pharmacy summary cards */
.pg-laneSummaryGrid {
  gap: 9px;
}

.pg-laneSummary {
  min-height: 104px;
  padding: 12px;
  grid-template-columns: auto minmax(0, 1fr) auto;
  grid-template-areas:
    "icon title value"
    "icon title count"
    "top top top"
    "spark spark spark";
}

.pg-laneSummary h3 {
  font-size: 13px;
}

.pg-laneSummary p {
  font-size: 10px;
}

.pg-laneSummary strong,
.pg-laneSummary em {
  font-size: 20px;
}

.pg-laneSummary small {
  margin-top: 5px;
  font-size: 10px;
}

.pg-summarySpark {
  height: 20px;
}

/* Fine visual texture */
.pg-panel,
.pg-kpi,
.pg-oppCard,
.pg-refItem,
.pg-laneSummary {
  box-shadow:
    inset 0 1px 0 rgba(255, 255, 255, 0.04),
    0 18px 52px rgba(0, 0, 0, 0.23);
}

.pg-panel::before {
  content: "";
  display: block;
  height: 1px;
  margin: -14px -14px 12px;
  background: linear-gradient(90deg, transparent, rgba(57, 216, 255, 0.24), transparent);
  opacity: 0.55;
}

/* Keep service lanes one row on the current screenshot width range */
@media (min-width: 1181px) {
  .pg-laneGrid {
    grid-template-columns: repeat(5, minmax(0, 1fr)) !important;
  }

  .pg-laneCard {
    min-width: 0;
  }
}

/* Laptop width tuning */
@media (min-width: 1181px) and (max-width: 1500px) {
  .pg-shell {
    grid-template-columns: 214px minmax(0, 1fr);
  }

  .pg-sidebar {
    padding-left: 12px;
    padding-right: 12px;
  }

  .pg-logo {
    font-size: 40px;
  }

  .pg-main {
    padding: 16px 20px 22px;
  }

  .pg-topbar {
    height: 50px;
    padding-left: 20px;
    padding-right: 20px;
  }

  .pg-contentGrid {
    grid-template-columns: minmax(0, 1fr) 315px;
    gap: 13px;
  }

  .pg-commandTitle h1 {
    font-size: clamp(31px, 3vw, 42px);
  }

  .pg-commandTitle p {
    font-size: 12.5px;
    max-width: 630px;
  }

  .pg-actions {
    gap: 8px;
  }

  .pg-btn {
    height: 36px;
    padding: 0 11px;
    font-size: 11px;
  }

  .pg-btn--primary {
    min-width: 160px;
  }

  .pg-kpi {
    min-height: 92px;
  }

  .pg-stage {
    min-height: 90px;
  }

  .pg-laneCard {
    min-height: 148px;
  }

  .pg-panel {
    padding: 13px;
  }

  .pg-panel::before {
    margin: -13px -13px 11px;
  }

  .pg-rightRail {
    top: 60px;
  }
}

/* Large monitor: restore fuller card details */
@media (min-width: 1600px) {
  .pg-contentGrid {
    grid-template-columns: minmax(0, 1fr) 360px;
  }

  .pg-laneCard {
    min-height: 172px;
    padding: 13px;
  }

  .pg-laneTop h3 {
    font-size: 14px;
  }

  .pg-laneTop small {
    font-size: 10px;
  }

  .pg-laneCard p {
    font-size: 11px;
  }

  .pg-laneLearning {
    font-size: 10px;
  }
}

/* Tablet collapse */
@media (max-width: 1180px) {
  .pg-contentGrid {
    grid-template-columns: 1fr;
  }

  .pg-rightRail {
    position: static;
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
  }

  .pg-laneGrid {
    grid-template-columns: repeat(2, minmax(0, 1fr)) !important;
  }
}

/* Mobile */
@media (max-width: 760px) {
  .pg-rightRail,
  .pg-kpis,
  .pg-pipelineLine,
  .pg-opportunityGrid,
  .pg-laneSummaryGrid {
    grid-template-columns: 1fr;
  }

  .pg-laneGrid {
    grid-template-columns: 1fr !important;
  }

  .pg-commandTitle h1 {
    font-size: 34px;
  }
}


