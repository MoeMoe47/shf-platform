:root {
  --pg-bg: #050b14;
  --pg-bg2: #071421;
  --pg-sidebar: #030914;
  --pg-panel: rgba(8, 22, 40, 0.88);
  --pg-panel2: rgba(10, 29, 52, 0.82);
  --pg-stroke: rgba(113, 211, 255, 0.18);
  --pg-stroke2: rgba(113, 211, 255, 0.34);
  --pg-text: #ecf8ff;
  --pg-muted: rgba(221, 238, 255, 0.7);
  --pg-soft: rgba(221, 238, 255, 0.52);
  --pg-cyan: #39d8ff;
  --pg-blue: #1677ff;
  --pg-green: #4ee6a8;
  --pg-gold: #ffd56a;
  --pg-violet: #9e8cff;
  --pg-teal: #38e6db;
  --pg-orange: #ff9d52;
  --pg-danger: #ff6681;
  --pg-shadow: 0 24px 70px rgba(0, 0, 0, 0.42);
}

* {
  box-sizing: border-box;
}

.pg-shell {
  min-height: 100vh;
  display: grid;
  grid-template-columns: 248px minmax(0, 1fr);
  background:
    radial-gradient(circle at 10% 4%, rgba(57, 216, 255, 0.15), transparent 32%),
    radial-gradient(circle at 92% 0%, rgba(22, 119, 255, 0.14), transparent 34%),
    linear-gradient(135deg, var(--pg-bg), var(--pg-bg2) 52%, #03101d);
  color: var(--pg-text);
  font-family: Inter, ui-sans-serif, system-ui, -apple-system, BlinkMacSystemFont, "Segoe UI", sans-serif;
  overflow-x: hidden;
}

.pg-sidebar {
  position: sticky;
  top: 0;
  height: 100vh;
  display: flex;
  flex-direction: column;
  border-right: 1px solid var(--pg-stroke);
  background:
    linear-gradient(180deg, rgba(4, 13, 24, 0.98), rgba(2, 8, 16, 0.98)),
    radial-gradient(circle at 100% 10%, rgba(57, 216, 255, 0.12), transparent 40%);
  padding: 24px 16px 18px;
}

.pg-logoBlock {
  margin-bottom: 22px;
  padding: 0 10px;
}

.pg-logo {
  font-size: 48px;
  line-height: 0.85;
  letter-spacing: -0.08em;
  font-weight: 950;
  color: #18a8ff;
  text-shadow: 0 0 24px rgba(24, 168, 255, 0.44);
}

.pg-logoSub {
  margin-top: 8px;
  color: #71d3ff;
  font-size: 10px;
  font-weight: 900;
  letter-spacing: 0.12em;
  text-transform: uppercase;
}

.pg-nav {
  display: grid;
  gap: 4px;
}

.pg-navItem {
  width: 100%;
  height: 42px;
  display: flex;
  align-items: center;
  gap: 12px;
  border: 1px solid transparent;
  border-radius: 12px;
  padding: 0 12px;
  color: var(--pg-muted);
  background: transparent;
  text-align: left;
  font-weight: 760;
  cursor: pointer;
}

.pg-navItem:hover,
.pg-navItem.is-active {
  color: #fff;
  border-color: rgba(57, 216, 255, 0.35);
  background: linear-gradient(90deg, rgba(22, 119, 255, 0.4), rgba(57, 216, 255, 0.1));
  box-shadow: 0 0 28px rgba(22, 119, 255, 0.18);
}

.pg-navIcon {
  width: 22px;
  color: #aeeeff;
  text-align: center;
  font-weight: 900;
}

.pg-systemCard {
  margin-top: auto;
  border: 1px solid rgba(57, 216, 255, 0.18);
  border-radius: 16px;
  padding: 14px;
  background: rgba(6, 19, 34, 0.75);
}

.pg-systemCard strong,
.pg-userCard strong {
  display: block;
  font-size: 13px;
}

.pg-systemCard span,
.pg-systemCard small,
.pg-userCard small {
  display: block;
  margin-top: 8px;
  color: var(--pg-muted);
  font-size: 12px;
}

.pg-dot {
  display: inline-block;
  width: 8px;
  height: 8px;
  margin-right: 7px;
  border-radius: 50%;
  background: var(--pg-green);
  box-shadow: 0 0 14px rgba(78, 230, 168, 0.8);
}

.pg-userCard {
  display: flex;
  align-items: center;
  gap: 12px;
  margin-top: 12px;
  border: 1px solid rgba(113, 211, 255, 0.14);
  border-radius: 16px;
  padding: 12px;
  background: rgba(255, 255, 255, 0.035);
}

.pg-avatar {
  width: 42px;
  height: 42px;
  display: grid;
  place-items: center;
  border-radius: 50%;
  background: linear-gradient(135deg, rgba(57, 216, 255, 0.85), rgba(78, 230, 168, 0.72));
  color: #02111d;
  font-weight: 950;
}

.pg-app {
  min-width: 0;
}

.pg-topbar {
  position: sticky;
  top: 0;
  z-index: 20;
  height: 58px;
  display: grid;
  grid-template-columns: auto minmax(340px, 520px) auto;
  gap: 18px;
  align-items: center;
  border-bottom: 1px solid var(--pg-stroke);
  background: rgba(3, 10, 18, 0.86);
  backdrop-filter: blur(18px);
  padding: 0 28px;
}

.pg-topbarLeft,
.pg-topbarRight {
  display: flex;
  align-items: center;
  gap: 14px;
}

.pg-menu {
  color: #dff7ff;
  font-size: 18px;
}

.pg-sectionLabel {
  color: var(--pg-cyan);
  font-size: 13px;
  font-weight: 900;
}

.pg-search {
  height: 36px;
  display: grid;
  grid-template-columns: auto 1fr auto;
  gap: 10px;
  align-items: center;
  border: 1px solid rgba(113, 211, 255, 0.18);
  border-radius: 8px;
  background: rgba(5, 14, 25, 0.92);
  padding: 0 11px;
}

.pg-search input {
  min-width: 0;
  border: 0;
  outline: 0;
  background: transparent;
  color: var(--pg-text);
  font-size: 13px;
}

.pg-search input::placeholder {
  color: var(--pg-soft);
}

.pg-search span,
.pg-search kbd {
  color: var(--pg-soft);
  font-size: 12px;
}

.pg-topbarRight {
  justify-content: flex-end;
}

.pg-topbarRight strong {
  color: #18a8ff;
  font-size: 22px;
  font-weight: 950;
}

.pg-notify {
  position: relative;
}

.pg-notify i {
  position: absolute;
  top: -9px;
  right: -10px;
  min-width: 17px;
  height: 17px;
  display: grid;
  place-items: center;
  border-radius: 999px;
  background: var(--pg-blue);
  color: #fff;
  font-size: 10px;
  font-style: normal;
  font-weight: 900;
}

.pg-help {
  width: 24px;
  height: 24px;
  display: grid;
  place-items: center;
  border: 1px solid rgba(255, 255, 255, 0.24);
  border-radius: 50%;
  color: var(--pg-muted);
}

.pg-main {
  padding: 28px;
}

.pg-commandHeader {
  display: grid;
  grid-template-columns: minmax(0, 1fr) auto;
  gap: 18px;
  align-items: start;
}

.pg-commandTitle h1 {
  margin: 14px 0 6px;
  font-size: clamp(34px, 4vw, 56px);
  line-height: 0.96;
  letter-spacing: -0.06em;
}

.pg-commandTitle p {
  max-width: 780px;
  margin: 0;
  color: var(--pg-muted);
  font-size: 15px;
}

.pg-actions {
  display: flex;
  flex-wrap: wrap;
  justify-content: flex-end;
  gap: 10px;
}

.pg-btn,
.pg-linkBtn,
.pg-wideAction {
  border: 1px solid rgba(113, 211, 255, 0.22);
  border-radius: 11px;
  background: rgba(5, 16, 29, 0.82);
  color: var(--pg-text);
  padding: 10px 14px;
  font-weight: 880;
  cursor: pointer;
  box-shadow: inset 0 1px 0 rgba(255, 255, 255, 0.06);
}

.pg-btn:hover,
.pg-linkBtn:hover,
.pg-wideAction:hover {
  border-color: rgba(57, 216, 255, 0.55);
  transform: translateY(-1px);
}

.pg-btn--primary {
  min-width: 190px;
  border-color: rgba(57, 216, 255, 0.7);
  background: linear-gradient(135deg, #0877ff, #0cbcff);
  color: #fff;
  box-shadow: 0 14px 44px rgba(22, 119, 255, 0.32);
}

.pg-strategyStrip {
  grid-column: 1 / -1;
  display: grid;
  grid-template-columns: 1.8fr 1.1fr 1fr 1fr 0.8fr;
  gap: 1px;
  overflow: hidden;
  margin-top: 4px;
  border: 1px solid var(--pg-stroke);
  border-radius: 12px;
  background: rgba(113, 211, 255, 0.13);
}

.pg-strategyStrip div {
  min-height: 48px;
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 12px;
  padding: 10px 16px;
  background: rgba(8, 22, 40, 0.9);
}

.pg-strategyStrip strong {
  font-size: 12px;
  color: var(--pg-muted);
}

.pg-strategyStrip span {
  font-size: 13px;
  font-weight: 900;
}

.pg-progress {
  min-width: 160px;
  display: flex;
  align-items: center;
  gap: 10px;
}

.pg-progress i {
  height: 7px;
  display: block;
  border-radius: 999px;
  background: linear-gradient(90deg, var(--pg-cyan), var(--pg-blue));
}

.pg-badge {
  display: inline-flex;
  width: fit-content;
  align-items: center;
  justify-content: center;
  padding: 6px 9px;
  border: 1px solid rgba(113, 211, 255, 0.24);
  border-radius: 999px;
  background: rgba(113, 211, 255, 0.08);
  color: #bfefff;
  font-size: 10px;
  font-weight: 950;
  letter-spacing: 0.08em;
  text-transform: uppercase;
  white-space: nowrap;
}

.pg-badge--cyan { border-color: rgba(57, 216, 255, 0.32); color: #aef3ff; background: rgba(57, 216, 255, 0.1); }
.pg-badge--green { border-color: rgba(78, 230, 168, 0.34); color: #b7ffd9; background: rgba(78, 230, 168, 0.1); }
.pg-badge--violet { border-color: rgba(158, 140, 255, 0.38); color: #d8d1ff; background: rgba(158, 140, 255, 0.1); }
.pg-badge--orange { border-color: rgba(255, 157, 82, 0.4); color: #ffd6b8; background: rgba(255, 157, 82, 0.12); }
.pg-badge--blue { border-color: rgba(22, 119, 255, 0.32); color: #cde3ff; background: rgba(22, 119, 255, 0.12); }

.pg-kpis {
  display: grid;
  grid-template-columns: repeat(8, minmax(0, 1fr));
  gap: 10px;
  margin-top: 18px;
}

.pg-kpi {
  min-height: 126px;
  position: relative;
  overflow: hidden;
  border: 1px solid var(--pg-stroke);
  border-radius: 14px;
  background: linear-gradient(145deg, rgba(10, 29, 52, 0.92), rgba(5, 17, 32, 0.9));
  color: var(--pg-text);
  padding: 14px;
  text-align: left;
  cursor: pointer;
}

.pg-kpi::after {
  content: "";
  position: absolute;
  inset: auto 0 0;
  height: 3px;
  background: linear-gradient(90deg, transparent, var(--pg-cyan), transparent);
  opacity: 0.48;
}

.pg-kpiIcon {
  width: 28px;
  height: 28px;
  display: grid;
  place-items: center;
  border-radius: 9px;
  background: rgba(57, 216, 255, 0.1);
  color: #aef3ff;
  font-size: 13px;
  font-weight: 900;
}

.pg-kpiLabel {
  display: block;
  margin-top: 11px;
  color: var(--pg-muted);
  font-size: 11px;
  font-weight: 900;
}

.pg-kpi strong {
  display: block;
  margin-top: 12px;
  font-size: 28px;
  letter-spacing: -0.04em;
}

.pg-kpi small {
  display: block;
  margin-top: 8px;
  color: var(--pg-green);
  font-size: 11px;
  font-weight: 800;
}

.pg-contentGrid {
  display: grid;
  grid-template-columns: minmax(0, 1fr) 360px;
  gap: 18px;
  margin-top: 18px;
}

.pg-contentMain,
.pg-rightRail {
  display: flex;
  flex-direction: column;
  gap: 18px;
  min-width: 0;
}

.pg-panel {
  border: 1px solid var(--pg-stroke);
  border-radius: 16px;
  background:
    linear-gradient(145deg, rgba(9, 25, 45, 0.9), rgba(4, 15, 27, 0.88)),
    radial-gradient(circle at 0% 0%, rgba(57, 216, 255, 0.09), transparent 38%);
  box-shadow: var(--pg-shadow);
  padding: 16px;
}

.pg-panelHead {
  display: flex;
  align-items: flex-start;
  justify-content: space-between;
  gap: 14px;
  margin-bottom: 14px;
}

.pg-panelHead h2 {
  margin: 0;
  font-size: 18px;
  letter-spacing: -0.03em;
}

.pg-panelHead p {
  margin: 6px 0 0;
  color: var(--pg-muted);
  font-size: 13px;
  line-height: 1.45;
}

.pg-panelMetric {
  text-align: right;
}

.pg-panelMetric span {
  display: block;
  color: var(--pg-muted);
  font-size: 12px;
  font-weight: 800;
}

.pg-panelMetric strong {
  display: block;
  margin-top: 4px;
  color: var(--pg-cyan);
  font-size: 28px;
  letter-spacing: -0.04em;
}

.pg-pipelineLine {
  position: relative;
  display: grid;
  grid-template-columns: repeat(8, minmax(0, 1fr));
  gap: 1px;
  overflow: hidden;
  border-radius: 12px;
  background: rgba(113, 211, 255, 0.12);
}

.pg-pipelineLine::before {
  content: "";
  position: absolute;
  top: 16px;
  left: 24px;
  right: 24px;
  height: 3px;
  background: linear-gradient(90deg, var(--pg-blue), var(--pg-cyan), var(--pg-blue));
  box-shadow: 0 0 18px rgba(57, 216, 255, 0.6);
}

.pg-stage {
  position: relative;
  min-height: 122px;
  border: 0;
  background: rgba(6, 19, 35, 0.96);
  color: var(--pg-text);
  padding: 34px 12px 12px;
  text-align: left;
  cursor: pointer;
}

.pg-stageNode {
  position: absolute;
  top: 11px;
  left: 18px;
  width: 13px;
  height: 13px;
  border: 2px solid #fff;
  border-radius: 50%;
  background: var(--pg-cyan);
  box-shadow: 0 0 20px rgba(57, 216, 255, 0.9);
}

.pg-stageName {
  color: var(--pg-muted);
  font-size: 12px;
  font-weight: 800;
}

.pg-stage strong {
  display: block;
  margin-top: 12px;
  font-size: 24px;
}

.pg-stage em {
  display: block;
  color: var(--pg-muted);
  font-size: 12px;
  font-style: normal;
}

.pg-miniBars {
  display: block;
  width: 82px;
  height: 24px;
  margin-top: 8px;
  background:
    linear-gradient(to top, rgba(22, 119, 255, 0.9) 20%, transparent 20%),
    repeating-linear-gradient(90deg, rgba(57, 216, 255, 0.7) 0 4px, transparent 4px 9px);
  opacity: 0.82;
  clip-path: polygon(0 100%, 0 calc(100% - var(--level)), 100% 0, 100% 100%);
}

.pg-laneGrid {
  display: grid;
  grid-template-columns: repeat(5, minmax(0, 1fr));
  gap: 12px;
}

.pg-laneCard {
  min-height: 220px;
  display: flex;
  flex-direction: column;
  border: 1px solid rgba(113, 211, 255, 0.18);
  border-radius: 16px;
  background: rgba(10, 29, 52, 0.74);
  color: var(--pg-text);
  padding: 15px;
  text-align: left;
  cursor: pointer;
}

.pg-laneCard.is-selected {
  border-color: rgba(255, 255, 255, 0.45);
  box-shadow: 0 0 0 1px rgba(57, 216, 255, 0.25), 0 20px 50px rgba(57, 216, 255, 0.11);
}

.pg-laneCard--green { background: linear-gradient(145deg, rgba(12, 84, 56, 0.58), rgba(7, 30, 30, 0.78)); }
.pg-laneCard--violet { background: linear-gradient(145deg, rgba(54, 43, 115, 0.58), rgba(14, 20, 47, 0.82)); }
.pg-laneCard--gold { background: linear-gradient(145deg, rgba(104, 83, 24, 0.58), rgba(27, 28, 20, 0.82)); }
.pg-laneCard--teal { background: linear-gradient(145deg, rgba(16, 83, 88, 0.58), rgba(8, 30, 41, 0.82)); }
.pg-laneCard--blue { background: linear-gradient(145deg, rgba(22, 76, 148, 0.6), rgba(8, 22, 45, 0.82)); }

.pg-laneTop {
  display: flex;
  align-items: center;
  gap: 12px;
}

.pg-laneIcon {
  width: 48px;
  height: 48px;
  display: grid;
  place-items: center;
  border-radius: 16px;
  background: rgba(255, 255, 255, 0.1);
  font-size: 24px;
  font-weight: 950;
}

.pg-laneTop h3 {
  margin: 0;
  font-size: 15px;
}

.pg-laneTop small {
  display: block;
  margin-top: 4px;
  color: var(--pg-muted);
  font-size: 11px;
  line-height: 1.3;
}

.pg-laneCard p {
  margin: 13px 0 0;
  color: var(--pg-muted);
  font-size: 12px;
  line-height: 1.45;
}

.pg-laneMetrics {
  display: grid;
  grid-template-columns: repeat(3, 1fr);
  gap: 6px;
  margin-top: auto;
  padding-top: 12px;
}

.pg-laneMetrics span {
  font-size: 11px;
  color: var(--pg-muted);
}

.pg-laneMetrics strong {
  display: block;
  color: var(--pg-text);
  font-size: 17px;
}

.pg-laneLearning {
  margin-top: 12px;
  border-top: 1px solid rgba(255, 255, 255, 0.12);
  padding-top: 10px;
  color: var(--pg-muted);
  font-size: 11px;
  line-height: 1.4;
}

.pg-laneLearning strong {
  color: #fff;
}

.pg-opportunityGrid {
  display: grid;
  grid-template-columns: repeat(2, minmax(0, 1fr));
  gap: 12px;
}

.pg-oppCard {
  overflow: hidden;
  border: 1px solid rgba(113, 211, 255, 0.16);
  border-radius: 16px;
  background: rgba(8, 23, 42, 0.86);
}

.pg-oppCard.is-selected {
  border-color: rgba(57, 216, 255, 0.56);
  box-shadow: 0 0 0 1px rgba(57, 216, 255, 0.16);
}

.pg-oppMain {
  width: 100%;
  border: 0;
  background: transparent;
  color: var(--pg-text);
  padding: 14px;
  text-align: left;
  cursor: pointer;
}

.pg-oppTop {
  display: grid;
  grid-template-columns: auto minmax(0, 1fr) auto;
  gap: 10px;
  align-items: center;
}

.pg-oppLogo {
  width: 42px;
  height: 42px;
  display: grid;
  place-items: center;
  border-radius: 12px;
  background: #fff;
  color: #0a2032;
  font-weight: 950;
}

.pg-oppTop h3 {
  margin: 0;
  font-size: 15px;
}

.pg-oppTop small {
  display: block;
  margin-top: 3px;
  color: var(--pg-muted);
}

.pg-oppMetrics {
  display: grid;
  grid-template-columns: repeat(3, 1fr);
  gap: 8px;
  margin-top: 14px;
}

.pg-oppMetrics span {
  border: 1px solid rgba(113, 211, 255, 0.12);
  border-radius: 12px;
  padding: 9px;
  background: rgba(255, 255, 255, 0.035);
}

.pg-oppMetrics small,
.pg-nextStep small {
  display: block;
  color: var(--pg-soft);
  font-size: 10px;
  font-weight: 900;
  text-transform: uppercase;
}

.pg-oppMetrics strong {
  display: block;
  margin-top: 4px;
  font-size: 17px;
}

.pg-laneFit {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 10px;
  margin-top: 12px;
  color: var(--pg-cyan);
  font-size: 12px;
  font-weight: 900;
}

.pg-laneFit em {
  color: var(--pg-muted);
  font-style: normal;
  font-weight: 700;
}

.pg-nextStep {
  margin-top: 12px;
}

.pg-nextStep strong {
  display: block;
  margin-top: 3px;
  font-size: 13px;
}

.pg-nextStep span {
  display: block;
  margin-top: 3px;
  color: var(--pg-muted);
  font-size: 12px;
}

.pg-recommendation {
  display: grid;
  grid-template-columns: minmax(0, 1fr) auto;
  gap: 10px;
  align-items: center;
  border-top: 1px solid rgba(113, 211, 255, 0.12);
  padding: 12px 14px;
  background: rgba(57, 216, 255, 0.045);
}

.pg-recommendation strong {
  display: block;
  color: #fff;
  font-size: 12px;
}

.pg-recommendation p {
  margin: 4px 0 0;
  color: var(--pg-muted);
  font-size: 12px;
  line-height: 1.35;
}

.pg-recommendation button,
.pg-detailSection button,
.pg-whyBox button {
  border: 1px solid rgba(78, 230, 168, 0.3);
  border-radius: 999px;
  background: rgba(78, 230, 168, 0.11);
  color: #b7ffd9;
  padding: 8px 10px;
  font-size: 11px;
  font-weight: 950;
  cursor: pointer;
}

.pg-laneSummaryGrid {
  display: grid;
  grid-template-columns: repeat(3, minmax(0, 1fr));
  gap: 12px;
}

.pg-laneSummary {
  min-height: 126px;
  display: grid;
  grid-template-columns: auto minmax(0, 1fr) auto auto;
  gap: 12px;
  align-items: start;
  border: 1px solid rgba(113, 211, 255, 0.16);
  border-radius: 16px;
  background: rgba(8, 23, 42, 0.86);
  color: var(--pg-text);
  padding: 15px;
  text-align: left;
  cursor: pointer;
}

.pg-summaryIcon {
  width: 34px;
  height: 34px;
  display: grid;
  place-items: center;
  border-radius: 11px;
  background: rgba(57, 216, 255, 0.12);
  color: var(--pg-cyan);
  font-weight: 950;
}

.pg-laneSummary h3 {
  margin: 0;
  font-size: 15px;
}

.pg-laneSummary p,
.pg-laneSummary small {
  display: block;
  margin: 5px 0 0;
  color: var(--pg-muted);
  font-size: 12px;
}

.pg-laneSummary strong {
