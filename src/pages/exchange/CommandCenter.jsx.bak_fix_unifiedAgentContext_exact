export default function CommandCenter({ onShellStateChange } = {}) {
  React.useEffect(() => {
    console.log("INIT LISTENER RUNNING");

    const handler = (e) => {
      console.log("SYSTEM RECEIVED ACTION:", e.detail?.type);
    };

    if (typeof window !== "undefined") {
      window.addEventListener("shf:ai_action", handler);
    }

    return () => {
      if (typeof window !== "undefined") {
        window.removeEventListener("shf:ai_action", handler);
      }
    };
  }, []);

  const [liveAgentContext, setLiveAgentContext] = React.useState(null);

  React.useEffect(() => {
    const handler = () => {
      if (typeof window !== "undefined" && window.__SHF_SIMULATION_STATE__) {
        setLiveAgentContext({ ...window.__SHF_SIMULATION_STATE__ });
      }
    };

    if (typeof window !== "undefined" && window.__SHF_SIMULATION_STATE__) {
      setLiveAgentContext({ ...window.__SHF_SIMULATION_STATE__ });
    }

    window.addEventListener("shf:update", handler);
    return () => window.removeEventListener("shf:update", handler);
  }, []);

  const [isAnalystDrawerOpen, setIsAnalystDrawerOpen] = React.useState(false);
  const [analystFocus, setAnalystFocus] = React.useState(null);
  const [simulationPaused, setSimulationPaused] = React.useState(false);
  const [simulationTickMs, setSimulationTickMs] = React.useState(5000);
  const [simulationStepNonce, setSimulationStepNonce] = React.useState(0);
  const {
    data,
    loading,
    error,
    refresh,
    activeCase,
    viewMode,
    setViewMode,
    selectedPanel,
    setSelectedPanel,
    selectedMetric,
    setSelectedMetric,
    agentAudience,
    setAgentAudience,
    systemStatus: liveSystemStatus,
    setSystemStatus,
    recommendation,
    setRecommendation,
    timelineStep,
    setTimelineStep,
    resetToLiveState,
    agentContext,
  } = useCommandCenterData();

  React.useEffect(() => {
    initAnalystListener({ setRecommendation, setTimelineStep });
  }, [setRecommendation, setTimelineStep]);

  React.useEffect(() => {
    initAnalystListener();
  }, []);

  
  // 🔥 SHF EVENT BRIDGE (sandbox → real state)
  React.useEffect(() => {
    const handler = (e) => {
      const action = e.detail?.type;

      console.log("🔥 COMMAND CENTER RECEIVED:", action);

      if (!action) return;

      try {
        if (typeof setTimelineStep === "function") {
          if (action === "execute") {
            setTimelineStep("action_queued");
          }

          if (action === "review") {
            setTimelineStep("verification_inquiry");
          }

          if (action === "hold") {
            setTimelineStep("risk_signal");
          }
        }
      } catch (err) {
        console.error("STATE UPDATE FAILED:", err);
      }
    };

    window.addEventListener("shf:ai_action", handler);
    return () => window.removeEventListener("shf:ai_action", handler);
  }, []);

  const simulationEngineContext = buildSimulationEngineContext({
    enabled: !simulationPaused,
    tickMs: simulationTickMs,
    stepNonce: simulationStepNonce,
    agentContext,
    recommendation,
    timelineStep,
    systemStatus,
  });

  const simulationFrame = useExchangeSimulation(simulationEngineContext);
  const simRecommendation = simulationFrame?.recommendation || null;
  const simAnalyst = simulationFrame?.analystSummary || null;
  const simulationViewData = buildSimulationViewData({
    simulationFrame,
    simAnalyst,
  });
  const liveTimelineStep =
    simulationFrame?.currentStage ||
    agentContext?.timelineStep ||
    timelineStep ||
    "risk_signal";

  const liveRecommendation = simRecommendation
    ? {
        ...recommendation,
        ...simRecommendation,
        reason: simRecommendation?.reason || simRecommendation?.note || recommendation?.reason,
      }
    : recommendation;


  const liveSystemStatus =
    simulationFrame?.systemStatus ||
    systemStatus;


  
  
  const rightPanelConfig = {
    risk_signal: {
      title: "Risk Signal Detected",
      status: "ALERT",
      severity: "HIGH",
      description: "Initial anomaly detected. Monitoring required before escalation.",
    },
    anomaly_clear: {
      title: "Anomaly Cleared",
      status: "STABLE",
      severity: "{activeRightPanel.severity}",
      description: "No further issues detected. System stabilized.",
    },
    verification_inquiry: {
      title: "Verification Inquiry",
      status: "REVIEW",
      severity: "MEDIUM",
      description: "Verification required before proceeding with action.",
    },
    action_queued: {
      title: "Action Queued",
      status: "{activeRightPanel.status}",
      severity: "{activeRightPanel.severity}",
      description: "Operator review required before execution.",
    },
    outcome_pending: {
      title: "Outcome Pending",
      status: "TRACKING",
      severity: "{activeRightPanel.severity}",
      description: "Outcome being monitored before validation.",
    },
    payment_pending: {
      title: "Payment Pending",
      status: "FUNDING",
      severity: "{activeRightPanel.severity}",
      description: "Awaiting funding release and final confirmation.",
    },
  };

  const activeRightPanel = rightPanelConfig[liveTimelineStep] || rightPanelConfig["risk_signal"];

  const rightPanelDisplay = {
    risk_signal: {
      title: "Risk Signal Detected",
      status: "ALERT",
      severity: "HIGH"
    },
    anomaly_clear: {
      title: "Anomaly Cleared",
      status: "STABLE",
      severity: "LOW"
    },
    verification_inquiry: {
      title: "Verification Inquiry",
      status: "REVIEW",
      severity: "MEDIUM"
    },
    action_queued: {
      title: "Action Queued",
      status: "READY",
      severity: "LOW"
    },
    outcome_pending: {
      title: "Outcome Pending",
      status: "TRACKING",
      severity: "LOW"
    },
    payment_pending: {
      title: "Payment Pending",
      status: "FUNDING",
      severity: "LOW"
    }
  };

  const panelUI = rightPanelDisplay[liveTimelineStep] || rightPanelDisplay["risk_signal"];

const computedAgentContext = buildComputedAgentContext({
    agentContext,
    liveRecommendation,
    recommendation,
    liveTimelineStep,
  });

  const activeAgentContext = buildActiveAgentContext({
    liveAgentContext,
    computedAgentContext,
  });

  const unifiedAgentContext = {
    ...activeAgentContext,

    // ONLY override specific fields from simulation
    timelineStep: simulationFrame?.currentStage || activeAgentContext?.timelineStep,
    systemStatus: liveSystemStatus,

    recommendation: simulationFrame?.recommendation
      ? {
          ...activeAgentContext?.recommendation,
          ...simulationFrame.recommendation,
        }
      : activeAgentContext?.recommendation,

    analystSummary: simulationFrame?.analystSummary || activeAgentContext?.analystSummary,
};
    ...activeAgentContext,
    recommendation: liveRecommendation,
    timelineStep: liveTimelineStep,
    systemStatus: liveSystemStatus,
    simulationAnalyst: simAnalyst,
  };

  const {
    handleGenerateBrief,
    handleOpenLatestBrief,
  } = useCommandCenterReportActions({
    agentContext: unifiedAgentContext,
    proofMetrics: data?.proofMetrics,
  });

  const predictive = buildPredictionLayer(
    unifiedAgentContext,
    agentAudience
  );

  const narrative = buildAnalystNarrative({
    predictionLayer: predictive,
    activeCase,
    systemStatus: liveSystemStatus,
    timelineStep: liveTimelineStep,
    recommendation: liveRecommendation,
    agentContext: unifiedAgentContext,
  });

  React.useEffect(() => {
    if (onShellStateChange) {
      onShellStateChange({
        predictive,
        narrative,
      });
    }
  }, [predictive, narrative, onShellStateChange]);

  const decisionSignal = buildDecisionSignal({
    predictive,
    liveRecommendation,
    recommendation,
    liveTimelineStep,
    systemStatus,
    narrative,
  });

  if (loading && !data) return <LoadingView />;
  if (error && !data) return <ErrorView error={error} refresh={refresh} />;

  return (
    <div style={{
        minHeight: "100vh",
        background: pageBg,
        padding: PAGE_PADDING,
        color: "#e9f2fa",
        fontFamily: "Inter, system-ui, sans-serif",
      }}>
      <AIAnalystDrawer
        isOpen={isAnalystDrawerOpen}
        onClose={() => setIsAnalystDrawerOpen(false)}
        agentContext={unifiedAgentContext}
        agentAudience={agentAudience}
        analystFocus={analystFocus}
        predictionLayer={predictive}
      />

      <div style={{ display: "grid", gap: 14 }}>
        <HeaderBar refresh={refresh} resetToLiveState={resetToLiveState} />
        <CommandCenterStats
          proofMetrics={data?.proofMetrics}
          selectedMetric={selectedMetric}
          setSelectedMetric={setSelectedMetric}
          setSelectedPanel={setSelectedPanel}
          onExplainFocus={(focus) => {
            setAnalystFocus(focus);
            setIsAnalystDrawerOpen(true);
          }}
        />
        <TopTabs />

        <FeatureGate feature="decisionSignal">
        <DecisionSignalCard
          label={decisionSignal.label}
          stateLabel={decisionSignal.stateLabel}
          tone={decisionSignal.tone}
          confidence={decisionSignal.confidence}
          recommendation={decisionSignal.recommendation}
        />
        </FeatureGate>

        <div className="alive-recommendation">

          <FeatureGate feature="reportActions">
          <CommandCenterReportActions
            onGenerate={handleGenerateBrief}
            onOpenLatest={handleOpenLatestBrief}
          />
          </FeatureGate>

          <RecommendedNextMove
          recommendation={liveRecommendation}
          activeCase={activeCase}
          predictive={predictive}
        />

        </div>


        <FeatureGate feature="simulationPanel">
        <SimulationControls
          isPaused={simulationPaused}
          setIsPaused={setSimulationPaused}
          tickMs={simulationTickMs}
          setTickMs={setSimulationTickMs}
          onStep={() => setSimulationStepNonce((n) => n + 1)}
        />
        <SimulationPanel
          simulation={simulationViewData}
        />
        </FeatureGate>

        <div style={{
            display: "grid",
            gridTemplateColumns: `${LEFT_W}px minmax(0, 1fr) ${RIGHT_W}px`,
            gap: GAP,
            alignItems: "start",
          }}>
          <LeftRail
            leftPanel={data?.leftPanel}
            activeCase={activeCase}
            selectedPanel={selectedPanel}
            setSelectedPanel={setSelectedPanel}
            onExplainFocus={(focus) => {
              setAnalystFocus(focus);
              setIsAnalystDrawerOpen(true);
            }}
          />
          <div style={{
              minWidth: 0,
              cursor: "pointer",
              borderRadius: 22,
              boxShadow:
                systemStatus === "on_hold"
                  ? "0 0 0 1px rgba(255,142,142,0.18), 0 0 34px rgba(200,70,70,0.14)"
                  : systemStatus === "approval_queued"
                  ? "0 0 0 1px rgba(122,224,178,0.18), 0 0 34px rgba(52,150,108,0.14)"
                  : selectedPanel === "center_scene"
                  ? "0 0 0 1px rgba(110,190,255,0.18), 0 0 34px rgba(68,146,234,0.12)"
                  : "none"
            }}
            onClick={() => {
              setSelectedPanel?.("center_scene");
              setAnalystFocus({
                type: "center_scene",
                title: viewMode === "executive" ? "Executive View" : "Operations View",
                value: systemStatus,
                explanation:
                  viewMode === "executive"
                    ? "This center scene is the executive view of the active case. It frames current state, status, and recommended action in a premium narrative surface."
                    : "This center scene is the operations view of the active case. It shows jurisdiction context, active routes, and state-aware operational emphasis."
              });
              setIsAnalystDrawerOpen(true);
            }}>
            
<div className="globe-command-panel">
  <GlobeScene
    viewMode={viewMode}
    setViewMode={setViewMode}
    activeCase={activeCase}
    systemStatus={systemStatus}
  />
</div>

          </div>
          <div style={{ minWidth: 0 }}>
            <RightDecisionPanel
              rightPanel={data?.rightPanel}
              activeCase={activeCase}
              selectedPanel={selectedPanel}
              setSelectedPanel={setSelectedPanel}
              setRecommendation={setRecommendation}
              setSystemStatus={setSystemStatus}
              setTimelineStep={setTimelineStep}
              timelineStep={liveTimelineStep}
              onExplainFocus={(focus) => {
                setAnalystFocus(focus);
                setIsAnalystDrawerOpen(true);
              }}
            />
          </div>
        </div>

        <BottomTimeline
          timelineStep={liveTimelineStep}
          bottomTimeline={data?.bottomTimeline}
          proofMetrics={data?.proofMetrics}
          systemStatus={systemStatus}
          setSelectedPanel={setSelectedPanel}
          onExplainFocus={(focus) => {
            setAnalystFocus(focus);
            setIsAnalystDrawerOpen(true);
          }}
        />

        <div className="alive-analyst">

          <AgentContextPreview
          agentContext={activeAgentContext}
          agentAudience={agentAudience}
          setAgentAudience={setAgentAudience}
          onOpenDrawer={() => setIsAnalystDrawerOpen(true)}
        />

          <AnalystPredictionCard
            agentContext={{
              timelineStep: liveTimelineStep,
              recommendation: liveRecommendation,
              activeCase
            }}
            agentAudience={agentAudience}
          />

        </div>

      </div>
    </div>
  );
}