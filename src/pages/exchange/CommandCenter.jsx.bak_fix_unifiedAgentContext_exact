                marginBottom: 6,
              }}>
              {label}
            </div>
            <div style={{
                color: "#edf5fe",
                fontSize: 13,
                fontWeight: 700,
                lineHeight: 1.25,
                wordBreak: "break-word",
              }}>
              {String(value)}
            </div>
          </div>
        ))}
      </div>
    </div>
  );
}

