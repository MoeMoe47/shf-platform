.top1-globe-shell {
  position: relative;
  isolation: isolate;
  overflow: visible;
  border-radius: 28px;
  border: 1px solid rgba(120, 170, 255, 0.20);
  background:
    radial-gradient(120% 90% at 50% 20%, rgba(66, 153, 225, 0.08) 0%, rgba(66, 153, 225, 0.03) 32%, rgba(5, 10, 20, 0.00) 60%),
    linear-gradient(180deg, rgba(10, 18, 30, 0.24) 0%, rgba(8, 14, 24, 0.34) 100%);
  box-shadow:
    inset 0 1px 0 rgba(255,255,255,0.06),
    inset 0 0 0 1px rgba(255,255,255,0.02),
    0 22px 60px rgba(0,0,0,0.28),
    0 0 0 1px rgba(93, 155, 255, 0.05);
}

.top1-globe-shell::before {
  content: "";
  position: absolute;
  left: 50%;
  bottom: -18px;
  transform: translateX(-50%);
  width: min(68%, 540px);
  height: 84px;
  border-radius: 999px;
  background: radial-gradient(
    closest-side,
    rgba(88, 166, 255, 0.28) 0%,
    rgba(88, 166, 255, 0.14) 34%,
    rgba(88, 166, 255, 0.06) 58%,
    rgba(88, 166, 255, 0.00) 100%
  );
  filter: blur(24px);
  z-index: 0;
  pointer-events: none;
}

.top1-globe-shell::after {
  content: "";
  position: absolute;
  inset: 0;
  border-radius: 28px;
  padding: 1px;
  background:
    linear-gradient(
      180deg,
      rgba(190, 220, 255, 0.22) 0%,
      rgba(120, 170, 255, 0.10) 24%,
      rgba(120, 170, 255, 0.05) 52%,
      rgba(255,255,255,0.03) 100%
    );
  -webkit-mask:
    linear-gradient(#000 0 0) content-box,
    linear-gradient(#000 0 0);
  -webkit-mask-composite: xor;
  mask-composite: exclude;
  z-index: 1;
  pointer-events: none;
}

.top1-globe-shell > * {
  position: relative;
  z-index: 2;
}

.top1-globe-shell canvas {
  filter: saturate(1.04) brightness(1.03);
  transform: translateZ(0);
}

.top1-globe-shell:hover {
  box-shadow:
    inset 0 1px 0 rgba(255,255,255,0.07),
    inset 0 0 0 1px rgba(255,255,255,0.025),
    0 26px 72px rgba(0,0,0,0.32),
    0 0 0 1px rgba(106, 174, 255, 0.08);
}
