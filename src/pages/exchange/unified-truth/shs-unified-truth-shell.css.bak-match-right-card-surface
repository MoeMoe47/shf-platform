.utc-shell {
  position: fixed;
  inset: 0;
  z-index: 9999;
  display: grid;
  grid-template-columns: 86px minmax(0, 1fr);
  background:
    radial-gradient(circle at 42% -10%, rgba(41, 112, 176, 0.16), transparent 33%),
    linear-gradient(180deg, #07111e, #040b14 62%, #03070d);
  color: #eef5ff;
  overflow: hidden;
  font-family: Inter, ui-sans-serif, system-ui, -apple-system, BlinkMacSystemFont, "Segoe UI", sans-serif;
}

.utc-rail {
  border-right: 1px solid rgba(128, 165, 198, 0.16);
  background: rgba(4, 13, 23, 0.94);
  padding: 18px 10px;
  display: flex;
  flex-direction: column;
  align-items: center;
  gap: 18px;
}

.utc-rail__mark {
  width: 54px;
  height: 54px;
  display: grid;
  place-items: center;
  border: 1px solid rgba(232, 148, 62, 0.75);
  border-radius: 9px;
  background: #071421;
  color: #eda24c;
  font-family: Georgia, "Times New Roman", serif;
  font-size: 26px;
  box-shadow: inset 0 0 18px rgba(232, 148, 62, 0.08), 0 0 16px rgba(232, 148, 62, 0.08);
}

.utc-rail__nav {
  width: 100%;
  display: grid;
  gap: 7px;
}

.utc-rail__item {
  min-height: 52px;
  border: 1px solid transparent;
  border-radius: 8px;
  background: transparent;
  color: rgba(219, 232, 244, 0.6);
  display: grid;
  place-items: center;
  gap: 2px;
  cursor: pointer;
}

.utc-rail__item span {
  font-size: 18px;
  filter: drop-shadow(0 0 8px currentColor);
}

.utc-rail__item small {
  font-size: 8.5px;
  line-height: 1.05;
  text-align: center;
}

.utc-rail__item.is-active {
  border-color: rgba(67, 139, 225, 0.48);
  background: rgba(26, 83, 151, 0.34);
  color: #eef7ff;
}

.utc-workspace {
  min-width: 0;
  padding: 14px 14px 12px;
  display: grid;
  grid-template-rows: auto auto minmax(0, 1fr) auto auto;
  gap: 10px;
  overflow: hidden;
}

.utc-header {
  min-height: 76px;
  border: 1px solid rgba(116, 151, 181, 0.2);
  border-radius: 12px;
  background:
    radial-gradient(circle at 6% 0%, rgba(61, 136, 210, 0.1), transparent 30%),
    rgba(5, 16, 27, 0.92);
  display: grid;
  grid-template-columns: minmax(460px, 1fr) auto auto;
  align-items: center;
  gap: 10px;
  padding: 12px 14px;
}

.utc-header__brand {
  min-width: 0;
}

.utc-header h1 {
  margin: 0;
  font-family: Georgia, "Times New Roman", serif;
  font-size: clamp(22px, 1.65vw, 31px);
  line-height: 1.04;
  white-space: nowrap;
  overflow: hidden;
  text-overflow: ellipsis;
}

.utc-header p {
  margin: 8px 0 0;
  color: rgba(215, 226, 237, 0.74);
  font-size: 13px;
  white-space: nowrap;
  overflow: hidden;
  text-overflow: ellipsis;
}

.utc-header p b {
  color: #d89243;
  padding: 0 7px;
}

.utc-header__chips {
  display: flex;
  gap: 8px;
  min-width: 0;
}

.utc-header-chip {
  width: 134px;
  height: 48px;
  border-radius: 7px;
  border: 1px solid rgba(105, 141, 173, 0.24);
  background: rgba(7, 21, 35, 0.9);
  display: flex;
  align-items: center;
  gap: 8px;
  padding: 0 10px;
  overflow: hidden;
}

.utc-header-chip > span {
  flex: 0 0 20px;
  display: grid;
  place-items: center;
  font-size: 15px;
  filter: drop-shadow(0 0 8px currentColor);
}

.utc-header-chip div {
  min-width: 0;
  display: grid;
  gap: 4px;
}

.utc-header-chip strong {
  font-size: 11px;
  line-height: 1;
  white-space: nowrap;
  overflow: hidden;
  text-overflow: ellipsis;
}

.utc-header-chip small {
  font-size: 9.5px;
  color: rgba(217, 231, 242, 0.65);
  white-space: nowrap;
  overflow: hidden;
  text-overflow: ellipsis;
}

.utc-header__controls {
  display: flex;
  align-items: center;
  justify-content: flex-end;
  gap: 10px;
  min-width: 0;
}

.utc-publication-mode,
.utc-export {
  height: 48px;
  border-radius: 7px;
  border: 1px solid rgba(127, 153, 178, 0.28);
  background: rgba(5, 15, 25, 0.92);
  color: #f4f8fb;
  font-weight: 850;
}

.utc-publication-mode {
  width: 135px;
  display: grid;
  align-content: center;
  gap: 3px;
  text-align: left;
  padding: 0 10px;
}

.utc-publication-mode span {
  font-size: 9px;
  color: rgba(218, 230, 240, 0.62);
}

.utc-publication-mode strong {
  font-size: 10px;
  white-space: nowrap;
}

.utc-export {
  width: 82px;
  padding: 0 12px;
}

.utc-operator-identity {
  min-width: 162px;
  height: 58px;
  display: flex;
  align-items: center;
  justify-content: flex-end;
  gap: 12px;
  padding-left: 12px;
  border-left: 1px solid rgba(112, 138, 160, 0.26);
}

.utc-operator-identity__copy {
  display: grid;
  gap: 5px;
  min-width: 0;
  text-align: left;
}

.utc-operator-identity__copy strong {
  color: rgba(246, 249, 252, 0.96);
  font-size: 12px;
  line-height: 1;
  font-weight: 900;
  white-space: nowrap;
}

.utc-operator-identity__copy small {
  color: rgba(209, 222, 232, 0.74);
  font-size: 11px;
  line-height: 1;
  white-space: nowrap;
}

.utc-operator-identity__avatar {
  position: relative;
  width: 52px;
  height: 52px;
  flex: 0 0 52px;
  display: grid;
  place-items: center;
  border-radius: 999px;
  border: 1px solid rgba(238, 198, 150, 0.42);
  background: radial-gradient(circle at 50% 28%, rgba(247, 197, 153, 0.88), rgba(102, 70, 57, 0.95) 46%, rgba(26, 37, 50, 0.98) 100%);
  color: rgba(255, 255, 255, 0.9);
  font-size: 14px;
  font-weight: 900;
  box-shadow: 0 0 0 3px rgba(255, 255, 255, 0.025), 0 0 20px rgba(0, 0, 0, 0.42);
}

.utc-operator-identity__avatar img {
  width: 100%;
  height: 100%;
  border-radius: 999px;
  object-fit: cover;
}

.utc-operator-identity__avatar i {
  position: absolute;
  right: 4px;
  bottom: 5px;
  width: 12px;
  height: 12px;
  border-radius: 999px;
  background: #55db8f;
  border: 2px solid #06111d;
  box-shadow: 0 0 10px rgba(85, 219, 143, 0.55);
}

.utc-kpis {
  display: grid;
  grid-template-columns: repeat(6, minmax(0, 1fr));
  gap: 10px;
}

.utc-kpi,
.utc-card,
.utc-actions,
.utc-reporting {
  border: 1px solid rgba(104, 139, 191, 0.18);
  border-radius: 10px;
  background: rgba(7, 17, 29, 0.9);
}

.utc-kpi {
  min-height: 96px;
  padding: 12px 14px;
  position: relative;
  overflow: hidden;
}

.utc-kpi__top {
  display: flex;
  align-items: center;
  gap: 8px;
}

.utc-kpi__icon {
  width: 26px;
  height: 26px;
  display: grid;
  place-items: center;
  border-radius: 8px;
  border: 1px solid rgba(122, 161, 195, 0.24);
  background: rgba(9, 25, 42, 0.9);
  font-size: 14px;
  filter: drop-shadow(0 0 8px currentColor);
}

.utc-kpi__label {
  color: rgba(214, 226, 245, 0.76);
  font-size: 10px;
  text-transform: uppercase;
  letter-spacing: 0.13em;
  font-weight: 900;
  white-space: nowrap;
  overflow: hidden;
  text-overflow: ellipsis;
}

.utc-kpi__body {
  margin-top: 11px;
  display: flex;
  justify-content: space-between;
  gap: 10px;
}

.utc-kpi__body strong {
  display: block;
  font-size: clamp(24px, 1.8vw, 32px);
  line-height: 1;
  letter-spacing: -0.045em;
}

.utc-kpi__body small {
  display: block;
  margin-top: 7px;
  color: rgba(216, 229, 242, 0.68);
  font-size: 11px;
}

.utc-kpi__delta {
  height: 22px;
  min-width: fit-content;
  padding: 0 8px;
  border-radius: 999px;
  background: rgba(49, 213, 139, 0.12);
  border: 1px solid rgba(49, 213, 139, 0.22);
  color: #60e39c;
  display: inline-flex;
  align-items: center;
  font-size: 11px;
  font-weight: 900;
}

.utc-kpi__sparkline {
  position: absolute;
  right: 14px;
  bottom: 12px;
  width: 70px;
  height: 26px;
  opacity: 0.72;
}

.utc-kpi__sparkline polyline {
  fill: none;
  stroke: rgba(86, 159, 255, 0.78);
  stroke-width: 3;
  stroke-linecap: round;
  stroke-linejoin: round;
  filter: drop-shadow(0 0 6px rgba(86, 159, 255, 0.5));
}

.utc-main-grid {
  min-height: 0;
  display: grid;
  grid-template-columns: 280px minmax(0, 1fr) 450px;
  gap: 10px;
}

.utc-card {
  min-height: 0;
  overflow: hidden;
}

.utc-card__head,
.utc-map__top {
  padding: 12px 14px 8px;
  display: flex;
  justify-content: space-between;
  align-items: start;
}

.utc-card__head h2,
.utc-map__top h2,
.utc-panel-title h2,
.utc-section-title h2 {
  margin: 0;
  color: rgba(223, 233, 244, 0.92);
  font-size: 12px;
  text-transform: uppercase;
  letter-spacing: 0.12em;
  font-weight: 950;
}

.utc-card__head button,
.utc-map__tools button,
.utc-panel-btn {
  border-radius: 7px;
  border: 1px solid rgba(111, 146, 171, 0.22);
  background: rgba(6, 15, 25, 0.9);
  color: #eaf3ff;
  padding: 9px 12px;
}

.utc-intake {
  display: grid;
  grid-template-rows: auto minmax(0, 1fr) auto;
}

.utc-intake__list {
  padding: 0 10px;
  display: grid;
  gap: 8px;
}

.utc-intake__row {
  min-height: 68px;
  border-radius: 8px;
  border: 1px solid rgba(112, 150, 184, 0.13);
  background: rgba(10, 25, 42, 0.78);
  display: grid;
  grid-template-columns: 34px 1fr auto;
  align-items: center;
  gap: 9px;
  padding: 10px;
}

.utc-intake__icon {
  width: 30px;
  height: 30px;
  border-radius: 8px;
  border: 1px solid rgba(86, 157, 255, 0.45);
  background: rgba(70, 140, 244, 0.16);
  display: grid;
  place-items: center;
  filter: drop-shadow(0 0 8px currentColor);
}

.utc-intake__row small {
  display: block;
  color: rgba(213, 226, 241, 0.62);
  font-size: 10px;
  text-transform: uppercase;
  letter-spacing: 0.06em;
}

.utc-intake__row strong {
  display: block;
  margin-top: 2px;
  font-size: 24px;
}

.utc-intake__row em {
  color: rgba(213, 226, 241, 0.58);
  font-size: 10px;
  font-style: normal;
  text-align: right;
}

.utc-wide-btn {
  margin: 10px;
  height: 42px;
  border-radius: 7px;
  border: 1px solid rgba(207, 143, 68, 0.45);
  background: rgba(11, 20, 33, 0.88);
  color: #e4a14a;
  font-weight: 850;
}

.utc-map {
  display: grid;
  grid-template-rows: auto minmax(0, 1fr);
}

.utc-map__top p {
  margin: 8px 0 0;
  display: flex;
  align-items: center;
  gap: 10px;
  color: rgba(213, 226, 241, 0.62);
  font-size: 10.5px;
}

.utc-map__top p i {
  width: 80px;
  height: 6px;
  border-radius: 999px;
  background: linear-gradient(90deg, #437cff, #f0a83e);
}

.utc-map__tools {
  display: flex;
  gap: 8px;
}

.utc-map__canvas {
  padding: 10px 14px 14px;
}

.utc-ohio-shape {
  position: relative;
  width: 100%;
  height: 100%;
  min-height: 430px;
  border-radius: 10px;
  overflow: hidden;
  background:
    radial-gradient(circle at 50% 50%, rgba(47, 113, 166, 0.16), transparent 62%),
    #081827;
  clip-path: polygon(11% 18%, 84% 8%, 90% 24%, 87% 86%, 52% 92%, 17% 80%, 7% 42%);
  border: 1px solid rgba(214, 167, 111, 0.35);
}

.utc-county-grid {
  position: absolute;
  inset: 8%;
  background-image:
    linear-gradient(rgba(140, 175, 205, 0.13) 1px, transparent 1px),
    linear-gradient(90deg, rgba(140, 175, 205, 0.13) 1px, transparent 1px);
  background-size: 72px 52px;
  opacity: 0.72;
}

.utc-node {
  position: absolute;
  width: 10px;
  height: 10px;
  transform: translate(-50%, -50%);
  border-radius: 999px;
}

.utc-node--blue {
  background: #4d9cff;
  box-shadow: 0 0 18px #4d9cff;
}

.utc-node--gold {
  background: #f0a83e;
  box-shadow: 0 0 18px #f0a83e;
}

.utc-franklin {
  position: absolute;
  left: 52%;
  top: 55%;
  width: 92px;
  height: 76px;
  transform: translate(-50%, -50%);
  border: 2px solid rgba(232, 162, 70, 0.9);
  display: grid;
  place-items: center;
  color: #f3c27b;
  font-size: 10px;
  letter-spacing: 0.08em;
}

.utc-franklin span {
  width: 19px;
  height: 19px;
  border-radius: 999px;
  background: #f0a83e;
  box-shadow: 0 0 30px #f0a83e;
}

.utc-franklin strong {
  position: absolute;
  bottom: 7px;
}

.utc-county-popup {
  position: absolute;
  right: 6%;
  top: 28%;
  width: 245px;
  border: 1px solid rgba(232, 162, 70, 0.62);
  border-radius: 8px;
  background: rgba(5, 14, 24, 0.94);
  padding: 14px;
  box-shadow: 0 16px 38px rgba(0, 0, 0, 0.3);
}

.utc-county-popup button {
  position: absolute;
  right: 10px;
  top: 8px;
  border: 0;
  background: transparent;
  color: rgba(230, 238, 246, 0.7);
  font-size: 18px;
}

.utc-county-popup h3 {
  margin: 0;
  font-size: 14px;
  text-transform: uppercase;
  letter-spacing: 0.06em;
}

.utc-county-popup p {
  color: #f0a83e;
  font-weight: 900;
}

.utc-county-popup dl {
  display: grid;
  gap: 7px;
}

.utc-county-popup dl div {
  display: flex;
  justify-content: space-between;
  gap: 12px;
}

.utc-county-popup dt {
  color: rgba(221, 232, 244, 0.6);
  font-size: 12px;
}

.utc-county-popup dd {
  margin: 0;
  font-size: 12px;
  font-weight: 850;
}

.utc-county-popup footer {
  margin-top: 12px;
  border-top: 1px solid rgba(123, 151, 178, 0.18);
  padding-top: 10px;
  color: #e7a247;
  font-weight: 850;
  font-size: 12px;
}

.utc-side-stack {
  min-height: 0;
  display: grid;
  grid-template-rows: minmax(0, 1.05fr) minmax(0, 0.85fr) minmax(0, 0.72fr);
  gap: 10px;
}

.utc-panel-title {
  padding: 13px 14px 8px;
  display: grid;
  grid-template-columns: auto 1fr auto;
  align-items: center;
  gap: 9px;
}

.utc-panel-title > span {
  filter: drop-shadow(0 0 8px currentColor);
}

.utc-panel-title b {
  color: #f5d08b;
  font-size: 12px;
}

.utc-oracle-grid,
.utc-trust-metrics {
  padding: 8px 14px;
  display: grid;
  grid-template-columns: repeat(2, minmax(0, 1fr));
  gap: 10px 14px;
}

.utc-oracle-grid div,
.utc-trust-metrics div {
  border-bottom: 1px solid rgba(123, 151, 178, 0.12);
  padding-bottom: 8px;
}

.utc-oracle-grid span,
.utc-trust-metrics span {
  display: block;
  color: rgba(221, 232, 244, 0.62);
  font-size: 10.5px;
}

.utc-oracle-grid strong,
.utc-trust-metrics strong {
  display: block;
  margin-top: 4px;
  color: #67d999;
  font-size: 14px;
}

.utc-oracle-copy,
.utc-analyst-panel p {
  margin: 0;
  padding: 8px 14px;
  color: rgba(221, 232, 244, 0.72);
  font-size: 12px;
  line-height: 1.45;
}

.utc-panel-btn {
  margin: 8px 14px 14px;
  color: #cda7ff;
}

.utc-verification-bar {
  margin: 10px 14px 14px;
  height: 7px;
  border-radius: 999px;
  background: rgba(107, 140, 169, 0.2);
  overflow: hidden;
}

.utc-verification-bar span {
  display: block;
  width: 91%;
  height: 100%;
  border-radius: inherit;
  background: linear-gradient(90deg, #54de96, #76b7ff);
}

.utc-actions,
.utc-reporting {
  padding: 10px 12px 12px;
}

.utc-section-title {
  min-height: 24px;
  display: flex;
  align-items: center;
  gap: 8px;
  margin-bottom: 9px;
}

.utc-section-title > span {
  color: #e7a247;
  filter: drop-shadow(0 0 8px currentColor);
}

.utc-section-title button {
  margin-left: auto;
  border-radius: 7px;
  border: 1px solid rgba(111, 146, 171, 0.22);
  background: rgba(6, 15, 25, 0.9);
  color: #eaf3ff;
  padding: 8px 12px;
}

.utc-actions__grid {
  display: grid;
  grid-template-columns: repeat(4, minmax(0, 1fr));
  gap: 10px;
}

.utc-action {
  min-height: 78px;
  border: 1px solid rgba(104, 139, 191, 0.18);
  border-radius: 8px;
  background: rgba(10, 25, 42, 0.78);
  padding: 12px;
  display: grid;
  grid-template-columns: 34px 1fr auto;
  gap: 10px;
  align-items: center;
}

.utc-action__icon {
  width: 30px;
  height: 30px;
  border-radius: 8px;
  display: grid;
  place-items: center;
  border: 1px solid rgba(232, 162, 70, 0.36);
  filter: drop-shadow(0 0 8px currentColor);
}

.utc-action strong {
  font-size: 13px;
}

.utc-action p {
  margin: 5px 0 7px;
  color: rgba(221, 232, 244, 0.62);
  font-size: 11px;
}

.utc-action dl {
  display: grid;
  grid-template-columns: repeat(4, minmax(0, 1fr));
  gap: 5px;
  margin: 0;
}

.utc-action dt {
  color: rgba(221, 232, 244, 0.45);
  font-size: 9px;
}

.utc-action dd {
  margin: 2px 0 0;
  color: rgba(221, 232, 244, 0.78);
  font-size: 9.5px;
  font-weight: 800;
}

.utc-action button {
  border: 0;
  border-radius: 7px;
  background: rgba(108, 138, 166, 0.16);
  color: #eaf3ff;
  width: 28px;
  height: 28px;
}

.utc-reporting__grid {
  display: grid;
  grid-template-columns: repeat(6, minmax(0, 1fr));
  gap: 10px;
}

.utc-report {
  min-height: 76px;
  border: 1px solid rgba(104, 139, 191, 0.18);
  border-radius: 8px;
  background: rgba(10, 25, 42, 0.78);
  padding: 12px;
  display: grid;
  grid-template-columns: 34px 1fr auto;
  gap: 10px;
  align-items: center;
}

.utc-report > span {
  font-size: 24px;
  filter: drop-shadow(0 0 8px currentColor);
}

.utc-report strong {
  display: block;
  font-size: 12px;
}

.utc-report p {
  margin: 5px 0 0;
  color: rgba(221, 232, 244, 0.6);
  font-size: 10.5px;
}

.utc-report em {
  color: #60e39c;
  font-size: 10px;
  font-style: normal;
  font-weight: 850;
}

.utc-glow--green { color: #5ee29b; }
.utc-glow--blue { color: #6da7ff; }
.utc-glow--cyan { color: #62e0ff; }
.utc-glow--teal { color: #52dfd2; }
.utc-glow--gold { color: #f0a83e; }
.utc-glow--orange { color: #ff8a57; }
.utc-glow--violet { color: #c79aff; }
.utc-glow--muted { color: rgba(216, 229, 242, 0.7); }

.utc-glow--green,
.utc-glow--blue,
.utc-glow--cyan,
.utc-glow--teal,
.utc-glow--gold,
.utc-glow--orange,
.utc-glow--violet {
  box-shadow: inset 0 0 18px color-mix(in srgb, currentColor 8%, transparent);
}

@media (max-width: 1500px) {
  .utc-header {
    grid-template-columns: minmax(420px, 1fr) auto auto;
  }

  .utc-header-chip {
    width: 112px;
  }

  .utc-header-chip small {
    display: none;
  }

  .utc-publication-mode {
    display: none;
  }

  .utc-main-grid {
    grid-template-columns: 260px minmax(0, 1fr) 390px;
  }
}

@media (max-width: 1250px) {
  .utc-kpis {
    grid-template-columns: repeat(3, minmax(0, 1fr));
  }

  .utc-main-grid {
    grid-template-columns: 1fr;
    overflow: auto;
  }

  .utc-side-stack {
    grid-template-rows: auto;
  }

