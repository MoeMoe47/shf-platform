const partners = hubPartners;
const opportunities = hubOpportunities;
const bundles = hubBundles;

function go(hash) {
  window.location.hash = hash;
}



function getPartner(id) {
  return getPartnerById(partners, id);
}

function getPartnerName(id) {
  return getSharedPartnerName(partners, id);
}



function readBundleEvents() {
  try {
    return JSON.parse(localStorage.getItem("shs_hub_bundle_recommendations_v1") || "[]");
  } catch {
    return [];
  }
}

function writeBundleEvents(events) {
  localStorage.setItem("shs_hub_bundle_recommendations_v1", JSON.stringify(events));
}


export default function HubBundleBuilderPage() {
  const [selectedOpportunityId, setSelectedOpportunityId] = React.useState("opp_001");
  const [events, setEvents] = React.useState(readBundleEvents);

