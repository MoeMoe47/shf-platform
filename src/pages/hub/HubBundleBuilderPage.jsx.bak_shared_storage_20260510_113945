  const scoredBundles = React.useMemo(() => {
    return bundles
      .filter((bundle) => bundle.opportunityId === selectedOpportunity.id)
      .map((bundle) => ({
        ...bundle,
        score: scoreBundle(bundle, selectedOpportunity, partners),
