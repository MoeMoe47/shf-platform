function getPartnerName(id) {
  return getSharedPartnerName(partners, id);
}

function readFeedback() {
  try {
    return JSON.parse(localStorage.getItem("shs_hub_intelligence_feedback_v1") || "[]");
  } catch {
    return [];
  }
}

function writeFeedback(events) {
  localStorage.setItem("shs_hub_intelligence_feedback_v1", JSON.stringify(events));
}


function explainMatch(score) {
  if (score >= 90) return "Strong relationship fit with high cross-sale and partnership potential.";
  if (score >= 75) return "Good relationship fit with useful partner alignment.";
  if (score >= 60) return "Possible relationship fit. Review partner needs and capacity.";
  return "Weak match. Keep as a backup or future relationship.";
}

function explainBundle(score) {
  const reasons = [];

  if (score.serviceCoverage >= 80) reasons.push("strong service coverage");
  if (score.pricingCompetitiveness >= 80) reasons.push("competitive estimated pricing");
  if (score.deliveryReadiness >= 80) reasons.push("strong delivery readiness");
  if (score.outcomeConfidence >= 80) reasons.push("strong verified outcome potential");

  if (!reasons.length) return "This bundle needs review before proposal planning.";

  return `This bundle is recommended because it has ${reasons.join(", ")}.`;
}

