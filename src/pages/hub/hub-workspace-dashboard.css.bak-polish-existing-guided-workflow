* {
  box-sizing: border-box;
}

body {
  margin: 0;
  background: #02070d;
}

.hubV1-shell {
  min-height: 100vh;
  display: grid;
  grid-template-columns: 118px minmax(0, 1fr);
  background:
    radial-gradient(circle at 45% -18%, rgba(45, 156, 255, 0.15), transparent 34%),
    radial-gradient(circle at 88% 110%, rgba(47, 223, 202, 0.08), transparent 32%),
    linear-gradient(180deg, #06111f 0%, #030914 64%, #02070d 100%);
  color: #edf6ff;
  font-family: Inter, ui-sans-serif, system-ui, -apple-system, BlinkMacSystemFont, "Segoe UI", sans-serif;
  overflow-x: hidden;
}

.hubV1-rail {
  grid-column: 1;
  position: sticky;
  top: 0;
  height: 100vh;
  padding: 12px 8px;
  border-right: 1px solid rgba(90, 155, 220, 0.22);
  background: linear-gradient(180deg, rgba(4, 15, 28, 0.98), rgba(2, 8, 15, 0.98));
  display: flex;
  flex-direction: column;
  align-items: center;
  gap: 12px;
  z-index: 50;
}

.hubV1-logo {
  width: 82px;
  height: 82px;
  border-radius: 20px;
  border: 1px solid rgba(92, 184, 255, 0.62);
  background: linear-gradient(180deg, rgba(9, 35, 64, 0.82), rgba(3, 12, 22, 0.95));
  color: #f2fbff;
  display: grid;
  place-items: center;
  font-weight: 950;
  letter-spacing: 0.08em;
  font-size: 18px;
  cursor: pointer;
  box-shadow: 0 0 22px rgba(48, 139, 255, 0.28), inset 0 0 20px rgba(70, 174, 255, 0.08);
  transition: transform 160ms ease, box-shadow 160ms ease;
}

.hubV1-logo:hover {
  transform: translateY(-3px) scale(1.04);
  box-shadow: 0 0 34px rgba(73, 171, 255, 0.42), inset 0 0 24px rgba(96, 210, 255, 0.12);
}

.hubV1-nav {
  width: 100%;
  display: grid;
  gap: 7px;
}

.hubV1-navItem {
  width: 100%;
  min-height: 58px;
  border: 1px solid transparent;
  border-radius: 12px;
  background: transparent;
  color: rgba(219, 232, 244, 0.76);
  display: grid;
  place-items: center;
  gap: 2px;
  position: relative;
  cursor: pointer;
  transition: transform 160ms ease, background 160ms ease, border-color 160ms ease, color 160ms ease;
}

.hubV1-navItem:hover,
.hubV1-navItem.is-active {
  background: linear-gradient(180deg, rgba(31, 121, 222, 0.94), rgba(22, 78, 148, 0.92));
  border-color: rgba(93, 184, 255, 0.62);
  color: #fff;
}

.hubV1-navItem:hover {
  transform: translateY(-2px);
}

.hubV1-navItem span {
  font-size: 18px;
}

.hubV1-navItem small {
  font-size: 10px;
  font-weight: 850;
  text-align: center;
}

.hubV1-navItem b {
  position: absolute;
  top: 8px;
  right: 8px;
  min-width: 22px;
  height: 18px;
  border-radius: 999px;
  background: #ff8d3b;
  color: #06111f;
  font-size: 10px;
  display: grid;
  place-items: center;
}

.hubV1-readiness {
  width: 100%;
  margin-top: auto;
  border: 1px solid rgba(85, 159, 225, 0.38);
  border-radius: 14px;
  background: rgba(6, 19, 33, 0.86);
  padding: 12px 8px;
  text-align: center;
}

.hubV1-readiness strong {
  display: block;
  font-size: 10px;
  line-height: 1.6;
  letter-spacing: 0.18em;
}

.hubV1-ring {
  width: 66px;
  height: 66px;
  border-radius: 50%;
  margin: 12px auto 8px;
  background: conic-gradient(#5dc8ff 0 87%, rgba(255,255,255,0.12) 87% 100%);
  display: grid;
  place-items: center;
}

.hubV1-ring span {
  width: 47px;
  height: 47px;
  border-radius: 50%;
  background: #071421;
  display: grid;
  place-items: center;
  font-size: 20px;
  font-weight: 950;
}

.hubV1-readiness b {
  color: #5ee29b;
  font-size: 12px;
}

.hubV1-readiness p {
  margin: 8px 0 0;
  color: rgba(220, 233, 244, 0.66);
  font-size: 11px;
  line-height: 1.3;
}

.hubV1-page {
  min-width: 0;
  padding: 10px 10px 28px;
  display: grid;
  gap: 10px;
  align-content: start;
}

.hubV1-header {
  min-height: 88px;
  border: 1px solid rgba(75, 145, 206, 0.34);
  border-radius: 18px;
  background:
    radial-gradient(circle at 8% 0%, rgba(61, 162, 255, 0.13), transparent 35%),
    linear-gradient(135deg, rgba(9, 31, 52, 0.96), rgba(5, 17, 31, 0.96));
  display: grid;
  grid-template-columns: minmax(260px, 1fr) auto auto;
  align-items: center;
  gap: 10px;
  padding: 18px;
  box-shadow: 0 18px 48px rgba(0,0,0,0.22);
}

.hubV1-header h1 {
  margin: 0;
  font-size: 26px;
  line-height: 1;
  letter-spacing: -0.05em;
  font-weight: 950;
}

.hubV1-header p {
  margin: 8px 0 0;
  color: #5ee8ff;
  text-transform: uppercase;
  font-weight: 950;
  letter-spacing: 0.22em;
  font-size: 12px;
}

.hubV1-headerActions {
  display: flex;
  gap: 6px;
  flex-wrap: wrap;
  justify-content: flex-end;
}

.hubV1-headerActions button,
.hubV1-user,
.hubV1-sectionHead button,
.hubV1-wideBtn {
  min-height: 42px;
  border-radius: 10px;
  border: 1px solid rgba(86, 155, 216, 0.36);
  background: rgba(5, 15, 27, 0.78);
  color: #eaf6ff;
  padding: 0 14px;
  font-weight: 900;
  cursor: pointer;
  box-shadow: inset 0 0 18px rgba(80, 170, 255, 0.04);
}

.hubV1-headerActions b {
  display: inline-grid;
  place-items: center;
  min-width: 22px;
  height: 19px;
  border-radius: 999px;
  background: #ff8d3b;
  color: #06111f;
  margin-left: 5px;
}

.hubV1-user {
  display: flex;
  align-items: center;
  gap: 10px;
}

.hubV1-user span {
  text-align: right;
}

.hubV1-user strong,
.hubV1-user small {
  display: block;
}

.hubV1-user small {
  color: rgba(219, 231, 243, 0.66);
}

.hubV1-user i {
  width: 42px;
  height: 42px;
  border-radius: 50%;
  display: grid;
  place-items: center;
  background: linear-gradient(135deg, #195392, #071c34);
  border: 1px solid rgba(99, 196, 255, 0.75);
  font-style: normal;
  font-weight: 950;
  position: relative;
}

.hubV1-user i::after {
  content: "";
  position: absolute;
  right: 1px;
  bottom: 2px;
  width: 10px;
  height: 10px;
  border-radius: 50%;
  background: #5ee29b;
  box-shadow: 0 0 0 3px #071421;
}

.hubV1-kpiRow {
  display: grid;
  grid-template-columns: repeat(6, minmax(0, 1fr));
  gap: 10px;
}

.hubV1-kpi {
  min-height: 112px;
  border: 1px solid rgba(75, 145, 206, 0.34);
  border-radius: 15px;
  background:
    radial-gradient(circle at 90% 92%, rgba(50, 145, 255, 0.14), transparent 40%),
    linear-gradient(135deg, rgba(8, 25, 43, 0.96), rgba(4, 14, 25, 0.96));
  padding: 13px;
  position: relative;
  overflow: hidden;
}

.hubV1-kpiTop {
  display: flex;
  align-items: center;
  gap: 10px;
}

.hubV1-icon {
  width: 37px;
  height: 37px;
  border-radius: 11px;
  display: grid;
  place-items: center;
  border: 1px solid rgba(89, 202, 255, 0.34);
  background: rgba(7, 27, 45, 0.84);
}

.hubV1-kpi h3 {
  margin: 0;
  font-size: 12px;
  letter-spacing: 0.16em;
  text-transform: uppercase;
  line-height: 1.18;
}

.hubV1-kpiMain {
  margin-top: 8px;
  display: flex;
  align-items: center;
  gap: 8px;
}

.hubV1-kpiMain strong {
  font-size: 31px;
  line-height: 1;
  font-weight: 950;
}

.hubV1-kpi p {
  margin: 8px 0 0;
  color: rgba(219, 231, 243, 0.66);
  font-size: 12px;
}

.hubV1-chip {
  display: inline-grid;
  place-items: center;
  border-radius: 999px;
  padding: 5px 10px;
  font-size: 11px;
  line-height: 1;
  font-weight: 950;
  border: 1px solid rgba(93, 185, 255, 0.35);
  background: rgba(63, 146, 220, 0.18);
  color: #8ed0ff;
}

.hubV1-chip--green {
  background: rgba(54, 207, 130, 0.18);
  border-color: rgba(85, 231, 162, 0.38);
  color: #5ee29b;
}

.hubV1-chip--gold {
  background: rgba(240, 168, 62, 0.18);
  border-color: rgba(240, 168, 62, 0.42);
  color: #ffc36a;
}

.hubV1-chip--violet {
  background: rgba(155, 127, 255, 0.18);
  border-color: rgba(179, 166, 255, 0.38);
  color: #c8bbff;
}

.hubV1-chip--teal {
  background: rgba(51, 202, 226, 0.16);
  border-color: rgba(98, 224, 255, 0.38);
  color: #62e0ff;
}

.hubV1-spark {
  position: absolute;
  right: 12px;
  bottom: 8px;
  width: 76px;
  height: 30px;
  fill: none;
}

.hubV1-spark polyline {
  fill: none;
  stroke-width: 4;
  stroke-linecap: round;
  stroke-linejoin: round;
  stroke: #6da7ff;
  filter: drop-shadow(0 0 8px currentColor);
  stroke-dasharray: 165;
  stroke-dashoffset: 165;
  animation: hubV1Draw 900ms ease forwards 320ms, hubV1Glow 3.5s ease-in-out infinite 1.4s;
}

.hubV1-spark--green polyline { stroke: #5ee29b; }
.hubV1-spark--gold polyline { stroke: #f0a83e; }
.hubV1-spark--teal polyline { stroke: #62e0ff; }
.hubV1-spark--violet polyline { stroke: #b3a6ff; }

@keyframes hubV1Draw {
  to { stroke-dashoffset: 0; }
}

@keyframes hubV1Glow {
  0%, 100% { opacity: 0.84; }
  50% { opacity: 1; }
}

.hubV1-dashboardGrid {
  display: grid;
  grid-template-columns: 360px minmax(0, 1fr) 360px;
  gap: 10px;
  align-items: start;
}

.hubV1-centerStack,
.hubV1-rightStack {
  display: grid;
  gap: 10px;
  min-width: 0;
}

.hubV1-card {
  border: 1px solid rgba(75, 145, 206, 0.34);
  border-radius: 16px;
  background:
    radial-gradient(circle at 86% 95%, rgba(43, 142, 255, 0.10), transparent 42%),
    linear-gradient(135deg, rgba(7, 22, 38, 0.97), rgba(4, 13, 24, 0.97));
  box-shadow: 0 18px 50px rgba(0,0,0,0.25);
  padding: 14px;
  overflow: hidden;
}

.hubV1-cardTitle,
.hubV1-sectionHead h2 {
  margin: 0;
  color: #f3f8ff;
  text-transform: uppercase;
  letter-spacing: 0.16em;
  font-size: 15px;
  font-weight: 950;
}

.hubV1-sectionHead {
  display: flex;
  justify-content: space-between;
  align-items: flex-start;
  gap: 12px;
  margin-bottom: 12px;
}

.hubV1-sectionHead p {
  margin: 6px 0 0;
  color: rgba(219, 231, 243, 0.68);
  font-size: 13px;
  line-height: 1.35;
}

.hubV1-network {
  min-height: 590px;
}

.hubV1-flywheelWrap {
  display: grid;
  place-items: center;
  min-height: 275px;
  margin: 8px 0 10px;
}

.hubV1-flywheelWrap img {
  width: 270px;
  height: 270px;
  object-fit: contain;
  filter: drop-shadow(0 0 24px rgba(91, 185, 255, 0.28));
}

.hubV1-flywheelFallback {
  width: 270px;
  height: 270px;
  border-radius: 50%;
  border: 8px solid #eef7ff;
  background: radial-gradient(circle, #eaf6ff, #1d5da0 68%, #0a2342);
  display: none;
  place-items: center;
  text-align: center;
  color: #062044;
  box-shadow: 0 0 30px rgba(91, 185, 255, 0.3);
}

.hubV1-flywheelFallback strong {
  font-size: 23px;
  line-height: 1.05;
}

.hubV1-flywheelFallback span {
  font-size: 9px;
  text-transform: uppercase;
  letter-spacing: 0.12em;
}

.hubV1-networkCopy {
  text-align: center;
  color: rgba(225, 237, 248, 0.78);
  line-height: 1.35;
  margin: 0 22px 12px;
}

.hubV1-profileRows {
  border-top: 1px solid rgba(116,151,181,0.15);
}

.hubV1-profileRows div {
  display: flex;
  justify-content: space-between;
  gap: 10px;
  padding: 8px 0;
  border-bottom: 1px solid rgba(116,151,181,0.14);
  color: rgba(220, 232, 244, 0.72);
}

.hubV1-profileRows strong {
  color: #edf6ff;
  text-align: right;
}

.hubV1-green { color: #5ee29b !important; }
.hubV1-gold { color: #f0a83e !important; }

.hubV1-wideBtn {
  width: 100%;
  margin-top: 12px;
  color: #8ed0ff;
}

.hubV1-tileGrid {
  display: grid;
  grid-template-columns: repeat(3, minmax(0, 1fr));
  gap: 8px;
}

.hubV1-tile {
  min-height: 60px;
  border-radius: 12px;
  border: 1px solid rgba(75, 145, 206, 0.34);
  background: rgba(5, 17, 30, 0.8);
  color: #edf6ff;
  display: flex;
  align-items: center;
  gap: 10px;
  text-align: left;
  padding: 10px;
  cursor: pointer;
  position: relative;
}

.hubV1-tile:hover {
  border-color: rgba(98, 224, 255, 0.54);
  box-shadow: inset 0 0 24px rgba(65, 159, 255, 0.08);
}

.hubV1-tile span {
  width: 38px;
  text-align: center;
  font-size: 23px;
  filter: drop-shadow(0 0 10px rgba(120, 198, 255, 0.35));
}

.hubV1-tile strong {
  font-size: 13px;
}

.hubV1-tile b {
  position: absolute;
  right: 8px;
  top: 8px;
  min-width: 24px;
  height: 22px;
  border-radius: 999px;
  background: #ff8d3b;
  color: #06111f;
  display: grid;
  place-items: center;
  font-size: 11px;
}

.hubV1-tile em {
  display: block;
  position: absolute;
  right: 10px;
  bottom: 7px;
  color: rgba(219, 231, 243, 0.34);
  font-size: 9px;
  font-style: normal;
}

.hubV1-tile.is-advanced {
  opacity: 0.62;
  border-style: dashed;
}

.hubV1-table {
  width: 100%;
  border-collapse: collapse;
}

.hubV1-table th,
.hubV1-table td {
  padding: 8px 7px;
  border-bottom: 1px solid rgba(116,151,181,0.13);
  text-align: left;
  font-size: 12px;
}

.hubV1-table th {
  color: rgba(219, 231, 243, 0.62);
  font-weight: 800;
}

.hubV1-rowIcon {
  width: 32px;
  height: 32px;
  display: grid;
  place-items: center;
  border-radius: 9px;
  background: rgba(65, 159, 255, 0.18);
}

.hubV1-rowIcon.closed {
  background: rgba(54, 207, 130, 0.16);
  color: #5ee29b;
}

.hubV1-rowIcon.on_hold {
  background: rgba(82, 145, 231, 0.16);
  color: #8ec8ff;
}

.hubV1-status {
  display: inline-grid;
  place-items: center;
  min-width: 78px;
  border-radius: 999px;
  padding: 6px 12px;
  background: rgba(54, 207, 130, 0.18);
  border: 1px solid rgba(85, 231, 162, 0.38);
  color: #5ee29b;
  font-weight: 950;
  font-size: 11px;
}

.hubV1-status.on_hold {
  background: rgba(72, 142, 230, 0.18);
  border-color: rgba(103, 170, 255, 0.42);
  color: #8ec8ff;
}

.hubV1-foot {
  margin-top: 8px;
  display: flex;
  justify-content: space-between;
  color: rgba(219, 231, 243, 0.68);
}

.hubV1-foot span {
  color: #75d9ff;
  font-weight: 900;
}

.hubV1-miniGrid {
  display: grid;
  grid-template-columns: repeat(2, minmax(0, 1fr));
  gap: 10px;
}

.hubV1-mini {
  min-height: 156px;
}

.hubV1-sectionHead.mini {
  align-items: center;
}

.hubV1-sectionHead.mini h2 {
  font-size: 14px;
}

.hubV1-miniBody {
  display: grid;
  grid-template-columns: 130px 1fr;
  align-items: center;
  gap: 10px;
}

.hubV1-donut,
.hubV1-gauge {
  width: 94px;
  height: 94px;
  border-radius: 50%;
  margin: 0 auto;
  display: grid;
  place-items: center;
  background: conic-gradient(#5ee29b 0 48%, #f0a83e 48% 77%, #ff6b63 77% 100%);
}

.hubV1-donut span,
.hubV1-gauge span {
  width: 66px;
  height: 66px;
  border-radius: 50%;
  background: #071421;
  display: grid;
  place-items: center;
  text-align: center;
}

.hubV1-donut strong,
.hubV1-gauge strong {
  font-size: 24px;
  line-height: 1;
}

.hubV1-donut small,
.hubV1-gauge small {
  font-size: 10px;
  color: rgba(219, 231, 243, 0.66);
}

.hubV1-legend {
  display: grid;
  gap: 5px;
}

.hubV1-legend div {
  display: grid;
  grid-template-columns: 9px 1fr auto auto;
  gap: 8px;
  align-items: center;
  color: rgba(219, 231, 243, 0.72);
  font-size: 12px;
}

.hubV1-legend.compact div {
  grid-template-columns: 9px 1fr auto;
}

.hubV1-legend i {
  width: 8px;
  height: 8px;
  border-radius: 3px;
}

.hubV1-legend .green { background: #5ee29b; }
.hubV1-legend .gold { background: #f0a83e; }
.hubV1-legend .orange { background: #ff8d3b; }
.hubV1-legend .red { background: #ff6b63; }

.hubV1-note,
.hubV1-agenda,
.hubV1-community {
  display: grid;
  grid-template-columns: 42px 1fr auto;
  gap: 10px;
  align-items: center;
  padding: 10px 0;
  border-bottom: 1px solid rgba(116,151,181,0.13);
}

.hubV1-noteIcon,
.hubV1-community span {
  width: 34px;
  height: 34px;
  border-radius: 9px;
  display: grid;
  place-items: center;
  background: rgba(70, 137, 210, 0.18);
}

.hubV1-noteIcon.warn { background: rgba(240, 168, 62, 0.18); }
.hubV1-noteIcon.red { background: rgba(255, 107, 99, 0.18); }
.hubV1-noteIcon.blue { background: rgba(82, 145, 231, 0.18); }
.hubV1-noteIcon.violet { background: rgba(155, 127, 255, 0.18); }

.hubV1-note strong,
.hubV1-agenda b,
.hubV1-community strong {
  display: block;
}

.hubV1-note p,
.hubV1-agenda p,
.hubV1-community p {
  margin: 2px 0 0;
  color: rgba(219, 231, 243, 0.64);
  font-size: 12px;
  line-height: 1.35;
}

.hubV1-note time {
  color: rgba(219, 231, 243, 0.64);
  font-size: 12px;
}

.hubV1-agenda {
  grid-template-columns: 80px 1fr;
}

.hubV1-agenda strong {
  font-size: 15px;
}

@media (max-width: 1500px) {
  .hubV1-kpiRow {
    grid-template-columns: repeat(3, minmax(0, 1fr));
  }

  .hubV1-dashboardGrid {
    grid-template-columns: 340px minmax(0, 1fr) 340px;
  }
}

@media (max-width: 1180px) {
  .hubV1-shell {
    grid-template-columns: 1fr;
  }

  .hubV1-rail {
    display: none;
  }

  .hubV1-header {
    grid-template-columns: 1fr;
  }

  .hubV1-kpiRow,
  .hubV1-dashboardGrid,
  .hubV1-miniGrid {
    grid-template-columns: 1fr;
  }
}

/* =========================================================
   HUB V1 PROFILE PHOTO UPLOAD
   Top-right avatar upload menu. Demo mode uses localStorage.
   ========================================================= */

.hubV1-profileWrap {
  position: relative;
  display: flex;
  justify-content: flex-end;
}

.hubV1-user i.has-photo {
  overflow: hidden;
  padding: 0;
}

.hubV1-user i.has-photo img,
.hubV1-profilePreview i.has-photo img {
  width: 100%;
  height: 100%;
  object-fit: cover;
  display: block;
}

/* keep online dot above uploaded image */
.hubV1-user i.has-photo::after {
  z-index: 2;
}

.hubV1-profileMenu {
  position: absolute;
  top: calc(100% + 10px);
  right: 0;
  width: 260px;
  z-index: 100;
  border: 1px solid rgba(92, 184, 255, 0.42);
  border-radius: 16px;
  background:
    radial-gradient(circle at 100% 0%, rgba(76, 176, 255, 0.16), transparent 36%),
    linear-gradient(180deg, rgba(8, 25, 43, 0.98), rgba(4, 13, 24, 0.98));
  box-shadow: 0 24px 60px rgba(0, 0, 0, 0.45);
  padding: 12px;
}

.hubV1-profilePreview {
  display: flex;
  align-items: center;
  gap: 10px;
  padding-bottom: 10px;
  margin-bottom: 10px;
  border-bottom: 1px solid rgba(116, 151, 181, 0.16);
}

.hubV1-profilePreview i {
  width: 52px;
  height: 52px;
  border-radius: 50%;
  display: grid;
  place-items: center;
  flex: 0 0 auto;
  background: linear-gradient(135deg, #195392, #071c34);
  border: 1px solid rgba(99, 196, 255, 0.75);
  font-style: normal;
  font-weight: 950;
  overflow: hidden;
}

