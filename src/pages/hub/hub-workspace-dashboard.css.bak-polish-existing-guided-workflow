.hub-workflow-readiness__stats {
  display: grid;
  grid-template-columns: repeat(5, minmax(0, 1fr));
  gap: 10px;
}

.hub-workflow-readiness__stats article,
.hub-workflow-readiness__steps article {
  padding: 12px;
  border-radius: 16px;
  border: 1px solid rgba(148, 163, 184, 0.14);
  background: rgba(2, 8, 18, 0.42);
}

.hub-workflow-readiness__stats span {
  display: block;
  margin-bottom: 6px;
  font-size: 10px;
  letter-spacing: 0.12em;
  text-transform: uppercase;
  color: rgba(148, 163, 184, 0.92);
}

.hub-workflow-readiness__stats strong {
  font-size: 18px;
  color: rgba(248, 250, 252, 0.98);
}

.hub-workflow-readiness__steps {
  display: grid;
  grid-template-columns: repeat(7, minmax(0, 1fr));
  gap: 10px;
}

.hub-workflow-readiness__steps article span {
  display: inline-grid;
  place-items: center;
  width: 28px;
  height: 28px;
  margin-bottom: 8px;
  border-radius: 999px;
  background: rgba(148, 163, 184, 0.14);
  color: rgba(226, 232, 240, 0.94);
  font-size: 11px;
  font-weight: 900;
}

.hub-workflow-readiness__steps article strong {
  display: block;
  font-size: 13px;
  color: rgba(248, 250, 252, 0.96);
}

.hub-workflow-readiness__steps article p {
  margin: 8px 0 0;
  font-size: 12px;
  line-height: 1.45;
  color: rgba(203, 213, 225, 0.82);
}

.hub-workflow-readiness__steps article.is-complete {
  border-color: rgba(34, 197, 94, 0.26);
  background: rgba(34, 197, 94, 0.08);
}

.hub-workflow-readiness__steps article.is-review {
  border-color: rgba(250, 204, 21, 0.28);
  background: rgba(250, 204, 21, 0.08);
}

.hub-workflow-readiness__steps article.is-blocked {
  border-color: rgba(248, 113, 113, 0.3);
  background: rgba(127, 29, 29, 0.18);
}

.hub-workflow-readiness__blockers {
  padding: 12px 14px;
  border-radius: 14px;
  border: 1px solid rgba(248, 113, 113, 0.22);
  background: rgba(127, 29, 29, 0.16);
  color: rgba(254, 226, 226, 0.94);
}

.hub-workflow-readiness__blockers strong {
  display: block;
  margin-bottom: 5px;
}

.hub-workflow-readiness__blockers p {
  margin: 0;
  line-height: 1.5;
}

.hub-workflow-readiness--ready {
  border-color: rgba(34, 197, 94, 0.24);
}

.hub-workflow-readiness--review {
  border-color: rgba(250, 204, 21, 0.24);
}

.hub-workflow-readiness--blocked {
  border-color: rgba(248, 113, 113, 0.26);
}

@media (max-width: 1280px) {
  .hub-workflow-readiness__steps {
    grid-template-columns: repeat(4, minmax(0, 1fr));
  }

  .hub-workflow-readiness__stats {
    grid-template-columns: repeat(3, minmax(0, 1fr));
  }
}

@media (max-width: 760px) {
  .hub-workflow-readiness__steps,
  .hub-workflow-readiness__stats {
    grid-template-columns: repeat(2, minmax(0, 1fr));
  }

  .hub-workflow-readiness__score {
    width: 100%;
    text-align: left;
  }
}

@media (max-width: 520px) {
  .hub-workflow-readiness__steps,
  .hub-workflow-readiness__stats {
    grid-template-columns: 1fr;
  }
}

