import React, { useEffect, useId, useMemo, useState } from "react";
import { geoMercator, geoPath } from "d3-geo";

const W = 980;
const H = 620;
const PAD_X = 80;
const PAD_Y = 50;

const GEOJSON_URLS = [
  "/geo/ohio-counties.geojson",
  "/assets/maps/ohio-counties.geojson",
];

function normalizeCountyName(name = "") {
  return String(name)
    .replace(/\s+County$/i, "")
    .replace(/\s+/g, " ")
    .trim();
}

function getFeatureCountyName(feature) {
  const props = feature?.properties || {};
  const keys = [
    "name",
    "NAME",
    "county",
    "COUNTY",
    "namelsad",
    "NAME11",
    "COUNTY_NAM",
    "County",
    "COUNTYNAME",
  ];

  for (const key of keys) {
    if (props[key]) return normalizeCountyName(props[key]);
  }
  return "";
}

export default function SHFRegionalCountyCluster({
  selectedCounty,
  clusterCounties = [],
  hoveredCounty = null,
  onCountyHover,
  onCountyClick,
}) {
  const [geojson, setGeojson] = useState(null);
  const gradientId = useId().replace(/:/g, "_");
  const glowId = `${gradientId}_glow`;

  useEffect(() => {
    let alive = true;

    async function load() {
      for (const url of GEOJSON_URLS) {
        try {
          const res = await fetch(url);
          if (!res.ok) continue;
          const json = await res.json();
          if (alive) {
            setGeojson(json);
          }
          return;
        } catch (_) {}
      }
      if (alive) {
        setGeojson(null);
      }
    }

    load();
    return () => {
      alive = false;
    };
  }, []);

  const filteredCollection = useMemo(() => {
    if (!geojson?.features?.length) return null;
    const wanted = new Set(clusterCounties.map(normalizeCountyName));
    const features = geojson.features.filter((feature) =>
      wanted.has(getFeatureCountyName(feature))
    );
    if (!features.length) return null;
    return { type: "FeatureCollection", features };
  }, [geojson, clusterCounties]);

  const projection = useMemo(() => {
    if (!filteredCollection) return null;
    const proj = geoMercator();
    proj.fitExtent(
      [
        [PAD_X, PAD_Y],
        [W - PAD_X, H - PAD_Y],
      ],
      filteredCollection
    );
    return proj;
  }, [filteredCollection]);

  const pathGen = useMemo(() => {
    if (!projection) return null;
    return geoPath(projection);
  }, [projection]);

  const features = filteredCollection?.features || [];

  if (!pathGen || !features.length) {
    return (
      <div className="shf-regional-cluster-loading">
        Loading regional county view…
      </div>
    );
  }

  const contextFeatures = features.filter(
    (feature) => getFeatureCountyName(feature) !== selectedCounty
  );
  const selectedFeature = features.find(
    (feature) => getFeatureCountyName(feature) === selectedCounty
  );

  return (
    <div className="shf-regional-cluster-surface">
      <svg
        className="shf-regional-cluster-svg"
        viewBox={`0 0 ${W} ${H}`}
        preserveAspectRatio="xMidYMid meet"
        role="img"
        aria-label={`${selectedCounty} regional county cluster`}
      >
        <defs>
          <linearGradient id={gradientId} x1="0%" y1="0%" x2="100%" y2="100%">
            <stop offset="0%" stopColor="rgba(240,187,107,1)" />
            <stop offset="55%" stopColor="rgba(220,155,72,1)" />
            <stop offset="100%" stopColor="rgba(176,114,42,1)" />
          </linearGradient>
          <filter id={glowId} x="-40%" y="-40%" width="180%" height="180%">
            <feGaussianBlur stdDeviation="8" result="blur" />
            <feColorMatrix
              in="blur"
              type="matrix"
              values="
                1 0 0 0 0.72
                0 1 0 0 0.50
                0 0 1 0 0.22
                0 0 0 1 0
              "
              result="goldglow"
            />
            <feMerge>
              <feMergeNode in="goldglow" />
              <feMergeNode in="SourceGraphic" />
            </feMerge>
          </filter>
        </defs>

        {contextFeatures.map((feature) => {
          const county = getFeatureCountyName(feature);
          const d = pathGen(feature);
          return (
            <path
              key={county}
              d={d || ""}
              className={`shf-regional-county shf-regional-county--context ${
                hoveredCounty === county ? "is-hovered" : ""
              }`}
              onMouseEnter={() => onCountyHover?.(county)}
              onMouseLeave={() => onCountyHover?.(null)}
              onClick={() => onCountyClick?.(county)}
            />
          );
        })}

        {selectedFeature ? (
          <path
            d={pathGen(selectedFeature) || ""}
            className="shf-regional-county shf-regional-county--selected"
            fill={`url(#${gradientId})`}
            filter={`url(#${glowId})`}
            onMouseEnter={() => onCountyHover?.(selectedCounty)}
            onMouseLeave={() => onCountyHover?.(null)}
            onClick={() => onCountyClick?.(selectedCounty)}
          />
        ) : null}
      </svg>
    </div>
  );
}
