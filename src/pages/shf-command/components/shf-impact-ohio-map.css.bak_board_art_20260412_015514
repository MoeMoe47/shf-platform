.shf-impact-map-root {
  position: relative;
  min-height: 520px;
  border-radius: 26px;
  overflow: hidden;
  background:
    linear-gradient(180deg, rgba(248,243,236,0.94) 0%, rgba(240,234,226,0.98) 100%);
}

.shf-impact-map-grid {
  position: absolute;
  inset: 0;
  background-image:
    linear-gradient(rgba(122, 96, 70, 0.035) 1px, transparent 1px),
    linear-gradient(90deg, rgba(122, 96, 70, 0.035) 1px, transparent 1px);
  background-size: 48px 48px;
  pointer-events: none;
  z-index: 0;
}

.shf-impact-map-toolbar {
  position: absolute;
  top: 18px;
  right: 18px;
  display: flex;
  gap: 10px;
  z-index: 6;
}

.shf-impact-map-toolbar button {
  border: 1px solid rgba(164, 137, 108, 0.18);
  background: rgba(255,255,255,0.78);
  color: #7a6249;
  border-radius: 999px;
  padding: 10px 16px;
  font: inherit;
}

.shf-impact-map-toolbar .is-active {
  background: rgba(223, 179, 116, 0.18);
  color: #6b4a2e;
}

.shf-impact-map-stage {
  position: relative;
  height: 470px;
  padding: 22px 18px 18px;
  z-index: 1;
}

.shf-impact-map-surface {
  position: absolute;
  inset: 24px 18px 18px;
  transform:
    translate(var(--map-tx, 0%), var(--map-ty, 0%))
    scale(var(--map-scale, 1));
  transform-origin: 50% 50%;
  transition: transform 700ms cubic-bezier(.22,1,.36,1);
}

.shf-impact-map-ohio-mask {
  position: absolute;
  inset: 4.5%;
  z-index: 2;
  overflow: hidden;
  pointer-events: none;
  -webkit-mask-image: url("/assets/shf-command/maps/shf-ohio-mask.png");
  -webkit-mask-repeat: no-repeat;
  -webkit-mask-position: center;
  -webkit-mask-size: contain;
  mask-image: url("/assets/shf-command/maps/shf-ohio-mask.png");
  mask-repeat: no-repeat;
  mask-position: center;
  mask-size: contain;
}

.shf-impact-map-terrain {
  position: absolute;
  inset: -6%;
  width: 112%;
  height: 112%;
  object-fit: cover;
  object-position: center center;
  filter: saturate(1.04) contrast(1.04);
}

.shf-impact-map-geo-slot {
  position: absolute;
  inset: 4.5%;
  z-index: 3;
  mix-blend-mode: screen;
  opacity: 0.96;
}

.shf-impact-map-geo-slot svg {
  width: 100%;
  height: 100%;
}

.shf-impact-map-geo-slot path,
.shf-impact-map-geo-slot polygon,
.shf-impact-map-geo-slot polyline {
  fill: transparent !important;
  stroke: rgba(255,255,255,0.94) !important;
  stroke-width: 1.2 !important;
  vector-effect: non-scaling-stroke;
  stroke-linejoin: round;
  stroke-linecap: round;
}

.shf-impact-map-stage.is-zoomed::after {
  content: "";
  position: absolute;
  inset: 18px;
  pointer-events: none;
  background:
    radial-gradient(circle at 50% 52%, rgba(255,255,255,0.00) 0%, rgba(255,255,255,0.00) 26%, rgba(88, 60, 35, 0.08) 100%);
  border-radius: 24px;
  z-index: 4;
}

.shf-impact-map-tooltip {
  position: absolute;
  left: 18%;
  bottom: 19%;
  z-index: 5;
  background: rgba(255,255,255,0.94);
  border: 1px solid rgba(170, 137, 103, 0.16);
  border-radius: 22px;
  padding: 18px 18px 16px;
  min-width: 238px;
  box-shadow: 0 18px 38px rgba(86, 58, 34, 0.10);
}

.shf-impact-map-tooltip strong {
  display: block;
  margin-bottom: 10px;
  font-size: 18px;
}

.shf-impact-map-tooltip div {
  line-height: 1.55;
}

/* =========================================================
   SHF OHIO MASK — FOOTPRINT CALIBRATION
   ========================================================= */
.shf-impact-map-ohio-mask {
  -webkit-mask-size: 128% auto !important;
  -webkit-mask-position: center 48% !important;
  mask-size: 128% auto !important;
  mask-position: center 48% !important;
}

/* =========================================================
   SHF OHIO MASK — CALIBRATION PASS 2
   ========================================================= */
.shf-impact-map-ohio-mask {
  -webkit-mask-size: 121% auto !important;
  -webkit-mask-position: 54% 50% !important;
  mask-size: 121% auto !important;
  mask-position: 54% 50% !important;
}

/* =========================================================
   SHF MAP — OHIO ON BOARD LOOK
   Goal:
   - calm parchment board with visible outer grid
   - Ohio feels like an object placed on the board
   - county lines stay crisp and readable
   ========================================================= */

/* Board stays light and readable */
.shf-impact-map-root {
  background:
    radial-gradient(circle at 50% 42%, rgba(255, 248, 239, 0.78) 0%, rgba(245, 238, 228, 0.88) 40%, rgba(236, 229, 219, 0.96) 100%) !important;
}

/* Make the grid read more like the board around Ohio */
.shf-impact-map-grid {
  background-image:
    linear-gradient(rgba(122, 96, 70, 0.055) 1px, transparent 1px),
    linear-gradient(90deg, rgba(122, 96, 70, 0.055) 1px, transparent 1px) !important;
  background-size: 44px 44px !important;
  opacity: 0.95 !important;
}

/* Keep the map frame soft and inset */
.shf-impact-map-stage {
  padding: 26px 18px 18px !important;
}

.shf-impact-map-surface {
  inset: 28px 18px 18px !important;
}

/* Ohio body should feel placed on the board, not like a full background */
.shf-impact-map-ohio-mask {
  inset: 8% 12% 10% 12% !important;
  -webkit-mask-size: 114% auto !important;
  -webkit-mask-position: 51% 53% !important;
  mask-size: 114% auto !important;
  mask-position: 51% 53% !important;
  filter: drop-shadow(0 12px 24px rgba(95, 62, 30, 0.10));
}

/* Terrain inside Ohio becomes more refined and less overpowering */
.shf-impact-map-terrain {
  inset: -4% !important;
  width: 108% !important;
  height: 108% !important;
  object-fit: cover !important;
  object-position: center center !important;
  filter:
    saturate(0.96)
    contrast(0.98)
    brightness(0.95) !important;
}

/* County geometry should stay crisp and sit above the Ohio body */
.shf-impact-map-geo-slot {
  inset: 8% 12% 10% 12% !important;
  opacity: 0.98 !important;
  mix-blend-mode: normal !important;
}

.shf-impact-map-geo-slot path,
.shf-impact-map-geo-slot polygon,
.shf-impact-map-geo-slot polyline {
  stroke: rgba(255, 248, 238, 0.96) !important;
  stroke-width: 1.35 !important;
}

/* Slightly soften the dark vignette from zoom so the board still reads */
.shf-impact-map-stage.is-zoomed::after {
  background:
    radial-gradient(circle at 50% 52%, rgba(255,255,255,0.00) 0%, rgba(255,255,255,0.00) 32%, rgba(88, 60, 35, 0.05) 100%) !important;
}

/* Tooltip should still float clearly above the board */
.shf-impact-map-tooltip {
  box-shadow:
    0 16px 34px rgba(86, 58, 34, 0.08),
    0 2px 0 rgba(255,255,255,0.78) inset !important;
}

/* =========================================================
   SHF MAP — OHIO BODY PLACEMENT CALIBRATION
   ========================================================= */
.shf-impact-map-ohio-mask {
  inset: 10% 14% 13% 14% !important;
  -webkit-mask-size: 108% auto !important;
  -webkit-mask-position: 52% 46% !important;
  mask-size: 108% auto !important;
  mask-position: 52% 46% !important;
}

.shf-impact-map-geo-slot {
  inset: 10% 14% 13% 14% !important;
}

/* =========================================================
   SHF MAP — FINAL OHIO PLACEMENT TUNE
   ========================================================= */
.shf-impact-map-ohio-mask {
  inset: 10% 15% 14% 15% !important;
  -webkit-mask-size: 104% auto !important;
  -webkit-mask-position: 53% 44% !important;
  mask-size: 104% auto !important;
  mask-position: 53% 44% !important;
}

.shf-impact-map-geo-slot {
  inset: 10% 15% 14% 15% !important;
}
