.shf-impact-map {
  position: relative;
  width: 100%;
  height: 100%;
  overflow: hidden;
}

/* TEXTURE BASE */
.shf-map-texture {
  position: absolute;
  inset: 0;
  width: 100%;
  height: 100%;
  object-fit: contain;
  z-index: 1;
}

/* COUNTY LINES */
.shf-map-counties {
  position: absolute;
  inset: 0;
  width: 100%;
  height: 100%;
  object-fit: contain;
  z-index: 2;

  filter: brightness(0) invert(1) opacity(0.85);
}

/* NODES */
.shf-map-nodes {
  position: absolute;
  inset: 0;
  z-index: 3;
}

/* NODE STYLE */
.shf-node {
  position: absolute;
  width: 12px;
  height: 12px;
  border-radius: 50%;
  transform: translate(-50%, -50%);

  background: radial-gradient(circle, #ffd89c, #ff9b3d);
  box-shadow:
    0 0 6px rgba(255,150,60,0.8),
    0 0 18px rgba(255,150,60,0.4);
}
