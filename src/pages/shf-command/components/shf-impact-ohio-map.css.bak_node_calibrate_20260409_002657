.shf-impact-map-root {
  position: relative;
  width: 100%;
  height: 100%;
  min-height: 420px;
  border-radius: 16px;
  overflow: hidden;
  background: #f6efe6;
}

.shf-impact-map-base {
  width: 100%;
  height: 100%;
  object-fit: contain;
  opacity: 0.96;
  filter:
    brightness(1.01)
    contrast(1.03)
    saturate(0.92);
}

.shf-impact-map-grid {
  position: absolute;
  inset: 0;
  background-image:
    linear-gradient(rgba(90, 66, 48, 0.035) 1px, transparent 1px),
    linear-gradient(90deg, rgba(90, 66, 48, 0.035) 1px, transparent 1px);
  background-size: 40px 40px;
  pointer-events: none;
  opacity: 0.55;
}

.shf-impact-node-layer {
  position: absolute;
  inset: 0;
}

.shf-impact-node {
  position: absolute;
  transform: translate(-50%, -50%);
  cursor: pointer;
  z-index: 4;
}

.shf-impact-node-core {
  width: 10px;
  height: 10px;
  border-radius: 50%;
  position: relative;
  z-index: 2;
  background: radial-gradient(
    circle at 35% 35%,
    rgba(248, 227, 192, 0.96) 0%,
    rgba(230, 164, 98, 0.92) 28%,
    rgba(204, 108, 47, 0.98) 68%,
    rgba(146, 73, 28, 0.98) 100%
  );
  box-shadow:
    0 0 0 1px rgba(255, 244, 228, 0.34),
    0 0 4px rgba(224, 123, 42, 0.20);
}

.shf-impact-node-pulse {
  position: absolute;
  width: 34px;
  height: 34px;
  top: -12px;
  left: -12px;
  border-radius: 50%;
  z-index: 1;
  background: radial-gradient(
    circle,
    rgba(255, 170, 90, 0.30) 0%,
    rgba(255, 140, 60, 0.18) 40%,
    rgba(255, 200, 140, 0.06) 70%,
    transparent 100%
  );
  opacity: 0;
}

.shf-impact-node.is-active .shf-impact-node-core {
  box-shadow:
    0 0 0 1px rgba(255, 242, 220, 0.52),
    0 0 6px rgba(224, 123, 42, 0.92),
    0 0 18px rgba(224, 123, 42, 0.58),
    0 0 40px rgba(255, 190, 122, 0.24);
}

.shf-impact-node.is-active .shf-impact-node-pulse {
  opacity: 1;
  animation: shfImpactPulse 2.15s ease-out infinite;
}

.shf-impact-node:hover .shf-impact-node-core {
  transform: scale(1.08);
}

.shf-impact-node:hover .shf-impact-node-pulse {
  opacity: 1;
  animation: shfImpactPulse 1.8s ease-out infinite;
}

.shf-impact-node--sm .shf-impact-node-core { width: 8px; height: 8px; }
.shf-impact-node--md .shf-impact-node-core { width: 12px; height: 12px; }
.shf-impact-node--lg .shf-impact-node-core { width: 18px; height: 18px; }

.shf-impact-map-tooltip {
  position: absolute;
  bottom: 20px;
  left: 20px;
  background: rgba(255, 251, 247, 0.94);
  border: 1px solid rgba(194, 163, 136, 0.42);
  padding: 12px 16px;
  border-radius: 12px;
  box-shadow:
    0 10px 30px rgba(79, 53, 40, 0.10),
    0 2px 8px rgba(79, 53, 40, 0.05);
  font-size: 13px;
  line-height: 1.45;
  color: #4f3528;
  z-index: 6;
}

@keyframes shfImpactPulse {
  0% {
    transform: scale(0.52);
    opacity: 0.65;
  }
  65% {
    transform: scale(1.48);
    opacity: 0;
  }
  100% {
    transform: scale(1.48);
    opacity: 0;
  }
}
