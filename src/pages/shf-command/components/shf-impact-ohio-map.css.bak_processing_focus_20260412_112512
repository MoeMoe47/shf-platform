.shf-impact-map-root {
  position: relative;
  min-height: 520px;
  border-radius: 26px;
  overflow: hidden;
  background:
    linear-gradient(180deg, rgba(248,243,236,0.94) 0%, rgba(240,234,226,0.98) 100%);
}

.shf-impact-map-grid {
  position: absolute;
  inset: 0;
  background-image:
    linear-gradient(rgba(122, 96, 70, 0.05) 1px, transparent 1px),
    linear-gradient(90deg, rgba(122, 96, 70, 0.05) 1px, transparent 1px);
  background-size: 44px 44px;
  pointer-events: none;
  z-index: 0;
}

.shf-impact-map-toolbar {
  position: absolute;
  top: 18px;
  right: 18px;
  display: flex;
  gap: 10px;
  z-index: 6;
}

.shf-impact-map-toolbar button {
  border: 1px solid rgba(164, 137, 108, 0.18);
  background: rgba(255,255,255,0.78);
  color: #7a6249;
  border-radius: 999px;
  padding: 10px 16px;
  font: inherit;
}

.shf-impact-map-toolbar .is-active {
  background: rgba(223, 179, 116, 0.18);
  color: #6b4a2e;
}

.shf-impact-map-stage {
  position: relative;
  height: 470px;
  padding: 26px 18px 18px;
  z-index: 1;
}

.shf-impact-map-surface {
  position: absolute;
  inset: 28px 18px 18px;
  transform:
    translate(var(--map-tx, 0%), var(--map-ty, 0%))
    scale(var(--map-scale, 1));
  transform-origin: 50% 50%;
  transition: transform 700ms cubic-bezier(.22,1,.36,1);
}

/* Ohio body from same geometry system */
.shf-impact-map-ohio-body-slot {
  position: absolute;
  inset: 6% 9% 8% 9%;
  z-index: 2;
  opacity: 1;
}

.shf-impact-map-ohio-body-slot svg {
  width: 100%;
  height: 100%;
}

.shf-impact-map-ohio-body-slot path,
.shf-impact-map-ohio-body-slot polygon,
.shf-impact-map-ohio-body-slot polyline {
  fill: rgba(223, 148, 64, 0.78) !important;
  stroke: rgba(255, 241, 222, 0.78) !important;
  stroke-width: 1.1 !important;
  vector-effect: non-scaling-stroke;
  stroke-linejoin: round;
  stroke-linecap: round;
}

/* subtle tonal lift inside Ohio */
.shf-impact-map-ohio-body-slot::before {
  content: "";
  position: absolute;
  inset: 0;
  pointer-events: none;
  background:
    radial-gradient(circle at 32% 30%, rgba(255, 214, 153, 0.34), transparent 28%),
    radial-gradient(circle at 68% 64%, rgba(184, 98, 31, 0.16), transparent 32%);
  mix-blend-mode: soft-light;
  z-index: 3;
}

/* County line truth layer */
.shf-impact-map-geo-slot {
  position: absolute;
  inset: 6% 9% 8% 9%;
  z-index: 4;
  opacity: 0.98;
  mix-blend-mode: normal;
}

.shf-impact-map-geo-slot svg {
  width: 100%;
  height: 100%;
}

.shf-impact-map-geo-slot path,
.shf-impact-map-geo-slot polygon,
.shf-impact-map-geo-slot polyline {
  fill: transparent !important;
  stroke: rgba(255, 248, 238, 0.98) !important;
  stroke-width: 1.35 !important;
  vector-effect: non-scaling-stroke;
  stroke-linejoin: round;
  stroke-linecap: round;
}

.shf-impact-map-stage.is-zoomed::after {
  content: "";
  position: absolute;
  inset: 18px;
  pointer-events: none;
  background:
    radial-gradient(circle at 50% 52%, rgba(255,255,255,0.00) 0%, rgba(255,255,255,0.00) 34%, rgba(88, 60, 35, 0.05) 100%);
  border-radius: 24px;
  z-index: 5;
}

.shf-impact-map-tooltip {
  position: absolute;
  left: 18%;
  bottom: 19%;
  z-index: 6;
  background: rgba(255,255,255,0.94);
  border: 1px solid rgba(170, 137, 103, 0.16);
  border-radius: 22px;
  padding: 18px 18px 16px;
  min-width: 238px;
  box-shadow:
    0 16px 34px rgba(86, 58, 34, 0.08),
    0 2px 0 rgba(255,255,255,0.78) inset;
}

.shf-impact-map-tooltip strong {
  display: block;
  margin-bottom: 10px;
  font-size: 18px;
}

.shf-impact-map-tooltip div {
  line-height: 1.55;
}

/* =========================================================
   PHASE B2A — PREMIUM SHF OHIO BODY
   ========================================================= */

/* Ohio body gets deeper tonal hierarchy */
.shf-impact-map-ohio-body-slot path,
.shf-impact-map-ohio-body-slot polygon,
.shf-impact-map-ohio-body-slot polyline {
  fill: rgba(223, 148, 64, 0.82) !important;
  stroke: rgba(255, 244, 228, 0.82) !important;
  stroke-width: 1.08 !important;
}

/* Richer internal glow and value variation */
.shf-impact-map-ohio-body-slot::before {
  content: "";
  position: absolute;
  inset: 0;
  pointer-events: none;
  background:
    radial-gradient(circle at 30% 26%, rgba(255, 220, 160, 0.34), transparent 22%),
    radial-gradient(circle at 68% 30%, rgba(214, 129, 42, 0.18), transparent 28%),
    radial-gradient(circle at 55% 68%, rgba(182, 96, 26, 0.16), transparent 32%),
    linear-gradient(135deg, rgba(255, 233, 193, 0.10) 0%, rgba(202, 118, 38, 0.14) 100%);
  mix-blend-mode: soft-light;
  z-index: 3;
}

/* Add soft SHF paper grain / terrain suggestion inside Ohio only */
.shf-impact-map-ohio-body-slot::after {
  content: "";
  position: absolute;
  inset: 0;
  pointer-events: none;
  background-image:
    radial-gradient(rgba(116, 77, 43, 0.045) 0.6px, transparent 0.9px),
    radial-gradient(rgba(255, 236, 204, 0.035) 0.7px, transparent 1px);
  background-size: 16px 16px, 24px 24px;
  background-position: 0 0, 7px 9px;
  mix-blend-mode: multiply;
  opacity: 0.42;
  z-index: 3;
}

/* County line layer gets slightly stronger premium contrast */
.shf-impact-map-geo-slot path,
.shf-impact-map-geo-slot polygon,
.shf-impact-map-geo-slot polyline {
  stroke: rgba(255, 248, 238, 0.985) !important;
  stroke-width: 1.42 !important;
}

/* Give the state body a touch more object feeling against board */
.shf-impact-map-ohio-body-slot {
  filter: drop-shadow(0 10px 18px rgba(92, 58, 29, 0.07));
}

/* =========================================================
   PHASE B2B — SUBTLE TERRAIN INSIDE GEO-TRUTH OHIO
   ========================================================= */

/* add restrained terrain texture inside the exact Ohio body footprint */
.shf-impact-map-ohio-body-slot::after {
  content: "";
  position: absolute;
  inset: 0;
  pointer-events: none;
  background-image: url("/assets/shf-command/maps/shf-impact-terrain-fill.png");
  background-size: cover;
  background-position: center center;
  background-repeat: no-repeat;
  mix-blend-mode: multiply;
  opacity: 0.22;
  z-index: 2;
  filter: saturate(0.9) contrast(0.92) brightness(0.96);
}

/* slightly deepen the Ohio base so the texture has something to sit into */
.shf-impact-map-ohio-body-slot path,
.shf-impact-map-ohio-body-slot polygon,
.shf-impact-map-ohio-body-slot polyline {
  fill: rgba(223, 148, 64, 0.88) !important;
  stroke: rgba(255, 244, 228, 0.86) !important;
  stroke-width: 1.08 !important;
}

/* keep county lines crisp over the texture */
.shf-impact-map-geo-slot path,
.shf-impact-map-geo-slot polygon,
.shf-impact-map-geo-slot polyline {
  stroke: rgba(255, 248, 238, 0.995) !important;
  stroke-width: 1.46 !important;
}

/* slightly stronger highlight structure */
.shf-impact-map-ohio-body-slot::before {
  background:
    radial-gradient(circle at 30% 26%, rgba(255, 220, 160, 0.30), transparent 22%),
    radial-gradient(circle at 68% 30%, rgba(214, 129, 42, 0.15), transparent 28%),
    radial-gradient(circle at 55% 68%, rgba(182, 96, 26, 0.14), transparent 32%),
    linear-gradient(135deg, rgba(255, 233, 193, 0.08) 0%, rgba(202, 118, 38, 0.10) 100%) !important;
}

/* =========================================================
   PHASE B2C — TERRAIN ONLY INSIDE OHIO BODY
   ========================================================= */

/* remove the broad texture feeling from the board rectangle */
.shf-impact-map-ohio-body-slot::after {
  inset: 0 !important;
  background-image: url("/assets/shf-command/maps/shf-impact-terrain-fill.png") !important;
  background-size: cover !important;
  background-position: center center !important;
  background-repeat: no-repeat !important;
  mix-blend-mode: multiply !important;
  opacity: 0.16 !important;
  filter: saturate(0.82) contrast(0.88) brightness(0.98) !important;
  z-index: 2 !important;
}

/* strengthen the Ohio body just slightly so the terrain reads inside it */
.shf-impact-map-ohio-body-slot path,
.shf-impact-map-ohio-body-slot polygon,
.shf-impact-map-ohio-body-slot polyline {
  fill: rgba(223, 148, 64, 0.9) !important;
  stroke: rgba(255, 244, 228, 0.84) !important;
  stroke-width: 1.08 !important;
}

/* keep county lines crisp */
.shf-impact-map-geo-slot path,
.shf-impact-map-geo-slot polygon,
.shf-impact-map-geo-slot polyline {
  stroke: rgba(255, 248, 238, 0.995) !important;
  stroke-width: 1.5 !important;
}

/* =========================================================
   SHF MAP — COUNTY FOCUS LAYER
   ========================================================= */

/* stronger zoom behavior now that focus is intentional */
.shf-impact-map-surface {
  transition:
    transform 760ms cubic-bezier(.22,1,.36,1),
    filter 320ms ease !important;
}

/* subtle statewide fade when focused */
.shf-impact-map-stage.is-zoomed .shf-impact-map-ohio-body-slot {
  filter:
    drop-shadow(0 10px 18px rgba(92, 58, 29, 0.06))
    saturate(0.96)
    brightness(0.98);
}

/* focus halo over selected region */
.shf-impact-map-focus-halo {
  position: absolute;
  inset: 6% 9% 8% 9%;
  z-index: 4;
  pointer-events: none;
  background:
    radial-gradient(circle at 52% 56%, rgba(243, 172, 83, 0.26), transparent 10%),
    radial-gradient(circle at 52% 56%, rgba(255, 223, 170, 0.12), transparent 18%);
  opacity: 0;
  transition: opacity 320ms ease, transform 760ms cubic-bezier(.22,1,.36,1);
}

.shf-impact-map-stage.is-zoomed .shf-impact-map-focus-halo {
  opacity: 1;
}

/* county line layer stronger in selected view */
.shf-impact-map-stage.is-zoomed .shf-impact-map-geo-slot path,
.shf-impact-map-stage.is-zoomed .shf-impact-map-geo-slot polygon,
.shf-impact-map-stage.is-zoomed .shf-impact-map-geo-slot polyline {
  stroke: rgba(255, 248, 238, 1) !important;
  stroke-width: 1.7 !important;
}

/* selected county feel via active state contrast */
.shf-impact-map-stage.is-zoomed .shf-impact-map-ohio-body-slot path,
.shf-impact-map-stage.is-zoomed .shf-impact-map-ohio-body-slot polygon,
.shf-impact-map-stage.is-zoomed .shf-impact-map-ohio-body-slot polyline {
  fill: rgba(220, 144, 56, 0.82) !important;
}

/* detail card becomes slightly more “active” */
.shf-impact-map-stage.is-zoomed + .shf-impact-map-tooltip {
  transform: translateY(-3px) scale(1.01);
  box-shadow:
    0 18px 38px rgba(86, 58, 34, 0.12),
    0 2px 0 rgba(255,255,255,0.78) inset !important;
}

/* selected state chips feel more active */
.shf-impact-map-toolbar .is-active {
  box-shadow: 0 0 0 1px rgba(214, 150, 82, 0.08) inset;
}

/* slightly stronger board vignette while focused */
.shf-impact-map-stage.is-zoomed::after {
  background:
    radial-gradient(circle at 50% 52%, rgba(255,255,255,0.00) 0%, rgba(255,255,255,0.00) 28%, rgba(88, 60, 35, 0.07) 100%) !important;
}
