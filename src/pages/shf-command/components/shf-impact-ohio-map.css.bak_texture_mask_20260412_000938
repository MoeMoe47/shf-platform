.shf-impact-map-root {
  position: relative;
  min-height: 520px;
  border-radius: 26px;
  overflow: hidden;
  background:
    linear-gradient(180deg, rgba(248,243,236,0.94) 0%, rgba(240,234,226,0.98) 100%);
}

.shf-impact-map-grid {
  position: absolute;
  inset: 0;
  background-image:
    linear-gradient(rgba(122, 96, 70, 0.035) 1px, transparent 1px),
    linear-gradient(90deg, rgba(122, 96, 70, 0.035) 1px, transparent 1px);
  background-size: 48px 48px;
  pointer-events: none;
  z-index: 0;
}

.shf-impact-map-toolbar {
  position: absolute;
  top: 18px;
  right: 18px;
  display: flex;
  gap: 10px;
  z-index: 6;
}

.shf-impact-map-toolbar button {
  border: 1px solid rgba(164, 137, 108, 0.18);
  background: rgba(255,255,255,0.78);
  color: #7a6249;
  border-radius: 999px;
  padding: 10px 16px;
  font: inherit;
}

.shf-impact-map-toolbar .is-active {
  background: rgba(223, 179, 116, 0.18);
  color: #6b4a2e;
}

.shf-impact-map-stage {
  position: relative;
  height: 470px;
  padding: 22px 18px 18px;
  z-index: 1;
}

.shf-impact-map-surface {
  position: absolute;
  inset: 24px 18px 18px;
  transform:
    translate(var(--map-tx, 0%), var(--map-ty, 0%))
    scale(var(--map-scale, 1));
  transform-origin: 50% 50%;
  transition: transform 700ms cubic-bezier(.22,1,.36,1);
}

/* Ohio body only */
.shf-impact-map-ohio-mask {
  position: absolute;
  inset: 4.5%;
  z-index: 2;
  pointer-events: none;
  overflow: hidden;
  border-radius: 12px;
  -webkit-mask-image: url("/assets/shf-command/maps/Ohio counties map outline.png");
  -webkit-mask-repeat: no-repeat;
  -webkit-mask-position: center;
  -webkit-mask-size: contain;
  mask-image: url("/assets/shf-command/maps/Ohio counties map outline.png");
  mask-repeat: no-repeat;
  mask-position: center;
  mask-size: contain;
  background:
    radial-gradient(circle at 30% 35%, rgba(236, 186, 90, 0.20), transparent 30%),
    radial-gradient(circle at 62% 50%, rgba(206, 127, 36, 0.10), transparent 28%);
}

.shf-impact-map-terrain {
  position: absolute;
  inset: -10%;
  width: 120%;
  height: 120%;
  object-fit: cover;
  object-position: center center;
  filter: saturate(1.04) contrast(1.04);
}

/* Real county/state geometry */
.shf-impact-map-geo-slot {
  position: absolute;
  inset: 4.5%;
  z-index: 3;
  mix-blend-mode: screen;
  opacity: 0.96;
}

.shf-impact-map-geo-slot svg {
  width: 100%;
  height: 100%;
}

.shf-impact-map-geo-slot path,
.shf-impact-map-geo-slot polygon,
.shf-impact-map-geo-slot polyline {
  fill: transparent !important;
  stroke: rgba(255,255,255,0.94) !important;
  stroke-width: 1.2 !important;
  vector-effect: non-scaling-stroke;
  stroke-linejoin: round;
  stroke-linecap: round;
}

.shf-impact-map-stage.is-zoomed::after {
  content: "";
  position: absolute;
  inset: 18px;
  pointer-events: none;
  background:
    radial-gradient(circle at 50% 52%, rgba(255,255,255,0.00) 0%, rgba(255,255,255,0.00) 26%, rgba(88, 60, 35, 0.08) 100%);
  border-radius: 24px;
  z-index: 4;
}

.shf-impact-map-tooltip {
  position: absolute;
  left: 18%;
  bottom: 19%;
  z-index: 5;
  background: rgba(255,255,255,0.94);
  border: 1px solid rgba(170, 137, 103, 0.16);
  border-radius: 22px;
  padding: 18px 18px 16px;
  min-width: 238px;
  box-shadow: 0 18px 38px rgba(86, 58, 34, 0.10);
}

.shf-impact-map-tooltip strong {
  display: block;
  margin-bottom: 10px;
  font-size: 18px;
}

.shf-impact-map-tooltip div {
  line-height: 1.55;
}
