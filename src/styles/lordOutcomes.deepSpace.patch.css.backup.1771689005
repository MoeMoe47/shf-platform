/* =========================================================
   LOO Deep Space Patch (LOAD LAST)
   Purpose:
   - Full-bleed / no right-side cutoff
   - Dark space background with subtle depth
   - Smaller, more 3D rings on the right
========================================================= */

html, body, #root {
  height: 100%;
  background: #030409;
}

.loo-dymApp {
  width: 100vw;
  max-width: 100vw;
  overflow-x: hidden;
  position: relative;

  /* deep space + warm nebula */
  background:
    radial-gradient(1200px 900px at 80% 45%,
      rgba(255,120,30,0.10),
      rgba(0,0,0,0) 62%),
    radial-gradient(900px 700px at 22% 70%,
      rgba(160,55,25,0.08),
      rgba(0,0,0,0) 66%),
    linear-gradient(180deg, #02030a 0%, #04030a 60%, #050208 100%);
}

/* stop any container max-width from clipping */
.looMain,
.looPage,
.looShell,
.looContainer {
  max-width: none !important;
  width: 100% !important;
}

/* =========================================================
   Rings: smaller + more 3D feel
   NOTE: this assumes you render something like .looRings .ring
========================================================= */

.looRings {
  position: absolute;
  right: -420px;   /* pulls rings off-canvas like the mock */
  top: 260px;
  width: 720px;
  height: 720px;

  transform: perspective(1200px) rotateX(68deg) rotateZ(-18deg);
  opacity: 0.80;
  pointer-events: none;
  filter: saturate(0.95) contrast(1.05);
}

/* make the ring edge feel “lit” not flat */
.looRings .ring {
  border-color: rgba(255, 135, 45, 0.30);
  box-shadow:
    0 0 18px rgba(255, 135, 45, 0.22),
    0 0 42px rgba(255, 90, 15, 0.14),
    inset 0 0 18px rgba(255, 170, 80, 0.10);
}

/* vignette for depth */
.loo-dymApp::after {
  content: "";
  position: absolute;
  inset: 0;
  pointer-events: none;
  background: radial-gradient(1100px 800px at center,
    rgba(0,0,0,0) 52%,
    rgba(0,0,0,0.50) 100%);
}
