import { useLayoutEffect, useState } from "react";
import { tourSteps } from "./tourConfig";
import TourStepCard from "./TourStepCard";

function findTarget(selectorString) {
  if (!selectorString) return null;
  const selectors = selectorString.split(",").map(s => s.trim());

  for (const s of selectors) {
    const el = document.querySelector(s);
    if (el) return el;
  }
  return null;
}

export default function TourOverlay({ state, nextStep, prevStep, endTour }) {
  const step = tourSteps[state.currentStep];
  const [rect, setRect] = useState(null);
  const [cardPos, setCardPos] = useState({});

  useLayoutEffect(() => {
    if (!state.isActive || !step) return;

    const el = step.target === "body" ? null : findTarget(step.target);

    if (!el) return;

    const r = el.getBoundingClientRect();

    // tighter highlight
    setRect({
      top: r.top + 4,
      left: r.left + 4,
      width: r.width - 8,
      height: r.height - 8,
    });

    // smart card positioning
    const centerX = r.left + r.width / 2;

    setCardPos({
      top: r.bottom + 16,
      left: centerX - 180,
    });

    el.scrollIntoView({ behavior: "smooth", block: "center" });

  }, [state.currentStep]);

  if (!state.isActive || !step) return null;

  return (
    <>
      <div className="tour-backdrop" />

      {rect && (
        <div
          className="tour-highlight"
          style={{
            top: rect.top,
            left: rect.left,
            width: rect.width,
            height: rect.height,
          }}
        />
      )}

      <div style={{ position: "fixed", zIndex: 10001, ...cardPos }}>
        <TourStepCard
          step={step}
          index={state.currentStep}
          total={tourSteps.length}
          onNext={nextStep}
          onBack={prevStep}
          onClose={endTour}
        />
      </div>
    </>
  );
}
