
.tour-backdrop {
  position: fixed;
  inset: 0;
  background: rgba(5, 10, 18, 0.75);
  backdrop-filter: blur(4px);
  z-index: 9998;
}

.tour-highlight {
  position: absolute;
  border: 3px solid rgba(255, 170, 80, 0.95);
  border-radius: 16px;
  box-shadow:
    0 0 0 2px rgba(255, 170, 80, 0.2),
    0 0 25px rgba(255, 140, 60, 0.7),
    0 0 60px rgba(255, 140, 60, 0.4);
  z-index: 10000;
  pointer-events: none;
  transition: all 0.3s ease;
}

.tour-card {
  position: fixed;
  bottom: 40px;
  right: 40px;
  width: 360px;
  background: rgba(10, 16, 28, 0.96);
  border: 1px solid rgba(255, 170, 80, 0.3);
  border-radius: 16px;
  padding: 16px;
  z-index: 10001;
}

.tour-start-btn {
  position: fixed;
  bottom: 20px;
  left: 20px;
  z-index: 10002;
  background: rgba(15, 23, 42, 0.95);
  border: 1px solid rgba(255, 170, 80, 0.3);
  padding: 10px 14px;
  border-radius: 12px;
  cursor: pointer;
  font-weight: 600;
}
