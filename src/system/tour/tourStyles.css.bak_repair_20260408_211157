
.tour-backdrop {
  position: fixed;
  inset: 0;
  background: rgba(5,10,18,0.78);
  backdrop-filter: blur(6px);
  z-index: 9998;
}

/* 🔥 tighter + cleaner glow */
.tour-highlight {
  position: fixed;
  z-index: 10000;
  pointer-events: none;

  border-radius: 14px;
  border: 2px solid rgba(255, 170, 80, 0.95);

  box-shadow:
    0 0 18px rgba(255, 140, 60, 0.7),
    0 0 45px rgba(255, 140, 60, 0.35);
}

/* 💎 cleaner card */
.tour-card {
  width: 360px;
  background: rgba(10,16,28,0.98);
  border: 1px solid rgba(255,170,80,0.25);
  border-radius: 16px;
  padding: 16px;
  color: #eef3fb;
  box-shadow: 0 24px 60px rgba(0,0,0,0.4);
}

/* subtle buttons */
.tour-controls button {
  background: rgba(255,255,255,0.05);
  border: 1px solid rgba(255,170,80,0.25);
}

/* 🧠 KEY: dim side drawer during tour */
.shf-command-detail,
.shf-right-panel,
.command-detail-panel {
  transition: opacity 0.3s ease;
}

body.tour-active .shf-command-detail,
body.tour-active .shf-right-panel {
  opacity: 0.2;
  pointer-events: none;
}

.tour-start-btn {
  position: fixed;
  left: 20px;
  bottom: 20px;
  z-index: 10002;
}
